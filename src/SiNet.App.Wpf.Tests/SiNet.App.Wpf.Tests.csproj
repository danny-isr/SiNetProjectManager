<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<!-- Must match the system-under-test project (SiNet.App.Wpf is a net10.0-windows WPF app whose
		 view models derive from a local ObservableObject), so the test project is WPF-enabled too. -->
	<TargetFramework>net10.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<IsPackable>false</IsPackable>
	<IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
	<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\SiNet.Application\SiNet.Application.csproj" />
	<ProjectReference Include="..\SiNet.App.Composition\SiNet.App.Composition.csproj" />
	<ProjectReference Include="..\SiNet.App.Wpf\SiNet.App.Wpf.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.Autodesk\SiNet.Infrastructure.Autodesk.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.FileSystem\SiNet.Infrastructure.FileSystem.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.Sql\SiNet.Infrastructure.Sql.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.Secrets\SiNet.Infrastructure.Secrets.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.Logging\SiNet.Infrastructure.Logging.csproj" />
	<ProjectReference Include="..\..\SiNetProjectManagerV2\SiNetProjectManagerV2.csproj" />
  </ItemGroup>

</Project>
