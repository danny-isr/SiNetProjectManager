<UserControl x:Class="SiNet.App.Wpf.Inspection.InspectionShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="600" d:DesignWidth="900"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!--
        DEVELOPER HARNESS ONLY - NOT the target Inspection UX.
        This view exists to exercise the workflow task-completion seam during development. It must NOT
        be expanded into the product screen and must NOT replace the legacy FloatingInspectionView.
        The visual-clone target is SiNet.App.Wpf.Surfaces.Inspection.InspectionWindowView.
        See docs/UI_WINDOW_MIGRATION_MAP.md.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{DynamicResource SiTextMediumStyle}"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6" CornerRadius="3"
                Background="#FFF3E0" BorderBrush="#FFB300" BorderThickness="1"
                Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Task mode" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TaskStatusMessage}" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
        </Border>

        <!--
            Minimal completion trigger. Shown only when completion is meaningful (task mode + a real
            task context). Event code and acting user id are auto-filled from the resolved task/host
            context when available; each falls back to an explicit dev input only when it could not be
            resolved safely (NeedsManualCompletionEventCode / NeedsManualActingUserId). For a branching
            task (its result selects the completion event, e.g. RecheckPlan) the dev event-code input
            stays hidden because the event is resolved from the chosen result via the metadata port; the
            result-code picker appears whenever the task allows more than one. All validation/resolution
            stays in the view model's CompleteFromTaskAsync (result code first, event code second).
        -->
        <Border Grid.Row="2" Margin="0,0,0,8" Padding="8,6" CornerRadius="3"
                Background="#E8F5E9" BorderBrush="#43A047" BorderThickness="1"
                Visibility="{Binding CanCompleteInTaskMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Complete task" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <TextBlock Text="Event code (dev):" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85"
                           Visibility="{Binding NeedsManualCompletionEventCode, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                         Visibility="{Binding NeedsManualCompletionEventCode, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding CompletionEventCode, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="User id (dev):" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85"
                           Visibility="{Binding NeedsManualActingUserId, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Width="60" VerticalAlignment="Center" Margin="0,0,12,0"
                         Visibility="{Binding NeedsManualActingUserId, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding ActingUserId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Result:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.85"
                           Visibility="{Binding HasMultipleAllowedResultCodes, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox Width="140" VerticalAlignment="Center" Margin="0,0,12,0"
                          ItemsSource="{Binding AllowedResultCodes}"
                          SelectedItem="{Binding SelectedResultCode, Mode=TwoWay}"
                          Visibility="{Binding HasMultipleAllowedResultCodes, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="Complete Task" Padding="10,3" VerticalAlignment="Center"
                        Command="{Binding CompleteTaskCommand}" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3">
            <TabItem Header="{Binding Tree.Title}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Tree.Series}"
                             SelectedItem="{Binding Tree.SelectedSeries, Mode=TwoWay}"
                             DisplayMemberPath="Name" Margin="0,0,8,0" />
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Tree.Reports}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              SelectedItem="{Binding Tree.SelectedReport, Mode=TwoWay}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Round" Binding="{Binding ReportNumber}" Width="Auto" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InspectionDate, StringFormat=dd/MM/yyyy}" Width="Auto" />
                            <DataGridTextColumn Header="Inspector" Binding="{Binding InspectorName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Notes.Title}">
                <DataGrid Margin="12" ItemsSource="{Binding Notes.Notes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="Auto" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Text}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{Binding Drawings.Title}">
                <TextBlock Text="{Binding Drawings.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
            <TabItem Header="{Binding ReviewedPlan.Title}">
                <TextBlock Text="{Binding ReviewedPlan.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
            <TabItem Header="{Binding Report.Title}">
                <TextBlock Text="{Binding Report.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
