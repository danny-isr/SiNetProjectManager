<UserControl x:Class="SiNet.App.Wpf.Inspection.InspectionShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="600" d:DesignWidth="900"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6" CornerRadius="3"
                Background="#FFF3E0" BorderBrush="#FFB300" BorderThickness="1"
                Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Task mode" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TaskStatusMessage}" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="{Binding Tree.Title}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Tree.Series}"
                             SelectedItem="{Binding Tree.SelectedSeries, Mode=TwoWay}"
                             DisplayMemberPath="Name" Margin="0,0,8,0" />
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Tree.Reports}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              SelectedItem="{Binding Tree.SelectedReport, Mode=TwoWay}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Round" Binding="{Binding ReportNumber}" Width="Auto" />
                            <DataGridTextColumn Header="Date" Binding="{Binding InspectionDate, StringFormat=dd/MM/yyyy}" Width="Auto" />
                            <DataGridTextColumn Header="Inspector" Binding="{Binding InspectorName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding Notes.Title}">
                <DataGrid Margin="12" ItemsSource="{Binding Notes.Notes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="Auto" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Text}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{Binding Drawings.Title}">
                <TextBlock Text="{Binding Drawings.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
            <TabItem Header="{Binding ReviewedPlan.Title}">
                <TextBlock Text="{Binding ReviewedPlan.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
            <TabItem Header="{Binding Report.Title}">
                <TextBlock Text="{Binding Report.Placeholder}" Margin="12" Opacity="0.8" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
