<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bootstrap defaults — appearance colors overwritten at runtime by WpfThemeRuntimeApplier -->
    <SolidColorBrush x:Key="SiPrimaryBrush" Color="#1F3A5F"/>
    <SolidColorBrush x:Key="SiSecondaryBrush" Color="#757575"/>
    <SolidColorBrush x:Key="SiBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SiForegroundBrush" Color="#000000"/>

    <!-- Structural / semantic defaults (not yet in appearance JSON) -->
    <SolidColorBrush x:Key="SiBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SiMutedForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="SiSurfaceBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="SiOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SiDangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="SiWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="SiSuccessBrush" Color="#059669"/>
</ResourceDictionary>
