<UserControl x:Class="SiNet.App.Wpf.Theme.ThemeColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"/>

        <Border x:Name="ColorSwatch" Grid.Column="1" Width="28" Height="28" Margin="4,0"
                BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" CornerRadius="2"/>

        <TextBox x:Name="HexBox" Grid.Column="2" Margin="8,0"
                 Style="{DynamicResource SiTextBoxStyle}"
                 ToolTip="Hex (#RRGGBB) — אופציה משנית"/>

        <Button Grid.Column="3" Content="בחר..." Margin="4,0,0,0" Padding="8,4"
                Command="{Binding PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <Button Grid.Column="4" Content="איפוס" Margin="4,0,0,0" Padding="8,4"
                Command="{Binding ResetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
