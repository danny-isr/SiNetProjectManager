<Window x:Class="SiNet.App.Wpf.Shell.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שיא חדש"
        Width="560" Height="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Icon="pack://application:,,,/Assets/sinet.ico">

  <Border Background="White"
          BorderBrush="#D5DEE7"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#1B5E20"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="190"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#F7F9F4" CornerRadius="14,14,0,0">
        <Image Source="pack://application:,,,/Assets/logo_si.jpg"
               Stretch="Uniform"
               Margin="36,20"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
      </Border>

      <Grid Grid.Row="1" Margin="28,14,28,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock Text="שיא חדש בע״מ"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#1B5E20"/>
          <TextBlock Text="מנהל פרויקטים — המערכת החדשה"
                     FontSize="13"
                     Foreground="#5B6B7A"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock x:Name="StatusText"
                     Text="מאתחל..."
                     FontSize="12"
                     Foreground="#6B7C8A"
                     Margin="0,0,0,10"/>
          <ProgressBar IsIndeterminate="True"
                       Height="6"
                       Foreground="#2E7D32"
                       Background="#E6EDF2"
                       BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
