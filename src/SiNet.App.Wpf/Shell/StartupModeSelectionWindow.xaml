<Window x:Class="SiNet.App.Wpf.Shell.StartupModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Shell"
        Title="שיא חדש — בחירת מצב הפעלה"
        Height="380"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        ShowInTaskbar="True"
        Background="{DynamicResource SiBackgroundBrush}"
        Icon="pack://application:,,,/Assets/sinet.ico">

  <Border Padding="28" Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
        <Image Source="pack://application:,,,/Assets/shia-chadash-mark.png"
               Width="52" Height="52"
               Stretch="Uniform"
               Margin="0,0,14,0"
               VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="שיא חדש בע״מ"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#1B5E20"/>
          <TextBlock Text="מנהל פרויקטים — בחירת מצב הפעלה"
                     FontSize="13"
                     Foreground="{DynamicResource SiMutedForegroundBrush}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
        <Button Content="המשך"
                Width="110"
                IsDefault="True"
                Click="Continue_OnClick"
                Style="{DynamicResource SiPrimaryButtonStyle}"
                Margin="0,0,8,0"/>
        <Button Content="ביטול"
                Width="110"
                IsCancel="True"
                Click="Cancel_OnClick"
                Style="{DynamicResource SiSecondaryButtonStyle}"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="בחר כיצד להפעיל את מנהל הפרויקטים של שיא חדש."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                   Margin="0,0,0,14"/>

        <Border BorderBrush="{DynamicResource SiBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,8"
                Background="{DynamicResource SiSurfaceBrush}">
          <RadioButton Content="מערכת חדשה (New System) — מעטפת נקייה"
                       IsChecked="{Binding IsNewSystemSelected}"
                       GroupName="StartupMode"/>
        </Border>

        <Border BorderBrush="{DynamicResource SiBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Background="{DynamicResource SiSurfaceBrush}">
          <RadioButton Content="מערכת רגילה (Legacy) — התנהגות ייצור נוכחית"
                       IsChecked="{Binding IsLegacySelected}"
                       GroupName="StartupMode"/>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
