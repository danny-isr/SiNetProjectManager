<Window x:Class="SiNet.App.Wpf.Shell.NewShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Shell"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="{Binding WindowTitle}"
        Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SiBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=local:NewShellDesignData, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SiPrimaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SiTextLargeStyle}" Foreground="White" />
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{DynamicResource SiTextSmallStyle}"
                               Foreground="White" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="משתמש נוכחי" Style="{DynamicResource SiTextTinyStyle}"
                               Foreground="White" Opacity="0.75" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding CurrentUserDisplay}" Style="{DynamicResource SiTextNormalStyle}"
                               Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SiBackgroundBrush}" Padding="12,5"
                BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="0,0,0,1" Opacity="0.95">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="פרויקט נוכחי:" VerticalAlignment="Center"
                           Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,10,0" />

                <ContentControl Grid.Column="1" x:Name="ProjectSelectorHost" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="פרויקט חדש"
                            Command="{Binding OpenNewProjectCommand}"
                            Style="{DynamicResource SiPrimaryButtonStyle}"
                            Padding="12,4"
                            Margin="0,0,10,0"
                            Visibility="{Binding CanOpenNewProject, Converter={StaticResource BoolToVis}}"
                            ToolTip="פתיחת פרויקט חדש"/>
                    <TextBlock Text="{Binding CurrentProjectDisplay}" VerticalAlignment="Center"
                               Style="{DynamicResource SiTextSmallStyle}" Opacity="0.85" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1,0,0,0" Opacity="0.5">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="תפריט מערכת חדשה" Style="{DynamicResource SiTextNormalStyle}"
                               FontWeight="SemiBold" Margin="12,12,12,6" />
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding OpenCommand}"
                                        Style="{DynamicResource SiSecondaryButtonStyle}"
                                        ToolTip="{Binding Description}"
                                        IsEnabled="{Binding IsAvailable}"
                                        HorizontalContentAlignment="Right"
                                        Padding="12,8" Margin="0,4"
                                        Content="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <TextBlock Text="בחר פריט מהתפריט כדי לפתוח מסך חדש."
                           Style="{DynamicResource SiTextNormalStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SiSecondaryBrush}" Opacity="0.85" />
                <ContentControl x:Name="ContentHost" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SiPrimaryBrush}" Padding="12,4">
            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SiTextTinyStyle}"
                       Foreground="White" Opacity="0.85" />
        </Border>
    </Grid>
</Window>
