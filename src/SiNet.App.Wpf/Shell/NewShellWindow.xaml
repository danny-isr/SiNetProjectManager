<Window x:Class="SiNet.App.Wpf.Shell.NewShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Shell"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="{Binding WindowTitle}"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SiBackgroundBrush}"
        Icon="pack://application:,,,/Assets/sinet.ico"
        d:DataContext="{d:DesignInstance Type=local:NewShellDesignData, IsDesignTimeCreatable=True}">

    <DockPanel LastChildFill="True">
        <!-- Header branding (no project selector — project is chosen inside surfaces such as Email) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SiPrimaryBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Background="#FFFFFF"
                        Opacity="0.98"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/shia-chadash-mark.png"
                           Stretch="Uniform"
                           Margin="2"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SiTextLargeStyle}" Foreground="White" />
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{DynamicResource SiTextSmallStyle}"
                               Foreground="White" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="משתמש נוכחי" Style="{DynamicResource SiTextTinyStyle}"
                               Foreground="White" Opacity="0.75" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding CurrentUserDisplay}" Style="{DynamicResource SiTextNormalStyle}"
                               Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top application menu with groups + submenus (legacy MainWindow pattern) -->
        <Menu DockPanel.Dock="Top"
              FlowDirection="RightToLeft"
              Background="{DynamicResource SiBackgroundBrush}"
              Padding="4,2"
              ItemsSource="{Binding MenuItems}">
            <Menu.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:NewShellMenuItem}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Description}" />
                </HierarchicalDataTemplate>
            </Menu.Resources>
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Command" Value="{Binding OpenCommand}" />
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </Menu.ItemContainerStyle>
        </Menu>

        <!-- Footer health -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SiPrimaryBrush}" Padding="12,4">
            <Button Command="{Binding OpenSystemStatusCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Right"
                    ToolTip="מצב מערכת — לחץ לפרטים">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{Binding OverallHealthBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{DynamicResource SiTextTinyStyle}"
                               Foreground="White" Opacity="0.9"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- Main content host (email and other in-shell surfaces) -->
        <Grid Margin="0">
            <TextBlock Text="בחר פריט מהתפריט כדי לפתוח מסך."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SiSecondaryBrush}" Opacity="0.85">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ContentControl x:Name="ContentHost"
                            Content="{Binding CurrentContent}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </DockPanel>
</Window>
