<Window x:Class="SiNet.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SiNet — new architecture slice"
        Height="480" Width="760"
        Background="{DynamicResource SiBackgroundBrush}">
    <TabControl Margin="8">
        <TabItem Header="Inbox" DataContext="{Binding Inbox}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="Connect Google" Command="{Binding ConnectCommand}"
                        HorizontalAlignment="Left" Padding="16,4" MinWidth="120" Margin="0,0,0,8" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Location:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Project:" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="Load" Command="{Binding LoadCommand}"
                            Padding="16,4" Margin="12,0,0,0" MinWidth="80" />
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,10" Opacity="0.8" />

                <DataGrid Grid.Row="3" ItemsSource="{Binding Emails}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="From" Binding="{Binding From}" Width="2*" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="3*" />
                        <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="Auto" />
                        <DataGridCheckBoxColumn Header="Attach." Binding="{Binding HasAttachments}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Inspection">
            <ContentControl x:Name="InspectionHost" />
        </TabItem>
    </TabControl>
</Window>
