                                                           Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding SubContracts}"
                                                              ItemTemplate="{StaticResource BillingSubContractGroupTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding StageGroups}"
                                          Visibility="{Binding ShowFlatSubContractGroups, Converter={StaticResource BoolToVis}}"
                                          ItemTemplate="{StaticResource BillingSubContractGroupTemplate}"
                                          AutomationProperties.AutomationId="BillingDashboard.StageEdits" />
                            <TextBlock Text="רכיבי שעות"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,8,0,8" />
                            <TextBlock Text="{Binding HourlyScopeCaption}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       AutomationProperties.AutomationId="BillingDashboard.HourlyScopeCaption" />
                            <ItemsControl ItemsSource="{Binding HourlyScopeEdits}"
                                          AutomationProperties.AutomationId="BillingDashboard.HourlyScopes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Left"
                                                            Content="הסר"
                                                            Command="{Binding DataContext.RemoveHourlyScopeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Style="{DynamicResource SiSecondaryButtonStyle}" />
                                                    <CheckBox Content="כלול בהכנה"
                                                              IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="הסכמי משנה שעתיים" Style="{StaticResource DetailLabelStyle}" />
                                                <ToggleButton x:Name="HourlySelectorToggle"
                                                              Content="{Binding SelectionSummaryText}"
                                                              IsChecked="{Binding IsSelectorOpen, Mode=TwoWay}"
                                                              HorizontalContentAlignment="Stretch"
                                                              Padding="8,6"
                                                              Margin="0,0,0,6"
                                                              AutomationProperties.AutomationId="BillingDashboard.HourlySelectorToggle" />
                                                <Border Background="{DynamicResource SiBackgroundBrush}"
                                                        BorderBrush="{DynamicResource SiBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="8"
                                                        Margin="0,0,0,6"
                                                        Visibility="{Binding IsSelectorOpen, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,0,6"
                                                                 AutomationProperties.AutomationId="BillingDashboard.HourlySearch" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Content="בחר הכל"
                                                                    Command="{Binding SelectAllCommand}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,0"
                                                                    Style="{DynamicResource SiSecondaryButtonStyle}"
                                                                    AutomationProperties.AutomationId="BillingDashboard.HourlySelectAll" />
                                                            <Button Content="נקה הכל"
                                                                    Command="{Binding ClearAllCommand}"
                                                                    Padding="8,4"
                                                                    Style="{DynamicResource SiSecondaryButtonStyle}"
                                                                    AutomationProperties.AutomationId="BillingDashboard.HourlyClearAll" />
                                                        </WrapPanel>
                                                        <ScrollViewer MaxHeight="{DynamicResource SiPopupListMaxHeight}"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding VisibleChoices}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  Content="{Binding Name}"
                                                                                  Margin="2,3"
                                                                                  AutomationProperties.AutomationId="{Binding AutomationId}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding SubContractName}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="מתאריך" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="120"
                                                             AutomationProperties.AutomationId="BillingDashboard.HourlyFromDate" />
                                                    <TextBlock Text="עד תאריך" VerticalAlignment="Center" Margin="12,0,8,0" />
                                                    <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="120"
                                                             AutomationProperties.AutomationId="BillingDashboard.HourlyToDate" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding AggregatePreviewText}"
                                                           TextWrapping="Wrap"
                                                           AutomationProperties.AutomationId="BillingDashboard.HourlyPreview" />
                                                <TextBlock Text="{Binding HoursAmountText}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding ShowHoursAmount, Converter={StaticResource BoolToVis}}"
                                                           AutomationProperties.AutomationId="BillingDashboard.HourlyAmount" />
                                                <TextBlock Text="{Binding UnifiedHourlyRateText}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding ShowUnifiedHourlyRate, Converter={StaticResource BoolToVis}}" />
                                                <Expander Header="הסכמי המשנה שנבחרו"
                                                          IsExpanded="{Binding ShowSelectedNames, Mode=TwoWay}"
                                                          Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding SelectedNamesText}" TextWrapping="Wrap" />
                                                </Expander>
                                                <TextBlock Text="{Binding ValidationMessage}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SiDangerBrush}"
                                                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding OverlapWarningText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="הוסף רכיב שעות"
                                    Command="{Binding AddHourlyScopeCommand}"
                                    Style="{DynamicResource SiSecondaryButtonStyle}"
                                    Padding="10,6"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="BillingDashboard.AddHourlyScope" />
                            <TextBlock Text="{Binding SelectedPreparationInstructions}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       FontFamily="Consolas" />
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
            </TabControl>
        </DockPanel>

        <Border Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
