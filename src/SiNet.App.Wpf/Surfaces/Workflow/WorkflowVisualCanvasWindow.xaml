<Window x:Class="SiNet.App.Wpf.Surfaces.Workflow.WorkflowVisualCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Workflow"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1280" Height="780"
        MinWidth="960" MinHeight="560"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=local:WorkflowVisualCanvasViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource SiPrimaryBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                           Style="{DynamicResource SiTextLargeStyle}"
                           Margin="10,6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2715;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="CloseButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Foreground="White" Width="34" Height="28"
                            BorderThickness="0" Background="Transparent" Click="MaximizeButton_Click"/>
                    <Button Content="&#x2500;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="MinimizeButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"
                           Style="{DynamicResource SiTextSmallStyle}"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="תבנית:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold"/>
                    <ComboBox Width="360"
                              Style="{DynamicResource SiComboBoxStyle}"
                              ItemsSource="{Binding Definitions}"
                              SelectedItem="{Binding SelectedPickerItem}"
                              DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="זום −" Style="{DynamicResource SiSecondaryButtonStyle}"
                            Padding="10,4" Margin="0,0,4,0"
                            Command="{Binding ZoomOutCommand}" ToolTip="הקטן (Ctrl+גלגלת)"/>
                    <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center" MinWidth="44"
                               TextAlignment="Center" Style="{DynamicResource SiTextSmallStyle}" Margin="0,0,4,0"/>
                    <Button Content="זום +" Style="{DynamicResource SiSecondaryButtonStyle}"
                            Padding="10,4" Margin="0,0,4,0"
                            Command="{Binding ZoomInCommand}" ToolTip="הגדל (Ctrl+גלגלת)"/>
                    <Button Content="100%" Style="{DynamicResource SiSecondaryButtonStyle}"
                            Padding="10,4" Margin="0,0,12,0"
                            Command="{Binding ZoomResetCommand}" ToolTip="איפוס זום"/>
                    <Button Content="נקה בחירה" Style="{DynamicResource SiSecondaryButtonStyle}"
                            Padding="12,4" Margin="0,0,8,0"
                            Command="{Binding ClearSelectionCommand}"/>
                    <Button Content="שמור פריסה" Style="{DynamicResource SiPrimaryButtonStyle}"
                            Padding="12,4" Margin="0,0,8,0"
                            Command="{Binding SaveLayoutCommand}"
                            ToolTip="שומר רק מיקומי CanvasX/Y — לא משנה תוכן תהליך"/>
                    <Button Content="רענן" Style="{DynamicResource SiSecondaryButtonStyle}"
                            Padding="12,4" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Legend + inspect panel -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="מקרא" Style="{DynamicResource SiSectionHeaderStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="14" Height="14" Fill="#43A047" Margin="0,0,6,0"/>
                                <TextBlock Text="התחלה" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="18" Height="12" Background="#1E88E5" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="שלב" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="14" Height="14" Fill="#E53935" Margin="0,0,6,0"/>
                                <TextBlock Text="סיום" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="↻" Margin="0,0,6,0" Style="{DynamicResource SiTextSmallStyle}"/>
                                <TextBlock Text="לולאה עצמית" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>

                            <TextBlock Text="פירוט" Style="{DynamicResource SiSectionHeaderStyle}"/>

                            <TextBlock Text="לחץ על שלב או על חץ בתרשים כדי לראות משימות נדרשות, תנאים ופעולות."
                                       TextWrapping="Wrap" Style="{DynamicResource SiTextSmallStyle}"
                                       Visibility="{Binding ShowEmptyInspectHint, Converter={StaticResource BoolToVis}}"/>

                            <!-- Stage inspect -->
                            <StackPanel Visibility="{Binding IsStageSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="שלב" Style="{DynamicResource SiTextMediumStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedStage.Name}" Style="{DynamicResource SiTextNormalStyle}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.Code, StringFormat=קוד: {0}}" Margin="0,2"
                                           Style="{DynamicResource SiTextSmallStyle}"/>
                                <TextBlock Text="{Binding SelectedStage.NodeType, StringFormat=NodeType: {0}}" Margin="0,2"
                                           Style="{DynamicResource SiTextSmallStyle}"/>
                                <TextBlock Margin="0,2" Style="{DynamicResource SiTextSmallStyle}">
                                    <Run Text="התחלה: "/><Run Text="{Binding SelectedStage.IsInitial, Mode=OneWay}"/>
                                    <Run Text=" · סיום: "/><Run Text="{Binding SelectedStage.IsFinal, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedStage.AssignedGroup, StringFormat=קבוצה: {0}}"
                                           Margin="0,2" Style="{DynamicResource SiTextSmallStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.SubWorkflow, StringFormat=תת-תהליך: {0}}"
                                           Margin="0,2" Style="{DynamicResource SiTextSmallStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.Description}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Style="{DynamicResource SiTextSmallStyle}"/>

                                <TextBlock Text="משימות נדרשות" Style="{DynamicResource SiTextNormalStyle}"
                                           FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedStage.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="0,0,0,1"
                                                    Padding="0,4" Margin="0,0,0,2">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Style="{DynamicResource SiTextSmallStyle}"
                                                               Text="{Binding TaskTypeName}"/>
                                                    <TextBlock Style="{DynamicResource SiTextTinyStyle}"
                                                               Text="{Binding TaskTypeCode, StringFormat=קוד: {0}}"/>
                                                    <TextBlock Style="{DynamicResource SiTextTinyStyle}">
                                                        <Run Text="{Binding RequiredLabel, Mode=OneWay}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Assignee, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{DynamicResource SiTextTinyStyle}" TextWrapping="Wrap"
                                                               Text="{Binding AllowedResultsEn}"/>
                                                    <TextBlock Style="{DynamicResource SiTextTinyStyle}" TextWrapping="Wrap"
                                                               Foreground="#2E7D32"
                                                               Text="{Binding AllowedResultsHe}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="מעברים יוצאים" Style="{DynamicResource SiTextNormalStyle}"
                                           FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedStage.OutgoingTransitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding DisplayEn}" Style="{DynamicResource SiTextSmallStyle}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DisplayHe}" Style="{DynamicResource SiTextTinyStyle}"
                                                           Foreground="#2E7D32" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Transition inspect -->
                            <StackPanel Visibility="{Binding IsTransitionSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="מעבר" Style="{DynamicResource SiTextMediumStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedTransition.Title}" Style="{DynamicResource SiTextNormalStyle}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,8,0,8"
                                        Visibility="{Binding SelectedTransition.IsSelfLoop, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedTransition.SelfLoopExplanation}"
                                               TextWrapping="Wrap" Style="{DynamicResource SiTextSmallStyle}" Foreground="#E65100"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedTransition.FromName, StringFormat=מ: {0}}" Margin="0,2"
                                           Style="{DynamicResource SiTextSmallStyle}"/>
                                <TextBlock Text="{Binding SelectedTransition.ToName, StringFormat=אל: {0}}" Margin="0,2"
                                           Style="{DynamicResource SiTextSmallStyle}"/>

                                <!-- Trigger frame -->
                                <Border Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,10,0,6">
                                    <StackPanel>
                                        <TextBlock Text="טריגר" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,4"
                                                   FontFamily="{DynamicResource SiFontFamily}"/>
                                        <TextBlock Text="{Binding SelectedTransition.TriggerType}" FontWeight="SemiBold"
                                                   Style="{DynamicResource SiTextSmallStyle}"/>
                                        <TextBlock Text="{Binding SelectedTransition.TriggerHe}"
                                                   Style="{DynamicResource SiTextSmallStyle}" Foreground="#1B5E20"/>
                                        <TextBlock Text="{Binding SelectedTransition.TriggerExplanation}" TextWrapping="Wrap"
                                                   Style="{DynamicResource SiTextTinyStyle}" Foreground="#455A64" Margin="0,4,0,0"/>
                                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource SiTextTinyStyle}">
                                            <Run Text="Evaluation: "/><Run Text="{Binding SelectedTransition.EvaluationMode, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding SelectedTransition.EvaluationHe, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedTransition.Priority, StringFormat=Priority: {0}}"
                                                   Style="{DynamicResource SiTextTinyStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Condition frame -->
                                <Border Background="#E3F2FD" BorderBrush="#42A5F5" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="תנאי" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4"
                                                   FontFamily="{DynamicResource SiFontFamily}"/>
                                        <TextBlock Text="{Binding SelectedTransition.ConditionType}" FontWeight="SemiBold"
                                                   Style="{DynamicResource SiTextSmallStyle}"/>
                                        <TextBlock Text="{Binding SelectedTransition.ConditionHe}"
                                                   Style="{DynamicResource SiTextSmallStyle}" Foreground="#0D47A1"/>
                                        <TextBlock Text="{Binding SelectedTransition.TaskResultCode}" Margin="0,6,0,0"
                                                   FontWeight="SemiBold" Style="{DynamicResource SiTextSmallStyle}"/>
                                        <TextBlock Text="{Binding SelectedTransition.TaskResultName}"
                                                   Style="{DynamicResource SiTextSmallStyle}" Foreground="#0D47A1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions frame -->
                                <Border Background="#F3E5F5" BorderBrush="#AB47BC" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="פעולות" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,0,0,4"
                                                   FontFamily="{DynamicResource SiFontFamily}"/>
                                        <TextBlock Text="אין פעולות במעבר זה"
                                                   Style="{DynamicResource SiTextSmallStyle}" Foreground="#7B1FA2"
                                                   Visibility="{Binding SelectedTransition.HasNoActions, Converter={StaticResource BoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTransition.Actions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding DisplayEn}" Style="{DynamicResource SiTextSmallStyle}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DisplayHe}" Style="{DynamicResource SiTextTinyStyle}"
                                                                   Foreground="#4A148C" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SiBackgroundBrush}"
                                        BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="משימות נדרשות בשלב המקור"
                                                   Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTransition.RequiredTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="0,0,0,1"
                                                            Padding="0,4" Margin="0,0,0,2">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                                                       Style="{DynamicResource SiTextSmallStyle}"
                                                                       Text="{Binding TaskTypeName}"/>
                                                            <TextBlock Style="{DynamicResource SiTextTinyStyle}"
                                                                       Text="{Binding TaskTypeCode, StringFormat=קוד: {0}}"/>
                                                            <TextBlock Style="{DynamicResource SiTextTinyStyle}">
                                                                <Run Text="{Binding RequiredLabel, Mode=OneWay}"/>
                                                                <Run Text=" · "/><Run Text="{Binding Assignee, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Style="{DynamicResource SiTextTinyStyle}" TextWrapping="Wrap"
                                                                       Text="{Binding AllowedResultsEn}"/>
                                                            <TextBlock Style="{DynamicResource SiTextTinyStyle}" TextWrapping="Wrap"
                                                                       Foreground="#2E7D32"
                                                                       Text="{Binding AllowedResultsHe}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                        <Canvas x:Name="GraphCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                Background="{DynamicResource SiBackgroundBrush}" FlowDirection="LeftToRight"
                                MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown">
                            <Canvas.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                            </Canvas.LayoutTransform>
                            <ItemsControl ItemsSource="{Binding Nodes}" Panel.ZIndex="3">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="140" Height="56" Cursor="SizeAll"
                                              Background="Transparent"
                                              MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                              MouseMove="Node_MouseMove"
                                              MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                              LostMouseCapture="Node_LostMouseCapture">
                                            <Ellipse Fill="{Binding Fill}" Stroke="{Binding StrokeBrush}"
                                                     StrokeThickness="{Binding StrokeThickness}"
                                                     Visibility="{Binding IsEllipse, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="{Binding Fill}" CornerRadius="8"
                                                    BorderBrush="{Binding StrokeBrush}"
                                                    BorderThickness="{Binding BorderThicknessValue}"
                                                    Visibility="{Binding IsRoundedRect, Converter={StaticResource BoolToVis}}"/>
                                            <Polygon Points="70,2 138,28 70,54 2,28" Fill="{Binding Fill}"
                                                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeThickness}"
                                                     Visibility="{Binding IsDiamond, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Caption}" Foreground="White" FontWeight="SemiBold"
                                                       FontFamily="{DynamicResource SiFontFamily}"
                                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="6"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Edges}" Panel.ZIndex="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Cursor="Hand"
                                                MouseLeftButtonDown="Edge_MouseLeftButtonDown">
                                            <!-- Wide invisible hit target -->
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="Transparent" StrokeThickness="14"
                                                  Visibility="{Binding IsStraight, Converter={StaticResource BoolToVis}}"/>
                                            <Polyline Points="{Binding LoopPoints}" Stroke="Transparent" StrokeThickness="14"
                                                      Visibility="{Binding IsSelfLoop, Converter={StaticResource BoolToVis}}"/>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding IsStraight, Converter={StaticResource BoolToVis}}"/>
                                            <Polyline Points="{Binding LoopPoints}"
                                                      Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                      IsHitTestVisible="False"
                                                      Visibility="{Binding IsSelfLoop, Converter={StaticResource BoolToVis}}"/>
                                            <Polygon Points="{Binding ArrowPoints}" Fill="{Binding Stroke}" Stroke="{Binding Stroke}"
                                                     IsHitTestVisible="False"/>
                                            <StackPanel Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                        Width="140" HorizontalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        IsHitTestVisible="False">
                                                <StackPanel.RenderTransform>
                                                    <RotateTransform Angle="{Binding LabelAngle}"/>
                                                </StackPanel.RenderTransform>
                                                <Border Background="#E8FFFFFF" CornerRadius="2" Padding="4,1" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="{DynamicResource SiFontFamily}"
                                                               FontSize="{DynamicResource SiTextTinyFontSize}"
                                                               FontWeight="SemiBold" TextAlignment="Center"
                                                               Text="{Binding LabelEn, Mode=OneWay}"
                                                               Foreground="{Binding LabelBrush, Mode=OneWay}"/>
                                                </Border>
                                                <Grid Height="12" Background="Transparent"/>
                                                <Border Background="#E8FFFFFF" CornerRadius="2" Padding="4,1" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="{DynamicResource SiFontFamily}"
                                                               FontSize="{DynamicResource SiTextTinyFontSize}"
                                                               TextAlignment="Center"
                                                               Text="{Binding LabelHe, Mode=OneWay}"
                                                               Foreground="{Binding LabelBrush, Mode=OneWay}"/>
                                                </Border>
                                            </StackPanel>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{DynamicResource SiTextSmallStyle}" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
