<Window x:Class="SiNet.App.Wpf.Surfaces.Workflow.WorkflowVisualCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Workflow"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1280" Height="780"
        MinWidth="960" MinHeight="560"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown"
        d:DataContext="{d:DesignInstance Type=local:WorkflowVisualCanvasViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1565C0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                           Margin="10,6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2715;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="CloseButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Foreground="White" Width="34" Height="28"
                            BorderThickness="0" Background="Transparent" Click="MaximizeButton_Click"/>
                    <Button Content="&#x2500;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="MinimizeButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="#0D47A1" FontSize="12"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="תבנית:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="360"
                              ItemsSource="{Binding Definitions}"
                              SelectedItem="{Binding SelectedPickerItem}"
                              DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="נקה בחירה" Padding="12,4" Margin="0,0,8,0"
                            Command="{Binding ClearSelectionCommand}"/>
                    <Button Content="שמור פריסה" Padding="12,4" Margin="0,0,8,0"
                            Command="{Binding SaveLayoutCommand}"
                            ToolTip="שומר רק מיקומי CanvasX/Y — לא משנה תוכן תהליך"/>
                    <Button Content="רענן" Padding="12,4" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Legend + inspect panel -->
                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="מקרא" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="14" Height="14" Fill="#43A047" Margin="0,0,6,0"/>
                                <TextBlock Text="התחלה" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="18" Height="12" Background="#1E88E5" CornerRadius="3" Margin="0,0,6,0"/>
                                <TextBlock Text="שלב" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="14" Height="14" Fill="#E53935" Margin="0,0,6,0"/>
                                <TextBlock Text="סיום" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="↻" Margin="0,0,6,0"/>
                                <TextBlock Text="לולאה עצמית" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border BorderBrush="#EEE" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>

                            <TextBlock Text="פירוט" FontWeight="Bold" Margin="0,0,0,8"/>

                            <TextBlock Text="לחץ על שלב או על חץ בתרשים כדי לראות משימות נדרשות, תנאים ופעולות."
                                       TextWrapping="Wrap" Foreground="#666" FontSize="11"
                                       Visibility="{Binding ShowEmptyInspectHint, Converter={StaticResource BoolToVis}}"/>

                            <!-- Stage inspect -->
                            <StackPanel Visibility="{Binding IsStageSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="שלב" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedStage.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.Code, StringFormat=קוד: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedStage.NodeType, StringFormat=NodeType: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Margin="0,2" FontSize="11">
                                    <Run Text="התחלה: "/><Run Text="{Binding SelectedStage.IsInitial, Mode=OneWay}"/>
                                    <Run Text=" · סיום: "/><Run Text="{Binding SelectedStage.IsFinal, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedStage.AssignedGroup, StringFormat=קבוצה: {0}}"
                                           Margin="0,2" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.SubWorkflow, StringFormat=תת-תהליך: {0}}"
                                           Margin="0,2" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedStage.Description}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" FontSize="11" Foreground="#555"/>

                                <TextBlock Text="משימות נדרשות" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedStage.Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,2">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"
                                                               Text="{Binding TaskTypeName}"/>
                                                    <TextBlock FontSize="10" Foreground="#555"
                                                               Text="{Binding TaskTypeCode, StringFormat=קוד: {0}}"/>
                                                    <TextBlock FontSize="10">
                                                        <Run Text="{Binding RequiredLabel, Mode=OneWay}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Assignee, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="#37474F"
                                                               Text="{Binding AllowedResults, StringFormat=תוצאות: {0}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="מעברים יוצאים" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedStage.OutgoingTransitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Transition inspect -->
                            <StackPanel Visibility="{Binding IsTransitionSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="מעבר" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedTransition.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,8,0,8"
                                        Visibility="{Binding SelectedTransition.IsSelfLoop, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedTransition.SelfLoopExplanation}"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#E65100"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedTransition.FromName, StringFormat=מ: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.ToName, StringFormat=אל: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.TriggerType, StringFormat=Trigger: {0}}" Margin="0,6,0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.TriggerExplanation}" TextWrapping="Wrap"
                                           FontSize="11" Foreground="#455A64" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedTransition.ConditionType, StringFormat=Condition: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.TaskResult, StringFormat=TaskResult: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.EvaluationMode, StringFormat=Evaluation: {0}}" Margin="0,2" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTransition.Priority, StringFormat=Priority: {0}}" Margin="0,2" FontSize="11"/>

                                <TextBlock Text="משימות נדרשות בשלב המקור" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedTransition.RequiredTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,2">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"
                                                               Text="{Binding TaskTypeName}"/>
                                                    <TextBlock FontSize="10" Foreground="#555"
                                                               Text="{Binding TaskTypeCode, StringFormat=קוד: {0}}"/>
                                                    <TextBlock FontSize="10">
                                                        <Run Text="{Binding RequiredLabel, Mode=OneWay}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Assignee, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" TextWrapping="Wrap"
                                                               Text="{Binding AllowedResults, StringFormat=תוצאות: {0}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="פעולות" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedTransition.Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="GraphCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                                Background="#FAFAFA" FlowDirection="LeftToRight"
                                MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown">
                            <ItemsControl ItemsSource="{Binding Nodes}" Panel.ZIndex="3">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="140" Height="56" Cursor="SizeAll"
                                              Background="Transparent"
                                              MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                              MouseMove="Node_MouseMove"
                                              MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                              LostMouseCapture="Node_LostMouseCapture">
                                            <Ellipse Fill="{Binding Fill}" Stroke="{Binding StrokeBrush}"
                                                     StrokeThickness="{Binding StrokeThickness}"
                                                     Visibility="{Binding IsEllipse, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="{Binding Fill}" CornerRadius="8"
                                                    BorderBrush="{Binding StrokeBrush}"
                                                    BorderThickness="{Binding BorderThicknessValue}"
                                                    Visibility="{Binding IsRoundedRect, Converter={StaticResource BoolToVis}}"/>
                                            <Polygon Points="70,2 138,28 70,54 2,28" Fill="{Binding Fill}"
                                                     Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeThickness}"
                                                     Visibility="{Binding IsDiamond, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Caption}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="6"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Edges}" Panel.ZIndex="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Cursor="Hand"
                                                MouseLeftButtonDown="Edge_MouseLeftButtonDown">
                                            <!-- Wide invisible hit target -->
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="Transparent" StrokeThickness="14"
                                                  Visibility="{Binding IsStraight, Converter={StaticResource BoolToVis}}"/>
                                            <Polyline Points="{Binding LoopPoints}" Stroke="Transparent" StrokeThickness="14"
                                                      Visibility="{Binding IsSelfLoop, Converter={StaticResource BoolToVis}}"/>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding IsStraight, Converter={StaticResource BoolToVis}}"/>
                                            <Polyline Points="{Binding LoopPoints}"
                                                      Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                      IsHitTestVisible="False"
                                                      Visibility="{Binding IsSelfLoop, Converter={StaticResource BoolToVis}}"/>
                                            <Polygon Points="{Binding ArrowPoints}" Fill="{Binding Stroke}" Stroke="{Binding Stroke}"
                                                     IsHitTestVisible="False"/>
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding Label}" FontSize="10" Foreground="#263238"
                                                       Background="#F5FFFFFF" Padding="3,1" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
