<Window x:Class="SiNet.App.Wpf.Surfaces.Workflow.WorkflowVisualCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Workflow"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="560"
        FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=local:WorkflowVisualCanvasViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1565C0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontWeight="Bold"
                           Margin="10,6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2715;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="CloseButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Foreground="White" Width="34" Height="28"
                            BorderThickness="0" Background="Transparent" Click="MaximizeButton_Click"/>
                    <Button Content="&#x2500;" Foreground="White" Width="34" Height="28" BorderThickness="0"
                            Background="Transparent" Click="MinimizeButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="#0D47A1" FontSize="12"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="תבנית:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="360"
                              ItemsSource="{Binding Definitions}"
                              SelectedItem="{Binding SelectedPickerItem}"
                              DisplayMemberPath="Display"/>
                </StackPanel>
                <Button Grid.Column="1" Content="רענן" Padding="12,4" Command="{Binding RefreshCommand}"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Legend -->
                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="מקרא" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="18" Height="18" Fill="#43A047" Margin="0,0,8,0"/>
                            <TextBlock Text="התחלה (Start)" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="16" Background="#1E88E5" CornerRadius="4" Margin="0,0,8,0"/>
                            <TextBlock Text="שלב (Stage)" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Polygon Points="9,0 18,9 9,18 0,9" Fill="#FB8C00" Margin="0,0,8,0"/>
                            <TextBlock Text="החלטה (Decision)" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="16" Background="#6D4C41" CornerRadius="2" BorderBrush="#3E2723"
                                    BorderThickness="2" Margin="0,0,8,0"/>
                            <TextBlock Text="תת-תהליך" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="18" Height="18" Fill="#E53935" Margin="0,0,8,0"/>
                            <TextBlock Text="סיום (End)" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="→" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="מעבר (Trigger על החץ)" VerticalAlignment="Center" TextWrapping="Wrap" Width="140"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#FAFAFA">
                            <ItemsControl ItemsSource="{Binding Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                                  X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="#607D8B" StrokeThickness="2"/>
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding Label}" FontSize="10" Foreground="#455A64"
                                                       Background="#EEFFFFFF" Padding="2"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="140" Height="56">
                                            <Ellipse Fill="{Binding Fill}" Stroke="#333" StrokeThickness="1"
                                                     Visibility="{Binding IsEllipse, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="{Binding Fill}" CornerRadius="8"
                                                    BorderBrush="#333" BorderThickness="1"
                                                    Visibility="{Binding IsRoundedRect, Converter={StaticResource BoolToVis}}"/>
                                            <Polygon Points="70,2 138,28 70,54 2,28" Fill="{Binding Fill}"
                                                     Stroke="#333" StrokeThickness="1"
                                                     Visibility="{Binding IsDiamond, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Caption}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="6"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
