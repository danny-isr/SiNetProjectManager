<Window x:Class="SiNet.App.Wpf.Surfaces.Inspection.InspectionWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Inspection"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Width="420" Height="850"
        MinWidth="360" MinHeight="380"
        FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=local:InspectionWindowViewModel, IsDesignTimeCreatable=True}">

    <!--
        VISUAL CLONE of the legacy SiNetProjectManagerV2/WPFUserControl/FloatingInspectionView.xaml.
        Structure (header chrome, create-report strip, locked-report action row, metadata row,
        notes list, report cards, status bar) is reproduced for visual parity. Commands are stubbed
        in InspectionWindowViewModel ("not wired yet"); data is fake/design-time only. No DB / report
        generation / Gmail / planner / ACC / file-system / workflow logic lives behind this window.
        InspectionShellView remains a developer harness only; this is the visual-clone target.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Small action button — shared rounded chrome (CornerRadius=6). -->
        <Style TargetType="Button" x:Key="CardActionButton" BasedOn="{StaticResource SiRoundedButtonBase}">
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CCC" />
        </Style>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════ Header: Project Name + Pin + Dock + Refresh + Collapse + Close ═══════ -->
            <Border Grid.Row="0" Background="#2E7D32" Padding="10,8"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveProjectDisplay}"
                               Foreground="White"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextMediumFontSize}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- Pin (stay on top) -->
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Width="28" Height="28"
                                  Margin="6,0,0,0"
                                  Cursor="Hand"
                                  ToolTip="הצמד למעלה">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="PinBorder" Background="Transparent" CornerRadius="4" Padding="4">
                                    <TextBlock x:Name="PinIcon" Text="📌" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Opacity="0.5" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="PinIcon" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="PinBorder" Property="Background" Value="#388E3C" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PinBorder" Property="Background" Value="#388E3C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Dock / Undock -->
                    <ToggleButton Grid.Column="2"
                                  IsChecked="{Binding IsDocked, Mode=TwoWay}"
                                  Width="28" Height="28"
                                  Margin="4,0,0,0"
                                  Cursor="Hand"
                                  ToolTip="עגן לאפליקציה">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="DockBorder" Background="Transparent" CornerRadius="4" Padding="4">
                                    <TextBlock x:Name="DockIcon" Text="🏠" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Opacity="0.5" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="DockIcon" Property="Opacity" Value="1.0" />
                                        <Setter TargetName="DockBorder" Property="Background" Value="#388E3C" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DockBorder" Property="Background" Value="#388E3C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Refresh -->
                    <Button Grid.Column="3"
                            Content="🔄"
                            Command="{Binding RefreshCommand}"
                            ToolTip="רענן"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White" />

                    <!-- Collapse / Expand -->
                    <Button Grid.Column="4"
                            Command="{Binding ToggleCollapseCommand}"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="🔽" />
                                <Setter Property="ToolTip" Value="כווץ" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Content" Value="🔼" />
                                        <Setter Property="ToolTip" Value="הרחב" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close -->
                    <Button Grid.Column="5"
                            Content="✕"
                            Click="CloseButton_Click"
                            ToolTip="סגור"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="Bold" />
                </Grid>
            </Border>

            <!-- ═══════ Create New Report Strip ═══════ -->
            <Border x:Name="CreateBar" Grid.Row="1" Background="{DynamicResource SiBackgroundBrush}" Padding="8,6"
                    BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Template picker -->
                    <ComboBox Grid.Row="0" Grid.Column="0"
                              Style="{DynamicResource SiComboBoxStyle}"
                              ItemsSource="{Binding AvailableTemplates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name"
                              Padding="4,3"
                              Margin="0,0,4,4"
                              ToolTip="בחר תבנית ביקורת" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="רענון תבניות"
                                Command="{Binding RefreshTemplatesCommand}"
                                Style="{StaticResource CardActionButton}"
                                Padding="8,3"
                                Margin="0,0,0,4"
                                ToolTip="טען תבניות מתיקיית Google Drive" />
                    </StackPanel>

                    <!-- Create report -->
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="+ דוח חדש"
                            Command="{Binding CreateReportCommand}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CardActionButton}"
                            FontWeight="SemiBold"
                            Padding="10,3"
                            ToolTip="צור דוח ביקורת חדש מהתבנית הנבחרת" />
                </Grid>
            </Border>

            <!-- ═══════ Selected report body (notes area) ═══════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SiBackgroundBrush}"
                    Padding="6"
                    Visibility="{Binding HasSelectedReport, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Foreground="#2E7D32" Margin="4,0,0,4"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextMediumFontSize}">
                        <Run Text="📋 שאלון ביקורת — דוח #" />
                        <Run Text="{Binding SelectedReport.ReportNumber, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Report action row + metadata -->
                    <Border Grid.Row="1" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="4"
                            BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1"
                            Padding="6,4" Margin="2,0,2,4">
                        <StackPanel Orientation="Vertical">

                            <!-- Action row: mark received / re-pull / open source / unlock / share -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="✅"
                                        Command="{Binding MarkResponseReceivedCommand}"
                                        MinWidth="28" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="#43A047" Foreground="White"
                                        BorderBrush="#2E7D32" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="התקבלה תגובה מהמתכנן" />
                                <Button Content="🔄"
                                        Command="{Binding RepullPlannerResponsesCommand}"
                                        MinWidth="26" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="Transparent" Foreground="#2E7D32"
                                        BorderBrush="#2E7D32" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="משיכת תגובות המתכנן מחדש" />
                                <Button Content="🔗"
                                        Command="{Binding OpenSourceReportCommand}"
                                        MinWidth="26" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="Transparent" Foreground="#1565C0"
                                        BorderBrush="#1565C0" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="פתח את דוח המקור" />
                                <Button Content="🔓"
                                        Command="{Binding UnlockReportCommand}"
                                        MinWidth="26" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="Transparent" Foreground="#6D4C00"
                                        BorderBrush="#FFB300" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="שחרר נעילה" />
                                <Button Content="🌐"
                                        Command="{Binding ShareReportCommand}"
                                        MinWidth="26" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="Transparent" Foreground="#6D4C00"
                                        BorderBrush="#FFB300" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        ToolTip="שתף קישור לכל מי שיש לו הקישור" />
                                <Button Content="📤"
                                        Command="{Binding ExportReportCommand}"
                                        MinWidth="26" MinHeight="24" Padding="4,2"
                                        FontFamily="{DynamicResource SiFontFamily}"
                                        FontSize="{DynamicResource SiTextNormalFontSize}"
                                        Background="Transparent" Foreground="#1565C0"
                                        BorderBrush="#1565C0" BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="{Binding ExportTooltip}"
                                        ToolTipService.ShowOnDisabled="True" />
                                <Button Content="השלם משימה"
                                        Command="{Binding CompleteTaskCommand}"
                                        Style="{StaticResource CardActionButton}"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding CanCompleteTask, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="השלם את המשימה הנוכחית" />
                            </StackPanel>

                            <TextBlock Text="{Binding ValidationSummary}"
                                       Foreground="#C62828"
                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasValidationBlockingExport, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Metadata + reviewed-plan selection -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="בודק:"
                                           Foreground="{DynamicResource SiSecondaryBrush}"
                                           FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextSmallFontSize}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedReport.InspectorName, Mode=OneWay}"
                                           FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextSmallFontSize}"
                                           Foreground="{DynamicResource SiForegroundBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="תאריך:"
                                           Foreground="{DynamicResource SiSecondaryBrush}"
                                           FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextSmallFontSize}"
                                           VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SelectedReport.InspectionDate, StringFormat=dd/MM/yyyy, Mode=OneWay}"
                                           FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextSmallFontSize}"
                                           Foreground="{DynamicResource SiForegroundBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="5"
                                        Content="בחר תוכנית..."
                                        Command="{Binding SelectReviewedPlanCommand}"
                                        Style="{StaticResource CardActionButton}"
                                        Margin="6,0,0,0" Padding="8,1"
                                        VerticalAlignment="Center"
                                        ToolTip="בחר את התוכנית שנבדקה" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes / cards list -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 שאלון ביקורת" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SiSecondaryBrush}"
                                       FontFamily="{DynamicResource SiFontFamily}"
                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="בדיקת AI"
                                    Command="{Binding ReviewNoteAiCommand}"
                                    Style="{StaticResource CardActionButton}"
                                    Padding="8,1" Margin="0,0,6,0"
                                    Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="הצעות דקדוק / ניסוח להערה הנבחרת" />
                            <Button Grid.Column="2" Content="+ הערה"
                                    Command="{Binding AddNoteCommand}"
                                    Style="{StaticResource CardActionButton}"
                                    Padding="8,1" ToolTip="הוסף הערה חדשה" />
                        </Grid>

                        <!-- Hierarchical questionnaire tree: General + Chapter → Section → Note -->
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding InspectionTree}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="InspectionTree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="FontFamily" Value="{DynamicResource SiFontFamily}" />
                                    <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SiForegroundBrush}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <!-- General chapter (Chapter 0) -->
                                <HierarchicalDataTemplate DataType="{x:Type local:InspectionGeneralChapterItem}"
                                                          ItemsSource="{Binding Fields}">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="Bold"
                                               Foreground="#1565C0"
                                               FontFamily="{DynamicResource SiFontFamily}"
                                               FontSize="{DynamicResource SiTextMediumFontSize}"
                                               Margin="0,2"
                                               ToolTip="שדות כלליים מהתבנית" />
                                </HierarchicalDataTemplate>

                                <!-- General field: label + TextBox + auto/manual -->
                                <DataTemplate DataType="{x:Type local:InspectionGeneralFieldItem}">
                                    <Border Padding="1,1" Margin="0"
                                            CornerRadius="2"
                                            BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="#D0D0D0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                        <Setter Property="Background" Value="#FDECEA" />
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="ToolTip" Value="שדה חובה — יש למלא לפני ייצוא" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SiForegroundBrush}"
                                                       FontFamily="{DynamicResource SiFontFamily}"
                                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="28"
                                                     FontFamily="{DynamicResource SiFontFamily}"
                                                     FontSize="{DynamicResource SiTextSmallFontSize}"
                                                     Foreground="{DynamicResource SiForegroundBrush}"
                                                     Padding="3,2"
                                                     VerticalAlignment="Top"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     LostFocus="GeneralField_LostFocus">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SiTextBoxStyle}">
                                                        <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                                <Setter Property="IsReadOnly" Value="True" />
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SiSecondaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsSelectedReportLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="IsReadOnly" Value="True" />
                                                                <Setter Property="Background" Value="#F0F0F0" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SiSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ToggleButton Grid.Column="2"
                                                          IsChecked="{Binding IsManualOverride}"
                                                          IsEnabled="{Binding DataContext.IsReportEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          FontFamily="{DynamicResource SiFontFamily}"
                                                          FontSize="{DynamicResource SiTextTinyFontSize}"
                                                          Padding="4,1"
                                                          Margin="4,0,0,0"
                                                          MinHeight="22"
                                                          VerticalAlignment="Top"
                                                          ToolTip="לחץ כדי לעבור בין מילוי אוטומטי לידני"
                                                          Click="AutoManualToggle_Click">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Content" Value="אוטומטי" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Content" Value="ידני" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <!-- Level 1: Chapter — number + title -->
                                <HierarchicalDataTemplate DataType="{x:Type local:InspectionChapterItem}"
                                                          ItemsSource="{Binding Sections}">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"
                                               FontFamily="{DynamicResource SiFontFamily}"
                                               FontSize="{DynamicResource SiTextMediumFontSize}"
                                               Margin="0,2"
                                               ToolTip="{Binding DisplayTitle}" />
                                </HierarchicalDataTemplate>

                                <!-- Level 2: Section — header + "+" add-note button -->
                                <HierarchicalDataTemplate DataType="{x:Type local:InspectionSectionItem}"
                                                          ItemsSource="{Binding Notes}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SectionHeaderText}"
                                                   Foreground="{DynamicResource SiForegroundBrush}"
                                                   FontFamily="{DynamicResource SiFontFamily}"
                                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding SectionHeaderText}" />
                                        <Button Grid.Column="1" Content="+"
                                                Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CardActionButton}"
                                                Padding="2,0" FontWeight="Bold"
                                                MinWidth="18" MinHeight="18"
                                                ToolTip="הוסף הערה חדשה" />
                                    </Grid>
                                </HierarchicalDataTemplate>

                                <!-- Level 3: Note — status Combo TwoWay + inline rich editor -->
                                <DataTemplate DataType="{x:Type local:InspectionNoteItem}">
                                    <Border Padding="2,3" Margin="0,0,0,2"
                                            CornerRadius="2" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="#D0D0D0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPlannerResponse}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MinWidth="36" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Vertical"
                                                        VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Button Content="▲" FontSize="{DynamicResource SiTextTinyFontSize}"
                                                        MinWidth="14" MinHeight="14" Padding="0"
                                                        Command="{Binding DataContext.MoveNoteUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CardActionButton}"
                                                        ToolTip="הזז למעלה" />
                                                <Button Content="▼" FontSize="{DynamicResource SiTextTinyFontSize}"
                                                        MinWidth="14" MinHeight="14" Padding="0"
                                                        Command="{Binding DataContext.MoveNoteDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CardActionButton}"
                                                        ToolTip="הזז למטה" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="2,0,4,0">
                                                <Button Content="📂" FontSize="{DynamicResource SiTextSmallFontSize}"
                                                        MinWidth="18" MinHeight="18" Padding="2" Margin="0,0,3,0"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.OpenNoteLinkedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="פתח / בחר קובץ מקושר"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ContextMenuService.ShowOnDisabled="True">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="פתח קובץ מקושר"
                                                                      Command="{Binding PlacementTarget.Tag.OpenNoteLinkedFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="בחר/שנה קובץ מקושר"
                                                                      Command="{Binding PlacementTarget.Tag.SetNoteLinkedFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="נקה קובץ מקושר"
                                                                      Command="{Binding PlacementTarget.Tag.ClearNoteLinkedFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CardActionButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLinkedFile}" Value="True">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="📷" FontSize="{DynamicResource SiTextSmallFontSize}"
                                                        MinWidth="18" MinHeight="18" Padding="2"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.ScreenshotPrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="צרף תמונה / פתח אחרונה"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ContextMenuService.ShowOnDisabled="True">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="פתח את התמונה האחרונה"
                                                                      Command="{Binding PlacementTarget.Tag.OpenLastAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="צרף תמונה חדשה מהלוח"
                                                                      Command="{Binding PlacementTarget.Tag.AttachScreenshotCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CardActionButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayLabel}"
                                                       Foreground="{DynamicResource SiForegroundBrush}"
                                                       FontFamily="{DynamicResource SiFontFamily}"
                                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,4,0" />

                                            <TextBlock Grid.Column="3" Text="💬"
                                                       FontSize="{DynamicResource SiTextSmallFontSize}" VerticalAlignment="Center"
                                                       Margin="0,0,4,0"
                                                       ToolTip="התקבלה תגובת מתכנן">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPlannerResponse}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ComboBox Grid.Column="4"
                                                      Style="{DynamicResource SiComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="DbKey"
                                                      SelectedValue="{Binding StatusText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="{DynamicResource SiTextSmallFontSize}" Padding="1,2" Margin="0,0,4,0"
                                                      MinHeight="22" VerticalAlignment="Top"
                                                      IsEnabled="{Binding DataContext.IsReportEditable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ToolTip="סטטוס ההערה" />

                                            <local:InspectionNoteRichEditor Grid.Column="5"
                                                EncodedText="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                NoteStatus="{Binding StatusText}"
                                                IsReadOnly="{Binding DataContext.IsSelectedReportLocked, RelativeSource={RelativeSource AncestorType=Window}}"
                                                VerticalAlignment="Top"
                                                EditCompleted="NoteRichEditor_EditCompleted"
                                                AiReviewRequested="NoteRichEditor_AiReviewRequested"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════ Report Cards List (bottom) ═══════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="{DynamicResource SiBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="6,4"
                    MaxHeight="160"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 דוחות ביקורת" FontWeight="SemiBold"
                               Foreground="{DynamicResource SiSecondaryBrush}"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Margin="0,0,0,2" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="2,0"
                             FontFamily="{DynamicResource SiFontFamily}"
                             FontSize="{DynamicResource SiTextSmallFontSize}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FontFamily" Value="{DynamicResource SiFontFamily}" />
                                <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,3" Margin="0,0,0,2"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource SiBorderBrush}"
                                        Background="{DynamicResource SiBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="2"
                                                Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Foreground="#2E7D32"
                                                       FontFamily="{DynamicResource SiFontFamily}"
                                                       FontSize="{DynamicResource SiTextSmallFontSize}">
                                                <Run Text="#" /><Run Text="{Binding ReportNumber, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding InspectorName}"
                                                   Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource SiFontFamily}"
                                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                                   Foreground="{DynamicResource SiForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InspectionDate, StringFormat=dd/MM}"
                                                   Foreground="{DynamicResource SiSecondaryBrush}"
                                                   FontFamily="{DynamicResource SiFontFamily}"
                                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                                   VerticalAlignment="Center" Margin="4,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════ Status Bar ═══════ -->
            <Border Grid.Row="4" Background="{DynamicResource SiBackgroundBrush}" Padding="8,4" CornerRadius="0,0,8,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           FontFamily="{DynamicResource SiFontFamily}"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
