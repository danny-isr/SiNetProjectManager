<UserControl x:Class="SiNet.App.Wpf.Surfaces.ProjectWork.ProjectWorkWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.ProjectWork"
        xmlns:proj="clr-namespace:SiNet.App.Wpf.Shared.Projects"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        d:DesignHeight="680" d:DesignWidth="1000"
        d:DataContext="{d:DesignInstance Type=local:ProjectWorkWindowViewModel, IsDesignTimeCreatable=True}">

    <!--
        Native ProjectWork surface — hosted in the main shell content area (cached like Email)
        or wrapped in a floating Window for task-only hosts. Left: project selector + unified
        file/folder tree. Right: ACC viewer host. Task strip appears only in task mode.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Version (leaf): opens on click via the node's OpenCommand. Right-click to replace/delete.
             Colour reflects real state: red on extension conflict, green while mid-upload. -->
        <DataTemplate DataType="{x:Type local:VersionNodeVm}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x05E9;&#x05DE;&#x05D5;&#x05E8; &#x05DC;&#x05D6;&#x05D9;&#x05DB;&#x05E8;&#x05D5;&#x05DF;" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="&#x05D4;&#x05D7;&#x05DC;&#x05E3; (&#x05D2;&#x05E8;&#x05E8;&#x05EA; &#x05D7;&#x05D3;&#x05E9;&#x05D4;)&#x2026;" Command="{Binding ReplaceCommand}" />
                        <MenuItem Header="&#x05DE;&#x05D7;&#x05E7;&#x05D2;&#x05E8;&#x05E1;&#x05D4;&#x2026;" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <CheckBox IsChecked="{Binding IsAccTabOpen, Mode=TwoWay}"
                          Visibility="{Binding IsAcc, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip="&#x05E4;&#x05EA;&#x05D5;&#x05D7;/&#x05E1;&#x05D2;&#x05D5;&#x05E8; &#x05D8;&#x05D0;&#x05D1; ACC"/>
                <TextBlock Text="&#x26A0;" Foreground="{DynamicResource SiDangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip="&#x05D4;&#x05EA;&#x05E0;&#x05D2;&#x05E9;&#x05D5;&#x05EA; &#x05E1;&#x05D9;&#x05D5;&#x05DE;&#x05D5;&#x05EA;"
                           Visibility="{Binding HasExtensionConflict, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding OpenCommand}" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Right" ToolTip="{Binding FullPath}">
                    <TextBlock Text="{Binding Title}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SiPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInFlight}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SiSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasExtensionConflict}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SiDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <TextBlock Margin="8,0,0,0"
                           FontSize="{DynamicResource SiTextTinyFontSize}"
                           Foreground="{DynamicResource SiSuccessBrush}"
                           VerticalAlignment="Center"
                           Text="&#x2191; &#x05DE;&#x05E2;&#x05DC;&#x05D4;&#x2026;"
                           Visibility="{Binding IsInFlight, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Details}" Margin="10,0,0,0"
                           FontSize="{DynamicResource SiTextTinyFontSize}"
                           Foreground="{DynamicResource SiMutedForegroundBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Alternative: contains versions. Right-click to add a version. -->
        <HierarchicalDataTemplate DataType="{x:Type local:AlternativeNodeVm}" ItemsSource="{Binding Children}">
            <TextBlock Foreground="{DynamicResource SiMutedForegroundBrush}">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x05D2;&#x05E8;&#x05E1;&#x05D4; &#x05D7;&#x05D3;&#x05E9;&#x05D4;&#x2026;" Command="{Binding AddVersionCommand}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
                <Run Text="&#x25CB;" />
                <Run Text="{Binding Title, Mode=OneWay}" />
            </TextBlock>
        </HierarchicalDataTemplate>

        <!-- File (logical): contains alternatives. Right-click for «אלטרנטיבה נוספת». -->
        <HierarchicalDataTemplate DataType="{x:Type local:ProjectFileNodeVm}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x05D0;&#x05DC;&#x05D8;&#x05E8;&#x05E0;&#x05D8;&#x05D9;&#x05D1;&#x05D4; &#x05E0;&#x05D5;&#x05E1;&#x05E4;&#x05EA;&#x2026;" Command="{Binding AddVersionCommand}" />
                        <MenuItem Header="&#x05D0;&#x05DC;&#x05D8;&#x05E8;&#x05E0;&#x05D8;&#x05D9;&#x05D1;&#x05D4; &#x05E0;&#x05D5;&#x05E1;&#x05E4;&#x05EA; &#x05DE;&#x05EA;&#x05D1;&#x05E0;&#x05D9;&#x05EA;&#x2026;"
                                  Command="{Binding AddVersionFromTemplateCommand}"
                                  Visibility="{Binding CanAddFromTemplate, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Defined without physical: blue -->
                            <Setter Property="Foreground" Value="#FF1565C0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnfiled}" Value="True">
                                    <Setter Property="Foreground" Value="#FF9CA3AF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRequiredMissing}" Value="True">
                                    <Setter Property="Foreground" Value="#FFEA580C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPhysicalVersions}" Value="True">
                                    <Setter Property="Foreground" Value="#FF047857" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3"
                        Background="{DynamicResource SiSurfaceBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StorageLabel}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"
                               Foreground="{DynamicResource SiSecondaryBrush}" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Folder: contains subfolders + files.
             Gray = empty; Blue = defs only; Orange = required missing; Green = physical. -->
        <HierarchicalDataTemplate DataType="{x:Type local:ProjectFolderNodeVm}" ItemsSource="{Binding Children}">
            <TextBlock FontWeight="SemiBold">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="&#x05E4;&#x05EA;&#x05D7; &#x05EA;&#x05D9;&#x05E7;&#x05D9;&#x05D9;&#x05D4;" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="&#x05D9;&#x05E6;&#x05D9;&#x05E8;&#x05EA; &#x05EA;&#x05D9;&#x05E7;&#x05D9;&#x05D9;&#x05D4;" Command="{Binding CreateFolderCommand}" />
                        <Separator />
                        <MenuItem Header="&#x05E9;&#x05DE;&#x05D5;&#x05E8; &#x05E9;&#x05DD; &#x05E4;&#x05E8;&#x05D5;&#x05D9;&#x05E7;&#x05D8;" Command="{Binding CopyProjectNameCommand}" />
                        <MenuItem Header="&#x05E9;&#x05DE;&#x05D5;&#x05E8; &#x05DC;&#x05D6;&#x05D9;&#x05DB;&#x05E8;&#x05D5;&#x05DF;" Command="{Binding CopyPathCommand}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FF9CA3AF" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDefinedFiles}" Value="True" />
                                    <Condition Binding="{Binding HasPhysicalFiles}" Value="False" />
                                    <Condition Binding="{Binding HasRequiredMissing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="#FF1565C0" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasPhysicalFiles}" Value="True" />
                                    <Condition Binding="{Binding HasRequiredMissing}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="#FF047857" />
                            </MultiDataTrigger>
                            <!-- Orange wins over green when a task-gated file is missing under this folder. -->
                            <DataTrigger Binding="{Binding HasRequiredMissing}" Value="True">
                                <Setter Property="Foreground" Value="#FFEA580C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="&#x1F4C1;" />
                <Run Text="{Binding Title, Mode=OneWay}" />
            </TextBlock>
        </HierarchicalDataTemplate>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="14" Background="{DynamicResource SiSurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: project context -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}"
                           FontSize="{DynamicResource SiTextLargeFontSize}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SiForegroundBrush}" />
                <TextBlock Text="{Binding ActiveProjectDisplay}"
                           FontSize="{DynamicResource SiTextNormalFontSize}"
                           Foreground="{DynamicResource SiMutedForegroundBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ActiveProjectDisplay}" />
            </StackPanel>

            <!-- Project selector (browse mode only — hidden in task mode) -->
            <ContentControl Grid.Row="1" Content="{Binding Selector}" Margin="0,0,0,8"
                            Visibility="{Binding ShowProjectSelector, Converter={StaticResource BoolToVis}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <proj:ProjectSelectorView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Task header (task mode only) -->
            <Border Grid.Row="2" Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TaskHeader}"
                           FontSize="{DynamicResource SiTextMediumFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SiForegroundBrush}" />
            </Border>

            <!-- Work area: unified tree (left) + viewer pane placeholder (right) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SiBackgroundBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="8,6,8,2"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"
                                   TextWrapping="Wrap">
                            <Run Text="ירוק = קבצים פיזיים" Foreground="#FF047857" />
                            <Run Text=" · " Foreground="{DynamicResource SiMutedForegroundBrush}" />
                            <Run Text="כתום = קובץ חובה חסר" Foreground="#FFEA580C" />
                            <Run Text=" · " Foreground="{DynamicResource SiMutedForegroundBrush}" />
                            <Run Text="כחול = לפי סוג פרויקט" Foreground="#FF1565C0" />
                            <Run Text=" · " Foreground="{DynamicResource SiMutedForegroundBrush}" />
                            <Run Text="אפור = ריק" Foreground="#FF9CA3AF" />
                        </TextBlock>
                        <TreeView x:Name="FileTree" BorderThickness="0" Background="Transparent"
                                  ItemsSource="{Binding Tree.RootFolders}"
                                  ItemContainerStyle="{StaticResource TreeItemStyle}" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="Transparent" />

                <Border x:Name="AccViewerDockHost" Grid.Column="2"
                        Background="{DynamicResource SiBackgroundBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Button x:Name="AccDockToggleButton" DockPanel.Dock="Top"
                                HorizontalAlignment="Left" Margin="6,6,6,0" Padding="10,4"
                                Click="AccDockToggleButton_Click"
                                Content="&#x05E0;&#x05EA;&#x05E7; &#x05DC;&#x05D7;&#x05DC;&#x05D5;&#x05DF; &#x05E6;&#x05E3;"
                                ToolTip="&#x05E0;&#x05EA;&#x05E7; &#x05D0;&#x05EA; &#x05E6;&#x05D5;&#x05E4;&#x05D4; ACC &#x05DC;&#x05D7;&#x05DC;&#x05D5;&#x05DF; &#x05E8;&#x05D7;&#x05D1; &#x05DE;&#x05E2;&#x05DC; &#x05D4;&#x05DE;&#x05E1;&#x05DA;"/>
                        <!-- The embedded ACC viewer host (WebView2, provided by the host via IAccViewerHost)
                             replaces this ContentControl's content on attach. Until then / when unavailable,
                             the placeholder explains the external-browser fallback. -->
                        <ContentControl x:Name="AccViewerHost">
                            <Border Background="{DynamicResource SiSurfaceBrush}" Padding="14">
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource SiTextNormalFontSize}"
                                           Foreground="{DynamicResource SiMutedForegroundBrush}"
                                           VerticalAlignment="Top"
                                           Text="&#x05E6;&#x05D5;&#x05E4;&#x05D4; ACC &#x05D9;&#x05D5;&#x05E4;&#x05D9;&#x05E2; &#x05DB;&#x05D0;&#x05DF; &#x05DC;&#x05D0;&#x05D7;&#x05E8; &#x05E4;&#x05EA;&#x05D9;&#x05D7;&#x05EA; &#x05E7;&#x05D5;&#x05D1;&#x05E5;. &#x05D0;&#x05DD; &#x05D4;&#x05E6;&#x05E4;&#x05D9;&#x05D9;&#x05DF; &#x05DC;&#x05D0; &#x05D6;&#x05DE;&#x05D9;&#x05DF; &#x2014; &#x05E7;&#x05D1;&#x05E6;&#x05D9;&#x05DD; &#x05D9;&#x05D9;&#x05E4;&#x05EA;&#x05D7;&#x05D5; &#x05D1;&#x05D3;&#x05E4;&#x05D3;&#x05E4;&#x05DF; &#x05D7;&#x05D9;&#x05E6;&#x05D5;&#x05E0;&#x05D9;." />
                            </Border>
                        </ContentControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Completion strip (task mode only) -->
            <Grid Grid.Row="4" Margin="0,10,0,0"
                  Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#x05EA;&#x05D5;&#x05E6;&#x05D0;&#x05D4;:"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{DynamicResource SiTextNormalFontSize}"
                           Foreground="{DynamicResource SiForegroundBrush}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AllowedResultOptions}"
                          SelectedItem="{Binding SelectedResultOption, Mode=TwoWay}"
                          Style="{DynamicResource SiComboBoxStyle}"
                          MinWidth="180" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SiForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ColorKind}" Value="Positive">
                                                <Setter Property="Foreground" Value="{DynamicResource SiSuccessBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColorKind}" Value="Negative">
                                                <Setter Property="Foreground" Value="{DynamicResource SiDangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="&#x05E1;&#x05D9;&#x05D9;&#x05DD; &#x05DE;&#x05E9;&#x05D9;&#x05DE;&#x05D4;"
                        Command="{Binding CompleteTaskCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"
                        Padding="14,6" Margin="8,0,0,0" Cursor="Hand" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="5" Margin="0,10,0,0" Padding="8,4"
                    Background="{DynamicResource SiSurfaceBrush}"
                    BorderBrush="{DynamicResource SiBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Foreground="{DynamicResource SiMutedForegroundBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Tree.ScanStatus}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Foreground="{DynamicResource SiMutedForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
