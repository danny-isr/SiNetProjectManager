<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,6"
            Background="{DynamicResource SiBackgroundBrush}">
        <StackPanel>
            <!-- Account status -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x2709;" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AccountStatusDisplay}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#333" />
                    <Border Background="#E3F2FD"
                            BorderBrush="#64B5F6"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShowUnreadCount, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="לא נקראו " Foreground="#1565C0" FontSize="{DynamicResource SiTextTinyFontSize}" />
                            <TextBlock Text="{Binding UnreadEmailCount}" Foreground="#1565C0" FontWeight="Bold" FontSize="{DynamicResource SiTextTinyFontSize}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="חבר Gmail"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding ShowConnectButton, Converter={StaticResource BoolToVis}}" />
                    <Button Content="רענן"
                            Command="{Binding RefreshPageCommand}"
                            Style="{StaticResource ActionButton}" />
                    <Button Content="התנתק"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                            ToolTip="ניתוק Gmail" />
                </StackPanel>
            </Grid>

            <!-- Paging (all-emails mode) -->
            <Border Padding="0,4"
                    BorderBrush="#EEE"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowAllEmailsPaging, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageInfo}"
                                   Foreground="#666"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Foreground="#999"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"
                                   Margin="0,2,0,0">
                            <Run Text="נטענו " />
                            <Run Text="{Binding DisplayedCount, Mode=OneWay}" />
                            <Run Text=" · הבא: " />
                            <Run Text="{Binding HasNextPage, Mode=OneWay}" />
                            <Run Text=" · הקודם: " />
                            <Run Text="{Binding HasPreviousPage, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#x25B6; 50 הקודמים"
                                Command="{Binding LoadPreviousPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasPreviousPage}" />
                        <Button Content="50 הבאים &#x25C0;"
                                Command="{Binding LoadNextPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasNextPage}" />
                        <Button Content="קבץ label"
                                Command="{Binding ToggleGroupByLabelCommand}"
                                Style="{StaticResource ActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Project group chrome -->
            <Border Padding="0,6"
                    BorderBrush="#EEE"
                    BorderThickness="0,1,0,0"
                    Background="#F5F8FF"
                    Visibility="{Binding ShowProjectGroupChrome, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayModeSummary}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SiPrimaryBrush}"
                               FontSize="{DynamicResource SiTextSmallFontSize}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="מיילים של הפרויקט:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ProjectGroupHeader}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="480"
                                   ToolTip="{Binding ProjectGroupHeader}" />
                        <Button Content="הצג עוד"
                                Command="{Binding ShowMoreProjectEmailsCommand}"
                                Style="{StaticResource ActionButton}"
                                Margin="12,0,0,0"
                                Visibility="{Binding HasMoreProjectEmails, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Filters (all-emails mode) -->
            <Border Padding="0,6,0,0"
                    BorderBrush="#EEE"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsAllEmailsMode, Converter={StaticResource BoolToVis}}">
                <WrapPanel Orientation="Horizontal">
                    <TextBox Width="120" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="חיפוש חופשי" />
                    <TextBox Width="100" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding AddressFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="from:/to:" />
                    <TextBox Width="100" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding SubjectFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="subject:" />
                    <ComboBox Width="140" Height="24"
                              ItemsSource="{Binding AvailableLabels}"
                              SelectedValue="{Binding SelectedLabel}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="Name"
                              Margin="0,0,4,0" ToolTip="label:" />
                    <ComboBox Width="90" Height="24"
                              ItemsSource="{Binding ProjectLinkFilterOptions}"
                              SelectedValue="{Binding SelectedProjectLinkFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,4,0" />
                    <Button Content="חפש" Command="{Binding ApplyFiltersCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="נקה" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ActionButton}" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
