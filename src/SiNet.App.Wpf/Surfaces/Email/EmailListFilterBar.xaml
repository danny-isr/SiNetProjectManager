<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button" x:Key="ActionButton" BasedOn="{StaticResource SiRoundedButtonBase}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
        </Style>

        <Style TargetType="ToggleButton" x:Key="ToggleActionButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SiBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource SiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource SiForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F5E9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#81C784" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,4"
            Background="{DynamicResource SiBackgroundBrush}">
        <StackPanel>
            <!-- Row 1: account status + paging actions (merged; details moved to tooltip) -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x2709;"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Foreground="{DynamicResource SiForegroundBrush}" />
                    <TextBlock Text="{Binding AccountStatusDisplay}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Foreground="{DynamicResource SiForegroundBrush}" />
                    <ToggleButton Style="{StaticResource ToggleActionButton}"
                                  IsChecked="{Binding ShowUnreadFilterActive, Mode=OneWay}"
                                  Command="{Binding ToggleUnreadOnlyCommand}"
                                  ToolTip="הצג רק מיילים שלא נקראו"
                                  Margin="10,0,0,0"
                                  Visibility="{Binding ShowUnreadCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UnreadCountDisplay}"
                                   Foreground="#1565C0"
                                   FontSize="{DynamicResource SiTextTinyFontSize}" />
                    </ToggleButton>
                    <TextBlock Text="{Binding PageInfo}"
                               Foreground="{DynamicResource SiMutedForegroundBrush}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="{Binding ShowAllEmailsPaging, Converter={StaticResource BoolToVis}}">
                        <TextBlock.ToolTip>
                            <StackPanel>
                                <TextBlock FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextTinyFontSize}">
                                    <Run Text="נטענו " />
                                    <Run Text="{Binding DisplayedCount, Mode=OneWay}" />
                                    <Run Text=" · הבא: " />
                                    <Run Text="{Binding HasNextPage, Mode=OneWay}" />
                                    <Run Text=" · הקודם: " />
                                    <Run Text="{Binding HasPreviousPage, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding MailboxDiagnostics}"
                                           Margin="0,2,0,0"
                                           FontFamily="{DynamicResource SiFontFamily}"
                                           FontSize="{DynamicResource SiTextTinyFontSize}"
                                           Visibility="{Binding ShowMailboxDiagnostics, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowAllEmailsPaging, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#x25B6; 50 הקודמים"
                                Command="{Binding LoadPreviousPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasPreviousPage}" />
                        <Button Content="50 הבאים &#x25C0;"
                                Command="{Binding LoadNextPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasNextPage}" />
                        <ToggleButton Content="קבץ label"
                                      IsChecked="{Binding GroupByLabel, Mode=OneWay}"
                                      Command="{Binding ToggleGroupByLabelCommand}"
                                      Style="{StaticResource ToggleActionButton}" />
                    </StackPanel>
                    <Button Content="חבר Gmail"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding ShowConnectButton, Converter={StaticResource BoolToVis}}" />
                    <Button Content="רענן"
                            Command="{Binding RefreshPageCommand}"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding CanRefreshEmails}" />
                    <Button Content="סנכרן שמות לייבלים"
                            Command="{Binding SyncProjectLabelNamesCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                            ToolTip="מעדכן שמות לייבלים לפי NameAndNumber של הפרויקטים" />
                    <Button Content="בדיקת תיוג"
                            Command="{Binding AuditMailboxLabelsCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="טבלת תוויות התיבה מול פרויקטים — כפילות מסומנות בהערה" />
                    <Button Content="התנתק"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                            ToolTip="ניתוק Gmail" />
                </StackPanel>
            </Grid>

            <!-- Row 2: filters -->
            <Border Padding="0,4,0,0"
                    BorderBrush="{DynamicResource SiBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <ComboBox Width="100" MinHeight="24"
                              Style="{DynamicResource SiComboBoxStyle}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"
                              ItemsSource="{Binding MailboxScopeOptions}"
                              SelectedValue="{Binding SelectedMailboxScope}"
                              SelectedValuePath="Scope"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,4,0" ToolTip="תיבה" />
                    <TextBox Width="120" MinHeight="24" VerticalContentAlignment="Center"
                             Style="{DynamicResource SiTextBoxStyle}"
                             FontSize="{DynamicResource SiTextSmallFontSize}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="חיפוש חופשי" />
                    <TextBox Width="100" MinHeight="24" VerticalContentAlignment="Center"
                             Style="{DynamicResource SiTextBoxStyle}"
                             FontSize="{DynamicResource SiTextSmallFontSize}"
                             Text="{Binding AddressFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="from:/to:" />
                    <TextBox Width="100" MinHeight="24" VerticalContentAlignment="Center"
                             Style="{DynamicResource SiTextBoxStyle}"
                             FontSize="{DynamicResource SiTextSmallFontSize}"
                             Text="{Binding SubjectFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="subject:" />
                    <ComboBox Width="140" MinHeight="24"
                              Style="{DynamicResource SiComboBoxStyle}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"
                              ItemsSource="{Binding AvailableLabels}"
                              SelectedValue="{Binding SelectedLabel}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="Name"
                              Margin="0,0,4,0" ToolTip="label:" />
                    <ComboBox Width="90" MinHeight="24"
                              Style="{DynamicResource SiComboBoxStyle}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"
                              ItemsSource="{Binding ProjectLinkFilterOptions}"
                              SelectedValue="{Binding SelectedProjectLinkFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,4,0" />
                    <Button Content="חפש" Command="{Binding ApplyFiltersCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="נקה" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ActionButton}" />
                    <ToggleButton Content="עם צרופות"
                                  IsChecked="{Binding AttachmentsOnly, Mode=OneWay}"
                                  Command="{Binding ToggleAttachmentsOnlyCommand}"
                                  Style="{StaticResource ToggleActionButton}" />
                </WrapPanel>
                <!-- Deprecated inline diagnostics row (2026-07): moved to PageInfo tooltip above to keep the bar at two rows.
                     Kept collapsed (not deleted) in case the inline display needs to return; safe to remove after verification. -->
                <TextBlock Text="{Binding MailboxDiagnostics}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           FontSize="{DynamicResource SiTextTinyFontSize}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
