<Window x:Class="SiNet.App.Wpf.Surfaces.Email.GmailMailboxLabelAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול תוויות Gmail"
        Width="1100" Height="640"
        MinWidth="800" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="רענן"
                        Command="{Binding RefreshCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="העבר למיקום הנכון"
                        Command="{Binding MoveCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="מזג אל..."
                        Command="{Binding MergeCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="העתק נבחרות"
                        Click="CopySelected_Click"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="העתק הכל"
                        Command="{Binding CopyAllCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"/>
                <Button Content="סגור"
                        IsCancel="True"
                        Padding="14,8"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="תוויות המשתמש בתיבה מול פרויקטים ב-SiNet. מספר הפרויקט הוא זהות התווית. נתיב שגוי מסומן באזהרה; כפילות באותו מספר — בשגיאה. תיקון מיקום ומיזוג הם פעולות מפורשות."
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="חיפוש:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontSize="{DynamicResource SiTextSmallFontSize}"/>
                <TextBox Width="280"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="AuditGrid"
                  ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="{DynamicResource SiBackgroundBrush}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Misplaced">
                            <Setter Property="Background" Value="{DynamicResource SiWarningSurfaceBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                            <Setter Property="Background" Value="{DynamicResource SiDangerSurfaceBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="מספר פרויקט" Binding="{Binding ParsedProjectNumber}" Width="90"/>
                <DataGridTextColumn Header="נתיב נוכחי" Binding="{Binding LabelName}" Width="2.2*"/>
                <DataGridTextColumn Header="נתיב צפוי" Binding="{Binding ExpectedPath}" Width="2*"/>
                <DataGridTextColumn Header="סטטוס" Binding="{Binding StatusLabel}" Width="90"/>
                <DataGridTextColumn Header="הודעות" Binding="{Binding MessageCount}" Width="70"/>
                <DataGridTextColumn Header="פרויקט" Binding="{Binding ProjectDisplayName}" Width="1.2*"/>
                <DataGridTextColumn Header="הערה" Binding="{Binding Note}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
