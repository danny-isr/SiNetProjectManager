<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailDetailView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:detail="clr-namespace:SiNet.App.Wpf.Surfaces.Email.Detail"

             FlowDirection="RightToLeft">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SiBackgroundBrush}">

        <Grid>

            <!-- Empty state -->

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel.Style>

                    <Style TargetType="StackPanel">

                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding HasSelectedEmail}" Value="True">

                                <Setter Property="Visibility" Value="Collapsed" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </StackPanel.Style>

                <TextBlock Text="✉" FontSize="{DynamicResource SiTextHugeFontSize}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SiSecondaryBrush}" />

                <TextBlock Text="בחר מייל מהרשימה לצפייה"
                           Opacity="0.7"
                           FontFamily="{DynamicResource SiFontFamily}"
                           FontSize="{DynamicResource SiTextNormalFontSize}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

            </StackPanel>



            <!-- Detail content: viewer stack + bottom context/actions strip -->

            <Grid Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>



                <detail:EmailViewerPaneView Grid.Row="0" DataContext="{Binding Viewer}" x:Name="ViewerPane" />

                <detail:EmailAttachmentStripView Grid.Row="1"

                                                 DataContext="{Binding AttachmentStrip}"

                                                 BorderBrush="{DynamicResource SiBorderBrush}"

                                                 BorderThickness="0,1,0,0" />

                <detail:EmailActionBarView Grid.Row="2"

                                           DataContext="{Binding ActionBar}"

                                           BorderBrush="{DynamicResource SiBorderBrush}"

                                           BorderThickness="0,1,0,0" />

                <detail:EmailWorkflowActionsPaneView Grid.Row="3"

                                                     DataContext="{Binding Workflow}"

                                                     BorderBrush="{DynamicResource SiBorderBrush}"

                                                     BorderThickness="0,1,0,0" />

                <!-- Explicit action feedback (MoveToProject failures, filing status). Visible in work-item window too. -->
                <Border Grid.Row="4"
                        Background="#FFF8E1"
                        BorderBrush="#FFE082"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#5D4037"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               TextWrapping="Wrap"
                               MaxHeight="120"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" />
                </Border>

            </Grid>

        </Grid>

    </Border>

</UserControl>

