<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailAttachmentStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Padding="8,4">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="📎 קבצים מצורפים"
                   FontWeight="SemiBold"
                   FontSize="{DynamicResource SiTextSmallFontSize}"
                   Foreground="#666"
                   Margin="0,0,0,2" />

        <ItemsControl ItemsSource="{Binding ExternalDownloadLinks}"
                      Margin="0,0,0,4"
                      Visibility="{Binding HasExternalDownloadLinks, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding DisplayLabel}"
                            Command="{Binding OpenCommand}"
                            ToolTip="{Binding Url}"
                            Padding="6,1"
                            Margin="0,0,4,2"
                            FontSize="{DynamicResource SiTextSmallFontSize}"
                            Foreground="#1565C0"
                            Cursor="Hand" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,2" Margin="0,0,4,4" Background="#EEF2FF" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontSize="{DynamicResource SiTextSmallFontSize}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Button Content="{Binding TagButtonText}"
                                    Command="{Binding TagCommand}"
                                    MinWidth="80"
                                    MaxWidth="180"
                                    Height="20"
                                    Padding="4,0"
                                    FontSize="10"
                                    Margin="0,0,4,0"
                                    Visibility="{Binding ShowTagSelector, Converter={StaticResource BoolToVis}}" />
                            <ComboBox MinWidth="70"
                                      MaxWidth="120"
                                      Height="20"
                                      ItemsSource="{Binding AvailableAlternatives}"
                                      SelectedValue="{Binding SelectedAlternativeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Visibility="{Binding ShowAlternativeSelector, Converter={StaticResource BoolToVis}}"
                                      SelectionChanged="AlternativeSelectionChanged" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
