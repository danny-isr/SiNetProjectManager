<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailAttachmentStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Padding="12,6">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="📎 קבצים מצורפים" FontWeight="SemiBold" FontSize="{DynamicResource SiTextSmallFontSize}" Foreground="#666" />
            <Button Content="🌐 פתח קישור הורדה"
                    Command="{Binding OpenExternalDownloadLinkCommand}"
                    Margin="12,0,0,0"
                    Padding="8,2"
                    FontSize="{DynamicResource SiTextSmallFontSize}"
                    Visibility="{Binding ShowExternalDownloadLinkAction, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,3" Margin="0,0,6,6" Background="#EEF2FF" BorderBrush="#C5CAE9" BorderThickness="1" CornerRadius="3">
                        <TextBlock Text="{Binding DisplayLabel}" FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
