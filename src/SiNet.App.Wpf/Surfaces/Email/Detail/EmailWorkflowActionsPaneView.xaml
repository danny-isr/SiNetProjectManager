<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailWorkflowActionsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiSurfaceBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="WorkflowActionItemStyle" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
    </UserControl.Resources>
    <Border Padding="6,2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Loading -->
            <TextBlock Grid.Row="0"
                       Text="מנתח הקשר..."
                       Foreground="{DynamicResource SiMutedForegroundBrush}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource SiTextSmallFontSize}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Context chips -->
            <WrapPanel Grid.Row="0"
                       Orientation="Horizontal">
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasContext}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>
                <Border Background="#E3F2FD" CornerRadius="3" Padding="4,1" Margin="0,0,4,1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="פרויקט: " FontWeight="SemiBold" Foreground="#1565C0"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ProjectDisplay}" Foreground="#1565C0"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProjectDisplay}" />
                    </StackPanel>
                </Border>
                <Border Background="#F3E5F5" CornerRadius="3" Padding="4,1" Margin="0,0,4,1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליך: " FontWeight="SemiBold" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding WorkflowFamilyDisplay, TargetNullValue='—'}" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF3E0" CornerRadius="3" Padding="4,1" Margin="0,0,4,1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ביטחון: " FontWeight="SemiBold" Foreground="#E65100"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ConfidenceDisplay, TargetNullValue='—'}" Foreground="#E65100"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>
                <Border Background="#E8F5E9" CornerRadius="3" Padding="4,1" Margin="0,0,4,1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליכים: " FontWeight="SemiBold" Foreground="#2E7D32"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ActiveWorkflowCount}" Foreground="#2E7D32"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Active Proposal banner -->
            <Border Grid.Row="1"
                    Background="#E8F5E9"
                    BorderBrush="#66BB6A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    Margin="0,4,0,2"
                    Visibility="{Binding ShowProposalBanner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ActiveProposalSummary}"
                           Foreground="#1B5E20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource SiTextSmallFontSize}" />
            </Border>

            <!-- Actions row -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="פעולה:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           FontSize="{DynamicResource SiTextSmallFontSize}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SuggestedActions}"
                          SelectedItem="{Binding SelectedAction}"
                          DisplayMemberPath="DisplayName"
                          ItemContainerStyle="{StaticResource WorkflowActionItemStyle}"
                          AutomationProperties.AutomationId="Email.Workflow.ActionSelector"
                          AutomationProperties.Name="בחירת פעולת תהליך"
                          VerticalAlignment="Center"
                          Padding="2,1"
                          FontSize="{DynamicResource SiTextSmallFontSize}" />

                <Button Grid.Column="2"
                        Content="▶ בצע"
                        AutomationProperties.AutomationId="Email.Workflow.ExecuteAction"
                        AutomationProperties.Name="בצע פעולת תהליך"
                        Command="{Binding ExecuteActionCommand}"
                        Padding="8,1"
                        Margin="4,0,0,0"
                        Background="#C8E6C9"
                        BorderBrush="#66BB6A"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource SiTextSmallFontSize}" />

                <TextBlock Grid.Column="3"
                           AutomationProperties.AutomationId="Email.Workflow.Status"
                           AutomationProperties.Name="סטטוס פעולת תהליך"
                           Text="{Binding StatusMessage}"
                           Foreground="#1565C0"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource SiTextSmallFontSize}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
