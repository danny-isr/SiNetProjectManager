<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailWorkflowActionsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#FAFAFA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Padding="8,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: context chips (horizontal) -->
            <WrapPanel Grid.Row="0"
                       Orientation="Horizontal"
                       Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="0,0,5,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="פרויקט: " FontWeight="SemiBold" Foreground="#1565C0"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ProjectDisplay}" Foreground="#1565C0"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProjectDisplay}" />
                    </StackPanel>
                </Border>

                <Border Background="#F3E5F5" CornerRadius="3" Padding="6,2" Margin="0,0,5,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליך: " FontWeight="SemiBold" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding WorkflowFamilyDisplay, TargetNullValue='—'}" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>

                <Border Background="#FFF3E0" CornerRadius="3" Padding="6,2" Margin="0,0,5,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ביטחון: " FontWeight="SemiBold" Foreground="#E65100"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ConfidenceDisplay, TargetNullValue='—'}" Foreground="#E65100"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>

                <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="0,0,5,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליכים: " FontWeight="SemiBold" Foreground="#2E7D32"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                        <TextBlock Text="{Binding ActiveWorkflowCount}" Foreground="#2E7D32"
                                   FontSize="{DynamicResource SiTextSmallFontSize}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Row 0 idle: no context yet -->
            <TextBlock Grid.Row="0"
                       Text="{Binding StatusMessage, TargetNullValue='בחר מייל לניתוח הקשר'}"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource SiTextSmallFontSize}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContext}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Row 1: suggested actions + execute -->
            <Grid Grid.Row="1" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="פעולה:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           FontSize="{DynamicResource SiTextSmallFontSize}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SuggestedActions}"
                          SelectedItem="{Binding SelectedAction}"
                          DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource SiTextSmallFontSize}" />

                <Button Grid.Column="2"
                        Content="▶ בצע"
                        Command="{Binding ExecuteActionCommand}"
                        Padding="10,2"
                        Margin="6,0,0,0"
                        Background="#C8E6C9"
                        BorderBrush="#66BB6A"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource SiTextSmallFontSize}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           Foreground="#1565C0"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource SiTextSmallFontSize}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
