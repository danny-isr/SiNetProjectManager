<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.Detail.EmailActionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#E8F5E9"
             Padding="6,3">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="שיוך: " FontWeight="SemiBold" VerticalAlignment="Center"
                       FontSize="{DynamicResource SiTextSmallFontSize}" />
            <TextBlock Text="{Binding ActiveProjectDisplay}" Foreground="#2E7D32" FontWeight="Bold"
                       VerticalAlignment="Center" FontSize="{DynamicResource SiTextSmallFontSize}" />
            <TextBlock Text="{Binding AssignedHint}"
                       Margin="8,0,0,0"
                       Foreground="#1565C0"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource SiTextSmallFontSize}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAssignedHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding MoveBlockReason}"
                       Margin="8,0,0,0"
                       Foreground="#C62828"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource SiTextSmallFontSize}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="360">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowMoveBlockReason}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox Content="סמן כנקרא"
                      IsChecked="{Binding MarkAsReadEnabled}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      FontSize="{DynamicResource SiTextSmallFontSize}"
                      ToolTip="לא בשימוש לפתיחת גוף — המייל מסומן כנקרא רק בסיום טיפול (אישי / לא רלוונטי / לידיעה / Workflow). נשמר להרצה הנוכחית בלבד." />
            <Button Content="פתח ב-Gmail"
                    Command="{Binding OpenInGmailCommand}"
                    Padding="8,2"
                    Margin="0,0,4,0"
                    FontSize="{DynamicResource SiTextSmallFontSize}"
                    ToolTip="פותח את המייל ב-Gmail בדפדפן — משם Reply / Forward" />
            <Button Content="לידיעה בלבד"
                    Command="{Binding MarkAsFyiCommand}"
                    Padding="8,2"
                    Margin="0,0,4,0"
                    FontSize="{DynamicResource SiTextSmallFontSize}"
                    ToolTip="מסיים טיפול במייל משויך בלי Workflow — מסמן כנקרא">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAssignedLayout}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="שייך לפרויקט"
                    Command="{Binding FileEmailCommand}"
                    Padding="8,2"
                    Margin="0,0,4,0"
                    FontSize="{DynamicResource SiTextSmallFontSize}"
                    ToolTip="שייך מייל לפרויקט — בוחרים פרויקט בחלון נפרד בלי לשנות את הפרויקט הפעיל באפליקציה">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowUnassignedLayout}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="העבר לפרויקט"
                    Command="{Binding MoveToProjectCommand}"
                    Padding="8,2"
                    Background="#C8E6C9"
                    BorderBrush="#66BB6A"
                    FontSize="{DynamicResource SiTextSmallFontSize}"
                    ToolTip="{Binding MoveButtonToolTip}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAssignedLayout}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
