<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailLabelGroupHeader"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"

             mc:Ignorable="d"

             d:DesignHeight="32"

             d:DesignWidth="400">



    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </UserControl.Resources>



    <Border BorderThickness="1"

            CornerRadius="4"

            Padding="8,4"

            Margin="0,4,0,2">

        <Border.Style>

            <Style TargetType="Border">

                <Setter Property="Background" Value="#F5F8FF" />

                <Setter Property="BorderBrush" Value="#D0D8E8" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsProjectGroup}" Value="True">

                        <Setter Property="Background" Value="#E8F5E9" />

                        <Setter Property="BorderBrush" Value="#A5D6A7" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>

        </Border.Style>

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>



            <StackPanel Grid.Column="0" Orientation="Vertical">

                <TextBlock Text="{Binding HeaderStatus}"

                           FontWeight="SemiBold"

                           FontFamily="{DynamicResource SiFontFamily}"

                           FontSize="{DynamicResource SiTextSmallFontSize}"

                           Foreground="#333" />

                <TextBlock Text="{Binding ErrorMessage}"

                           Foreground="#C62828"

                           FontSize="{DynamicResource SiTextTinyFontSize}"

                           TextWrapping="Wrap"

                           Margin="0,2,0,0"

                           Visibility="{Binding ShowGroupError, Converter={StaticResource BoolToVis}}" />

            </StackPanel>



            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="טען עוד"

                        Command="{Binding LoadMoreForLabelCommand}"

                        Padding="6,2"

                        Margin="4,0,0,0"

                        FontSize="{DynamicResource SiTextTinyFontSize}"

                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />

            </StackPanel>

        </Grid>



        <Border.ContextMenu>

            <ContextMenu>

                <MenuItem Header="טען את כל המיילים מהלייבל הזה"

                          Command="{Binding LoadAllForLabelCommand}" />

                <MenuItem Header="טען עוד 50 מהלייבל הזה"

                          Command="{Binding LoadMoreForLabelCommand}" />

                <Separator />

                <MenuItem Header="פתח קבוצה"

                          Command="{Binding ExpandCommand}" />

                <MenuItem Header="כווץ קבוצה"

                          Command="{Binding CollapseCommand}" />

            </ContextMenu>

        </Border.ContextMenu>

    </Border>

</UserControl>

