<Window x:Class="SiNet.App.Wpf.Surfaces.Email.GmailProjectLabelMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מיזוג תוויות פרויקט"
        Width="560" Height="420"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="מזג"
                    IsDefault="True"
                    Click="Confirm_Click"
                    Style="{DynamicResource SiPrimaryButtonStyle}"
                    Padding="16,8"
                    Margin="0,0,8,0"/>
            <Button Content="ביטול"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Padding="16,8"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="מקור (תימחק אחרי אימות):" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="יעד (תישאר):" FontWeight="SemiBold"/>
            <ComboBox x:Name="TargetCombo"
                      DisplayMemberPath="Display"
                      Margin="0,4,0,12"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       Text="כל ההודעות מהמקור יקבלו את תווית היעד. לאחר השלמת ההעברה ואימותה תווית המקור תימחק."/>
        </StackPanel>
    </DockPanel>
</Window>
