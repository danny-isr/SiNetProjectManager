<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListView"
             x:Name="EmailListRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             mc:Ignorable="d"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="EmailListContainerStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
        </Style>

        <Style TargetType="ListBoxItem" x:Key="EmailCardItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#EEEEEE" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="📁 שייך לפרויקט"
                                  Command="{Binding FileEmailToProjectCommand, Source={x:Reference EmailListRoot}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiledToProject}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="↩️ בטל שיוך"
                                  Command="{Binding UnfileEmailCommand, Source={x:Reference EmailListRoot}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiledToProject}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="⏳ סמן כממתין לטיפול"
                                  Command="{Binding MarkAsPendingCommand, Source={x:Reference EmailListRoot}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="👤 סמן כאישי"
                                  Command="{Binding MarkAsPersonalCommand, Source={x:Reference EmailListRoot}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="🚫 סמן כלא רלוונטי"
                                  Command="{Binding MarkAsIrrelevantCommand, Source={x:Reference EmailListRoot}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                    <Setter Property="BorderBrush" Value="#90CAF9" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="EmailGroupExpanderTemplate" DataType="{x:Type local:EmailLabelGroupViewModel}">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      BorderThickness="0"
                      Margin="0,0,0,4">
                <Expander.Header>
                    <local:EmailLabelGroupHeader DataContext="{Binding}" />
                </Expander.Header>
                <ListBox ItemsSource="{Binding Emails}"
                         Style="{StaticResource EmailListContainerStyle}"
                         SelectedItem="{Binding DataContext.SelectedEmail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ItemContainerStyle="{StaticResource EmailCardItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:EmailListRow}">
                            <local:EmailListItemCard />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFF8E1"
                    BorderBrush="#FFE082"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    Visibility="{Binding ShowLoadWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LoadWarning}"
                           Foreground="#8D6E63"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="1"
                    Background="#FFEBEE"
                    BorderBrush="#EF9A9A"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    Visibility="{Binding ShowLoadError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LoadError}"
                           Foreground="#C62828"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           TextWrapping="Wrap" />
            </Border>

            <ScrollViewer x:Name="EmailListScrollViewer"
                          Grid.Row="2"
                          VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          MinHeight="120">
                <StackPanel>
                    <ContentControl Content="{Binding ActiveProjectGroup}"
                                    ContentTemplate="{StaticResource EmailGroupExpanderTemplate}"
                                    Visibility="{Binding ShowProjectGroupAboveFlat, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding DisplayGroups}"
                                  Visibility="{Binding ShowLabelGroups, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:EmailLabelGroupViewModel}">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource EmailGroupExpanderTemplate}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListBox ItemsSource="{Binding FlatDisplayEmails}"
                             Style="{StaticResource EmailListContainerStyle}"
                             SelectedItem="{Binding SelectedEmail}"
                             ItemContainerStyle="{StaticResource EmailCardItemStyle}"
                             Visibility="{Binding ShowFlatEmailList, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:EmailListRow}">
                                <local:EmailListItemCard />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
