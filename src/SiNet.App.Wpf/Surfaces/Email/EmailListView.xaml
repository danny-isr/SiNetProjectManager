<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SiBackgroundBrush}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="תיבת דואר"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PageInfo}"
                                   Margin="10,0,0,0"
                                   Foreground="#666"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#E3F2FD"
                            BorderBrush="#64B5F6"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,2"
                            Visibility="{Binding ShowUnreadCount, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E9; לא נקראו " Foreground="#1565C0" FontSize="{DynamicResource SiTextSmallFontSize}" />
                            <TextBlock Text="{Binding UnreadEmailCount}" Foreground="#1565C0" FontWeight="Bold" FontSize="{DynamicResource SiTextSmallFontSize}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding EmailsView}"
                      SelectedItem="{Binding SelectedEmail}"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" Padding="6,4" Margin="0,4,0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#555" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="נושא" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#2196F3"
                                                 Margin="0,0,4,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="מאת" Width="100" DisplayMemberBinding="{Binding Sender}" />
                        <GridViewColumn Header="אל" Width="90" DisplayMemberBinding="{Binding To}" />
                        <GridViewColumn Header="תאריך" Width="110" DisplayMemberBinding="{Binding ReceivedDisplay}" />
                        <GridViewColumn Header="Labels" Width="120" DisplayMemberBinding="{Binding LabelsDisplay}" />
                        <GridViewColumn Header="שיוך" Width="60" DisplayMemberBinding="{Binding ProjectLinkDisplay}" />
                        <GridViewColumn Header="פרויקט" Width="100" DisplayMemberBinding="{Binding ProjectDisplay}" />
                        <GridViewColumn Header="תקציר" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Snippet}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#888"
                                               FontSize="{DynamicResource SiTextSmallFontSize}"
                                               ToolTip="{Binding Snippet}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Border>
</UserControl>
