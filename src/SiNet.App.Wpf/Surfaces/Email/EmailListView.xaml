<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SiBackgroundBrush}" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="מיילים לתיוק"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Background="#E3F2FD"
                            BorderBrush="#64B5F6"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            Visibility="{Binding ShowUnreadCount, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E9; לא נקראו " Foreground="#1565C0" FontSize="{DynamicResource SiTextSmallFontSize}" />
                            <TextBlock Text="{Binding UnreadEmailCount}" Foreground="#1565C0" FontWeight="Bold" FontSize="{DynamicResource SiTextSmallFontSize}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Emails}"
                     SelectedItem="{Binding SelectedEmail}"
                     HorizontalContentAlignment="Stretch"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#2196F3"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Sender}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subject}"
                                               Margin="14,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Preview}"
                                               Margin="14,2,0,0"
                                               Foreground="#888"
                                               FontSize="{DynamicResource SiTextSmallFontSize}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ReceivedDisplay}"
                                               Foreground="#999"
                                               FontSize="{DynamicResource SiTextTinyFontSize}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding AttachmentBadge}"
                                               Foreground="#666"
                                               FontSize="{DynamicResource SiTextSmallFontSize}"
                                               HorizontalAlignment="Left"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="&#x2713; משויך"
                                               Foreground="#2E7D32"
                                               FontSize="{DynamicResource SiTextTinyFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Left"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
