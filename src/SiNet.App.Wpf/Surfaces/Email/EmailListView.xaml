<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EmailListViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="EmailCardItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#EEEEEE" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                    <Setter Property="BorderBrush" Value="#90CAF9" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Account status bar -->
            <Border Grid.Row="0" Background="#FAFAFA" Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2709;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AccountStatusDisplay}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#333" />
                        <Border Background="#E3F2FD"
                                BorderBrush="#64B5F6"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="10,0,0,0"
                                Visibility="{Binding ShowUnreadCount, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="לא נקראו " Foreground="#1565C0" FontSize="{DynamicResource SiTextTinyFontSize}" />
                                <TextBlock Text="{Binding UnreadEmailCount}" Foreground="#1565C0" FontWeight="Bold" FontSize="{DynamicResource SiTextTinyFontSize}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="חבר Gmail"
                                Command="{Binding ConnectCommand}"
                                Style="{StaticResource ActionButton}"
                                Visibility="{Binding ShowConnectButton, Converter={StaticResource BoolToVis}}" />
                        <Button Content="רענן"
                                Command="{Binding RefreshPageCommand}"
                                Style="{StaticResource ActionButton}" />
                        <Button Content="התנתק"
                                Command="{Binding DisconnectCommand}"
                                Style="{StaticResource ActionButton}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                ToolTip="ניתוק Gmail" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Paging bar -->
            <Border Grid.Row="1" Padding="8,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding PageInfo}"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               FontSize="{DynamicResource SiTextSmallFontSize}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#x25B6; 50 הקודמים"
                                Command="{Binding LoadPreviousPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasPreviousPage}" />
                        <Button Content="50 הבאים &#x25C0;"
                                Command="{Binding LoadNextPageCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding HasNextPage}" />
                        <Button Content="קבץ label"
                                Command="{Binding ToggleGroupByLabelCommand}"
                                Style="{StaticResource ActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter bar -->
            <Border Grid.Row="2" Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">
                    <projects:ProjectSelectorView DataContext="{Binding ProjectSelector}"
                                                  CompactMode="True"
                                                  SearchBoxWidth="180"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding ShowProjectSelector, Converter={StaticResource BoolToVis}}" />

                    <CheckBox Content="סנן פרויקט"
                              IsChecked="{Binding FilterByCurrentProject}"
                              VerticalAlignment="Center"
                              Margin="8,0,4,0"
                              ToolTip="סינון אופציונלי — ברירת מחדל: כל המיילים" />

                    <TextBox Width="120" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="חיפוש חופשי" />

                    <TextBox Width="100" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding AddressFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="from:/to:" />

                    <TextBox Width="100" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding SubjectFilter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,4,0" ToolTip="subject:" />

                    <ComboBox Width="140" Height="24"
                              ItemsSource="{Binding AvailableLabels}"
                              SelectedValue="{Binding SelectedLabel}"
                              SelectedValuePath="Name"
                              DisplayMemberPath="Name"
                              Margin="0,0,4,0" ToolTip="label:" />

                    <ComboBox Width="90" Height="24"
                              ItemsSource="{Binding ProjectLinkFilterOptions}"
                              SelectedValue="{Binding SelectedProjectLinkFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,4,0" />

                    <Button Content="חפש" Command="{Binding ApplyFiltersCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="נקה" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ActionButton}" />
                </WrapPanel>
            </Border>

            <!-- Warning / error banners -->
            <Border Grid.Row="3"
                    Background="#FFF8E1"
                    BorderBrush="#FFE082"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    Visibility="{Binding ShowLoadWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LoadWarning}" Foreground="#8D6E63" FontSize="{DynamicResource SiTextSmallFontSize}" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="4"
                    Background="#FFEBEE"
                    BorderBrush="#EF9A9A"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    Visibility="{Binding ShowLoadError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LoadError}" Foreground="#C62828" FontSize="{DynamicResource SiTextSmallFontSize}" TextWrapping="Wrap" />
            </Border>

            <!-- Outlook-style card list -->
            <ListBox Grid.Row="5"
                     ItemsSource="{Binding EmailsView}"
                     SelectedItem="{Binding SelectedEmail}"
                     ItemContainerStyle="{StaticResource EmailCardItemStyle}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" Padding="6,4" Margin="0,4,0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#555" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:EmailListRow}">
                        <local:EmailListItemCard />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
