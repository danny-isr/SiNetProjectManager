<Window x:Class="SiNet.App.Wpf.Surfaces.Email.EmailWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1200" Height="720"
        MinWidth="820" MinHeight="480"
        FlowDirection="RightToLeft"
        Closing="EmailWindowView_OnClosing"
        d:DataContext="{d:DesignInstance Type=local:EmailWindowViewModel, IsDesignTimeCreatable=True}">

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="HeaderBar"
                  Background="#1976D2"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,6">
                    <TextBlock Text="&#x2709;" FontSize="{DynamicResource SiTextMediumFontSize}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextMediumFontSize}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2715;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="סגור" />
                    <Button x:Name="MaximizeButton"
                            Content="&#x25A1;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"
                            ToolTip="הגדל" />
                    <Button Content="&#x2500;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"
                            ToolTip="מזער" />
                </StackPanel>
            </Grid>

            <local:EmailSurfaceView x:Name="EmailSurfaceHost" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
