<Window x:Class="SiNet.App.Wpf.Surfaces.Email.EmailWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
        xmlns:detail="clr-namespace:SiNet.App.Wpf.Surfaces.Email.Detail"
        xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Width="1200" Height="720"
        MinWidth="820" MinHeight="480"
        FlowDirection="RightToLeft"
        Closing="EmailWindowView_OnClosing"
        d:DataContext="{d:DesignInstance Type=local:EmailWindowViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource SiBackgroundBrush}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="HeaderBar"
                  Background="#1976D2"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,6">
                    <TextBlock Text="&#x2709;" FontSize="{DynamicResource SiTextMediumFontSize}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextMediumFontSize}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2715;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="סגור" />
                    <Button x:Name="MaximizeButton"
                            Content="&#x25A1;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"
                            ToolTip="הגדל" />
                    <Button Content="&#x2500;"
                            Foreground="White"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextNormalFontSize}"
                            MinWidth="34"
                            MinHeight="28"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="MinimizeButton_Click"
                            ToolTip="מזער" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="פרויקט:"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               Foreground="{DynamicResource SiSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <projects:ProjectSelectorView DataContext="{Binding ProjectSelector}"
                                                  CompactMode="True"
                                                  SearchBoxWidth="280"
                                                  ShowUserFilter="False"
                                                  VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveProjectDisplay}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#2E7D32"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               TextWrapping="Wrap" />
                </WrapPanel>
            </Border>

            <local:EmailListFilterBar Grid.Row="2"
                                      DataContext="{Binding EmailList}"
                                      Margin="0,0,0,6" />

            <Grid Grid.Row="3" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="480" />
                </Grid.ColumnDefinitions>

                <local:EmailListView Grid.Column="0"
                                     DataContext="{Binding EmailList}"
                                     VerticalAlignment="Stretch"
                                     MinHeight="0" />

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              Cursor="SizeWE" />

                <detail:EmailDetailView Grid.Column="2"
                                        x:Name="EmailDetailHost"
                                        DataContext="{Binding EmailDetail}"
                                        VerticalAlignment="Stretch"
                                        MinHeight="0" />
            </Grid>

            <Border Grid.Row="4"
                    Background="{DynamicResource SiBackgroundBrush}"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Padding="10,5"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0"
                                 Height="3"
                                 Margin="0,0,0,4"
                                 IsIndeterminate="True"
                                 Foreground="#FB8C00"
                                 Visibility="{Binding HasBackgroundWork, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource SiSecondaryBrush}"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BackgroundWorkDisplay}"
                                   Foreground="#E65100"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Visibility="{Binding HasBackgroundWork, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RuntimeSummary}"
                                   Foreground="{DynamicResource SiSecondaryBrush}"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
