<Window x:Class="SiNet.App.Wpf.Surfaces.Email.GmailDuplicateLabelDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="לייבלים כפולים — בחירת שמירה"
        Width="720" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="שמור נבחר ומחק את האחרים"
                        Command="{Binding ConfirmCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        IsDefault="True"/>
                <Button Content="ביטול"
                        Command="{Binding CancelCommand}"
                        Padding="14,8"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="נמצאו כמה לייבלים עם אותו מספר פרויקט בתיבת הדואר."
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="בחרו איזה לייבל לשמור בכל קבוצה. האחרים יימחקו מ-Gmail (הודעות לא נמחקות — רק תווית הלייבל)."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SiMutedForegroundBrush}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="10"
                                BorderBrush="{DynamicResource SiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="{DynamicResource SiSurfaceBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Candidates}"
                                         SelectedItem="{Binding SelectedKeep}"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding LeafName}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FullPath}"
                                                           FontSize="{DynamicResource SiTextTinyFontSize}"
                                                           Foreground="{DynamicResource SiMutedForegroundBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
