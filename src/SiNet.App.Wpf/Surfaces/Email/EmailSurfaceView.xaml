<UserControl x:Class="SiNet.App.Wpf.Surfaces.Email.EmailSurfaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Email"
             xmlns:detail="clr-namespace:SiNet.App.Wpf.Surfaces.Email.Detail"
             xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=local:EmailWindowViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SiBackgroundBrush}"
                BorderBrush="{DynamicResource SiBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="פרויקט:"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource SiFontFamily}"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <projects:ProjectSelectorView DataContext="{Binding ProjectSelector}"
                                              CompactMode="True"
                                              ShowUserFilter="False"
                                              VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveProjectDisplay}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#2E7D32"
                           FontFamily="{DynamicResource SiFontFamily}"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           TextWrapping="Wrap" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#FFF8E1"
                BorderBrush="#FFB300"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,6"
                Visibility="{Binding ShowFollowQuoteBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <Button Content="בחר מייל אחר"
                            Command="{Binding ClearFollowQuoteFilterCommand}"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextSmallFontSize}" />
                    <Button Content="תיוק קובץ בלי מייל"
                            Command="{Binding OpenFollowQuoteProjectWorkCommand}"
                            Padding="10,4"
                            FontFamily="{DynamicResource SiFontFamily}"
                            FontSize="{DynamicResource SiTextSmallFontSize}"
                            Visibility="{Binding OfferFollowQuoteProjectWorkFallback, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding FollowQuoteBannerText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource SiFontFamily}"
                           FontSize="{DynamicResource SiTextSmallFontSize}"
                           Foreground="#5D4037" />
            </DockPanel>
        </Border>

        <local:EmailListFilterBar Grid.Row="2"
                                  DataContext="{Binding EmailList}"
                                  Margin="0,0,0,6" />

        <Grid Grid.Row="3" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <local:EmailListView Grid.Column="0"
                                 DataContext="{Binding EmailList}"
                                 VerticalAlignment="Stretch"
                                 MinHeight="0" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <detail:EmailDetailView Grid.Column="2"
                                    x:Name="EmailDetailHost"
                                    DataContext="{Binding EmailDetail}"
                                    VerticalAlignment="Stretch"
                                    MinHeight="0" />
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource SiBackgroundBrush}"
                BorderBrush="{DynamicResource SiBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Height="3"
                             Margin="0,0,0,4"
                             IsIndeterminate="True"
                             Foreground="#FB8C00"
                             Visibility="{Binding HasBackgroundWork, Converter={StaticResource BoolToVisibility}}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SiSecondaryBrush}"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxHeight="120"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BackgroundWorkDisplay}"
                               Foreground="#E65100"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding HasBackgroundWork, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding RuntimeSummary}"
                               Foreground="{DynamicResource SiSecondaryBrush}"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
