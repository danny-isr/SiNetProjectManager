<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.TaskWorkbenchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Tasks"
        xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="400"
        Height="800"
        MinWidth="320"
        MinHeight="400"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        d:DataContext="{d:DesignInstance Type=local:TaskWorkbenchViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TaskCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SiBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SiSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskCardTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource TaskCardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SiPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Queue position + created -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource SiSecondaryBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="מיקום בתור">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="מיקום בתור "
                                           Style="{DynamicResource SiTextTinyStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WorkPriority}"
                                           FontWeight="Bold"
                                           Style="{DynamicResource SiTextSmallStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </Grid>

                    <!-- Title -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               Style="{DynamicResource SiTextNormalStyle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="44"
                               ToolTip="{Binding Title}"
                               Margin="0,0,0,4" />

                    <!-- Type + status -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TaskTypeName}"
                                   Style="{DynamicResource SiTextSmallStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TaskTypeName}" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource SiSecondaryBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding StatusName}"
                                       Style="{DynamicResource SiTextTinyStyle}" />
                        </Border>
                    </Grid>

                    <!-- Project + assignee + due -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ProjectId, StringFormat=פרויקט {0}}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   Foreground="{DynamicResource SiPrimaryBrush}"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AssignedToUserName}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AssignedToUserName}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DueDate, StringFormat=יעד {0:dd/MM}}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   Margin="8,0,0,0"
                                   Opacity="0.8" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TaskCardListBoxStyle" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource TaskCardTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardListBoxItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <EventSetter Event="MouseDoubleClick" Handler="TaskList_OnMouseDoubleClick" />
        </Style>
    </Window.Resources>

    <Grid Margin="8" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   Style="{DynamicResource SiTextLargeStyle}"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap" />

        <!-- Actions toolbar -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="רענון" Command="{Binding RefreshCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4" />
            <Button Content="פתח משימה" Command="{Binding OpenTaskCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4" />
            <Button Content="הוסף משימה" Command="{Binding AddTaskCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="מחק משימה" Command="{Binding DeleteTaskCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="השבת משימה" Command="{Binding DeactivateTaskCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    ToolTip="השבתת משימה מפעילת Workflow משהה את ה-Workflow ושומרת את המשימה להפעלה מחדש."
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="הפעל מחדש" Command="{Binding ReactivateTaskCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    ToolTip="הפעלת משימה מושבתת מחדש ומחדשת את ה-Workflow המושהה."
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="תקן תור" Command="{Binding RepairQueueCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="העבר למעלה" Command="{Binding MoveUpCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    ToolTip="{Binding QueueMoveStatusHint}"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="העבר למטה" Command="{Binding MoveDownCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,4,4"
                    ToolTip="{Binding QueueMoveStatusHint}"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </WrapPanel>

        <!-- Context / filter area -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,6"
                CornerRadius="4"
                Background="{DynamicResource SiBackgroundBrush}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="מציג משימות:"
                           Style="{DynamicResource SiTextNormalStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding AvailableScopes}"
                          SelectedValuePath="Scope"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedScope}"
                          IsEnabled="{Binding CanSelectTaskScope}"
                          Style="{DynamicResource SiComboBoxStyle}"
                          MinWidth="140"
                          VerticalAlignment="Center"
                          Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding AvailableUsers}"
                          SelectedValuePath="UserId"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedUserId}"
                          Style="{DynamicResource SiComboBoxStyle}"
                          MinWidth="140"
                          Margin="0,0,8,4"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsSpecificUserScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox.ToolTip>
                        <TextBlock Text="בחר משתמש" Style="{DynamicResource SiTextSmallStyle}" />
                    </ComboBox.ToolTip>
                </ComboBox>
                <TextBlock Text="פרויקט:"
                           Style="{DynamicResource SiTextNormalStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4"
                           Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <projects:ProjectSelectorView DataContext="{Binding LocalProjectFilterSelector}"
                                              CompactMode="True"
                                              SearchBoxWidth="160"
                                              ShowUserFilter="False"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,4"
                                              Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="נקה"
                        Command="{Binding ClearSelectedProjectCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,4"
                        IsEnabled="{Binding CanClearSelectedProject}"
                        Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.ToolTip>
                        <TextBlock Text="בטל סינון לפי פרויקט והצג את כל הפרויקטים" Style="{DynamicResource SiTextSmallStyle}" />
                    </Button.ToolTip>
                </Button>
                <TextBlock Text="{Binding ProjectFilterDisplayText}"
                           Style="{DynamicResource SiTextSmallStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="6"
                Margin="0,0,0,6"
                CornerRadius="4"
                Background="{DynamicResource SiBackgroundBrush}">
            <TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" Style="{DynamicResource SiTextSmallStyle}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Style="{DynamicResource SiTextSmallStyle}"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap" />

        <!-- Task buckets: main content area -->
        <TabControl Grid.Row="5"
                    Background="{DynamicResource SiBackgroundBrush}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            <TabItem Header="קצר">
                <ListBox ItemsSource="{Binding QuickTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
            <TabItem Header="בינוני">
                <ListBox ItemsSource="{Binding MediumTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
            <TabItem Header="ארוך">
                <ListBox ItemsSource="{Binding LongTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
        </TabControl>

        <!-- Resolve preview: collapsed by default, limited height -->
        <Expander Grid.Row="6"
                  Header="Resolve preview (WorkSurfaceContext)"
                  IsExpanded="False"
                  Margin="0,6,0,0"
                  MaxHeight="160">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="96" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="בדוק פתיחה / Resolve" Command="{Binding ResolveCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Text="{Binding ResolvePreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Style="{DynamicResource SiTextBoxStyle}" />
            </Grid>
        </Expander>
    </Grid>
</Window>
