<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.TaskWorkbenchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNet.App.Wpf.Surfaces.Tasks"
        xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="400"
        Height="800"
        MinWidth="320"
        MinHeight="400"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        d:DataContext="{d:DesignInstance Type=local:TaskWorkbenchViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Compact toolbar buttons — inherits global rounded CornerRadius=6 chrome. -->
        <Style x:Key="TaskWorkbenchCompactButton" TargetType="Button"
               BasedOn="{StaticResource SiRoundedButtonBase}">
            <Setter Property="FontSize" Value="{DynamicResource SiTextSmallFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource SiForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource SiBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SiSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,0,3,3" />
        </Style>

        <Style x:Key="TaskCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SiBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SiSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CardListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding TaskId, StringFormat=Task.{0}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskCardTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource TaskCardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SiPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource SiSecondaryBrush}"
                                CornerRadius="6"
                                Padding="4,1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="מיקום בתור">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="מיקום בתור "
                                           Style="{DynamicResource SiTextTinyStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WorkPriority}"
                                           FontWeight="Bold"
                                           Style="{DynamicResource SiTextSmallStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               Style="{DynamicResource SiTextSmallStyle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="36"
                               ToolTip="{Binding Title}"
                               Margin="0,0,0,2" />

                    <Grid Grid.Row="2" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TaskTypeName}"
                                       Style="{DynamicResource SiTextTinyStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TaskTypeName}" />
                            <TextBlock Text="{Binding TrackDisplayLine}"
                                       Style="{DynamicResource SiTextTinyStyle}"
                                       Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TrackDisplayLine}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource SiSecondaryBrush}"
                                CornerRadius="6"
                                Padding="4,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding StatusName}"
                                       Style="{DynamicResource SiTextTinyStyle}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ProjectId, StringFormat=פרויקט {0}}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   Foreground="{DynamicResource SiPrimaryBrush}"
                                   Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AssignedToUserName}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AssignedToUserName}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DueDate, StringFormat=יעד {0:dd/MM}}"
                                   Style="{DynamicResource SiTextTinyStyle}"
                                   Margin="6,0,0,0"
                                   Opacity="0.8" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TaskCardListBoxStyle" TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource TaskCardTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardListBoxItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <EventSetter Event="MouseDoubleClick" Handler="TaskList_OnMouseDoubleClick" />
        </Style>
    </Window.Resources>

    <Grid Margin="6" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}"
                       Style="{DynamicResource SiTextLargeStyle}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       Style="{DynamicResource SiTextTinyStyle}"
                       Margin="8,0,0,0"
                       MaxWidth="160"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Actions toolbar -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="רענון" Command="{Binding RefreshCommand}" Style="{StaticResource TaskWorkbenchCompactButton}" />
            <Button Content="פתח משימה"
                    Command="{Binding OpenTaskCommand}"
                    AutomationProperties.AutomationId="TaskWorkbench.OpenTask"
                    AutomationProperties.Name="פתח משימה"
                    Style="{StaticResource TaskWorkbenchCompactButton}" />
            <Button Content="הוסף משימה" Command="{Binding AddTaskCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="מחק משימה" Command="{Binding DeleteTaskCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="השבת משימה" Command="{Binding DeactivateTaskCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    ToolTip="השבתת משימה מפעילת Workflow משהה את ה-Workflow ושומרת את המשימה להפעלה מחדש."
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="הפעל מחדש" Command="{Binding ReactivateTaskCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    ToolTip="הפעלת משימה מושבתת מחדש ומחדשת את ה-Workflow המושהה."
                    Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="תקן תור" Command="{Binding RepairQueueCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="העבר למעלה" Command="{Binding MoveUpCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    ToolTip="{Binding QueueMoveStatusHint}"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="העבר למטה" Command="{Binding MoveDownCommand}" Style="{StaticResource TaskWorkbenchCompactButton}"
                    ToolTip="{Binding QueueMoveStatusHint}"
                    Visibility="{Binding CanManageQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </WrapPanel>

        <!-- Context / filter area -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="4"
                Margin="0,0,0,4"
                CornerRadius="6"
                Background="{DynamicResource SiBackgroundBrush}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="מציג משימות:"
                           Style="{DynamicResource SiTextSmallStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,2" />
                <ComboBox ItemsSource="{Binding AvailableScopes}"
                          SelectedValuePath="Scope"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedScope}"
                          IsEnabled="{Binding CanSelectTaskScope}"
                          AutomationProperties.AutomationId="TaskWorkbench.ScopeSelector"
                          AutomationProperties.Name="מציג משימות"
                          Style="{DynamicResource SiComboBoxStyle}"
                          FontSize="{DynamicResource SiTextSmallFontSize}"
                          MinWidth="120"
                          VerticalAlignment="Center"
                          Margin="0,0,6,2" />
                <ComboBox ItemsSource="{Binding AvailableUsers}"
                          SelectedValuePath="UserId"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedUserId}"
                          AutomationProperties.AutomationId="TaskWorkbench.UserSelector"
                          AutomationProperties.Name="בחירת משתמש"
                          Style="{DynamicResource SiComboBoxStyle}"
                          FontSize="{DynamicResource SiTextSmallFontSize}"
                          MinWidth="120"
                          Margin="0,0,6,2"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsSpecificUserScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox.ToolTip>
                        <TextBlock Text="בחר משתמש" Style="{DynamicResource SiTextSmallStyle}" />
                    </ComboBox.ToolTip>
                </ComboBox>
                <TextBlock Text="פרויקט:"
                           Style="{DynamicResource SiTextSmallStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,2"
                           Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <projects:ProjectSelectorView DataContext="{Binding LocalProjectFilterSelector}"
                                              CompactMode="True"
                                              SearchBoxWidth="140"
                                              ShowUserFilter="False"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,2"
                                              Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="נקה"
                        Command="{Binding ClearSelectedProjectCommand}"
                        Style="{StaticResource TaskWorkbenchCompactButton}"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanClearSelectedProject}"
                        Visibility="{Binding HasLocalProjectFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.ToolTip>
                        <TextBlock Text="בטל סינון לפי פרויקט והצג את כל הפרויקטים" Style="{DynamicResource SiTextSmallStyle}" />
                    </Button.ToolTip>
                </Button>
                <TextBlock Text="{Binding ProjectFilterDisplayText}"
                           Style="{DynamicResource SiTextTinyStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2" />
            </WrapPanel>
        </Border>

        <Expander Grid.Row="3"
                  Header="אבחון"
                  IsExpanded="False"
                  Margin="0,0,0,4"
                  FontSize="{DynamicResource SiTextTinyFontSize}">
            <TextBlock Text="{Binding DiagnosticsText}" FontFamily="Consolas" Style="{DynamicResource SiTextTinyStyle}" TextWrapping="Wrap" Margin="4,2" />
        </Expander>

        <!-- Task buckets: main content area -->
        <TabControl Grid.Row="4"
                    Background="{DynamicResource SiBackgroundBrush}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">
            <TabItem Header="קצר">
                <ListBox ItemsSource="{Binding QuickTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
            <TabItem Header="בינוני">
                <ListBox ItemsSource="{Binding MediumTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
            <TabItem Header="ארוך">
                <ListBox ItemsSource="{Binding LongTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Style="{StaticResource TaskCardListBoxStyle}" />
            </TabItem>
        </TabControl>

        <!-- Resolve preview: collapsed by default, limited height -->
        <Expander Grid.Row="5"
                  Header="Resolve preview (WorkSurfaceContext)"
                  IsExpanded="False"
                  Margin="0,4,0,0"
                  MaxHeight="160">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="96" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="בדוק פתיחה / Resolve" Command="{Binding ResolveCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" Text="{Binding ResolvePreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Style="{DynamicResource SiTextBoxStyle}" />
            </Grid>
        </Expander>
    </Grid>
</Window>
