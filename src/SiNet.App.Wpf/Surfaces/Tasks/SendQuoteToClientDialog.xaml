<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.SendQuoteToClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שליחת הצעת מחיר ללקוח"
        Width="820" Height="640"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        MinWidth="640" MinHeight="480"
        ShowInTaskbar="True"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="שלח"
                        Padding="14,8" Margin="0,0,8,0"
                        Background="#BBDEFB" Foreground="#0D47A1" FontWeight="SemiBold"
                        BorderBrush="#64B5F6" Click="Send_Click"
                        IsEnabled="{Binding CanSend}"/>
                <Button Content="סיום אחרי הוכחה"
                        Padding="14,8" Margin="0,0,8,0"
                        Background="#A5D6A7" Foreground="#1B5E20" FontWeight="SemiBold"
                        BorderBrush="#66BB6A" Click="CompleteVerified_Click"
                        IsEnabled="{Binding CanCompleteVerified}"/>
                <Button Content="אישור מנהל (override)"
                        Padding="14,8" Margin="0,0,8,0"
                        Background="#FFE0B2" Foreground="#E65100" FontWeight="SemiBold"
                        BorderBrush="#FFB74D" Click="Override_Click"
                        IsEnabled="{Binding CanOverride}"/>
                <Button Content="צרף קובץ…"
                        Padding="14,8" Margin="0,0,8,0"
                        Click="Attach_Click"
                        Background="{DynamicResource SiSurfaceBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}"/>
                <Button Content="בחר מייל מקור…"
                        Padding="14,8" Margin="0,0,8,0"
                        Click="PickSource_Click"
                        Background="{DynamicResource SiSurfaceBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}"/>
                <Button Content="Compose חדש"
                        Padding="14,8" Margin="0,0,8,0"
                        Click="NewCompose_Click"
                        Background="{DynamicResource SiSurfaceBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}"/>
                <Button Content="סגור"
                        Padding="14,8" Click="Close_Click"
                        Background="{DynamicResource SiSurfaceBrush}"
                        BorderBrush="{DynamicResource SiBorderBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="שליחת הצעת מחיר — Compose פנימי"
                   FontWeight="SemiBold"
                   FontSize="{DynamicResource SiTextMediumFontSize}"
                   Foreground="{DynamicResource SiForegroundBrush}"
                   Margin="0,0,0,6"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ProjectLine}"
                   Foreground="{DynamicResource SiSecondaryBrush}"
                   Margin="0,0,0,4"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ModeLine}"
                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                   Margin="0,0,0,4"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SiForegroundBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="קבצים מצורפים"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding AttachmentChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4"
                                Margin="0,0,6,4"
                                Background="{DynamicResource SiSurfaceBrush}"
                                BorderBrush="{DynamicResource SiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                Tag="{Binding}"
                                MouseLeftButtonUp="AttachmentChip_MouseLeftButtonUp"
                                ToolTip="לחץ לצפייה ב-PDF המתויק">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center"
                                           MaxWidth="220"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}"
                                           Foreground="{DynamicResource SiForegroundBrush}"
                                           Margin="0,0,8,0"/>
                                <Button Content="✕"
                                        Width="22" Height="22"
                                        Padding="0"
                                        FontSize="{DynamicResource SiTextSmallFontSize}"
                                        ToolTip="הסר קובץ מצורף"
                                        Tag="{Binding}"
                                        Click="RemoveAttachment_Click"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource SiBorderBrush}"
                                        Foreground="{DynamicResource SiMutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="אין קבצים מצורפים"
                       Foreground="{DynamicResource SiMutedForegroundBrush}"
                       Visibility="{Binding HasNoAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="אל:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,6" MinHeight="28"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="עותק:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CcText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,6" MinHeight="28"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="נושא:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SubjectText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,6" MinHeight="28"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="גוף:" VerticalAlignment="Top" Margin="0,4,8,0"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding BodyText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="220"/>
        </Grid>
    </DockPanel>
</Window>
