<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.OpenQuoteProjectDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
        Title="פתיחת פרויקט הצעת מחיר"
        Width="1100" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="860" MinHeight="600"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="לא הצעת מחיר"
                            Padding="14,8" Margin="0,0,8,0"
                            Background="#FFCDD2" Foreground="#B71C1C" FontWeight="SemiBold"
                            BorderBrush="#E57373" Click="NotQuote_Click"/>
                    <Button Content="סגור בלי שינוי"
                            Padding="14,8" Click="Cancel_Click"
                            Background="{DynamicResource SiSurfaceBrush}"
                            BorderBrush="{DynamicResource SiBorderBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Physical LTR split: email LEFT, project form RIGHT -->
        <Grid FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.15*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: email + attachments -->
            <Border Grid.Column="0" Padding="12" CornerRadius="6"
                    Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                    FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Subject}"
                               FontSize="{DynamicResource SiTextMediumFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SiForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding FromDisplay}"
                                   Foreground="{DynamicResource SiMutedForegroundBrush}"/>
                        <TextBlock Text="{Binding DateDisplay}"
                                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding PromptHint}"
                                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource SiTextNormalFontSize}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="קבצים מקושרים"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SiForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="{Binding AttachmentsHint}"
                                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <ListBox ItemsSource="{Binding Attachments}"
                                 BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SiForegroundBrush}"/>
                                        <Button Grid.Column="1" Content="פתח ב-ACC"
                                                Margin="8,0,0,0" Padding="10,4"
                                                IsEnabled="{Binding CanOpenInAcc}"
                                                Click="OpenAttachment_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#FFD54F" ResizeBehavior="PreviousAndNext"/>

            <!-- Right: project create form (approval lives here) -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1" Padding="4"
                    FlowDirection="RightToLeft">
                <projects:ProjectCreateDialogView x:Name="ProjectFormHost"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
