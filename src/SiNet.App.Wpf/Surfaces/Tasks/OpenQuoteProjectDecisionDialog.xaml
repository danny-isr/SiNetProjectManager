<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.OpenQuoteProjectDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="פתיחת פרויקט הצעת מחיר"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="560" MinHeight="360"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="פתיחת פרויקט"
                            Padding="14,8" Margin="0,0,8,0"
                            Background="#C8E6C9" Foreground="#1B5E20" FontWeight="SemiBold"
                            BorderBrush="#81C784" Click="OpenProject_Click"/>
                    <Button Content="לא הצעת מחיר"
                            Padding="14,8" Margin="0,0,8,0"
                            Background="#FFCDD2" Foreground="#B71C1C" FontWeight="SemiBold"
                            BorderBrush="#E57373" Click="NotQuote_Click"/>
                    <Button Content="ביטול"
                            Padding="14,8" Click="Cancel_Click"
                            Background="#ECEFF1" BorderBrush="#B0BEC5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="מייל מקור — בחר פעולה להמשך תהליך הצעת המחיר"
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding PromptHint}"
                   Foreground="{DynamicResource SiSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Padding="14" CornerRadius="6"
                Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FromDisplay}" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DateDisplay}" Foreground="#555" Margin="0,0,0,10"/>
                    <TextBlock Text="תיוק חומר (Move to project) יתבצע בשלב הבא אחרי פתיחת הפרויקט."
                               Foreground="#666" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
