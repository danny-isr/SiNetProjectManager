<UserControl x:Class="SiNet.App.Wpf.Surfaces.Tasks.TaskCreateDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="פרויקט"
                       Style="{DynamicResource SiTextNormalStyle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <projects:ProjectSelectorView Grid.Row="1"
                                          DataContext="{Binding ProjectSelector}"
                                          CompactMode="True"
                                          SearchBoxWidth="280"
                                          ShowUserFilter="False"
                                          Margin="0,0,0,12" />

            <TextBlock Grid.Row="2"
                       Text="אחראי"
                       Style="{DynamicResource SiTextNormalStyle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <ComboBox Grid.Row="3"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedAssignee}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding CanEditAssignee}"
                      Style="{DynamicResource SiComboBoxStyle}"
                      Margin="0,0,0,12" />

            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="סוג משימה"
                               Style="{DynamicResource SiTextNormalStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TaskTypes}"
                              SelectedItem="{Binding SelectedTaskType}"
                              DisplayMemberPath="DisplayName"
                              Style="{DynamicResource SiComboBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="תור"
                               Style="{DynamicResource SiTextNormalStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Buckets}"
                              SelectedItem="{Binding SelectedBucket}"
                              DisplayMemberPath="DisplayName"
                              Style="{DynamicResource SiComboBoxStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="5"
                       Text="כותרת"
                       Style="{DynamicResource SiTextNormalStyle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox Grid.Row="6"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource SiTextBoxStyle}"
                     Margin="0,0,0,12" />

            <TextBlock Grid.Row="7"
                       Text="תיאור (אופציונלי)"
                       Style="{DynamicResource SiTextNormalStyle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox Grid.Row="8"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource SiTextBoxStyle}"
                     AcceptsReturn="True"
                     MinHeight="64"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12" />

            <StackPanel Grid.Row="9" Margin="0,0,0,12">
                <TextBlock Text="תאריך יעד (אופציונלי)"
                           Style="{DynamicResource SiTextNormalStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding DueDate}" />
            </StackPanel>

            <TextBlock Grid.Row="10"
                       Text="{Binding ValidationMessage}"
                       Style="{DynamicResource SiTextSmallStyle}"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <StackPanel Grid.Row="11"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="הוסף"
                        Command="{Binding CreateCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="ביטול"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource SiSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
