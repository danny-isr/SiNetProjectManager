<Window x:Class="SiNet.App.Wpf.Surfaces.Tasks.QuoteClassificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="סיווג בקשת הצעת מחיר"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="480" MinHeight="320"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="זו בקשת הצעת מחיר"
                        Padding="14,8" Margin="0,0,8,0"
                        Background="#C8E6C9" Foreground="#1B5E20" FontWeight="SemiBold"
                        BorderBrush="#81C784" Click="QuoteRequest_Click"/>
                <Button Content="זו לא בקשת הצעת מחיר"
                        Padding="14,8" Margin="0,0,8,0"
                        Background="#FFCDD2" Foreground="#B71C1C" FontWeight="SemiBold"
                        BorderBrush="#E57373" Click="NotQuote_Click"/>
                <Button Content="ביטול"
                        Padding="14,8" Click="Cancel_Click"
                        Background="#ECEFF1" BorderBrush="#B0BEC5"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="האם המייל הוא בקשת הצעת מחיר?"
                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding PromptHint}"
                   Foreground="{DynamicResource SiSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Padding="12" CornerRadius="6"
                Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding Subject}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding FromDisplay}" Foreground="#555" Margin="0,0,0,3"/>
                <TextBlock Text="{Binding DateDisplay}" Foreground="#555"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
