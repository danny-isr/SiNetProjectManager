<UserControl x:Class="SiNet.App.Wpf.Shared.Projects.ProjectCreateDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="clr-namespace:SiNet.App.Wpf.Shared.Projects"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="מספר פרויקט" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="{Binding ProjectNumberDisplay}" Style="{DynamicResource SiTextNormalStyle}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="2" Text="שם פרויקט" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource SiTextBoxStyle}" MaxLength="24" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="4" Text="מקום" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Places}"
                          SelectedItem="{Binding SelectedPlace}"
                          DisplayMemberPath="Title"
                          Style="{DynamicResource SiComboBoxStyle}"/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="8,0,0,0"
                        Command="{Binding OpenPlacePickerCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"/>
            </Grid>

            <TextBlock Grid.Row="6" Text="חברה" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Grid.Row="7" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Companies}"
                          SelectedItem="{Binding SelectedCompany}"
                          DisplayMemberPath="Title"
                          Style="{DynamicResource SiComboBoxStyle}"/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="8,0,0,0"
                        Command="{Binding OpenCompanyPickerCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"/>
            </Grid>

            <TextBlock Grid.Row="8" Text="איש קשר" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox Grid.Row="9"
                      ItemsSource="{Binding Contacts}"
                      SelectedItem="{Binding SelectedContact}"
                      DisplayMemberPath="DisplayName"
                      Style="{DynamicResource SiComboBoxStyle}"
                      Margin="0,0,0,12"/>

            <TextBlock Grid.Row="10" Text="שייך לפרויקט (אב)" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <projects:ProjectSelectorView Grid.Row="11"
                                          DataContext="{Binding ParentProjectSelector}"
                                          CompactMode="True"
                                          SearchBoxWidth="280"
                                          ShowUserFilter="False"
                                          Margin="0,0,0,12"/>

            <TextBlock Grid.Row="12" Text="סוגי פרויקט" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border Grid.Row="13" BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,12" MaxHeight="160">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding JobTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="14"
                       Text="{Binding ValidationMessage}"
                       Foreground="#C62828"
                       Style="{DynamicResource SiTextSmallStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="אישור"
                        Command="{Binding CreateCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"
                        MinWidth="100" Margin="0,0,8,0"
                        IsDefault="True"/>
                <Button Content="ביטול"
                        Command="{Binding CancelCommand}"
                        MinWidth="80"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
