<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
	<RootNamespace>SiNet.App.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="SiNet.App.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
	<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.7" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="appsettings.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\SiNet.App.Composition\SiNet.App.Composition.csproj" />
	<ProjectReference Include="..\SiNet.Application\SiNet.Application.csproj" />
	<ProjectReference Include="..\SiNet.Domain\SiNet.Domain.csproj" />
	<ProjectReference Include="..\SiNet.Infrastructure.Secrets\SiNet.Infrastructure.Secrets.csproj" />
	<ProjectReference Include="..\..\..\SiNetSQL\SiNetSQL\SiNetSQL.csproj" />
	<ProjectReference Include="..\..\..\AutodeskIntegration\SiOffice.AutodeskConnector\SiOffice.AutodeskConnector.csproj" />
  </ItemGroup>

</Project>
