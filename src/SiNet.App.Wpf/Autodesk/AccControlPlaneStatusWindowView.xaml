<UserControl x:Class="SiNet.App.Wpf.Autodesk.AccControlPlaneStatusWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:autodesk="clr-namespace:SiNet.App.Wpf.Autodesk"
             FlowDirection="RightToLeft">
    <Grid Margin="16" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <autodesk:AccControlPlaneStatusView HintText="{Binding HintText}"
                                                    ModeSummary="{Binding ModeSummary}"
                                                    KeySummary="{Binding KeySummary}"
                                                    ProjectsSummary="{Binding ProjectsSummary}"
                                                    HealthSummary="{Binding HealthSummary}"
                                                    DiagnosticsSummary="{Binding DiagnosticsSummary}"/>

                <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="בדיקת resolve של פריט ACC (קריאה בלבד)"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="הזן projectId, folderId ו-fileName כדי לבדוק שה-service/local mode מצליח לפתור פריט אמיתי ב-ACC."
                                   Margin="0,6,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="ACC Project ID" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding LookupProjectId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

                        <TextBlock Text="ACC Folder ID" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding LookupFolderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

                        <TextBlock Text="File Name" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding LookupFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding LookupResultSummary}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{Binding SummaryMessage}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SiSecondaryBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="בדוק פריט"
                    Command="{Binding ResolveDocumentCommand}"
                    Style="{DynamicResource SiPrimaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
