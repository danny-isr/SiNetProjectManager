<UserControl x:Class="SiNet.App.Wpf.Autodesk.AccControlPlaneStatusWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:autodesk="clr-namespace:SiNet.App.Wpf.Autodesk"
             FlowDirection="RightToLeft">
    <Grid Margin="16" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <autodesk:AccControlPlaneStatusView HintText="{Binding HintText}"
                                                    ModeSummary="{Binding ModeSummary}"
                                                    KeySummary="{Binding KeySummary}"
                                                    ProjectsSummary="{Binding ProjectsSummary}"
                                                    HealthSummary="{Binding HealthSummary}"
                                                    DiagnosticsSummary="{Binding DiagnosticsSummary}"/>

                <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ACC Inbox bootstrap (כתיבה מבוקרת)"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextMediumFontSize}"/>
                        <TextBlock Text="הפעולה מבצעת ensure לפרויקט Inbox, לתיקיית _Inbox ולהגדרות הגישה דרך ה-service/local mode הפעיל. לאחר הצלחה ימולאו projectId ו-folderId לבדיקה מיידית."
                                   Margin="0,6,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                            <Button Content="Ensure ACC Inbox"
                                    Command="{Binding EnsureInboxBootstrapCommand}"
                                    Style="{DynamicResource SiSecondaryButtonStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InboxBootstrapSummary}"
                                   Margin="0,8,0,0"
                                   Opacity="0.85"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>

                        <TextBlock Text="ACC Inbox reconciliation (קריאה בלבד)"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextMediumFontSize}"/>
                        <TextBlock Text="הזן EmailInboxMessage.Id או MessageUniqueId כדי לבדוק מה באמת קיים ב-ACC Inbox. התוצאה משתמשת ב-reconciliation read-only דרך ה-port החדש, בלי לבצע כתיבה."
                                   Margin="0,6,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Text="{Binding ReconcileMessageIdText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="EmailInboxMessage.Id"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding ReconcileMessageUniqueIdText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="MessageUniqueId"/>
                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <Button Content="Reconcile Inbox"
                                        Command="{Binding ReconcileInboxMessageCommand}"
                                        Style="{DynamicResource SiSecondaryButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="העבר ל-lookup"
                                        Command="{Binding UseSelectedReconciliationItemCommand}"
                                        Style="{DynamicResource SiSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ReconciliationSummary}"
                                   Margin="0,8,0,0"
                                   Opacity="0.85"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <DataGrid ItemsSource="{Binding ReconciliationItems}"
                                  SelectedItem="{Binding SelectedReconciliationItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="{DynamicResource SiPopupListMaxHeight}"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Attachment"
                                                    Binding="{Binding AttachmentLabel}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="File"
                                                    Binding="{Binding FileName}"
                                                    Width="2*"/>
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding StatusText}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="ACC Item"
                                                    Binding="{Binding AccItemId}"
                                                    Width="140"/>
                                <DataGridTextColumn Header="Folder"
                                                    Binding="{Binding OpenAccFolderId}"
                                                    Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="בדיקת resolve של פריט ACC (קריאה בלבד)"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextMediumFontSize}"/>
                        <TextBlock Text="הזן projectId, folderId ו-fileName כדי לבדוק שה-service/local mode מצליח לפתור פריט אמיתי ב-ACC."
                                   Margin="0,6,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <autodesk:AccReadOnlyDocumentBrowserView DataContext="{Binding Browser}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{Binding SummaryMessage}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SiSecondaryBrush}"
                   FontFamily="{DynamicResource SiFontFamily}"
                   FontSize="{DynamicResource SiTextSmallFontSize}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="טען דוגמה מה-DB"
                    Command="{Binding LoadLookupSeedCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
