<UserControl x:Class="SiNet.App.Wpf.Autodesk.AccControlPlaneStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FlowDirection="RightToLeft">
    <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
        <StackPanel>
            <TextBlock Text="{Binding HintText, ElementName=Root}" Opacity="0.7" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ModeSummary, ElementName=Root}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding KeySummary, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProjectsSummary, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding HealthSummary, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DiagnosticsSummary, ElementName=Root}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
