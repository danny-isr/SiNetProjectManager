<Window x:Class="SiNet.App.Wpf.Admin.MasterPlan.Reports.R03ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R03 — השוואת נוכחות"
        Width="900" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="דוח השוואת נוכחות — R03"
                 Style="{DynamicResource SiTextLargeStyle}"/>
      <TextBlock Text="השוואה בין שעות נוכחות לשעות מדווחות לפי עובד ויום"
                 Style="{DynamicResource SiTextSmallStyle}"
                 Foreground="{DynamicResource SiMutedForegroundBrush}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="חודש / שנה" FontWeight="SemiBold" Margin="0,0,0,8"
                 FontFamily="{DynamicResource SiFontFamily}"
                 FontSize="{DynamicResource SiTextMediumFontSize}"
                 Foreground="{DynamicResource SiForegroundBrush}"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <ComboBox Width="80"
                  ItemsSource="{Binding Months}"
                  SelectedItem="{Binding Month}"
                  Style="{DynamicResource SiComboBoxStyle}"
                  Margin="0,0,8,0"/>
        <ComboBox Width="100"
                  ItemsSource="{Binding Years}"
                  SelectedItem="{Binding Year}"
                  Style="{DynamicResource SiComboBoxStyle}"/>
      </StackPanel>

      <TextBlock Text="עובדים" FontWeight="SemiBold" Margin="0,0,0,6"
                 FontFamily="{DynamicResource SiFontFamily}"
                 FontSize="{DynamicResource SiTextMediumFontSize}"
                 Foreground="{DynamicResource SiForegroundBrush}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ToggleButton x:Name="EmployeeSelectorToggle"
                      Grid.Column="0"
                      IsChecked="{Binding IsEmployeePopupOpen, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch"
                      Padding="10,6"
                      Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedEmployeesSummary}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource SiFontFamily}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"/>
            <TextBlock Grid.Column="1" Text=" ▼"
                       FontFamily="{DynamicResource SiFontFamily}"
                       FontSize="{DynamicResource SiTextTinyFontSize}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </ToggleButton>

        <TextBlock Grid.Column="0"
                   Text="{Binding CurrentUserEmployeeText}"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource SiFontFamily}"
                   FontSize="{DynamicResource SiTextSmallFontSize}"
                   Foreground="{DynamicResource SiMutedForegroundBrush}"
                   Visibility="{Binding IsNotAdminMode, Converter={StaticResource BoolToVis}}"/>

        <Button Grid.Column="1"
                Content="בחר הכל"
                Command="{Binding SelectAllEmployeesCommand}"
                Style="{DynamicResource SiSecondaryButtonStyle}"
                Margin="8,0,0,0"
                Padding="10,6"
                Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>
        <Button Grid.Column="2"
                Content="נקה"
                Command="{Binding ClearEmployeeSelectionCommand}"
                Style="{DynamicResource SiSecondaryButtonStyle}"
                Margin="8,0,0,0"
                Padding="10,6"
                Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>

        <Popup IsOpen="{Binding IsChecked, ElementName=EmployeeSelectorToggle}"
               PlacementTarget="{Binding ElementName=EmployeeSelectorToggle}"
               Placement="Bottom"
               StaysOpen="False"
               Width="{Binding ActualWidth, ElementName=EmployeeSelectorToggle}">
          <Border Background="{DynamicResource SiBackgroundBrush}"
                  BorderBrush="{DynamicResource SiBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8">
            <StackPanel>
              <TextBox Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                       Style="{DynamicResource SiTextBoxStyle}"
                       Margin="0,0,0,6"/>
              <ScrollViewer MaxHeight="{DynamicResource SiPopupListMaxHeight}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredEmployees}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Content="{Binding Name}"
                                Margin="2,3"
                                FontFamily="{DynamicResource SiFontFamily}"
                                FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="2" Visibility="{Binding HasViewData, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DataGrid Grid.Row="0"
                ItemsSource="{Binding ViewDailyRows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                AlternatingRowBackground="{DynamicResource SiSurfaceBrush}"
                Background="{DynamicResource SiBackgroundBrush}"
                BorderBrush="{DynamicResource SiBorderBrush}"
                FlowDirection="RightToLeft"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                Margin="0,0,0,8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="עובד" Binding="{Binding EmployeeName}" Width="*" MinWidth="120"/>
          <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="90"/>
          <DataGridTextColumn Header="יום" Binding="{Binding DayName}" Width="60"/>
          <DataGridTextColumn Header="נוכחות" Binding="{Binding AttendanceHours, StringFormat=N2}" Width="80"/>
          <DataGridTextColumn Header="מדווח" Binding="{Binding ReportedHours, StringFormat=N2}" Width="80"/>
          <DataGridTextColumn Header="הפרש" Binding="{Binding Difference, StringFormat=N2}" Width="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsNegativeDifference}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SiDangerBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Row="1"
                 Text="{Binding ViewSummary}"
                 FontWeight="SemiBold"
                 FontFamily="{DynamicResource SiFontFamily}"
                 FontSize="{DynamicResource SiTextNormalFontSize}"
                 Foreground="{DynamicResource SiForegroundBrush}"/>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 FontFamily="{DynamicResource SiFontFamily}"
                 FontSize="{DynamicResource SiTextSmallFontSize}"
                 Foreground="{DynamicResource SiMutedForegroundBrush}"/>
      <TextBlock Text="{Binding ResultUrl}" TextWrapping="Wrap" Margin="0,6,0,0"
                 FontFamily="{DynamicResource SiFontFamily}"
                 FontSize="{DynamicResource SiTextTinyFontSize}"
                 Foreground="{DynamicResource SiPrimaryBrush}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="הצג נתונים"
              Command="{Binding PreviewCommand}"
              Style="{DynamicResource SiSecondaryButtonStyle}"
              Margin="0,0,10,0"
              ToolTip="הצגת נתוני נוכחות בטבלה בתוך האפליקציה"/>
      <Button Content="הפקה ל-Google Sheets"
              Command="{Binding GenerateCommand}"
              Style="{DynamicResource SiPrimaryButtonStyle}"
              Margin="0,0,10,0"
              Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
              ToolTip="יצירת דוח בגוגל שיטס (הנהלה בלבד)"/>
      <Button Content="סגור"
              Style="{DynamicResource SiSecondaryButtonStyle}"
              Click="CloseButton_Click"
              Padding="15,8"/>
    </StackPanel>
  </Grid>
</Window>
