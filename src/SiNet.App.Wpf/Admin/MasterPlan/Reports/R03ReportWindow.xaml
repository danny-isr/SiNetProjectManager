<Window x:Class="SiNet.App.Wpf.Admin.MasterPlan.Reports.R03ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R03 — השוואת נוכחות"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom"
            Content="הפקה ל-Google Sheets"
            Command="{Binding GenerateCommand}"
            Padding="12,6"
            HorizontalAlignment="Left"
            Margin="0,12,0,0"/>
    <StackPanel>
      <TextBlock Text="חודש / שנה" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <ComboBox Width="80" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" Margin="0,0,8,0"/>
        <ComboBox Width="100" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ResultUrl}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="DarkBlue"/>
    </StackPanel>
  </DockPanel>
</Window>
