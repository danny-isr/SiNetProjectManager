<Window x:Class="SiNet.App.Wpf.Admin.MasterPlan.Reports.R02ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R02 — שעות עבודה"
        Width="520" Height="300"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom"
            Content="הפקה ל-Google Sheets"
            Command="{Binding GenerateCommand}"
            Padding="12,6"
            HorizontalAlignment="Left"
            Margin="0,12,0,0"/>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="מתאריך:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <DatePicker SelectedDate="{Binding StartDate}" Width="140" Margin="0,0,16,0"/>
        <TextBlock Text="עד:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <DatePicker SelectedDate="{Binding EndDate}" Width="140"/>
      </StackPanel>
      <CheckBox Content="החרג שורות עם 0 שעות" IsChecked="{Binding ExcludeZeroHours}" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ResultUrl}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="DarkBlue"/>
    </StackPanel>
  </DockPanel>
</Window>
