<Window x:Class="SiNet.App.Wpf.Admin.MasterPlan.Reports.R01ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R01 — סיכום שעות"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource SiBackgroundBrush}">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom"
            Content="הפקה ל-Google Sheets"
            Command="{Binding GenerateCommand}"
            Padding="12,6"
            HorizontalAlignment="Left"
            Margin="0,12,0,0"/>
    <StackPanel>
      <CheckBox Content="פרויקטים פעילים בלבד" IsChecked="{Binding ActiveOnly}" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="עלות שעה:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Width="100" Text="{Binding HourPrice, UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ResultUrl}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="DarkBlue"/>
    </StackPanel>
  </DockPanel>
</Window>
