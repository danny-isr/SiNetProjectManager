<UserControl x:Class="SiNet.App.Wpf.Admin.SystemStatus.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.SystemStatus"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="16" LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Left"
                    Content="רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource SiPrimaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0" />
            <Button DockPanel.Dock="Left"
                    Content="פתח הקצאות"
                    Command="{Binding OpenUserGroupsCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0" />
            <TextBlock Text="{Binding Summary}"
                       Style="{DynamicResource SiTextSmallStyle}"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <ListView ItemsSource="{Binding Rows}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SiSecondaryBrush}"
                  Background="{DynamicResource SiBackgroundBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="מערכת" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:SystemStatusRowViewModel}">
                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{DynamicResource SiTextNormalStyle}"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="מצב" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:SystemStatusRowViewModel}">
                                <Border Background="{Binding StateBrush}"
                                        CornerRadius="3"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StateLabel}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource SiTextTinyFontSize}" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="רקע" Width="60"
                                    DisplayMemberBinding="{Binding ActiveWorkDisplay}" />
                    <GridViewColumn Header="פירוט" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:SystemStatusRowViewModel}">
                                <TextBlock Text="{Binding Summary}"
                                           Style="{DynamicResource SiTextSmallStyle}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
