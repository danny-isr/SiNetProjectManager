<UserControl x:Class="SiNet.App.Wpf.Admin.FileCatalog.FileCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.FileCatalog"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiWindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <CollectionViewSource x:Key="FileExtensionsSource" Source="{Binding FileExtensions}" />

        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="3,1"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:FileCatalogFolderNodeVm}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="הוספת תת-תיקייה"
                                  Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="שייך את הקובץ הנבחר לכאן"
                                  Command="{Binding PlacementTarget.Tag.AssignFileToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="מחק תיקייה"
                                  Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="📁" Margin="0,0,5,0" Foreground="#FFDAA520"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10" Padding="8"
                BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource SiSurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="סינון לפי סוג עבודה:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding JobTypes}"
                          SelectedItem="{Binding SelectedJobType}"
                          DisplayMemberPath="Title"
                          Width="200" Margin="0,0,8,0"/>
                <Button Content="הוסף סוג עבודה" Command="{Binding AddJobTypeCommand}"
                        Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="ערוך" Command="{Binding RenameJobTypeCommand}"
                        ToolTip="שינוי שם סוג העבודה הנבחר" Padding="8,4" Margin="0,0,12,0"/>
                <Button Content="רענון" Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="שמור שינויים" Command="{Binding SaveChangesCommand}"
                        Padding="10,4" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="תיקיות פרויקט" FontWeight="Bold" Margin="0,0,0,5"/>
                <TreeView x:Name="FolderTree" Grid.Row="1"
                          ItemsSource="{Binding FolderTree}"
                          BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1"
                          PreviewMouseRightButtonDown="FolderTree_OnPreviewMouseRightButtonDown"
                          SelectedItemChanged="FolderTree_OnSelectedItemChanged"/>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="קבצים" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" — תצוגה:" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource SiSecondaryBrush}"/>
                    <TextBlock Text="{Binding FolderFilterCaption}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    <Button Content="הוסף קובץ" Command="{Binding AddFileCommand}"
                            Margin="10,0,0,0" Padding="8,2"/>
                    <Button Content="מחק נבחר" Command="{Binding DeleteFileCommand}"
                            Margin="5,0,0,0" Padding="8,2" Background="#FFEBEE" Foreground="#D32F2F"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilesView}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          ColumnWidth="*"
                          HorizontalScrollBarVisibility="Auto"
                          BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1"
                          Background="{DynamicResource SiSurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="כותרת" Binding="{Binding Title}" Width="2*" MinWidth="140">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="MaxLength" Value="24"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="תיקייה" Binding="{Binding FolderTitle}" IsReadOnly="True" Width="1.2*" MinWidth="100"/>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="0.5*" MinWidth="40"/>
                        <DataGridComboBoxColumn Header="סיומת"
                                                SelectedItemBinding="{Binding Typefile}"
                                                ItemsSource="{Binding Source={StaticResource FileExtensionsSource}}"
                                                Width="0.8*" MinWidth="70"/>
                        <DataGridCheckBoxColumn Header="Look" Binding="{Binding LookAtDes}" Width="0.5*" MinWidth="50"/>
                        <DataGridCheckBoxColumn Header="Out" Binding="{Binding OutSidData}" Width="0.5*" MinWidth="50"/>
                        <DataGridCheckBoxColumn Header="חובה" Binding="{Binding IsRequired}" Width="0.5*" MinWidth="50"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" IsReadOnly="True" Width="0.9*" MinWidth="80"/>
                        <DataGridComboBoxColumn Header="אחסון"
                                                SelectedItemBinding="{Binding StorageDestination}"
                                                ItemsSource="{x:Static local:FileCatalogFileRowVm.StorageDestinationOptions}"
                                                Width="0.9*" MinWidth="90"/>
                        <DataGridTemplateColumn Header="תבנית" Width="2*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TemplateLocation, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Content="..." Grid.Column="1" Width="28"
                                                Command="{Binding DataContext.BrowseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="תיאור" Binding="{Binding Description}" Width="2.5*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource SiSecondaryBrush}"/>

        <Grid Background="#7F000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
              Grid.RowSpan="3">
            <Border Background="{DynamicResource SiSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20" CornerRadius="6" Width="360"
                    BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding DialogHeader}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <TextBlock Text="שם:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DialogInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="אישור" Command="{Binding ConfirmDialogCommand}"
                                Width="90" Margin="0,0,10,0" Padding="6" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button Content="ביטול" Command="{Binding CancelDialogCommand}" Width="90" Padding="6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
