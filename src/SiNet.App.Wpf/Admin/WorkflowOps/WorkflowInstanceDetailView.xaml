<UserControl x:Class="SiNet.App.Wpf.Admin.WorkflowOps.WorkflowInstanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="16" LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Left"
                    Content="רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="השהה"
                    Command="{Binding PauseCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="חדש"
                    Command="{Binding ResumeCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="סיים"
                    Command="{Binding CompleteCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button DockPanel.Dock="Left"
                    Content="בטל"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource SiTextSmallStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HeaderText}"
                   Style="{DynamicResource SiTextNormalStyle}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ProgressText}"
                   Style="{DynamicResource SiTextSmallStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="קידום ידני"
                           Style="{DynamicResource SiTextSmallStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="שלב יעד:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Style="{DynamicResource SiTextSmallStyle}" />
                    <ComboBox ItemsSource="{Binding NextStages}"
                              SelectedItem="{Binding SelectedNextStage}"
                              DisplayMemberPath="Name"
                              MinWidth="220" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="הערות:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Style="{DynamicResource SiTextSmallStyle}" />
                    <TextBox Text="{Binding AdvanceNotes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="28" />
                </DockPanel>
                <Button Content="קדם"
                        Command="{Binding AdvanceCommand}"
                        Style="{DynamicResource SiPrimaryButtonStyle}"
                        Padding="14,6"
                        HorizontalAlignment="Left" />
            </DockPanel>
        </Border>

        <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="היסטוריית מעברים"
                           Style="{DynamicResource SiTextSmallStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding TransitionsText}"
                               Style="{DynamicResource SiTextSmallStyle}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
