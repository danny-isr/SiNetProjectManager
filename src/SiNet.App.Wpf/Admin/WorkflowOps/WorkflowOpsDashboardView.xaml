<UserControl x:Class="SiNet.App.Wpf.Admin.WorkflowOps.WorkflowOpsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.WorkflowOps"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="16" LastChildFill="True">
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Left"
                    Content="רענון"
                    Command="{Binding RefreshCommand}"
                    Style="{DynamicResource SiPrimaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0" />
            <Button DockPanel.Dock="Left"
                    Content="העתק מזהה"
                    Command="{Binding CopyInstanceIdCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    ToolTip="העתקת Instance Id ללוח" />
            <Button DockPanel.Dock="Left"
                    Content="פתח מופע"
                    Command="{Binding OpenInstanceCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    ToolTip="פירוט מופע + קידום / השהיה / ביטול" />
            <Button DockPanel.Dock="Left"
                    Content="הפעל תהליך"
                    Command="{Binding StartWorkflowCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    ToolTip="הפעלה ידנית לפרויקט + תבנית מותרת" />
            <Button DockPanel.Dock="Left"
                    Content="Retry"
                    Command="{Binding RetryCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    ToolTip="שחזור מופע חשוד כתקוע" />
            <Button DockPanel.Dock="Left"
                    Content="ביטול"
                    Command="{Binding CancelWorkflowCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0"
                    ToolTip="ביטול מופע נבחר" />
            <TextBlock Text="{Binding DangerousActionsHint}"
                       Style="{DynamicResource SiTextSmallStyle}"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <!-- Summary cards -->
        <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="0,0,0,10">
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="מצב כללי" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Text="{Binding OverallStatusText}" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="פעילים" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Text="{Binding ActiveCountText}" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" FontSize="20" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="הושלמו היום" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Text="{Binding CompletedTodayText}" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" FontSize="20" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="בוטלו היום" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Text="{Binding CancelledTodayText}" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" FontSize="20" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="חשודים כתקועים" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Text="{Binding StalledCountText}" Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold" FontSize="20" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="משך ממוצע היום / רענון" Style="{DynamicResource SiTextTinyStyle}" Foreground="{DynamicResource SiSecondaryBrush}" />
                    <TextBlock Style="{DynamicResource SiTextNormalStyle}" FontWeight="SemiBold">
                        <Run Text="{Binding AvgDurationText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastRefreshText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Infra strip -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Left"
                    Content="פתח מצב מערכת"
                    Command="{Binding OpenSystemStatusCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,12,0" />
            <TextBlock Text="{Binding InfraSummaryText}"
                       Style="{DynamicResource SiTextSmallStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <!-- Filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="סטטוס:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{DynamicResource SiTextSmallStyle}" />
            <ComboBox DockPanel.Dock="Left"
                      Width="140"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding StatusFilter}" />
            <TextBlock DockPanel.Dock="Left" Text="תהליך:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{DynamicResource SiTextSmallStyle}" />
            <ComboBox DockPanel.Dock="Left"
                      Width="180"
                      Margin="0,0,12,0"
                      ItemsSource="{Binding WorkflowNameFilterOptions}"
                      SelectedItem="{Binding WorkflowNameFilter}" />
            <TextBlock DockPanel.Dock="Left" Text="חיפוש:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Style="{DynamicResource SiTextSmallStyle}" />
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     MinWidth="180" />
        </DockPanel>

        <!-- Detail panel -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                MinHeight="120"
                MaxHeight="180">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding DetailSummary}"
                           Style="{DynamicResource SiTextSmallStyle}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DetailTransitions}"
                               Style="{DynamicResource SiTextSmallStyle}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Grid -->
        <ListView ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SiSecondaryBrush}"
                  Background="{DynamicResource SiBackgroundBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  MouseDoubleClick="OnRowsMouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" Width="55"
                                    DisplayMemberBinding="{Binding InstanceId}" />
                    <GridViewColumn Header="תהליך" Width="140"
                                    DisplayMemberBinding="{Binding WorkflowName}" />
                    <GridViewColumn Header="פרויקט" Width="160"
                                    DisplayMemberBinding="{Binding ProjectDisplay}" />
                    <GridViewColumn Header="משתמש" Width="110"
                                    DisplayMemberBinding="{Binding UserDisplay}" />
                    <GridViewColumn Header="התחלה" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:WorkflowOpsInstanceRowVm}">
                                <TextBlock Text="{Binding StartedLocal, StringFormat={}{0:dd/MM HH:mm}}"
                                           Style="{DynamicResource SiTextSmallStyle}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="שלב" Width="120"
                                    DisplayMemberBinding="{Binding StageName}" />
                    <GridViewColumn Header="משך" Width="70"
                                    DisplayMemberBinding="{Binding DurationText}" />
                    <GridViewColumn Header="סטטוס" Width="90"
                                    DisplayMemberBinding="{Binding StatusLabel}" />
                    <GridViewColumn Header="תקוע?" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type local:WorkflowOpsInstanceRowVm}">
                                <TextBlock Text="{Binding StalledBadge}"
                                           Style="{DynamicResource SiTextSmallStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="#B45309" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="הערות" Width="160"
                                    DisplayMemberBinding="{Binding Notes}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
