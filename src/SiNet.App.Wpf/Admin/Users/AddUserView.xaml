<UserControl x:Class="SiNet.App.Wpf.Admin.Users.AddUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.Users"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <local:AppAccUserTypeDisplayConverter x:Key="AccUserTypeDisplayConverter"/>
        <local:AppRoleDisplayConverter x:Key="RoleDisplayConverter"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="LoginName:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="שם תצוגה:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="ACC הרשאת:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding AvailableAccUserTypes}"
                  SelectedItem="{Binding SelectedAccUserType}"
                  Margin="0,4">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource AccUserTypeDisplayConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Role:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1"
                  ItemsSource="{Binding AvailableRoles}"
                  SelectedItem="{Binding SelectedRole}"
                  Margin="0,4">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource RoleDisplayConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="MasterPlan:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="5" Grid.Column="1"
                  ItemsSource="{Binding MasterPlanEmployees}"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Name"
                  SelectedValue="{Binding MasterPlanEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="פעיל:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding IsActive}" Margin="0,4"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="הערות:" VerticalAlignment="Top"/>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{Binding ValidationMessage}" Foreground="Red" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="שמור" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="ביטול" Command="{Binding CancelCommand}" Padding="16,4"/>
        </StackPanel>
    </Grid>
</UserControl>
