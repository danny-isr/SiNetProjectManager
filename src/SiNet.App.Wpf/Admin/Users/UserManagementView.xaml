<UserControl x:Class="SiNet.App.Wpf.Admin.Users.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="רענון" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="שמור" Command="{Binding SaveCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="ביטול" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="* יש שינויים שלא נשמרו"
                       Foreground="DarkOrange"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="שם" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="LoginName" Binding="{Binding LoginName}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive}" Width="60"/>
                <DataGridTextColumn Header="MasterPlan ID" Binding="{Binding MasterPlanEmployeeId}" Width="90"/>
                <DataGridTextColumn Header="משימות פתוחות" Binding="{Binding OpenTaskCount}" Width="90"/>
                <DataGridCheckBoxColumn Header="שונה" Binding="{Binding IsDirty}" Width="60" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" BorderBrush="LightGray" BorderThickness="1"
                DataContext="{Binding SelectedUser}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="שם תצוגה:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="LoginName:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Role:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{Binding DataContext.AvailableRoles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="פעיל:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding IsActive}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="MasterPlan ID:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="3"
                         Text="{Binding MasterPlanEmployeeId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="הערות:" VerticalAlignment="Top"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="Gray"
                   Text="בחר משתמש לעריכה. הגנות self-protection (ביטול Admin / deactivate / LoginName) פעילות רק כש-host מחובר ל-ICurrentUserContext."/>
    </Grid>
</UserControl>
