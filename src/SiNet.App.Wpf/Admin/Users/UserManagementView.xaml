<UserControl x:Class="SiNet.App.Wpf.Admin.Users.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.Users"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:AppAccUserTypeDisplayConverter x:Key="AccUserTypeDisplayConverter"/>
        <local:AppRoleDisplayConverter x:Key="RoleDisplayConverter"/>
    </UserControl.Resources>
    <Grid Margin="12" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="0"/>
            <RowDefinition Height="Auto" MaxHeight="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="רענון" Command="{Binding RefreshCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="שמור" Command="{Binding SaveCommand}" Style="{DynamicResource SiPrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="ביטול" Command="{Binding CancelCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{DynamicResource SiTextSmallStyle}"
                       Text="* יש שינויים שלא נשמרו"
                       Foreground="DarkOrange"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="חיפוש:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="260"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredUsers}"
                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  VerticalAlignment="Stretch"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="None"
                  Background="{DynamicResource SiBackgroundBrush}"
                  AlternatingRowBackground="{x:Null}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="#F1FAF1"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                <Condition Binding="{Binding IsAdministrator}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#F1F6FF"/>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Background" Value="#FFF1F1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive, Mode=OneWay}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="שם" Binding="{Binding DisplayName, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="דוא״ל" Binding="{Binding Email, Mode=OneWay}" Width="160"/>
                <DataGridTextColumn Header="LoginName" Binding="{Binding LoginName, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="ACC הרשאת" Binding="{Binding AccUserTypeDisplay, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="תפקיד" Binding="{Binding RoleDisplay, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="עובד MasterPlan" Binding="{Binding MasterPlanEmployeeName, Mode=OneWay}" Width="160"/>
                <DataGridTextColumn Header="משימות פתוחות" Binding="{Binding OpenTaskCount, Mode=OneWay}" Width="90"/>
                <DataGridTemplateColumn Header="לא נשמר" Width="72" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="שינוי מקומי שלא נשמר"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsDirty, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      ToolTip="שינוי מקומי שלא נשמר"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" BorderBrush="LightGray" BorderThickness="1"
                DataContext="{Binding SelectedUser}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="שם תצוגה:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="LoginName:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ACC הרשאת:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{Binding DataContext.AvailableAccUserTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding AccUserType, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource AccUserTypeDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="תפקיד:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding DataContext.AvailableRoles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,4,8,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RoleDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="פעיל:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding IsActive}" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="MasterPlan:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                          ItemsSource="{Binding DataContext.MasterPlanEmployees, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding MasterPlanEmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="הערות:" VerticalAlignment="Top"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="Gray"
                   Text="בחר משתמש לעריכה. MasterPlan employees נטענים מ-ReplicaDatabase + MasterPlanDatabase (דרך host connection provider)."/>
    </Grid>
</UserControl>
