<UserControl x:Class="SiNet.App.Wpf.Admin.Permissions.ActionPermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="רענון" Command="{Binding RefreshCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="שמור" Command="{Binding SaveCommand}" Style="{DynamicResource SiPrimaryButtonStyle}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                       Style="{DynamicResource SiTextSmallStyle}"
                       Text="* יש שינויים שלא נשמרו"
                       Foreground="DarkOrange"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="סוגי פעולה" Grid.Column="0" Margin="0,0,8,0">
                <ListBox ItemsSource="{Binding Actions}"
                         SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName"/>
            </GroupBox>

            <GroupBox Grid.Column="1">
                <GroupBox.Header>
                    <TextBlock>
                        <Run Text="מורשים ל: "/>
                        <Run Text="{Binding SelectedAction.DisplayName, Mode=OneWay}"/>
                    </TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Margin="0,0,0,8"
                             Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="חיפוש לפי שם או אימייל"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredUserRows}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsAuthorized, Mode=TwoWay}"
                                          Checked="UserCheckBox_Changed"
                                          Unchecked="UserCheckBox_Changed"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="Gray"
                   Text="סמן משתמשים מורשים לכל פעולה ולחץ שמור."/>
    </Grid>
</UserControl>
