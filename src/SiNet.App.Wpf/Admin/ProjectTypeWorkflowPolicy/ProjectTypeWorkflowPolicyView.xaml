<UserControl x:Class="SiNet.App.Wpf.Admin.ProjectTypeWorkflowPolicy.ProjectTypeWorkflowPolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiWindowBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10" Padding="8"
                BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource SiSurfaceBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="רענון" Command="{Binding RefreshCommand}"
                        Padding="12,4" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding UnmappedSummary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="סוג פרויקט (JobType)" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding JobTypes}"
                         SelectedItem="{Binding SelectedJobType}"
                         DisplayMemberPath="Title"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="מיפויי תהליך לסוג הנבחר" FontWeight="Bold" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding Mappings}"
                          SelectedItem="{Binding SelectedMapping}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="תהליך" Binding="{Binding DisplayWorkflow}" Width="*"/>
                        <DataGridTextColumn Header="ברירת מחדל" Binding="{Binding DefaultLabel}" Width="90"/>
                        <DataGridTextColumn Header="מצב" Binding="{Binding EnabledLabel}" Width="70"/>
                        <DataGridTextColumn Header="סדר" Binding="{Binding SortOrder}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8"
                Background="{DynamicResource SiSurfaceBrush}"
                BorderBrush="{DynamicResource SiBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="הוסף / עדכן מיפוי:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ActiveWorkflowDefinitions}"
                              SelectedItem="{Binding SelectedDefinitionToAdd}"
                              DisplayMemberPath="Name"
                              Width="260" Margin="0,0,8,0"/>
                    <CheckBox Content="ברירת מחדל" IsChecked="{Binding AddAsDefault}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="סדר:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding AddSortOrder, UpdateSourceTrigger=PropertyChanged}"
                             Width="48" Margin="0,0,8,0"/>
                    <Button Content="שמור מיפוי" Command="{Binding AddMappingCommand}" Padding="10,4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="הגדר ברירת מחדל" Command="{Binding SetDefaultCommand}"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="הפעל / כבה" Command="{Binding ToggleEnabledCommand}"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="מחק" Command="{Binding DeleteMappingCommand}" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SiMutedForegroundBrush}"/>
    </Grid>
</UserControl>
