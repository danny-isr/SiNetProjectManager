<UserControl x:Class="SiNet.App.Wpf.Admin.Diagnostics.WorkstationCrashReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.Diagnostics"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SiBackgroundBrush}">
    <DockPanel Margin="16" LastChildFill="True">

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   Style="{DynamicResource SiTextSmallStyle}"
                   Foreground="{DynamicResource SiSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="למה אתה מפיק את הדוח?"
                       Style="{DynamicResource SiTextMediumStyle}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Display"
                          MinWidth="220" />

                <TextBlock Grid.Column="1"
                           Text="מתי אירע לאחרונה (רשות)"
                           Style="{DynamicResource SiTextSmallStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,8,0" />

                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding LastOccurrenceDate}"
                            MinWidth="130" />

                <TextBox Grid.Column="3"
                         Text="{Binding LastOccurrenceTime, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="70"
                         Margin="8,0,0,0"
                         ToolTip="שעה בפורמט HH:mm" />

                <TextBlock Grid.Column="4"
                           Text="HH:mm"
                           Style="{DynamicResource SiTextTinyStyle}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </Grid>

            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{Binding DescriptionMaxLengthValue, Mode=OneTime}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="64"
                     MaxHeight="120" />
            <TextBlock Text="מה קרה, מתי זה התחיל, מה עשית כשזה קרה, והאם זה חוזר על עצמו. בלי ההסבר הזה הניתוח נשאר ניחוש."
                       Style="{DynamicResource SiTextTinyStyle}"
                       Foreground="{DynamicResource SiSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="טווח (ימים)"
                       Style="{DynamicResource SiTextSmallStyle}"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding LookbackDays, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="50"
                     Margin="8,0,16,0" />

            <TextBlock Grid.Column="2"
                       Text="מיקוד"
                       Style="{DynamicResource SiTextSmallStyle}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding Scopes}"
                      SelectedValue="{Binding Scope}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Display"
                      MinWidth="150"
                      Margin="8,0,16,0" />

            <TextBlock Grid.Column="4"
                       Text="אפליקציות"
                       Style="{DynamicResource SiTextSmallStyle}"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="5"
                     Text="{Binding AppFilters, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="220"
                     Margin="8,0,16,0" />

            <TextBox Grid.Column="6"
                     Text="{Binding MaxEvents, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left"
                     MinWidth="70"
                     ToolTip="תקרת אירועים" />
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="הפק דוח"
                    Command="{Binding GenerateCommand}"
                    Style="{DynamicResource SiPrimaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
            <Button Content="בטל"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
            <Button Content="ייצוא CSV"
                    Command="{Binding ExportCsvCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
            <Button Content="ייצוא לניתוח AI"
                    Command="{Binding ExportMarkdownCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
            <Button Content="שמור לתיקייה משותפת"
                    Command="{Binding SaveToShareCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
            <Button Content="פתח תיקייה"
                    Command="{Binding OpenFolderCommand}"
                    Style="{DynamicResource SiSecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,8" />
        </WrapPanel>

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SiSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Summary}"
                           Style="{DynamicResource SiTextNormalStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding MachineSummary}"
                           Style="{DynamicResource SiTextSmallStyle}"
                           Foreground="{DynamicResource SiSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Events}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource SiBackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="זמן" Binding="{Binding Time}" Width="150" />
                <DataGridTextColumn Header="יומן" Binding="{Binding Log}" Width="90" />
                <DataGridTextColumn Header="חומרה" Binding="{Binding Severity}" Width="100" />
                <DataGridTextColumn Header="מזהה" Binding="{Binding EventId}" Width="60" />
                <DataGridTextColumn Header="ספק" Binding="{Binding Provider}" Width="160" />
                <DataGridTextColumn Header="אפליקציה" Binding="{Binding AppName}" Width="140" />
                <DataGridTextColumn Header="מודול" Binding="{Binding ModuleName}" Width="160" />
                <DataGridTextColumn Header="קוד חריגה" Binding="{Binding ExceptionCode}" Width="110" />
                <DataGridTextColumn Header="מקושר ל" Binding="{Binding CorrelatedWith}" Width="200" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type local:CrashEventRowViewModel}">
                    <TextBlock Text="{Binding Message}"
                               Style="{DynamicResource SiTextTinyStyle}"
                               TextWrapping="Wrap"
                               Margin="12,4,12,8" />
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </DockPanel>
</UserControl>
