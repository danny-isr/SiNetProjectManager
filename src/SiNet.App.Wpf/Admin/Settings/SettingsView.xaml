<UserControl x:Class="SiNet.App.Wpf.Admin.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:autodesk="clr-namespace:SiNet.App.Wpf.Autodesk"
             xmlns:theme="clr-namespace:SiNet.App.Wpf.Theme"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <theme:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>
    <Grid Margin="12" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="{DynamicResource SiBackgroundBrush}">
            <!-- Per-user -->
            <TabItem Header="מראה (משתמש)" Visibility="{Binding CanViewPersonalSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditPersonalSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel MaxWidth="720">
                        <TextBlock Text="הגדרות מקומיות — settings.json" Style="{DynamicResource SiTextSmallStyle}" Opacity="0.7" Margin="0,0,0,12"/>
                        <TextBlock Text="פונט" Style="{DynamicResource SiTextNormalStyle}"/>
                        <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding FontFamily}"
                                  Style="{DynamicResource SiComboBoxStyle}" Margin="0,4,0,12"/>
                        <TextBlock Text="גודל פונט בסיס (Normal = 1.00×)" Style="{DynamicResource SiTextNormalStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Slider Minimum="8" Maximum="32" Value="{Binding BaseFontSize}" Width="220"/>
                            <TextBlock Text="{Binding BaseFontSize}" Style="{DynamicResource SiTextNormalStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="מכפילי גודל טקסט" Style="{DynamicResource SiTextMediumStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tiny" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.60" Maximum="0.95" Value="{Binding TextTinyScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TextTinyScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Small" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.70" Maximum="1.00" Value="{Binding TextSmallScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TextSmallScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Normal" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0.90" Maximum="1.10" Value="{Binding TextNormalScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TextNormalScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Medium" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="1.05" Maximum="1.35" Value="{Binding TextMediumScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TextMediumScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Large" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="4" Grid.Column="1" Minimum="1.30" Maximum="1.80" Value="{Binding TextLargeScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TextLargeScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Huge" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                            <Slider Grid.Row="5" Grid.Column="1" Minimum="1.60" Maximum="2.40" Value="{Binding TextHugeScale}" Margin="8,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding TextHugeScale, StringFormat={}{0:0.00}}" Style="{DynamicResource SiTextSmallStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <theme:ThemeColorEditor Label="צבע ראשי" ColorHex="{Binding PrimaryColor, UpdateSourceTrigger=PropertyChanged}"
                                                DefaultColorHex="{Binding DefaultPrimaryColor}"/>
                        <theme:ThemeColorEditor Label="צבע משני" ColorHex="{Binding SecondaryColor, UpdateSourceTrigger=PropertyChanged}"
                                                DefaultColorHex="{Binding DefaultSecondaryColor}"/>
                        <theme:ThemeColorEditor Label="צבע טקסט" ColorHex="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                DefaultColorHex="{Binding DefaultForegroundColor}"/>
                        <theme:ThemeColorEditor Label="צבע רקע" ColorHex="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                DefaultColorHex="{Binding DefaultBackgroundColor}"/>

                        <TextBlock Text="תצוגה מקדימה" Style="{DynamicResource SiTextMediumStyle}" Margin="0,12,0,8"/>
                        <Border BorderBrush="{DynamicResource SiSecondaryBrush}" BorderThickness="1" Padding="12" CornerRadius="4"
                                Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}">
                            <StackPanel>
                                <TextBlock Text="כותרת גדולה (Large)" FontFamily="{Binding FontFamily}"
                                           FontSize="{Binding PreviewLargeFontSize}"
                                           Foreground="{Binding PrimaryColor, Converter={StaticResource HexToBrush}}" FontWeight="SemiBold"/>
                                <TextBlock Text="טקסט רגיל (Normal)" FontFamily="{Binding FontFamily}"
                                           FontSize="{Binding PreviewNormalFontSize}"
                                           Foreground="{Binding ForegroundColor, Converter={StaticResource HexToBrush}}" Margin="0,8,0,0"/>
                                <TextBlock Text="טקסט קטן (Small)" FontFamily="{Binding FontFamily}"
                                           FontSize="{Binding PreviewSmallFontSize}"
                                           Foreground="{Binding SecondaryColor, Converter={StaticResource HexToBrush}}" Margin="0,4,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="כפתור ראשי" FontFamily="{Binding FontFamily}"
                                            FontSize="{Binding PreviewNormalFontSize}"
                                            Background="{Binding PrimaryColor, Converter={StaticResource HexToBrush}}" Foreground="White"
                                            Padding="12,6" Margin="0,0,8,0" BorderThickness="0"/>
                                    <Button Content="כפתור משני" FontFamily="{Binding FontFamily}"
                                            FontSize="{Binding PreviewNormalFontSize}"
                                            Foreground="{Binding ForegroundColor, Converter={StaticResource HexToBrush}}"
                                            Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{Binding SecondaryColor, Converter={StaticResource HexToBrush}}" BorderThickness="1"
                                            Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="שינויי מראה מוחלים מיד על כל החלונות. שמירה כותבת ל-JSON; ביטול או סגירה מחזירים לערך לפני פתיחת ההגדרות." Style="{DynamicResource SiTextSmallStyle}" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="התנהגות (משתמש)" Visibility="{Binding CanViewPersonalSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditPersonalSettings}">
                <StackPanel Margin="12" MaxWidth="640">
                    <CheckBox Content="אפשר מספר מופעים (Multiple Instances)" IsChecked="{Binding AllowMultipleInstances}" Margin="0,0,0,8"
                              FontFamily="{DynamicResource SiFontFamily}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBlock Text="דורש restart" Opacity="0.6" Margin="0,0,0,16"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    <CheckBox Content="Authorization test mode (DEBUG)" IsChecked="{Binding EnableAuthorizationTestMode}" Margin="0,0,0,8"
                              FontFamily="{DynamicResource SiFontFamily}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBlock Text="ללא UI ב-legacy — נשמר ב-JSON בלבד; דורש restart" Opacity="0.6" TextWrapping="Wrap"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="לוג מקומי (משתמש)" Visibility="{Binding CanViewPersonalSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditPersonalSettings}">
                <StackPanel Margin="12" MaxWidth="640">
                    <CheckBox Content="הפעל רישום לוג לקובץ" IsChecked="{Binding LoggingEnabled}" Margin="0,0,0,12"
                              FontFamily="{DynamicResource SiFontFamily}"
                              FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBlock Text="מוחל מיד דרך ILoggingRuntimeApplier" Opacity="0.6" Margin="0,0,0,12"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    <TextBlock Text="תיקיית לוג"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LogDirectoryDisplay, Mode=OneWay}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="בחר..." Command="{Binding BrowseLogDirectoryCommand}" Margin="8,0,0,0" Padding="8,4"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="חלונות צפים (משתמש)" Visibility="{Binding CanViewPersonalSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditPersonalSettings}">
                <StackPanel Margin="12" MaxWidth="640">
                    <TextBlock Text="שקיפות פעילה"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding FloatingActiveOpacity}" Margin="0,4,0,12"/>
                    <TextBlock Text="שקיפות רקע"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding FloatingIdleOpacity}" Margin="0,4,0,12"/>
                    <TextBlock Text="גיאומטריה נשמרת אוטומטית ב-legacy — לא נערך כאן." Opacity="0.6" TextWrapping="Wrap"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="צבעי סטטוס (משתמש)" Visibility="{Binding CanViewPersonalSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditPersonalSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding UserStatusColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <theme:ThemeColorEditor Label="{Binding StatusName}"
                                                              ColorHex="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                                                              DefaultColorHex="{Binding DefaultColorHex}"/>
                                    <Button Grid.Column="1" Content="שמור" Command="{Binding SaveOverrideCommand}" Padding="8,4" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="איפוס" Command="{Binding ResetCommand}" Padding="8,4" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Global / admin -->
            <TabItem Header="משרד / דוא&quot;ל (גלובלי)" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="{Binding RestartRequiredHint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"/>
                        <TextBlock Text="פרויקט ברירת מחדל לדוא&quot;ל"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding DefaultProjectTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="מספר פרויקט ניהול משרד"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding OfficeManagementProjectId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="מחיר שעה (ברירת מחדל)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding HourPriceDefault, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="תיקיית Inbox ב-ACC"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding InboxFolderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="שם פרויקט Inbox (נגזר / stored)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding InboxProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="מגבלת טאבים ACC"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding AccViewerMaxTabs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                        <TextBlock Text="מכסת מופעי תת-תהליך פתוחים במקביל (למשל קליטת חומר)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding WorkflowMaxOpenChildInstances, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                        <TextBlock Text="ברירת מחדל: 2. לא ניתן לפתוח מופע נוסף מעבר למכסה לפני הכרעה/סיום של מופע קיים."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ACC (גלובלי)" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel Margin="12" MaxWidth="640">
                    <TextBlock Text="AccService Base URL"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding AccServiceBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="Pinned Certificate Thumbprints (מופרד ב-; )"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding AccServicePinnedCertificateThumbprints, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                    <TextBlock Text="Thumbprint של תעודת AccService (self-signed). מועתק מ-Secret Setup → Test או מלוג ההפעלה של השירות. לא סוד."
                               Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    <autodesk:AccControlPlaneStatusView Margin="0,0,0,12"
                                                         HintText="{Binding AccServiceRuntimeHint}"
                                                         ModeSummary="{Binding AccServiceRuntimeModeSummary}"
                                                         KeySummary="{Binding AccServiceRuntimeKeySummary}"
                                                         ProjectsSummary="{Binding AccServiceRuntimeProjectsSummary}"
                                                         HealthSummary="{Binding AccServiceRuntimeHealthSummary}"
                                                         DiagnosticsSummary="{Binding AccServiceRuntimeDiagnosticsSummary}"/>
                    <Border BorderBrush="{DynamicResource SiSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="בדיקת resolve חיה של פריט ACC (runtime בלבד)"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource SiFontFamily}"
                                       FontSize="{DynamicResource SiTextMediumFontSize}"/>
                            <TextBlock Text="בדיקה זו משתמשת ב-runtime הנוכחי של ההוסט בלבד. היא לא קוראת מה-Base URL שנערך למעלה עד שלא נשמר ומאותחל מחדש."
                                       Margin="0,6,0,0"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource SiFontFamily}"
                                       FontSize="{DynamicResource SiTextTinyFontSize}"/>
                            <autodesk:AccReadOnlyDocumentBrowserView DataContext="{Binding AccBrowser}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Bootstrap Admin Email"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding AccBootstrapAdminEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="שם תבנית פרויקט ACC (stored — ללא refresh מ-ACC)"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding AccProjectTemplateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="סיומות העלאה ידנית"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding AccManualUploadAllowedExtensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="סיומות / קידומות להסתרה בעץ עבודה"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding ProjectWorkScanExclusionRules, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                    <TextBlock Text="מופרד בפסיקים. סיומת מתחילה בנקודה (למשל .bak); קידומת שם בלי נקודה (למשל ~$). קבצי *.si.json תמיד מוסתרים."
                               Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    <Button Content="פתח ניהול קבוצות"
                            Command="{Binding OpenUserGroupsCommand}"
                            Style="{DynamicResource SiPrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            Margin="0,4,0,12"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ביקורת / Drive (גלובלי)" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <StackPanel Margin="12" MaxWidth="640">
                    <TextBlock Text="תיקיית תבניות ביקורת (Folder ID)"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding InspectionTemplatesFolderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="תיקיית דוחות ביקורת (Folder ID)"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding InspectionReportsFolderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="Reports output root (ללא UI ב-legacy)"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding ReportsOutputRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                    <TextBlock Text="נתיב תבנית חותמת"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding StampTemplatePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="תוויות סטטוס ביקורת" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <StackPanel Margin="12" MaxWidth="640">
                    <TextBlock Text="מקובל"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding StatusLabelPassed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    <TextBlock Text="הערה"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding StatusLabelFailed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    <TextBlock Text="הערה חוזרת"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding StatusLabelRecurringFailed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    <TextBlock Text="לא רלוונטי"
                               FontFamily="{DynamicResource SiFontFamily}"
                               FontSize="{DynamicResource SiTextSmallFontSize}"/>
                    <TextBox Text="{Binding StatusLabelNotApplicable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="AI (גלובלי)" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="Ollama URL"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                        <TextBlock Text="Ollama Model"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                        <TextBlock Text="Simple — model / provider"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiModelSimple, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding AiProviderSimple, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        </StackPanel>
                        <TextBlock Text="QualityCheck"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiModelQualityCheck, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding AiProviderQualityCheck, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        </StackPanel>
                        <TextBlock Text="Writing"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiModelWriting, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding AiProviderWriting, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        </StackPanel>
                        <TextBlock Text="DeepAnalysis"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiModelDeepAnalysis, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding AiProviderDeepAnalysis, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        </StackPanel>
                        <TextBlock Text="Configured cloud models CSV"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding AiConfiguredCloudModelsCsv, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" Margin="0,4,0,8"/>
                        <TextBlock Text="AiModelCatalogWindow — deferred; CSV נשמר כאן." Opacity="0.6" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="לוג מרכזי (גלובלי)" Visibility="{Binding CanViewSystemSettings, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditSystemSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="{Binding CentralLoggingRestartHint}" Foreground="#B71C1C" TextWrapping="Wrap" Margin="0,0,0,12"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextTinyFontSize}"/>
                        <TextBlock Text="נתיב לוג מרכזי (UNC)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CentralLogPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="בדוק כתיבה" Command="{Binding ProbeCentralLogPathCommand}" Margin="8,0,0,0" Padding="8,4"/>
                        </Grid>
                        <TextBlock Text="שמירה מקומית (ימים)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding LocalRetentionDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                        <TextBlock Text="שמירה מרכזית (ימים)"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <TextBox Text="{Binding CentralRetentionDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                        <TextBlock Text="Client — קובץ מקומי"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding ClientFileLevel}" Margin="0,4,0,8"/>
                        <TextBlock Text="Client — מרכזי"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding ClientCentralLevel}" Margin="0,4,0,8"/>
                        <TextBlock Text="AccService — מקומי / מרכזי"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding AccServiceFileLevel}" Width="160" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding AccServiceCentralLevel}" Width="160"/>
                        </StackPanel>
                        <TextBlock Text="SyncEngine — מקומי / מרכזי"
                                   FontFamily="{DynamicResource SiFontFamily}"
                                   FontSize="{DynamicResource SiTextSmallFontSize}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SyncEngineFileLevel}" Width="160" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SyncEngineCentralLevel}" Width="160"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="צבעי סטטוס (גלובלי)" Visibility="{Binding CanViewGlobalStatusColors, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditGlobalStatusColors}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl ItemsSource="{Binding GlobalStatusColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <theme:ThemeColorEditor Label="{Binding StatusName}"
                                                              ColorHex="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                                                              DefaultColorHex="{Binding DefaultColorHex}"/>
                                    <Button Grid.Column="1" Content="שמור" Command="{Binding SaveCommand}" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding SummaryMessage}" Margin="0,12,0,8" TextWrapping="Wrap"
                   FontFamily="{DynamicResource SiFontFamily}"
                   FontSize="{DynamicResource SiTextSmallFontSize}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="שמור" Command="{Binding SaveCommand}" Style="{DynamicResource SiPrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="טען מחדש" Command="{Binding ReloadCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="ביטול" Command="{Binding CancelCommand}" Style="{DynamicResource SiSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
