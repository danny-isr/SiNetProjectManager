<Window x:Class="SiNet.App.Wpf.Admin.Security.ProvisioningPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="סיסמת חבילת הגדרות"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="{DynamicResource SiBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="הזן סיסמה לחבילת ההגדרות"
                   FontWeight="SemiBold"
                   FontFamily="{DynamicResource SiFontFamily}"
                   FontSize="{DynamicResource SiTextMediumFontSize}"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="הסיסמה משמשת להצפנת/פענוח כל המפתחות בקובץ .secrets (AES-256)."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   FontFamily="{DynamicResource SiFontFamily}"
                   FontSize="{DynamicResource SiTextTinyFontSize}"/>

        <DockPanel Grid.Row="2">
            <TextBlock Text="סיסמה:" Width="70" VerticalAlignment="Center"
                       FontFamily="{DynamicResource SiFontFamily}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"/>
            <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight" Margin="8,0,0,0"/>
        </DockPanel>

        <DockPanel Grid.Row="3" x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="אימות:" Width="70" VerticalAlignment="Center"
                       FontFamily="{DynamicResource SiFontFamily}"
                       FontSize="{DynamicResource SiTextSmallFontSize}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" FlowDirection="LeftToRight" Margin="8,0,0,0"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="אישור" Width="90" IsDefault="True" Click="OnOkClick" Margin="0,0,8,0"/>
            <Button Content="ביטול" Width="90" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
