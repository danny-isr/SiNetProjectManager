<UserControl x:Class="SiNet.App.Wpf.Admin.Security.SecretSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNet.App.Wpf.Admin.Security"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:SecretStatusBrushConverter x:Key="StatusBrushConverter"/>
    </UserControl.Resources>
    <Grid Margin="16" Background="{DynamicResource SiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SecretRowViewModel}">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding StatusLevel, Converter={StaticResource StatusBrushConverter}}"
                                     ToolTip="{Binding StatusToolTip}"/>

                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="8,0,8,0"/>

                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="{Binding IsMultiline}"
                                         TextWrapping="Wrap">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="MinHeight" Value="24"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                    <Setter Property="MinHeight" Value="48"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsJsonFile}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <PasswordBox local:PasswordBoxBinding.BoundPassword="{Binding PasswordValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>

                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJsonFile}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Left" Content="Browse..."
                                            Command="{Binding DataContext.BrowseGoogleCredentialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,2" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding JsonFileLabel, Mode=OneWay}" IsReadOnly="True"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccServiceApiKey}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="Generate"
                                            Command="{Binding DataContext.GenerateAccServiceKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,2" Margin="0,0,8,0"/>
                                    <Button Content="Test"
                                            Command="{Binding DataContext.TestAccServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding SummaryMessage}" TextWrapping="Wrap"
                   Style="{DynamicResource SiTextSmallStyle}"
                   Margin="0,12,0,0" Foreground="{DynamicResource SiSecondaryBrush}"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="שמור ובדוק" Command="{Binding SaveCommand}" Style="{DynamicResource SiPrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="רענון" Command="{Binding RefreshCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Export secrets" Command="{Binding ExportCommand}" Style="{DynamicResource SiSecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Import secrets" Command="{Binding ImportCommand}" Style="{DynamicResource SiSecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
