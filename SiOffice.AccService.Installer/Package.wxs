<?xml version="1.0" encoding="UTF-8"?>
<!--
  SiOffice ACC Service installer MSI.

  Scope:
    - Install all files under C:\AccService from $(var.PublishDir)
    - Register the Windows service 'SiOfficeAccService' under either LocalSystem
      (default) or a named Windows account passed in at install time
    - Stop / Start the service on upgrade
    - Open inbound TCP firewall rule on the configured HTTPS port (default 8443)
    - Support side-by-side major upgrades (older MSI auto-uninstalled)

  Install — default (LocalSystem):
    msiexec /i SiOfficeAccService.msi /qb /l*v install.log

  Install — under a specific Windows account (so the service can read secrets
  from that user's Credential Manager vault):
    msiexec /i SiOfficeAccService.msi ^
            SERVICEACCOUNT="DOMAIN\User" SERVICEPASSWORD="P@ssw0rd" ^
            /qb /l*v install.log

  Notes on service account:
    - The account MUST already have the 'Log on as a service' right
      (secpol.msc → Local Policies → User Rights Assignment → Log on as a service).
    - When SERVICEACCOUNT is omitted (or empty), the service is installed as
      LocalSystem just like before, preserving backward-compatible behavior.
    - SERVICEPASSWORD is required by Windows for any non-system account.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package
      Name="SiOffice ACC Service"
      Manufacturer="SiOffice"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C2A1F08-4D5E-4B9A-8E6F-9D1C2A3B4C5D"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="SiOffice ACC Service installer" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize"
        AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Service-account MSI properties. Both default to empty; when SERVICEACCOUNT
      is empty we resolve to LocalSystem at install time. Marked Secure="yes" so
      they survive the elevation barrier (UAC) in managed MSI installs.
      SERVICEPASSWORD is also Hidden so it does not appear in MSI logs.
    -->
    <Property Id="SERVICEACCOUNT" Secure="yes" />
    <Property Id="SERVICEPASSWORD" Secure="yes" Hidden="yes" />

    <!--
      RESOLVEDSERVICEACCOUNT: SERVICEACCOUNT if non-empty, otherwise "LocalSystem".
      Implemented with two SetProperty actions because MSI has no inline
      conditional expression on the ServiceInstall element itself.
    -->
    <Property Id="RESOLVEDSERVICEACCOUNT" Value="LocalSystem" Secure="yes" />
    <SetProperty Id="RESOLVEDSERVICEACCOUNT"
                 Value="[SERVICEACCOUNT]"
                 After="AppSearch"
                 Condition="SERVICEACCOUNT AND SERVICEACCOUNT &lt;&gt; &quot;&quot;" />

    <!--
      Force install dir to C:\AccService regardless of MSI defaults.
      INSTALLFOLDER is authored under ProgramFiles64Folder so WiX can generate
      stable per-component GUIDs (auto-GUID requires a "standard" directory
      ancestor); SetDirectory below redirects the runtime path to C:\AccService.
    -->
    <SetDirectory Id="INSTALLFOLDER" Value="C:\AccService" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AccService" />
    </StandardDirectory>

    <Feature Id="Main" Title="ACC Service" Level="1">
      <ComponentGroupRef Id="ServiceHostGroup" />
      <Files Include="$(var.SharedDir)\**"
             Directory="INSTALLFOLDER" />
    </Feature>

    <!--
      Component that hosts the service binary, registers the Windows service,
      controls its lifecycle, and opens the firewall port.
    -->
    <ComponentGroup Id="ServiceHostGroup" Directory="INSTALLFOLDER">
      <Component Id="AccServiceHost"
                 Guid="D4F2C8A1-6B3E-4F9C-AE7D-2C5B8E1F0A3D">

        <File Id="AccServiceExe"
              Source="$(var.PublishDir)\SiOffice.AccService.exe"
              KeyPath="yes" />

        <ServiceInstall Id="InstallAccService"
                        Name="SiOfficeAccService"
                        DisplayName="SiOffice ACC Service"
                        Description="SiOffice privileged ACC operations service. Listens on HTTPS for the SiOffice WPF client."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="[RESOLVEDSERVICEACCOUNT]"
                        Password="[SERVICEPASSWORD]"
                        Vital="yes" />

        <!-- Stop on install (before file copy) AND on uninstall -->
        <ServiceControl Id="StopAccService"
                        Name="SiOfficeAccService"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Start after install completes -->
        <ServiceControl Id="StartAccService"
                        Name="SiOfficeAccService"
                        Start="install"
                        Wait="yes" />

        <!-- Inbound firewall rule for the HTTPS listener (default 8443). -->
        <fw:FirewallException Id="AccServiceHttpsIn"
                              Name="SiOffice ACC Service (HTTPS 8443)"
                              Description="Allow inbound HTTPS to SiOffice ACC Service"
                              Port="8443"
                              Protocol="tcp"
                              Scope="any"
                              Profile="all"
                              IgnoreFailure="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>

