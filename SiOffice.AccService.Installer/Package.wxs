<?xml version="1.0" encoding="UTF-8"?>
<!--
  SiOffice ACC Service updater MSI.

  Scope:
    - Stop the existing Windows service 'SiOfficeAccService'
    - Replace files under C:\AccService with the contents of $(var.PublishDir)
    - Start the service again
    - Support side-by-side major upgrades (older MSI auto-uninstalled)

  This MSI INTENTIONALLY does NOT install or configure the service itself
  (no ServiceInstall element). The service is provisioned once on the server
  with sc.exe (see SiOffice.AccService\README.md), keeping its
  DisplayName / Description / Recovery / ACL settings unchanged across upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="SiOffice ACC Service"
      Manufacturer="SiOffice"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C2A1F08-4D5E-4B9A-8E6F-9D1C2A3B4C5D"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <SummaryInformation Description="SiOffice ACC Service updater" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize"
        AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Refuse to install if the Windows service has not been bootstrapped.
      Without this guard a clean machine would silently get only files
      and no service - very confusing in production.
    -->
    <Property Id="ACCSERVICE_INSTALLED">
      <RegistrySearch Id="AccSvcImagePath"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\SiOfficeAccService"
                      Name="ImagePath"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR ACCSERVICE_INSTALLED"
            Message="The Windows service 'SiOfficeAccService' is not installed on this machine. Run the initial bootstrap (sc.exe create ...) from the SiOffice.AccService README before using this updater." />

    <!--
      Force install dir to C:\AccService regardless of MSI defaults.
      INSTALLFOLDER is authored under ProgramFiles64Folder so WiX can generate
      stable per-component GUIDs (auto-GUID requires a "standard" directory
      ancestor); SetDirectory below redirects the runtime path to C:\AccService.
    -->
    <SetDirectory Id="INSTALLFOLDER" Value="C:\AccService" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AccService" />
    </StandardDirectory>

    <Feature Id="Main" Title="ACC Service" Level="1">
      <ComponentGroupRef Id="ServiceControlGroup" />
      <Files Include="$(var.PublishDir)\**"
             Directory="INSTALLFOLDER" />
    </Feature>

    <!--
      Single component that owns the Stop/Start ServiceControl rows.
      KeyPath is a benign HKLM registry value so the component stays
      installable even though it has no payload files of its own.
    -->
    <ComponentGroup Id="ServiceControlGroup" Directory="INSTALLFOLDER">
      <Component Id="AccServiceController"
                 Guid="D4F2C8A1-6B3E-4F9C-AE7D-2C5B8E1F0A3D">
        <RegistryValue Root="HKLM"
                       Key="Software\SiOffice\AccService\Installer"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />

        <!-- Stop on install (before file copy) AND on uninstall -->
        <ServiceControl Id="StopAccService"
                        Name="SiOfficeAccService"
                        Stop="both"
                        Wait="yes" />

        <!-- Start on install (after file copy); never auto-start on uninstall -->
        <ServiceControl Id="StartAccService"
                        Name="SiOfficeAccService"
                        Start="install"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
