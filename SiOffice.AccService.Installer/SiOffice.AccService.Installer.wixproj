<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>SiOfficeAccService</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!--
      The MSI is built from a published folder produced by publish-service.ps1.
      Override on the command line with -p:PublishDir=...
    -->
    <PublishDir Condition="'$(PublishDir)' == ''">D:\AccService_Publish</PublishDir>
    <SharedDir Condition="'$(SharedDir)' == ''">$(PublishDir)</SharedDir>

    <!--
      Product version flows in from publish-service.ps1 (read from the
      AccService csproj). Default keeps Visual Studio "Build" working locally.
    -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>

    <DefineConstants>
      PublishDir=$(PublishDir);SharedDir=$(SharedDir);ProductVersion=$(ProductVersion)
    </DefineConstants>

    <SuppressIces>ICE57;ICE64</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
