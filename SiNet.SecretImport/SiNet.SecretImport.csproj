<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SiNet.SecretImport</RootNamespace>
    <AssemblyName>SiNet.SecretImport</AssemblyName>
    <Version>1.0.14</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
  <!--
    Shared secret-handling code is sourced directly from the SiNetSQL repo
    (vault) and the WPF project (provisioning file format) via Compile links,
    so this tiny CLI ships only the pieces it needs - no WPF, no DB, no Google.
  -->
  <ItemGroup>
    <Compile Include="..\..\SiNetSQL\SiNetSQL\Services\CredentialProvider.cs" Link="Shared\CredentialProvider.cs" />
    <Compile Include="..\..\SiNetSQL\SiNetSQL\Services\CredentialVaultService.cs" Link="Shared\CredentialVaultService.cs" />
    <Compile Include="..\SiNetProjectManagerV2\Services\SecretProvisioningService.cs" Link="Shared\SecretProvisioningService.cs" />
  </ItemGroup>
</Project>