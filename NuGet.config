<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Supply-chain hygiene: <clear /> drops any machine- or user-level feeds so a build resolves the
    same packages on a developer box and in CI. Every package in Directory.Packages.props is public
    and comes from nuget.org; the sibling repositories are consumed as ProjectReferences fetched by
    build/fetch-siblings.ps1, not as packages.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
