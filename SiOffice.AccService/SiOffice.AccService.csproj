<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      net8.0-windows is required because SiNetSQL targets net8.0-windows
      (it has WPF/COM dependencies). The AccService runs on Windows Server
      2019 only, so this constraint is acceptable.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SiOffice.AccService</RootNamespace>
    <AssemblyName>SiOffice.AccService</AssemblyName>
    <UserSecretsId>siofficeaccservice-d9b2c1a0</UserSecretsId>
    <!--
      Version is the single source of truth for AssemblyVersion / FileVersion
      AND for the MSI ProductVersion (read by publish-service.ps1 and passed
      to SiOffice.AccService.Installer.wixproj). Bump on every release.
    -->
    <Version>2.0.34</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- B4 (docs/ACC_SERVICE_DECOUPLING.md): AccBootstrap/provisioning types no longer come
         from the legacy SiNetSQL project — that project reference was dropped entirely.
         CredentialProvider and legacy SystemSettingsService bridges were removed from
         Program.cs/AccEndpoints.cs in favor of CredentialVault + SecretCatalog and
         ISystemSettingsQueryService. -->
    <ProjectReference Include="..\src\SiNet.Infrastructure.AccBootstrap\SiNet.Infrastructure.AccBootstrap.csproj" />
    <ProjectReference Include="..\src\SiNet.Application\SiNet.Application.csproj" />
    <ProjectReference Include="..\src\SiOffice.AccService.Contracts\SiOffice.AccService.Contracts.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Autodesk\SiNet.Infrastructure.Autodesk.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Logging\SiNet.Infrastructure.Logging.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Secrets\SiNet.Infrastructure.Secrets.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Sql\SiNet.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\..\AutodeskIntegration\SiOffice.AutodeskConnector\SiOffice.AutodeskConnector.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Diagnostics\" />
  </ItemGroup>
</Project>