<Window x:Class="SiNetProjectManagerV2.Windows.ReviewedPlanPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בחר תוכנית נבדקת"
        FlowDirection="RightToLeft"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="סמן את הקבצים והאלטרנטיבות שהיו התוכנית הנבדקת לדוח זה."
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

        <ListBox x:Name="CandidatesList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <TextBlock>
                            <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding Alternative, Mode=OneWay}"/>
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="אישור" Width="90" Margin="0,0,8,0"
                    IsDefault="True" Click="OnOk"/>
            <Button Content="ביטול" Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
