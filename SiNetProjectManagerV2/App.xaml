<Application x:Class="SiNetProjectManagerV2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
              xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- קונברטר שמעביר את עצמו כ-CommandParameter -->
        <conv:SelfConverter x:Key="SelfConverter"/>
        
        <!-- ═══════════════════════════════════════════════════════════════════
             DYNAMIC RESOURCES — Updated via App.ApplySettings()
             All windows/controls bind to these for universal theme consistency
             ═══════════════════════════════════════════════════════════════════ -->
        <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
        <sys:Double x:Key="AppFontSize">12</sys:Double>
        <sys:Double x:Key="AppFontSizeSecondary">10.8</sys:Double>
        <sys:Double x:Key="AppFontSizeSmall">7.8</sys:Double>
        <SolidColorBrush x:Key="AppForeground">Black</SolidColorBrush>
        <SolidColorBrush x:Key="AppBackground">White</SolidColorBrush>

        <!-- ═══════════════════════════════════════════════════════════════════
             GLOBAL IMPLICIT STYLES — Apply to ALL controls unless overridden
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Window Base Style -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- Menu & MenuItem -->
        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- TextBlock (most common text element) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ComboBox & ComboBoxItem -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ListBox & ListBoxItem -->
        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- TabControl & TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>

        <!-- Expander -->
        <Style TargetType="Expander">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ToolTip -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ContextMenu -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- StatusBar -->
        <Style TargetType="StatusBar">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ColorPicker (Xceed) -->
        <Style TargetType="{x:Type xctk:ColorPicker}">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- TreeView & TreeViewItem -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <!-- DataGrid, DataGridCell, DataGridRow -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════
             NAMED STYLES — For special cases
             ═══════════════════════════════════════════════════════════════════ -->

        <Style x:Key="ZebraComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter TargetName="Border" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="Border" Property="Background" Value="Blue" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZebraComboBoxStyle" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ZebraComboBoxItemStyle}" />
        </Style>

    </Application.Resources>
</Application>
