<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SiNetProjectManagerV2</RootNamespace>
    <AssemblyName>SiNetProjectManagerV2</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\si.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>NU1701</NoWarn>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <!-- ClickOnce Settings -->
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <ProductName>SiNet Project Manager</ProductName>
    <PublisherName>SI Office</PublisherName>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <!-- Ensure all content files are included in publish -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.22</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\folder_project.png" />
    <None Remove="Assets\folder_user.png" />
    <None Remove="Assets\logo_si.jpg" />
    <None Remove="Assets\si.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\si - Copy.ico" />
    <Content Include="Assets\si.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SiNetSQL\SiNetSQL\SiNetSQL.csproj" />
    <ProjectReference Include="..\..\AutodeskIntegration\SiOffice.GoogleConnector\SiOffice.GoogleConnector.csproj" />
    <!-- New clean-architecture stack (strangler). The WPF host is the only layer that knows both
         the legacy GoogleService and the new ports, so it binds the LegacyBridge seam here. -->
    <ProjectReference Include="..\src\SiNet.Domain\SiNet.Domain.csproj" />
    <ProjectReference Include="..\src\SiNet.Application\SiNet.Application.csproj" />
    <ProjectReference Include="..\src\SiNet.LegacyBridge\SiNet.LegacyBridge.csproj" />
    <!-- Composition adoption (Phase 1): direct reference so the host can delegate the Workflow
         read slice to the modular AddSiNetWorkflowReads(). Already reached transitively via
         SiNetSQL -> SiNet.Infrastructure.Sql; this makes the dependency explicit (no new cycle). -->
    <ProjectReference Include="..\src\SiNet.Infrastructure.Sql\SiNet.Infrastructure.Sql.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Secrets\SiNet.Infrastructure.Secrets.csproj" />
    <ProjectReference Include="..\src\SiNet.Infrastructure.Logging\SiNet.Infrastructure.Logging.csproj" />
    <!-- Inspection migration (Phase 5): the new Inspection shell view + view-models live in the
         SiNet.App.Wpf preview harness. The main host references it ONLY to surface the new screen
         as an additive "Inspection (Preview)" developer entry point with live data through the
         already-bound ILegacyInspectionSource seam. SiNet.App.Wpf has no SiNetSQL reference, so this
         does not create a SiNet.App.Wpf -> SiNetSQL dependency. The host never instantiates the
         preview app's System.Windows.Application; it only resolves InspectionShellView from DI. -->
    <ProjectReference Include="..\src\SiNet.App.Wpf\SiNet.App.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\folder_project.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\folder_user.png" />
    <Resource Include="Assets\si.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo_si.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <!-- Content files MUST be marked as Content for ClickOnce -->
    <Content Include="credentials.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- appsettings.local.json is optional (user-specific overrides) -->
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.template.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Commands\" />
  </ItemGroup>

  <!-- Test-only visibility for host adapter integration tests in SiNetSQL.Tests -->
  <ItemGroup>
    <InternalsVisibleTo Include="SiNetSQL.Tests" />
    <InternalsVisibleTo Include="SiNet.App.Wpf.Tests" />
  </ItemGroup>
</Project>