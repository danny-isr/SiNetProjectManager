<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SiNetProjectManagerV2.Controls.EmailTopStatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=vm:EmailManagementViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Not Connected"/>
                    <Setter Property="Foreground" Value="Gray"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Text" Value="✓"/>
                            <Setter Property="Foreground" Value="Green"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Connected Email Display -->
        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"
                   Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Run Text="{Binding ConnectedEmail, Mode=OneWay}" FontWeight="Bold" Foreground="#333"/>
        </TextBlock>
        <TextBlock Text=" | " Foreground="Gray" VerticalAlignment="Center"
                   Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   Foreground="#555"/>
        <!-- Error Count (Red) -->
        <TextBlock VerticalAlignment="Center"
                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
            <Run Text=" | " Foreground="Gray"/>
            <Run Text="Errors: " Foreground="Red" FontWeight="Bold"/>
            <Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="Red" FontWeight="Bold"/>
        </TextBlock>
        <!-- Context enrichment indicator -->
        <TextBlock Text=" | 🔄 Enriching..."
                   Foreground="#1976D2"
                   Visibility="{Binding IsEnrichingContext, Converter={StaticResource BoolToVis}}"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
