<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SiNetProjectManagerV2.Controls.EmailActionBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:EmailManagementViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Padding="8,5">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E8F5E9"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedEmail.IsAssigned}" Value="True">
                        <Setter Property="Background" Value="#C8E6C9"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Show for unassigned emails -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        Visibility="{Binding IsSelectedEmailUnassigned, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="File to project:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedProject.NameAndNumber}"
                           Foreground="#2E7D32"
                           FontWeight="Bold"
                           Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Select a project above"
                           Foreground="Gray"
                           FontStyle="Italic"
                           Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
            </StackPanel>

            <!-- Show for assigned emails -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        Visibility="{Binding SelectedEmail.IsAssigned, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ " Foreground="#2E7D32" FontWeight="Bold"/>
                    <TextBlock Text="Already assigned to: " FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedEmail.AssignedProjectName}"
                           Foreground="#2E7D32"
                           FontWeight="Bold"/>
            </StackPanel>

            <!-- File Email button (for unassigned) -->
            <Button Grid.Column="1"
                    Command="{Binding FileEmailCommand}"
                    Padding="12,5"
                    FontWeight="Bold"
                    Content="File Email"
                    Visibility="{Binding IsSelectedEmailUnassigned, Converter={StaticResource BoolToVis}}"/>

            <!-- Assigned email buttons: Move to Project + Unfile -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding IsSelectedEmailAssigned, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding MoveToProjectCommand}"
                        Padding="12,5"
                        FontWeight="Bold"
                        Content="📂 Move to Project"
                        Background="#C8E6C9"
                        BorderBrush="#66BB6A"
                        ToolTip="העבר קבצים מתויגים לתיקיית הפרויקט"
                        Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding AreAllAttachmentsPlaced, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0">
                    <TextBlock Text="✓ " Foreground="#2E7D32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="הקבצים כבר הועברו לפרויקט" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Command="{Binding UnfileEmailCommand}"
                        Padding="12,5"
                        FontWeight="Bold"
                        Content="Unfile Email"
                        Background="#FFCDD2"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
