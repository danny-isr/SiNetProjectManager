<UserControl x:Class="SiNetProjectManagerV2.Controls.EmailViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:uc="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Rich attachment item template with tag selector -->
        <DataTemplate x:Key="ViewerAttachmentTemplate">
            <Border CornerRadius="3" 
                    Padding="4,2" 
                    Margin="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="AttachmentBorder_MouseLeftButtonUp"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExternalDownload}" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInAcc}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="BorderBrush" Value="#81C784"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                <Setter Property="Background" Value="#C8E6C9"/>
                                <Setter Property="BorderBrush" Value="#43A047"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 פתח קובץ מקומי" 
                                  Click="OpenLocalFile_Click"
                                  Visibility="{Binding HasLocalFile, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="🔍 הצג ב-ACC" 
                                  Click="ShowInAcc_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconName}" 
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <!-- ACC badge -->
                    <TextBlock Text="☁✓" 
                               Foreground="#2E7D32"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"
                               ToolTip="הקובץ הועלה ל-ACC — לחץ לפתיחה"
                               Visibility="{Binding IsInAcc, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding FileName}" 
                               FontSize="11"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding FileName}"/>
                    <TextBlock Text="{Binding DisplaySize}" 
                               FontSize="9"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <!-- Tag badge -->
                    <TextBlock Text="{Binding TagBadge}"
                               Foreground="#1565C0"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"
                               ToolTip="{Binding TaggedProjectFileTitle}"/>
                    <!-- Placement badge -->
                    <TextBlock Text="{Binding PlacementBadge}"
                               Foreground="#2E7D32"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"
                               ToolTip="{Binding PlacementInfo}"
                               Visibility="{Binding IsPlaced, Converter={StaticResource BoolToVis}}"/>
                    <Button Margin="3,0,0,0"
                            MinWidth="70"
                            Height="20"
                            VerticalAlignment="Center"
                            Padding="6,0"
                            FontSize="10"
                            Background="#FFF3E0"
                            BorderBrush="#FFB74D"
                            Content="🔄 עדכן"
                            ToolTip="תיוק חוזר ליעד אחר (יחליף את הקובץ הקיים לאחר אישור)"
                            Visibility="{Binding IsPlaced, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.RefileAttachmentCommand, ElementName=Root}"
                            CommandParameter="{Binding}"/>
                    <!-- Inline tag selector (compact): button opens shared FileTreePicker -->
                    <Button Margin="3,0,0,0"
                            MinWidth="100"
                            MaxWidth="220"
                            Height="20"
                            VerticalAlignment="Center"
                            Padding="6,0"
                            Visibility="{Binding ShowTagSelector, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding CanEditTarget}"
                            Command="{Binding DataContext.TagAttachmentPickCommand, ElementName=Root}"
                            CommandParameter="{Binding}"
                            Content="{Binding}"
                            ToolTip="{Binding TaggedProjectFileTitle, TargetNullValue='בחר קובץ פרויקט יעד (חומר חיצוני) לשיוך הקובץ המצורף'}">
                        <Button.Resources>
                            <DataTemplate x:Key="TagButtonPickTemplate">
                                <TextBlock Text="🔗 בחר קובץ"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                            <DataTemplate x:Key="TagButtonChangeTemplate">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗 "/>
                                    <TextBlock Text="{Binding TaggedProjectFileTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TaggedProjectFileTitle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="ContentTemplate" Value="{StaticResource TagButtonPickTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagged}" Value="True">
                                        <Setter Property="BorderBrush" Value="#66BB6A"/>
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Setter Property="ContentTemplate" Value="{StaticResource TagButtonChangeTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Inline alternative selector (compact) -->
                    <ComboBox Margin="3,0,0,0"
                              MinWidth="80"
                              MaxWidth="140"
                              Height="20"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowAlternativeSelector, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding CanEditTarget}"
                              ItemsSource="{Binding AvailableAlternatives}"
                              SelectedValue="{Binding SelectedAlternativeId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              ToolTip="בחר אלטרנטיבה"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="BorderBrush" Value="#CE93D8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAlternativeId}" Value="{x:Null}">
                                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root, Path=ViewModel}">
        <!-- Empty state -->
        <TextBlock Text="בחר מייל להצגה"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray" FontStyle="Italic"
                   Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

        <!-- Email content (visible when email selected) -->
        <Grid Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Email Header -->
            <Border Grid.Row="0" Background="#F5F5F5" Padding="10,6">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}" 
                               FontWeight="Bold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subject}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="From: " Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding From}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="  |  Date: " Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding DateDisplay}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 1: Attachments Bar -->
            <Border Grid.Row="1" 
                    Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="0,1"
                    Padding="6,3" MaxHeight="110"
                    Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="📎" FontSize="11"/>
                        <TextBlock Text=" Attachments" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text=" (" Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding AttachmentCount}" Opacity="0.7" FontSize="11"/>
                        <TextBlock Text=")" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Attachments}"
                                      ItemTemplate="{StaticResource ViewerAttachmentTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Row 2: Email Body (WebView2) -->
            <wv2:WebView2 x:Name="EmailWebView"
                          Grid.Row="2"
                          uc:WebView2Helper.NavigateUrl="{Binding Email.GmailPopoutUrl}"
                          uc:WebView2Helper.FallbackHtml="{Binding Email.HtmlBodyForDisplay}"
                          uc:WebView2Helper.SelectedEmailInfo="{Binding Email}"
                          Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}"/>

            <!-- Body loading overlay -->
            <Border Grid.Row="2" Background="#80FFFFFF"
                    Visibility="{Binding IsLoadingBody, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Loading email..." FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding BodyStatusMessage}" FontSize="11" Foreground="Gray"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
