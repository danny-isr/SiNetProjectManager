<UserControl x:Class="SiNetProjectManagerV2.Controls.EmailViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:uc="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Attachment item template -->
        <DataTemplate x:Key="ViewerAttachmentTemplate">
            <Border Padding="6,3" Margin="2" CornerRadius="4"
                    Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="AttachmentBorder_MouseLeftButtonUp"
                    Tag="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="הצג ב-ACC"
                                  Command="{Binding PlacementTarget.Tag.DataContext.ShowInAccCommand, 
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding IconName}" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding FileName}" FontSize="11" VerticalAlignment="Center"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FileName}"/>
                    <TextBlock Text="{Binding DisplaySize}" FontSize="9" Opacity="0.6"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <!-- ACC badge -->
                    <Border Visibility="{Binding IsInAcc, Converter={StaticResource BoolToVis}}"
                            Background="#C8E6C9" CornerRadius="3" Padding="3,1" Margin="4,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓ ACC" FontSize="8" Foreground="#2E7D32" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root, Path=ViewModel}">
        <!-- Empty state -->
        <TextBlock Text="בחר מייל להצגה"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="Gray" FontStyle="Italic"
                   Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

        <!-- Email content (visible when email selected) -->
        <Grid Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Email Header -->
            <Border Grid.Row="0" Background="#F5F5F5" Padding="10,6">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}" 
                               FontWeight="Bold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subject}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="From: " Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding From}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="  |  Date: " Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding DateDisplay}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 1: Attachments Bar -->
            <Border Grid.Row="1" 
                    Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="0,1"
                    Padding="6,3" MaxHeight="110"
                    Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="📎" FontSize="11"/>
                        <TextBlock Text=" Attachments" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text=" (" Opacity="0.7" FontSize="11"/>
                        <TextBlock Text="{Binding AttachmentCount}" Opacity="0.7" FontSize="11"/>
                        <TextBlock Text=")" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Attachments}"
                                      ItemTemplate="{StaticResource ViewerAttachmentTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Row 2: Email Body (WebView2) -->
            <wv2:WebView2 x:Name="EmailWebView"
                          Grid.Row="2"
                          uc:WebView2Helper.NavigateUrl="{Binding Email.GmailPopoutUrl}"
                          uc:WebView2Helper.FallbackHtml="{Binding Email.HtmlBodyForDisplay}"
                          uc:WebView2Helper.SelectedEmailInfo="{Binding Email}"
                          Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}"/>

            <!-- Body loading overlay -->
            <Border Grid.Row="2" Background="#80FFFFFF"
                    Visibility="{Binding IsLoadingBody, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Loading email..." FontSize="14" Foreground="Gray"/>
                    <TextBlock Text="{Binding BodyStatusMessage}" FontSize="11" Foreground="Gray"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
