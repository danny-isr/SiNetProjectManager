<wpf:BaseWindow 
    x:Class="SiNetProjectManagerV2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:SiNetProjectManagerV2.WPF"
    xmlns:uc="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
    xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
    mc:Ignorable="av"
    FlowDirection="RightToLeft"
    Title="תוכנת ניהול"
    Height="600" Width="1000"
    Icon="/Assets/si - Copy.ico"
    AutoScrollEnabled="False">

    <!-- 1. הגדרת DataContext -->
    <wpf:BaseWindow.DataContext>
        <vm:MainWindowViewModel/>
    </wpf:BaseWindow.DataContext>

    <!-- 2. משאבים גלובליים -->
    <!--<wpf:BaseWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="MenuItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </wpf:BaseWindow.Resources>-->
    <wpf:BaseWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate DataType="{x:Type vm:FileManagerViewModel}">
            <uc:FileManagerView/>
        </DataTemplate>
    </wpf:BaseWindow.Resources>
    <DockPanel>
        <Menu FlowDirection="RightToLeft" DockPanel.Dock="Top" HorizontalAlignment="Left">

            <!-- Admins -->
            <MenuItem Header="מנהלה"
                Visibility="{Binding IsInUsers, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="הגדרות" Click="OpenSettings_Click"/>
                <MenuItem Header="הגדרות ניהול" Click="OpenManagementSettings_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="חוקי סוג פרויקט" Click="OpenProjectTypeRules_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="מיפוי סטטוס משימה ← פרויקט" Click="OpenStatusMapping_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="🔐 הרשאות פעולות" Click="OpenActionPermissions_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <Separator Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="🔬 בדיקת חילוץ דוח (Migration PoC)" Click="OpenMigrationPoc_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="🔗 מיפוי MasterPlan ↔ SiNet" Click="OpenMasterPlanMapping_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <Separator Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="🔍 ניתוח DWF (Stamp Analysis)" Click="OpenDwfAnalysis_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>

            <!-- ProjectManagers -->
            <MenuItem Header="פרויקטים ותבניות"
                Visibility="{Binding IsInUsers, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="פתיחת פרויקט חדש" Click="OpenNewProject_Click" Visibility="{Binding IsInProjectManagers , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="עדכון פרויקט"      Click="OpenTemplate_Click" Visibility="{Binding IsInProjectManagers , Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="בעבודה"            Click="Approve_Click" Visibility="{Binding IsInUsers , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="בעבודה 2"          Click="OpenProjectWork2_Click" Visibility="{Binding IsInUsers , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="מיילים"           Click="OpenEmailManagement_Click" Visibility="{Binding IsInUsers , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="ניהול קבצים"      Command="{Binding OpenProjectFilesCommand}" Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="בקרה"             Click="Control_Click" Visibility="{Binding IsInAdmins , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="ניהול רוחב"       Click="ManageWidth_Click" Visibility="{Binding IsInAdmins , Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="ניהול עובדים"     Click="ManageEmployees_Click" Visibility="{Binding IsInAdmins , Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="כללי"             Click="General_Click" Visibility="{Binding IsInAdmins , Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="החלטות פרויקט"    Click="OpenProjectDecisions_Click" Visibility="{Binding IsInUsers , Converter={StaticResource BoolToVis}}"/>
            </MenuItem>

            <!-- Users - Only visible to administrators -->
            <MenuItem Header="משתמשים והרשאות"
                Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="הוסף משתמש חדש" Click="AddUser_Click"/>
                <MenuItem Header="👥 ניהול משתמשים" Click="OpenUserManagement_Click"/>
            </MenuItem>

            <!-- ניהול משימות - Task Management -->
            <MenuItem Header="משימות"
                Visibility="{Binding IsInUsers, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="לוח משימות" Click="OpenTaskPanel_Click"/>
                <MenuItem Header="📋 משימות פרויקט (חלון צף)" Click="OpenFloatingTaskPanel_Click"/>
                <Separator/>
                <MenuItem Header="🔍 דוחות ביקורת (חלון צף)" Click="OpenFloatingInspection_Click"/>
                <MenuItem Header="📋 בדיקת תקינות תבניות" Click="OpenTemplateValidation_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="📐 חותמת מהירה (DWF/PDF)" Click="OpenQuickStamp_Click"/>
                <Separator/>
                <MenuItem Header="📊 תהליכי עבודה" Click="OpenWorkflowDashboard_Click"/>
                <MenuItem Header="📈 מצב תהליכים — כלל הפרויקטים" Click="OpenWorkflowStatusDashboard_Click"/>
                <MenuItem Header="🛠️ ניהול תהליכים (מרוכז)" Click="OpenWorkflowManagement_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>

            <!-- דוחות - Reports (visible to all users; R01/R02 management-only) -->
            <MenuItem Header="דוחות"
                Visibility="{Binding IsInUsers, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="R01 - סיכום שעות" Click="OpenR01Report_Click"
                    Visibility="{Binding IsInProjectManagers, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="R02 - שעות עבודה" Click="OpenR02Report_Click"
                    Visibility="{Binding IsInProjectManagers, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="R03 - השוואת נוכחות" Click="OpenR03Report_Click"/>
            </MenuItem>

            <!-- מערכת – תמיד גלוי -->
            <MenuItem Header="מערכת">
                <MenuItem Header="🔑 הגדרת מפתחות ואישורים" Click="OpenSecretSetup_Click"
                    Visibility="{Binding IsInAdmins, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>

        </Menu>

        <Grid Name="MainContentArea">
            <TextBlock Text="ברוך הבא לתוכנת הניהול"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"/>
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>
    </DockPanel>
</wpf:BaseWindow>
