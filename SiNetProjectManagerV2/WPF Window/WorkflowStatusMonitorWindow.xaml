<Window x:Class="SiNetProjectManagerV2.WPF_Window.WorkflowStatusMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="📈 מצב תהליכי עבודה"
        Width="1100" Height="700" MinWidth="800" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Topmost="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Pipeline dot styles -->
        <Style x:Key="DotCompleted" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="#4CAF50"/>
            <Setter Property="Stroke" Value="#388E3C"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
        </Style>
        <Style x:Key="DotCurrent" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#2196F3"/>
            <Setter Property="Stroke" Value="#1565C0"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
        </Style>
        <Style x:Key="DotFuture" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="#E0E0E0"/>
            <Setter Property="Stroke" Value="#BDBDBD"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
        </Style>

        <!-- Pipeline dot template -->
        <DataTemplate x:Key="PipelineDotTemplate">
            <Grid>
                <Ellipse Style="{StaticResource DotCompleted}"
                         Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                <Ellipse Style="{StaticResource DotCurrent}"
                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                <Ellipse Style="{StaticResource DotFuture}"
                         Visibility="{Binding IsFuture, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- Status color style -->
        <Style x:Key="StatusCellStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="#F57F17"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <TextBlock Grid.Row="0" Text="📈 מוניטור תהליכי עבודה"
                   FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

        <!-- ═══ Toolbar ═══ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
            <!-- Search -->
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" Padding="4,3" VerticalContentAlignment="Center"
                     Margin="0,0,16,4"/>

            <!-- Workflow type filter -->
            <TextBlock Text="סוג תהליך:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding WorkflowTypes}"
                      SelectedItem="{Binding SelectedWorkflowType}"
                      Width="180" Margin="0,0,16,4"/>

            <!-- Status filter -->
            <TextBlock Text="סטטוס:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox SelectedIndex="1" Width="120" Margin="0,0,16,4"
                      SelectionChanged="FilterCombo_SelectionChanged"
                      x:Name="FilterCombo">
                <ComboBoxItem Content="הכל" Tag="All"/>
                <ComboBoxItem Content="פעילים" Tag="ActiveOnly"/>
                <ComboBoxItem Content="הושלמו" Tag="Completed"/>
                <ComboBoxItem Content="טיוטות" Tag="Draft"/>
            </ComboBox>

            <!-- Refresh + auto-refresh -->
            <Button Content="🔄 רענן" Command="{Binding RefreshCommand}"
                    Padding="8,4" Margin="0,0,8,4"/>
            <CheckBox Content="רענון אוטומטי (15 שנ׳)"
                      IsChecked="{Binding AutoRefreshEnabled}"
                      VerticalAlignment="Center" Margin="0,0,8,4"/>

            <!-- Pin toggle -->
            <CheckBox Content="📌 תמיד למעלה" IsChecked="True"
                      Checked="Pin_Checked" Unchecked="Pin_Unchecked"
                      VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- ═══ Master–Detail ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Master: instances list -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E0E0E0"
                      RowHeaderWidth="0"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="סוג תהליך" Binding="{Binding WorkflowName}" Width="140"/>
                    <DataGridTextColumn Header="פרויקט" Binding="{Binding ProjectDisplay}" Width="200"/>
                    <DataGridTemplateColumn Header="סטטוס" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusCellStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="שלב נוכחי" Binding="{Binding CurrentStageName}" Width="130"/>
                    <DataGridTextColumn Header="התקדמות" Binding="{Binding ProgressText}" Width="70"/>
                    <DataGridTemplateColumn Header="צינור" Width="*" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding PipelineStages}"
                                              ItemTemplate="{StaticResource PipelineDotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0"/>

            <!-- Detail panel -->
            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#E0E0E0"
                    CornerRadius="4" Padding="12" Margin="4,0,0,0"
                    Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- No selection -->
                        <TextBlock Text="בחר תהליך מהרשימה" Foreground="Gray"
                                   Margin="0,40,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Detail -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <!-- Workflow type -->
                            <TextBlock Text="{Binding SelectedItem.WorkflowName}"
                                       FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>

                            <!-- Project -->
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="פרויקט: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedItem.ProjectDisplay, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Status -->
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="8,4"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <TextBlock Text="{Binding SelectedItem.StatusText}" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Current stage -->
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="שלב נוכחי: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedItem.CurrentStageName, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Progress -->
                            <TextBlock Margin="0,0,0,4">
                                <Run Text="התקדמות: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedItem.ProgressText, Mode=OneWay}"/>
                            </TextBlock>
                            <ProgressBar Value="{Binding SelectedItem.ProgressRatio, Mode=OneWay}"
                                         Minimum="0" Maximum="1" Height="8"
                                         Foreground="#2196F3" Margin="0,0,0,12"/>

                            <!-- Created -->
                            <TextBlock Margin="0,0,0,12">
                                <Run Text="נוצר: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SelectedItem.CreatedAt, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"/>
                            </TextBlock>

                            <!-- Pipeline (vertical) -->
                            <TextBlock Text="צינור שלבים:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedItem.PipelineStages}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Grid Width="18" Height="18" Margin="0,0,8,0">
                                                <Ellipse Style="{StaticResource DotCompleted}"
                                                         Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                <Ellipse Style="{StaticResource DotCurrent}"
                                                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                <Ellipse Style="{StaticResource DotFuture}"
                                                         Visibility="{Binding IsFuture, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Open button -->
                            <Button Content="📂 פתח תהליך"
                                    Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="12,6" HorizontalAlignment="Right"
                                    Background="#BBDEFB" BorderBrush="#64B5F6"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Status bar ═══ -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</Window>