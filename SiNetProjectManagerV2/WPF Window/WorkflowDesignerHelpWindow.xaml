                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#1565C0"><TextBlock Style="{StaticResource TableHeader}" Text="מקש"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#1565C0"><TextBlock Style="{StaticResource TableHeader}" Text="פעולה"/></Border>

                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource TableCell}" Text="Delete" FontWeight="SemiBold"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מוחק את הצומת או החיבור הנבחר."/></Border>

                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource TableCell}" Text="Escape" FontWeight="SemiBold"/></Border>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מבטל מצב חיבור (🔗)."/></Border>

                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource TableCell}" Text="Ctrl + גלגלת" FontWeight="SemiBold"/></Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="זום פנימה/החוצה (30%–300%)."/></Border>

                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource TableCell}" Text="גרירה" FontWeight="SemiBold"/></Border>
                                <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="גרור צומת למיקום חדש על הקנבס."/></Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource TipBox}">
                            <TextBlock Style="{StaticResource BodyText}" Foreground="#2E7D32">
                                💡 כפתור "🔄 סדר אוטומטי" מסדר את כל הצמתים בשכבות לפי BFS מצומת ההתחלה.
                                שימושי כשהתרשים מבולגן או לאחר ייבוא.
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource TipBox}">
                            <TextBlock Style="{StaticResource BodyText}" Foreground="#2E7D32">
                                💡 כפתור "✅ בדוק" מריץ בדיקת תקינות: צומת התחלה/סיום, צמתים לא מחוברים,
                                תנאים חסרים, צמתים לא נגישים, ועוד.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Bottom spacing -->
                <Border Height="20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
