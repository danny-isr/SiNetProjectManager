<Window x:Class="SiNetProjectManagerV2.WPF_Window.AlternativeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
        Title="אלטרנטיבה"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ControlTemplate x:Key="ErrorTemplate">
            <DockPanel>
                <TextBlock Foreground="Red"
                   DockPanel.Dock="Bottom"
                   Text="{Binding [0].ErrorContent}" />
                <AdornedElementPlaceholder/>
            </DockPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10" MinWidth="320">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <!-- Row 1: First-level (editable ComboBox over existing prefixes; "1" always present) -->
            <TextBlock Text="שם אלטרנטיבה (רמה ראשונה):"/>
            <ComboBox Width="240"
                      Margin="0,5,0,0"
                      IsEditable="True"
                      ItemsSource="{Binding FirstLevelOptions}"
                      Text="{Binding FirstLevelName,
                                     UpdateSourceTrigger=PropertyChanged,
                                     ValidatesOnNotifyDataErrors=True}"
                      Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>

            <!-- Row 2: Opt-in for second level -->
            <CheckBox Margin="0,12,0,0"
                      Content="הוסף רמה שנייה"
                      IsChecked="{Binding UseSecondLevel}"/>

            <!-- Row 3: Second-level mode picker (date vs free text) -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding UseSecondLevel}"
                        Visibility="{Binding UseSecondLevel, Converter={StaticResource BoolToVis}}">
                <RadioButton Content="תאריך"
                             GroupName="SecondLevelMode"
                             IsChecked="{Binding IsSecondLevelDate}"/>
                <RadioButton Content="טקסט חופשי"
                             GroupName="SecondLevelMode"
                             Margin="12,0,0,0"
                             IsChecked="{Binding IsSecondLevelText}"/>
            </StackPanel>

            <!-- Row 4a: Date picker (default = today, formatted as dd.MM.yyyy) -->
            <DatePicker Width="240"
                        Margin="0,6,0,0"
                        SelectedDate="{Binding SecondLevelDate}"
                        Visibility="{Binding ShowDateEditor, Converter={StaticResource BoolToVis}}"/>

            <!-- Row 4b: Free-text second level -->
            <TextBox Width="240"
                     Margin="0,6,0,0"
                     Text="{Binding SecondLevelText,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}"
                     Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                     Visibility="{Binding ShowTextEditor, Converter={StaticResource BoolToVis}}"/>

            <!-- Live preview of the full canonical name -->
            <TextBlock Margin="0,10,0,0"
                       Foreground="#666"
                       FontStyle="Italic"
                       FontSize="11"
                       Text="{Binding AlternativeName, StringFormat='תצוגה מקדימה: {0}'}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="אישור"
              IsDefault="True"
              Click="Ok_Click"
              IsEnabled="{Binding IsOkEnabled}" />
            <Button Content="ביטול"
              IsCancel="True"
              Click="Cancel_Click"
              Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

