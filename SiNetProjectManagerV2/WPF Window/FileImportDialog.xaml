<Window x:Class="SiNetProjectManagerV2.WPF_Window.FileImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ייבוא קבצים מדוא״ל"
        Width="500" Height="400"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📂 ייבוא קבצים מצורפים" FontWeight="Bold"
                   FontSize="14" Margin="0,0,0,12"/>

        <!-- Target folder selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="קובץ יעד בפרויקט:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="FolderCombo"
                      DisplayMemberPath="Title"
                      SelectedValuePath="Id"
                      Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Attachments list -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="קבצים מצורפים:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox x:Name="AttachmentsList" SelectionMode="Extended"
                     BorderThickness="1" BorderBrush="#E0E0E0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FileName}"/>
                            <TextBlock Text="{Binding Status}" Foreground="Gray" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="Gray" Margin="0,4,0,4"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="📥 ייבא" Click="Import_Click" Padding="16,6" Margin="0,0,8,0"
                    Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"/>
            <Button Content="סגור" Click="Close_Click" Padding="16,6"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
