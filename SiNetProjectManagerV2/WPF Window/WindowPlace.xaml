<Window x:Class="WpfSiData.WPF_Window.WindowPlace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="בחר מקום" Height="450" Width="800"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">
    <!-- DataContext is set from code-behind via DI (PlaceViewModel requires IDbContextFactory) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Places}"
                  SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="City Icon" Binding="{Binding CityIcon}"/>
                <DataGridCheckBoxColumn Header="In Use" Binding="{Binding InUse}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="ביטול" Width="75" Margin="5" Click="Cancel_Click"/>
            <Button Content="אישור" Width="75" Margin="5" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>