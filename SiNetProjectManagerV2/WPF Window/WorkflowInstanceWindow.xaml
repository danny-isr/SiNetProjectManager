<Window x:Class="SiNetProjectManagerV2.WPF_Window.WorkflowInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="פרטי תהליך"
        Width="700" Height="600"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: definition name + status -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontWeight="Bold" FontSize="16">
                <Run Text="תהליך: "/>
                <Run Text="{Binding DefinitionName, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="סטטוס:" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold"/>
                <TextBlock Text=" | שלב נוכחי:" Margin="16,0,8,0"/>
                <TextBlock Text="{Binding CurrentStageName}" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <!-- Stages overview (visual pipeline) -->
        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="שלבים:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,3" Margin="2" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="#BDBDBD">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInitial}" Value="True">
                                                <Setter Property="Background" Value="#C8E6C9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFinal}" Value="True">
                                                <Setter Property="Background" Value="#BBDEFB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSmall}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Transition History -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="היסטוריית מעברים:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding TransitionHistory}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="1"
                      BorderBrush="#E0E0E0"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="לשלב" Binding="{Binding ToStage.Name}" Width="150"/>
                    <DataGridTextColumn Header="ע״י" Binding="{Binding TransitionedByUser.PersonName}" Width="120"/>
                    <DataGridTextColumn Header="תאריך" Binding="{Binding TransitionedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="הערות" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Advance controls -->
        <Border Grid.Row="3" Background="#FAFAFA" CornerRadius="4" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="מעבר שלב:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ComboBox ItemsSource="{Binding AllowedNextStages}"
                              SelectedItem="{Binding SelectedNextStage}"
                              DisplayMemberPath="Name"
                              Width="200" Margin="0,0,8,0"/>
                    <Button Content="▶ קדם" Command="{Binding AdvanceCommand}" Padding="12,4"
                            Background="#C8E6C9" BorderBrush="#66BB6A"/>
                </StackPanel>
                <TextBox Text="{Binding AdvanceNotes, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,0,0,4"
                         ToolTip="הערות (אופציונלי)"/>
            </StackPanel>
        </Border>

        <!-- Action buttons + status -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⏸ השהה" Command="{Binding PauseCommand}" Padding="8,4" Margin="0,0,4,0"
                    Background="#FFF9C4" BorderBrush="#FDD835"/>
            <Button Content="▶ חדש" Command="{Binding ResumeCommand}" Padding="8,4" Margin="0,0,4,0"
                    Background="#C8E6C9" BorderBrush="#66BB6A"/>
            <Button Content="✔ סיים" Command="{Binding CompleteCommand}" Padding="8,4" Margin="0,0,4,0"
                    Background="#BBDEFB" BorderBrush="#42A5F5"/>
            <Button Content="✖ בטל" Command="{Binding CancelCommand}" Padding="8,4" Margin="0,0,4,0"
                    Background="#FFCDD2" BorderBrush="#E53935"/>

            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Foreground="Gray" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
