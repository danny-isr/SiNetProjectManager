<Window x:Class="SiNetProjectManagerV2.WPF_Window.MasterPlanMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
        FlowDirection="RightToLeft"
        Title="🔗 מיפוי MasterPlan ↔ SiNet"
        Height="700" Width="1900"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/si - Copy.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <ToolBar Grid.Row="0" Margin="4">
            <Button Content="🔄 רענן" Command="{Binding LoadCommand}" Padding="8,4" Margin="2"/>
            <Button Content="⚡ התאמה אוטומטית" Command="{Binding AutoMatchCommand}" Padding="8,4" Margin="2"/>
            <Button Content="🤖 התאמה AI" Command="{Binding AiMatchCommand}" Padding="8,4" Margin="2"
                    ToolTip="שולח את הנתונים ל-Gemini AI להתאמה חכמה" Foreground="DarkBlue"/>
            <Separator/>
            <Button Content="🧹 נקה הכל" Command="{Binding ClearAllMappingsCommand}" Padding="8,4" Margin="2"
                    ToolTip="מוחק את כל המיפויים — ניתן אח״כ להריץ התאמה מחדש" Foreground="OrangeRed"/>
            <Separator/>
            <Button Content="💾 שמור ל-DB" Command="{Binding ApplyCommand}" Padding="8,4" Margin="2"
                    FontWeight="Bold" Foreground="DarkGreen"/>
            <Separator/>
            <Button Content="📋 השלם חומר חסר" Command="{Binding CompleteMissingCommand}" Padding="8,4" Margin="2"
                    ToolTip="מייבא חברות ואנשי קשר חסרים מ-MasterPlan ל-SiNet (מקור: MasterPlan)" Foreground="DarkViolet"/>
            <Separator/>
            <Button Content="🔄 הפעל סנכרון מלא" Command="{Binding EnableFullSyncCommand}" Padding="8,4" Margin="2"
                    ToolTip="מפעיל סנכרון יומי מ-MasterPlan לכל הרשומות הממופות" Foreground="Teal"/>
            <Separator/>
            <Button Content="📤 ייצוא JSON" Command="{Binding ExportJsonCommand}" Padding="8,4" Margin="2"/>
            <Button Content="📥 ייבוא JSON" Command="{Binding ImportJsonCommand}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="{Binding ShowInactiveLabel}" Command="{Binding ToggleShowInactiveCommand}" Padding="8,4" Margin="2"/>
            <Separator/>
            <Button Content="✅ הפעל נבחרים" Click="ActivateSelected_Click" Padding="8,4" Margin="2"
                    ToolTip="הפעל את כל השורות המסומנות" Foreground="Green"/>
            <Button Content="❌ בטל נבחרים" Click="DeactivateSelected_Click" Padding="8,4" Margin="2"
                    ToolTip="בטל את כל השורות המסומנות" Foreground="Red"/>
        </ToolBar>

        <!-- ═══ Tab Control ═══ -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="4">

            <!-- ══ Companies Tab ══ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="🏢 חברות (" />
                        <Run Text="{Binding CompanyRows.Count, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </TabItem.Header>
                <DataGrid x:Name="CompaniesGrid"
                          ItemsSource="{Binding CompanyRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          AlternatingRowBackground="#F9F9F9"
                          RowHeight="28"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SiNet ID" Binding="{Binding SiNetId}" IsReadOnly="True" Width="65"/>
                        <DataGridTextColumn Header="שם חברה (SiNet)" Binding="{Binding SiNetTitle}" IsReadOnly="True" Width="170"/>
                        <DataGridTextColumn Header="מייל (SiNet)" Binding="{Binding SiNetEmail}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="טלפון (SiNet)" Binding="{Binding SiNetPhone}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="קשרים" Binding="{Binding RelationInfo}" IsReadOnly="True" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelationInfo}" Value="ללא קשרים">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="MP ID" Binding="{Binding MpId}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="שם חברה (MP)" Binding="{Binding MpName}" IsReadOnly="True" Width="170"/>
                        <DataGridTextColumn Header="מייל (MP)" Binding="{Binding MpEmail}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="טלפון (MP)" Binding="{Binding MpPhone}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="ח.פ. (MP)" Binding="{Binding MpRegNum}" IsReadOnly="True" Width="100"/>
                        <DataGridTemplateColumn Header="בחר MP" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding MpOptions}"
                                              SelectedItem="{Binding SelectedMpOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Padding="2,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="סטטוס" Binding="{Binding MatchStatus}" IsReadOnly="True" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✖" ToolTip="נקה מיפוי"
                                            Command="{Binding DataContext.ClearCompanyMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="2" FontSize="10" Background="Transparent" BorderBrush="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ══ Contacts Tab ══ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="👤 אנשי קשר (" />
                        <Run Text="{Binding ContactRows.Count, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </TabItem.Header>
                <DataGrid x:Name="ContactsGrid"
                          ItemsSource="{Binding ContactRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          AlternatingRowBackground="#F9F9F9"
                          RowHeight="28"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SiNet ID" Binding="{Binding SiNetId}" IsReadOnly="True" Width="65"/>
                        <DataGridTextColumn Header="שם (SiNet)" Binding="{Binding SiNetFullName}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="חברה (SiNet)" Binding="{Binding SiNetCompanyTitle}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="מייל (SiNet)" Binding="{Binding SiNetEmail}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="טלפון (SiNet)" Binding="{Binding SiNetPhone}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="קשרים" Binding="{Binding RelationInfo}" IsReadOnly="True" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelationInfo}" Value="ללא קשרים">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="MP ID" Binding="{Binding MpId}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="שם (MP)" Binding="{Binding MpFullName}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="חברה (MP)" Binding="{Binding MpCompanyName}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="מייל (MP)" Binding="{Binding MpEmail}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="טלפון (MP)" Binding="{Binding MpPhone}" IsReadOnly="True" Width="100"/>
                        <DataGridTemplateColumn Header="בחר MP" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding MpOptions}"
                                              SelectedItem="{Binding SelectedMpOption, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="FullName"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Padding="2,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="סטטוס" Binding="{Binding MatchStatus}" IsReadOnly="True" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✖" ToolTip="נקה מיפוי"
                                            Command="{Binding DataContext.ClearContactMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="2" FontSize="10" Background="Transparent" BorderBrush="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- ═══ Status Bar ═══ -->
        <StatusBar Grid.Row="2">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="16" Margin="0,0,8,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" />
        </StatusBar>
    </Grid>
</Window>
