<Window x:Class="SiNetProjectManagerV2.WPF_Window.SecretSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הגדרת מפתחות ואישורים"
        Height="650" Width="620"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="CanResizeWithGrip"
        MinHeight="550" MinWidth="520"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="הגדרת מפתחות ואישורים" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="המפתחות מוצפנים ב-Windows Credential Manager לפי המשתמש הנוכחי."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,2,0,0">
                <Run Text="● ירוק = פעיל ונבדק" Foreground="#4CAF50"/>
                <Run Text="  "/>
                <Run Text="● כתום = נשמר אך חיבור נכשל" Foreground="#FF9800"/>
                <Run Text="  "/>
                <Run Text="● אדום = חסר" Foreground="#F44336"/>
            </TextBlock>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4">
            <StackPanel>

                <!-- ═══ Gemini API ═══ -->
                <TextBlock Text="── Gemini API ──" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Ellipse x:Name="StatusGemini" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="API Key:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <PasswordBox x:Name="TxtGeminiApiKey" Style="{StaticResource FieldPassword}"/>
                </DockPanel>

                <!-- ═══ Autodesk ═══ -->
                <TextBlock Text="── Autodesk (APS) ──" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Ellipse x:Name="StatusAdClientId" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="Client ID:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtAdClientId" Style="{StaticResource FieldBox}"/>
                </DockPanel>
                <DockPanel>
                    <Ellipse x:Name="StatusAdClientSecret" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="Client Secret:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <PasswordBox x:Name="TxtAdClientSecret" Style="{StaticResource FieldPassword}"/>
                </DockPanel>

                <!-- ═══ Google OAuth ═══ -->
                <TextBlock Text="── Google OAuth ──" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Ellipse x:Name="StatusGoogleSecrets" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <Button x:Name="BtnBrowseCredentials" Content="עיון..." 
                            Width="60" Margin="4,2" DockPanel.Dock="Left" Click="BtnBrowseCredentials_Click"/>
                    <TextBlock Text="credentials.json:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtGoogleCredentialsPath" Style="{StaticResource FieldBox}" IsReadOnly="True"
                             Background="#F0F0F0"/>
                </DockPanel>

                <!-- ═══ Active Directory ═══ -->
                <TextBlock Text="── Active Directory ──" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Ellipse x:Name="StatusAdUser" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="שם משתמש:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtAdUsername" Style="{StaticResource FieldBox}" ToolTip="DOMAIN\user or user@domain"/>
                </DockPanel>
                <DockPanel>
                    <Ellipse x:Name="StatusAdPass" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="סיסמה:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <PasswordBox x:Name="TxtAdPassword" Style="{StaticResource FieldPassword}"/>
                </DockPanel>

                <!-- ═══ Connection Strings ═══ -->
                <TextBlock Text="── Connection Strings ──" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Ellipse x:Name="StatusCsSiNet" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="SiNet DB:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtCsSiNet" Style="{StaticResource FieldBox}"/>
                </DockPanel>
                <DockPanel>
                    <Ellipse x:Name="StatusCsReplica" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="Replica DB:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtCsReplica" Style="{StaticResource FieldBox}"/>
                </DockPanel>
                <DockPanel>
                    <Ellipse x:Name="StatusCsMasterPlan" Style="{StaticResource StatusDot}" DockPanel.Dock="Left" Fill="Gray"/>
                    <TextBlock Text="MasterPlan DB:" Style="{StaticResource FieldLabel}" DockPanel.Dock="Right"/>
                    <TextBox x:Name="TxtCsMasterPlan" Style="{StaticResource FieldBox}"/>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Right">
                <Button x:Name="BtnSave" Content="שמור" Width="90" Height="32" Margin="0,0,8,0"
                        FontWeight="Bold" Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="בטל" Width="90" Height="32"
                        Click="BtnCancel_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Left">
                <Button x:Name="BtnExport" Content="📦 ייצוא חבילה" Width="120" Height="32" Margin="0,0,8,0"
                        ToolTip="ייצוא כל המפתחות לקובץ מוצפן להפצה" Click="BtnExport_Click"/>
                <Button x:Name="BtnImport" Content="📥 ייבוא חבילה" Width="120" Height="32"
                        ToolTip="ייבוא מפתחות מקובץ מוצפן" Click="BtnImport_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
