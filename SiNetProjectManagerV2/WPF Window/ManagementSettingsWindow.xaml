<Window x:Class="SiNetProjectManagerV2.WPF_Window.ManagementSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
        Title="הגדרות ניהול"
        Height="550" Width="580"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="CanResizeWithGrip"
        MinHeight="400" MinWidth="480"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <conv:HexToColorConverter x:Key="HexToColor"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="הגדרות ניהול" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="הגדרות אלו משפיעות על חישובי דוחות וזמינות רק למנהלי מערכת" 
                       Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20">
            <StackPanel>
                <!-- Default Project Title -->
                <TextBlock Text="פרויקט ברירת מחדל לדוא&quot;ל" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="שם הפרויקט שמיילים חדשים ישויכו אליו לפני שיוך ידני. חייב להתאים בדיוק לשם פרויקט קיים במסד הנתונים." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="DefaultProjectWarning" 
                           Text="" 
                           Foreground="#D32F2F" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed"/>
                <TextBox x:Name="DefaultProjectTitleTextBox" 
                         Width="350" 
                         HorizontalAlignment="Right"
                         VerticalContentAlignment="Center"
                         Padding="5,3"
                         FlowDirection="RightToLeft"/>

                <!-- Office Management Project (workflows + ACC Inbox) -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="פרויקט ניהול משרד" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="פרויקט הבסיס למשרד. משמש גם כברירת מחדל לתהליכי עבודה שאינם משויכים לפרויקט (למשל: הצעת מחיר), וגם כפרויקט ה-Inbox ב-ACC שאליו עולים מיילים וקבצים מצורפים. שם הפרויקט ב-ACC חייב להתאים בדיוק לשם הפרויקט הנבחר כאן." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="מספר פרויקט:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="OfficeProjectIdTextBox" 
                             Width="100" 
                             VerticalContentAlignment="Center"
                             Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="מספר ID של פרויקט ניהול משרד (ברירת מחדל: 136)"/>
                    <TextBlock x:Name="OfficeProjectNamePreview" 
                               VerticalAlignment="Center" Margin="10,0,0,0" 
                               Opacity="0.7" FontStyle="Italic"/>
                </StackPanel>

                <!-- ACC Viewer Tab Limit ("בעבודה 2" multi-tab viewer) -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="מגבלת טאבים לתצוגת ACC" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="מספר הטאבים המקסימלי שניתן לפתוח בו-זמנית בחלון 'בעבודה 2'. ברירת המחדל היא 10." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="מקסימום טאבים:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="AccViewerMaxTabsTextBox" 
                             Width="80" 
                             VerticalContentAlignment="Center"
                             Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="מספר שלם חיובי. ברירת מחדל: 10."/>
                </StackPanel>

                <!-- User Groups -->
                <Separator Margin="0,20,0,10"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="קבוצות משתמשים" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <Button x:Name="ManageGroupsButton" Content="⚙ ניהול קבוצות" 
                            Click="ManageGroupsButton_Click"
                            DockPanel.Dock="Left" HorizontalAlignment="Left"
                            Padding="10,4" Cursor="Hand"
                            Background="Transparent" BorderBrush="#CCC" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="הגדרת קבוצות (ניהול משרד, הנהלה בכירה, מתכננים), חברי קבוצה וברירת מחדל לשיוך משימות." 
                           Opacity="0.7" TextWrapping="Wrap"/>

                <!-- ACC Inbox Folder -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="תיקיית Inbox ב-ACC" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="שם התיקייה בתוך פרויקט ניהול המשרד ב-ACC שאליה עולים מיילים וקבצים. הפרויקט עצמו נקבע לפי ההגדרה למעלה." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="שם תיקייה:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="InboxFolderNameTextBox"
                             Width="250" 
                             VerticalContentAlignment="Center" Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="שם תיקיית ה-Inbox בתוך הפרויקט (למשל: _Inbox)"/>
                </StackPanel>

                <!-- ACC Bootstrap Admin (service account, NOT in user-management) -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="חשבון אדמין ייעודי ל-ACC (Bootstrap Admin)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="חשבון השירות שמופקד על יצירת פרויקטים ב-ACC. הוא לא מופיע ברשימת המשתמשים, ההרשאות שלו לא נוגעות אוטומטית — כל פרויקט חדש שנוצר ימנה אותו כ-Project Admin אך הוא יישאר עם ההרשאות שלו במלואן." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="אימייל אדמין:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="AccBootstrapAdminEmailTextBox"
                             Width="320"
                             VerticalContentAlignment="Center" Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="אימייל החשבון ב-ACC. השאר ריק כדי לחזור לבחירה אוטומטית מטבלת המשתמשים."/>
                </StackPanel>

                <!-- ACC Project Template -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="תבנית פרויקט ב-ACC" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="כל פרויקט חדש ב-ACC ייווצר מהתבנית שתבחרי כאן ויירש ממנה את מבנה התיקיות והרשאות התפקידים (Engineer=Edit, Administrator=Manage וכו'). השאר ריק כדי לבטל יצירה דרך תבנית." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="תבנית:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AccTemplateComboBox"
                              Width="280"
                              VerticalContentAlignment="Center"
                              Padding="5,3"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Name"
                              ToolTip="בחרי תבנית מהרשימה (נטענת מ-ACC)."/>
                    <Button x:Name="RefreshTemplatesButton"
                            Content="🔄 רענן רשימה"
                            Click="RefreshTemplatesButton_Click"
                            Margin="8,0,0,0"
                            Padding="8,3"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"/>
                </StackPanel>
                <TextBlock x:Name="AccTemplateStatusLabel"
                           Margin="0,0,0,0"
                           Opacity="0.7"
                           FontStyle="Italic"
                           TextWrapping="Wrap"/>

                <!-- Hour Price Default -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="מחיר לשעה (ברירת מחדל)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="ערך זה ישמש כברירת מחדל בדוחות R01 עבור חישוב שעות לפי סכום שהוגש" 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HourPriceTextBox" 
                             Width="120" 
                             VerticalContentAlignment="Center"
                             Padding="5,3"/>
                    <TextBlock Text="₪" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Inspection Templates Folder -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="תיקיית תבניות ביקורת (Google Drive)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="מזהה תיקייה ב-Google Drive שמכילה את תבניות הביקורת (Google Sheets בלבד). המשתמשים יראו רשימה של גיליונות מתוך תיקייה זו." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="InspectionFolderIdTextBox" 
                         Width="350" 
                         HorizontalAlignment="Right"
                         VerticalContentAlignment="Center"
                         Padding="5,3"
                         FlowDirection="LeftToRight"
                         ToolTip="Google Drive Folder ID (from the folder URL)"
                         LostFocus="InspectionFolderIdTextBox_LostFocus"/>

                <!-- Validate button + folder name preview -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                    <Button x:Name="ValidateFolderButton"
                            Content="🔍 בדוק חיבור"
                            Click="ValidateFolderButton_Click"
                            Padding="8,3"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            ToolTip="בדוק שהמזהה תקין ושיש גישה לתיקייה"/>
                </StackPanel>
                <TextBlock x:Name="FolderPreviewLabel"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>

                <!-- Reports Google Drive Folder -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="תיקיית דוחות ביקורת (Google Drive)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="מזהה תיקייה (Folder ID) ב-Google Drive לשמירת דוחות ביקורת מיוצאים. הדוחות יישמרו בתיקייה זו במבנה: [פרויקט אב]/[פרויקט]/[דוח]." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="ReportsFolderIdTextBox"
                         Width="350"
                         HorizontalAlignment="Right"
                         VerticalContentAlignment="Center"
                         Padding="5,3"
                         FlowDirection="LeftToRight"
                         ToolTip="Google Drive Folder ID (מופיע בכתובת ה-URL של התיקייה)"
                         LostFocus="ReportsFolderIdTextBox_LostFocus"/>

                <!-- Validate button + folder name preview -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                    <Button x:Name="ValidateReportsFolderButton"
                            Content="🔍 בדוק חיבור"
                            Click="ValidateReportsFolderButton_Click"
                            Padding="8,3"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            ToolTip="בדוק שהמזהה תקין ושיש גישה לתיקייה"/>
                </StackPanel>
                <TextBlock x:Name="ReportsFolderPreviewLabel"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>

                <!-- Status Default Colors -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="צבעי סטטוס (ברירת מחדל גלובלית)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="צבעים אלו ישפיעו על כל המשתמשים. משתמש יכול לדרוס בצבע אישי." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <ItemsControl x:Name="StatusColorsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StatusName}" 
                                               VerticalAlignment="Center" FontWeight="SemiBold"/>

                                    <xctk:ColorPicker x:Name="AdminColorPicker" Grid.Column="1"
                                                      SelectedColor="{Binding ColorHex, Converter={StaticResource HexToColor}, Mode=TwoWay}"
                                                      ShowStandardColors="True"
                                                      ShowRecentColors="True"
                                                      UsingAlphaChannel="False"
                                                      Width="130"
                                                      Margin="0,0,8,0"
                                                      ToolTip="בחר צבע לסטטוס"/>

                                    <!-- Live badge preview (mirrors task grid appearance) -->
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                            MinWidth="60" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding SelectedColor, ElementName=AdminColorPicker}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding StatusName}" Foreground="#333"
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" 
                                               Margin="4,0,0,0" Opacity="0.7">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="פתוח"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                                        <Setter Property="Text" Value="סגור"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Inspection Status Labels -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="תוויות סטטוס ביקורת" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="שמות הסטטוסים שיוצגו בדוחות ביקורת ובתפריטים. ניתן לשנות לטקסט מותאם אישית." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="מקובל (Passed):" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="StatusLabelPassedTextBox" Grid.Row="0" Grid.Column="1"
                             Width="200" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="הערה (Failed):" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="StatusLabelFailedTextBox" Grid.Row="1" Grid.Column="1"
                             Width="200" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="הערה חוזרת (Recurring):" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="StatusLabelRecurringFailedTextBox" Grid.Row="2" Grid.Column="1"
                             Width="200" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="לא רלוונטי (N/A):" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox x:Name="StatusLabelNotApplicableTextBox" Grid.Row="3" Grid.Column="1"
                             Width="200" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"/>
                </Grid>

                <Button x:Name="RestoreStatusDefaultsButton"
                        Content="🔄 שחזר ברירות מחדל"
                        Click="RestoreStatusDefaultsButton_Click"
                        Padding="8,3"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        ToolTip="שחזר את תוויות הסטטוס לערכי ברירת המחדל"/>

                <!-- AI (Ollama) Settings -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="📐 נתיב תבנית חותמת DWF (אופציונלי)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="נתיב לקובץ תבנית חותמת DWF בלבד. קבצי PDF מקבלים חותמת פרוגרמטית עם תאריך ושם בודק אוטומטיים. אם לא מוגדר – קבצי DWF ידולגו." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StampTemplatePathTextBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="נתיב לקובץ תבנית חותמת DWF (אופציונלי)"/>
                    <Button Grid.Column="1" Content="📂"
                            Click="BrowseStampTemplate_Click"
                            Padding="6,3" Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            ToolTip="בחר קובץ תבנית חותמת DWF"/>
                </Grid>

                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="🤖 הגדרות AI (Ollama)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="בחר את מודל ה-AI המקומי לבדיקת הערות ביקורת. מודלים קטנים (4B) מהירים יותר, מודלים גדולים (26B) מדויקים יותר אך דורשים חומרה חזקה." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="כתובת שרת:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="OllamaBaseUrlTextBox" Grid.Row="0" Grid.Column="1"
                             Width="250" HorizontalAlignment="Right"
                             Padding="5,3" Margin="0,0,0,6"
                             FlowDirection="LeftToRight"
                             ToolTip="כתובת שרת Ollama (למשל: http://192.168.1.50:11434). ברירת מחדל: http://localhost:11434"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="מודל AI:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox x:Name="OllamaModelComboBox" Grid.Row="1" Grid.Column="1"
                              Width="250" HorizontalAlignment="Right"
                              Padding="5,3" Margin="0,0,0,6"
                              FlowDirection="LeftToRight"
                              IsEditable="True"
                              ToolTip="בחר מודל מהרשימה או הקלד שם מודל ידנית"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="סטטוס:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OllamaStatusLabel" Grid.Row="2" Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0"/>
                </Grid>
                <Button x:Name="OllamaTestButton"
                        Content="🔍 בדוק חיבור AI"
                        Click="OllamaTestButton_Click"
                        Padding="8,3"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="#CCC"
                        BorderThickness="1"
                        ToolTip="בדוק שהשרת המקומי פועל ושהמודל זמין"/>

                <!-- AI Model Catalog & per-level selection -->
                <Separator Margin="0,20,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🧠 בחירת מודלי AI לפי רמה" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Grid.Column="1" x:Name="OpenAiCatalogButton"
                            Content="📚 קטלוג מודלים..."
                            Click="OpenAiCatalogButton_Click"
                            Padding="8,3" Cursor="Hand"
                            Background="Transparent" BorderBrush="#CCC" BorderThickness="1"
                            ToolTip="פתח את קטלוג מודלי ה-AI להורדה / הגדרה"/>
                </Grid>
                <TextBlock Text="כל רמה מצביעה על מודל אחד מהרשימה. הרשימה מאחדת מודלים מקומיים מותקנים (Ollama) ומודלי ענן שהוגדרו בקטלוג."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Simple:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SelectedSimpleModel" Grid.Row="0" Grid.Column="1"
                              Width="320" HorizontalAlignment="Right"
                              Padding="5,3" Margin="0,0,0,6"
                              FlowDirection="LeftToRight"
                              DisplayMemberPath="Display"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="QualityCheck:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SelectedQualityCheckModel" Grid.Row="1" Grid.Column="1"
                              Width="320" HorizontalAlignment="Right"
                              Padding="5,3" Margin="0,0,0,6"
                              FlowDirection="LeftToRight"
                              DisplayMemberPath="Display"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Writing:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SelectedWritingModel" Grid.Row="2" Grid.Column="1"
                              Width="320" HorizontalAlignment="Right"
                              Padding="5,3" Margin="0,0,0,6"
                              FlowDirection="LeftToRight"
                              DisplayMemberPath="Display"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="DeepAnalysis:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SelectedDeepAnalysisModel" Grid.Row="3" Grid.Column="1"
                              Width="320" HorizontalAlignment="Right"
                              Padding="5,3" Margin="0,0,0,6"
                              FlowDirection="LeftToRight"
                              DisplayMemberPath="Display"/>
                </Grid>

                <!-- Centralized Logging -->
                <Separator Margin="0,20,0,10"/>
                <TextBlock Text="📋 לוגים מרוכזים" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="מיקום אחד שאליו כל היישומים (Client, AccService, SyncEngine) כותבים לוג. רמת הסף נקבעת בנפרד לכל יישום לקובץ המקומי ולתיקייה המרוכזת. שינוי נכנס לתוקף בהפעלה הבאה של היישום." 
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="נתיב מרוכז (UNC או מקומי):" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LoggingCentralPathTextBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Padding="5,3"
                             FlowDirection="LeftToRight"
                             ToolTip="ריק = הסינק המרוכז כבוי. ברירת מחדל: \\si-win-2k19\AutoCAD Data\log"/>
                    <Button Grid.Column="1" Content="בדוק כתיבה"
                            Click="TestCentralLogPath_Click"
                            Padding="6,3" Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            ToolTip="צור את התיקייה (אם חסרה) ובדוק הרשאות כתיבה"/>
                    <Button Grid.Column="2" Content="📂 פתח"
                            Click="OpenCentralLogPath_Click"
                            Padding="6,3" Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            ToolTip="פתח את התיקייה ב-Explorer"/>
                </Grid>
                <TextBlock x:Name="LoggingPathStatusLabel"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Opacity="0.8"
                           Visibility="Collapsed"/>

                <!-- Per-app levels -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="יישום" FontWeight="SemiBold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="קובץ מקומי" FontWeight="SemiBold" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="קובץ מרוכז" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client (WPF)" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="LoggingClientFileLevelCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" Padding="5,3" FlowDirection="LeftToRight"/>
                    <ComboBox x:Name="LoggingClientCentralLevelCombo" Grid.Row="1" Grid.Column="2" Margin="0,0,0,4" Padding="5,3" FlowDirection="LeftToRight"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="AccService" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="LoggingAccFileLevelCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,8,4" Padding="5,3" FlowDirection="LeftToRight"/>
                    <ComboBox x:Name="LoggingAccCentralLevelCombo" Grid.Row="2" Grid.Column="2" Margin="0,0,0,4" Padding="5,3" FlowDirection="LeftToRight"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SyncEngine" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="LoggingSyncFileLevelCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,8,4" Padding="5,3" FlowDirection="LeftToRight"/>
                    <ComboBox x:Name="LoggingSyncCentralLevelCombo" Grid.Row="3" Grid.Column="2" Margin="0,0,0,4" Padding="5,3" FlowDirection="LeftToRight"/>
                </Grid>

                <!-- Retention -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="שמירת קבצים מקומיים (ימים):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox x:Name="LoggingLocalRetentionTextBox" Grid.Row="0" Grid.Column="1"
                             Width="80" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"
                             FlowDirection="LeftToRight"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="שמירת קבצים מרוכזים (ימים):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox x:Name="LoggingCentralRetentionTextBox" Grid.Row="1" Grid.Column="1"
                             Width="80" HorizontalAlignment="Right" Padding="5,3" Margin="0,0,0,4"
                             FlowDirection="LeftToRight"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="שמור" 
                    Click="SaveButton_Click"
                    Width="80" Height="30" 
                    FontWeight="Bold"
                    Background="#2E7D32"
                    Foreground="White"/>
            <Button Content="ביטול" 
                    Click="CancelButton_Click"
                    Width="80" Height="30" 
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
