<Window x:Class="SiNetProjectManagerV2.WPF_Window.ProvisioningPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="סיסמת חבילת הגדרות"
        Height="220" Width="420"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="הזן סיסמה לחבילת ההגדרות"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>

        <!-- Description -->
        <TextBlock Grid.Row="1" x:Name="TxtDescription"
                   Text="הסיסמה משמשת להצפנת/פענוח כל המפתחות בחבילה."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

        <!-- Password -->
        <DockPanel Grid.Row="2">
            <TextBlock Text="סיסמה:" Width="70" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            <PasswordBox x:Name="TxtPassword" FlowDirection="LeftToRight"
                         Padding="4,3" Margin="4,2" KeyDown="TxtPassword_KeyDown"/>
        </DockPanel>

        <!-- Confirm (visible only for export) -->
        <DockPanel Grid.Row="3" x:Name="PanelConfirm" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock Text="אימות:" Width="70" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            <PasswordBox x:Name="TxtConfirm" FlowDirection="LeftToRight"
                         Padding="4,3" Margin="4,2" KeyDown="TxtPassword_KeyDown"/>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button x:Name="BtnOk" Content="אישור" Width="90" Height="30" Margin="0,0,8,0"
                    FontWeight="Bold" Click="BtnOk_Click"/>
            <Button Content="ביטול" Width="90" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
