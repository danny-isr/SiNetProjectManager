<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.EmailManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
             xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:EmailManagementViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <!--
        DataContext is intentionally NOT declared in XAML.
        MainWindow.xaml.cs assigns a DI-built EmailManagementViewModel
        (with shared GoogleService) on creation. The previous
        <UserControl.DataContext><vm:EmailManagementViewModel/></UserControl.DataContext>
        block silently instantiated a second VM (creating an extra GoogleService)
        that was immediately discarded when MainWindow re-assigned DataContext.
        The d:DataContext above keeps Designer IntelliSense without runtime creation.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SiNetProjectManagerV2;component/Resources/EmailManagementViewResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Marker: Resources moved to Resources/EmailManagementViewResources.xaml -->

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Status Bar + Project Filters (Combined) -->
        <Border Grid.Row="0" 
                Background="#F5F5F5" 
                Padding="10,5" 
                Margin="0,0,0,8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Text with Error Count (extracted) -->
                <controls:EmailTopStatusBarControl Grid.Column="0"/>
                
                <!-- Pagination Controls (extracted) -->
                <controls:EmailPaginationControl Grid.Column="1" Margin="0,0,20,0"/>

                <!-- Refresh Button + Calendar Toggle + Help Popup -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Refresh + Calendar Toggle (extracted) -->
                    <controls:EmailRefreshAndCalendarToggleControl/>

                    <!-- Help Button + Popup (extracted) -->
                    <controls:EmailHelpPopupControl Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <controls:SearchableProjectSelector
                    ItemsSource="{Binding ProjectsView}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ExternalFilter="{Binding ProjectFilterPredicate}"
                    FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                    SortPropertyPath="Number"
                    SortAscending="False"
                    Width="350" 
                    Margin="0,0,10,0" 
                    ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

                <Button Content="🔄"
                        Width="28" Height="24"
                        Margin="0,0,10,0"
                        Padding="0"
                        FontSize="14"
                        Command="{Binding RefreshProjectsCommand}"
                        ToolTip="רענן רשימת פרויקטים מהשרת"/>

                <ComboBox Width="120" 
                          Margin="0,0,10,0"
                          ItemsSource="{Binding JobTypes}"
                          SelectedItem="{Binding SelectedJobTypeFilter}"
                          DisplayMemberPath="Title"
                          ToolTip="Job Type"/>

                <ComboBox Width="120" 
                          Margin="0,0,10,0"
                          ItemsSource="{Binding ProjectStatuses}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="Title"
                          ToolTip="Status"/>

                <ComboBox Width="120"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUserFilter}"
                          DisplayMemberPath="Name"
                          ToolTip="User"/>

                <TextBlock Text="🔎 Gmail"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0"
                           FontSize="11"
                           FontWeight="SemiBold"/>

                <TextBox Width="170"
                         Height="24"
                         VerticalContentAlignment="Center"
                         Text="{Binding GmailSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="חיפוש חופשי ב-Gmail"
                         FontSize="11"
                         Margin="0,0,6,0"/>

                <DatePicker Width="90"
                            Height="24"
                            Margin="0,0,6,0"
                            SelectedDate="{Binding GmailSearchFromDate, Mode=TwoWay}"
                            ToolTip="מתאריך"/>

                <DatePicker Width="90"
                            Height="24"
                            Margin="0,0,6,0"
                            SelectedDate="{Binding GmailSearchToDate, Mode=TwoWay}"
                            ToolTip="עד תאריך"/>

                <Button Command="{Binding SearchEmailsCommand}"
                        Content="חפש"
                        Padding="8,2"
                        MinWidth="46"
                        Height="24"
                        FontSize="11"
                        Margin="0,0,4,0"
                        ToolTip="טען מיילים מחדש לפי החיפוש והתאריך"/>

                <Button Command="{Binding ClearEmailSearchCommand}"
                        Content="נקה"
                        Padding="8,2"
                        MinWidth="46"
                        Height="24"
                        FontSize="11"
                        ToolTip="נקה חיפוש ותאריכים"/>
            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ROW 1: Selected Project Info (extracted) -->
        <controls:EmailSelectedProjectInfoControl Grid.Row="1" Margin="0,0,0,10"/>

        <!-- ROW 2: Main Content Area (RTL: Column 0 = visual Right, last column = visual Left) -->
        <Grid Grid.Row="2" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CALENDAR SIDEBAR (visually Far-Left in RTL — last column) -->
            <wv2:WebView2 x:Name="CalendarWebView"
                           Grid.Column="4"
                           Width="385"
                           MinWidth="220"
                           MaxWidth="480"
                           FlowDirection="LeftToRight"
                           Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- SPLITTER: Email List | Email Viewer -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- EMAIL LIST (visually Right in RTL — first column) -->
            <controls:EmailListControl Grid.Column="0"/>

            <!-- SPLITTER: Email Viewer | Calendar -->
            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE"
                          Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- CENTER COLUMN: Email Viewer -->
            <Border Grid.Column="2" 
                    FlowDirection="LeftToRight"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <!-- No Email Selected -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <TextBlock Text="Mail" FontSize="64" HorizontalAlignment="Center" Foreground="#CCC"/>
                        <TextBlock Text="Select an email from the list" 
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Email Content -->
                    <Grid Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Email Viewer Component (Header + Attachments + Body) -->
                        <controls:EmailViewerControl x:Name="EmailViewerCtl" Grid.Row="0"
                                                   ViewModel="{Binding EmailViewer}"
                                                   TagTargets="{Binding TagTargets}"/>

                        <!-- Row 1: Action Bar (extracted) -->
                        <controls:EmailActionBarControl Grid.Row="1"/>

                        <!-- Row 2: Email Context Panel (Workflow + Suggested Actions) -->
                        <!--
                            DataContext is intentionally pinned to {x:Null} here so the panel
                            does NOT inherit the parent EmailManagementViewModel. The real
                            EmailContextViewModel is injected in code-behind (OnLoaded) via
                            App.ServiceProvider. Without this pin, the bindings inside
                            EmailContextPanel (HasContext / ProjectDisplay / SuggestedActions /
                            ExecuteActionCommand / ...) would evaluate against
                            EmailManagementViewModel during the initial render pass and
                            produce noisy BindingExpression path errors.
                        -->
                        <local:EmailContextPanel x:Name="EmailContextPanel"
                                                  Grid.Row="2"
                                                  DataContext="{x:Null}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
