<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.EmailContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="800"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Loading indicator (overlays when active) -->
            <StackPanel Grid.Row="0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Orientation="Horizontal">
                <TextBlock Text="⏳" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 0: Idle / Error state (when not loading and no context yet) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding HasContext}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📋 " VerticalAlignment="Center"
                           FontSize="{DynamicResource AppFontSizeSmall}"/>
                <TextBlock Text="{Binding StatusMessage, TargetNullValue='בחר מייל לניתוח הקשר'}"
                           Foreground="Gray" VerticalAlignment="Center"
                           FontSize="{DynamicResource AppFontSizeSmall}"/>
            </StackPanel>

            <!-- Row 0: Context summary — horizontal colored chips -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal"
                       Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="📋" Margin="0,0,4,0" VerticalAlignment="Center"/>

                <!-- Project chip -->
                <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="פרויקט: " FontWeight="SemiBold" Foreground="#1565C0"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                        <TextBlock Text="{Binding ProjectDisplay}" Foreground="#1565C0"
                                   FontSize="{DynamicResource AppFontSizeSmall}"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProjectDisplay}"/>
                    </StackPanel>
                </Border>

                <!-- Workflow family chip -->
                <Border Background="#F3E5F5" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליך: " FontWeight="SemiBold" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                        <TextBlock Text="{Binding WorkflowFamilyDisplay}" Foreground="#7B1FA2"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                    </StackPanel>
                </Border>

                <!-- Confidence chip -->
                <Border Background="#FFF3E0" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ביטחון: " FontWeight="SemiBold" Foreground="#E65100"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                        <TextBlock Text="{Binding ConfidenceDisplay}" Foreground="#E65100"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                    </StackPanel>
                </Border>

                <!-- Active workflows chip -->
                <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="תהליכים: " FontWeight="SemiBold" Foreground="#2E7D32"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                        <TextBlock Text="{Binding Context.ActiveWorkflows.Count, FallbackValue=0}"
                                   Foreground="#2E7D32"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                    </StackPanel>
                </Border>

                <!-- Attachments chip -->
                <Border Background="#FFF8E1" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎 " Foreground="#F57F17"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                        <TextBlock Text="{Binding Context.AttachmentAnalysis.TotalCount, FallbackValue=0}"
                                   Foreground="#F57F17"
                                   FontSize="{DynamicResource AppFontSizeSmall}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Row 1: Action selector + execute button (inline) -->
            <Grid Grid.Row="1" Margin="0,3,0,0"
                  Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="פעולה:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="{DynamicResource AppFontSizeSmall}"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SuggestedActions}"
                          SelectedItem="{Binding SelectedAction}"
                          DisplayMemberPath="DisplayText"
                          VerticalAlignment="Center"
                          FontSize="{DynamicResource AppFontSizeSmall}"/>

                <Button Grid.Column="2" Content="▶ בצע"
                        Command="{Binding ExecuteActionCommand}"
                        Padding="10,2" Margin="6,0,0,0"
                        Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource AppFontSizeSmall}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding LastResultMessage}"
                           Foreground="#1565C0" VerticalAlignment="Center"
                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource AppFontSizeSmall}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
