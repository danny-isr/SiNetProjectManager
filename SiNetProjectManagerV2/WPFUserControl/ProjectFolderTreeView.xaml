<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.ProjectFolderTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0: סינונים -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,5"
                    Visibility="{Binding ShowProjectSelector, Converter={StaticResource BoolToVis}}">
            <controls:SearchableProjectSelector
                ItemsSource="{Binding ProjectsView}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ExternalFilter="{Binding ProjectFilterPredicate}"
                FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                SortPropertyPath="Number"
                SortAscending="False"
                Width="300" Margin="0,0,5,0"
                ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

            <!-- Place and Company filters removed - SearchableProjectSelector handles these via text search -->

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding JobTypes}"
                      SelectedItem="{Binding SelectedJobTypeFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סוג פרויקט" />

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding ProjectStatuses}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סטטוס" />

            <ComboBox Width="120"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUserFilter}"
                      DisplayMemberPath="Name"
                      ToolTip="משתמש (Siuser.Name)" />
        </StackPanel>



        <!-- 1: בחירת פרויקט -->
        
        <!-- 2: פרטי הפרויקט -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Padding="5" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="4" Background="#F9F9F9" Margin="0,0,0,10"
                Visibility="{Binding ShowProjectSelector, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ProjectDetails}" TextWrapping="Wrap" />
        </Border>

        <!-- סינון: הצג רק קבצים קיימים -->
        <CheckBox Grid.Row="2" Grid.Column="1"
                  Content="הצג רק קבצים קיימים"
                  IsChecked="{Binding ShowOnlyExistingFiles}"
                  HorizontalAlignment="Right"
                  Margin="0,0,10,5"
                  ToolTip="מסנן קבצים ללא גרסאות – מציג רק קבצים שקיימים בפועל על השרת, ב-ACC או ב-Drive" />

        <!-- 3: עץ תיקיות (TreeView כולל ScrollViewer פנימי משלו) -->
        <TreeView Grid.Row="3" Grid.Column="0"
                  ItemsSource="{Binding RootFolders}"
                  SelectedItemChanged="TreeView_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                        <Image Width="16" Height="16" Margin="0,0,5,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="/Assets/folder_project.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUserCreated}" Value="True">
                                            <Setter Property="Source" Value="/Assets/folder_user.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 3: עץ קבצים — reusable ProjectFileTreeControl -->
        <controls:ProjectFileTreeControl Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"
            x:Name="FileTreeControl"
            ProjectFiles="{Binding ProjectFiles}"
            FileDropCommand="{Binding HandleFileDropCommand}" />
    </Grid>
</UserControl>
