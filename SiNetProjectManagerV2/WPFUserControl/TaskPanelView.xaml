<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.TaskPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="{DynamicResource AppBackground}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StatusIdToColorConverter x:Key="StatusIdToColor"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="DropdownStyle">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- Task row visual states: Active / Waiting / Closed -->
        <Style TargetType="DataGridRow" x:Key="TaskRowStyle">
            <Style.Triggers>
                <!-- Waiting: alive but ball is outside (IsOpen=true, IsActionable=false) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AssignmentStatus.IsOpen}" Value="True"/>
                        <Condition Binding="{Binding AssignmentStatus.IsActionable}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </MultiDataTrigger>
                <!-- Closed: done (IsOpen=false) -->
                <DataTrigger Binding="{Binding AssignmentStatus.IsOpen}" Value="False">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#888"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Employee Selection -->
        <Border Grid.Row="0" Background="#E8F4FC" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="תור עבודה של:" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Employees}" 
                          SelectedItem="{Binding SelectedEmployee}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsEmployeeSelectionEnabled}"
                          Width="180"
                          Style="{StaticResource DropdownStyle}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="הצג גם משימות סגורות" 
                              IsChecked="{Binding IncludeClosedTasks}"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"/>

                    <CheckBox Content="📝 הערות מלאות" 
                              IsChecked="{Binding ShowFullNotes}"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              ToolTip="הצג/הסתר הערות אחרונות במלואן"/>
                </StackPanel>

                <Button Grid.Column="3" Content="▲" ToolTip="העבר למעלה"
                        Command="{Binding MoveTaskUpCommand}" 
                        Style="{StaticResource SmallButton}" Width="30"/>
                <Button Grid.Column="4" Content="▼" ToolTip="העבר למטה"
                        Command="{Binding MoveTaskDownCommand}" 
                        Style="{StaticResource SmallButton}" Width="30"/>
            </Grid>
        </Border>

        <!-- Create Task Area - Compact -->
        <Border Grid.Row="1" Background="#FFF8E1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="משימה חדשה:" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Project Selector - High Performance with ICollectionView -->
                <controls:SearchableProjectSelector
                    ItemsSource="{Binding AllProjects}"
                    SelectedItem="{Binding NewTaskProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ExcludedNumbers="{Binding ExcludedProjectNumbers}"
                    SortPropertyPath="Number"
                    SortAscending="False"
                    Width="320"
                    ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

                <!-- Task Type - Bound to filtered list, disabled until project selected -->
                <ComboBox ItemsSource="{Binding AllowedTaskTypesForCreate}" 
                          SelectedItem="{Binding NewTaskType}"
                          DisplayMemberPath="Name"
                          Width="100"
                          Style="{StaticResource DropdownStyle}"
                          IsEnabled="{Binding CanSelectTaskType}"
                          ToolTip="סוג משימה - יש לבחור פרויקט תחילה"/>

                <!-- Status - Bound to filtered list, disabled until project selected -->
                <ComboBox ItemsSource="{Binding AllowedStatusesForCreate}" 
                          SelectedItem="{Binding NewTaskStatus}"
                          DisplayMemberPath="Name"
                          Width="120"
                          Style="{StaticResource DropdownStyle}"
                          IsEnabled="{Binding CanSelectStatusForCreate}"
                          ToolTip="סטטוס - יש לבחור פרויקט תחילה"/>

                <!-- Due Date -->
                <DatePicker SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"
                            Width="110"
                            Margin="2"
                            SelectedDateFormat="Short"
                            ToolTip="תאריך יעד (אופציונלי)"/>

                <Button Content="צור" 
                        Command="{Binding CreateTaskCommand}"
                        Style="{StaticResource ActionButton}"
                        ToolTip="צור משימה חדשה"/>

                <Button Content="רענן" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource ActionButton}"
                        Margin="15,2,2,2"/>
            </StackPanel>
        </Border>

        <!-- Main Task Grid with Inline Editing -->
        <DataGrid x:Name="TasksGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Tasks}"
                  SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CanUserResizeRows="False"
                  ColumnHeaderHeight="32"
                  HorizontalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  RowStyle="{StaticResource TaskRowStyle}"
                  BorderBrush="#DDD" 
                  BorderThickness="1"
                  Background="White"
                  Margin="5">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="בחר פרויקט"
                              Command="{Binding SelectProjectCommand}"
                              InputGestureText=""/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- WorkPriority - Read only display -->
                <DataGridTextColumn Header="עדיפות" 
                                    Binding="{Binding WorkPriority}" 
                                    Width="Auto"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- TaskType - Read only -->
                <DataGridTextColumn Header="סוג" 
                                    Binding="{Binding TaskType.Name}" 
                                    Width="Auto"
                                    IsReadOnly="True"/>

                <!-- Title - Read only (shows action description for email-sourced tasks) -->
                <DataGridTextColumn Header="כותרת" 
                                    Binding="{Binding Title}" 
                                    Width="Auto"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="MaxWidth" Value="250"/>
                            <Setter Property="ToolTip" Value="{Binding Title}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status - Inline ComboBox with immediate save -->
                <DataGridTemplateColumn Header="סטטוס" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="2" CornerRadius="3"
                                    Background="{Binding StatusId, Converter={StaticResource StatusIdToColor}}">
                                <TextBlock Text="{Binding AssignmentStatus.Name}" 
                                           Foreground="#333" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AllowedStatusesForEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding StatusId, Mode=TwoWay}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      IsDropDownOpen="True"
                                      Tag="{Binding}"
                                      SelectionChanged="StatusComboBox_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Project - Inline searchable ComboBox with immediate save -->
                <DataGridTemplateColumn Header="פרויקט" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Project.NameAndNumber}" 
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.FilteredProjectsForEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Project, Mode=TwoWay}"
                                      Text="{Binding DataContext.EditProjectFilterText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="NameAndNumber"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      IsDropDownOpen="True"
                                      Tag="{Binding}"
                                      SelectionChanged="ProjectComboBox_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- DueDate - Inline DatePicker with immediate save -->
                <DataGridTemplateColumn Header="תאריך יעד" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DueDate, StringFormat=dd/MM/yyyy}" 
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                        SelectedDateFormat="Short"
                                        Tag="{Binding}"
                                        SelectedDateChanged="DueDatePicker_SelectedDateChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Created - Read only -->
                <DataGridTextColumn Header="נוצר" 
                                    Binding="{Binding Created, StringFormat=dd/MM/yyyy}" 
                                    Width="Auto"
                                    IsReadOnly="True"/>

                <!-- Last business result (TaskResultDefinition) - read only -->
                <DataGridTextColumn Header="תוצאה אחרונה"
                                    Binding="{Binding LastTaskResult.Name}"
                                    Width="Auto"
                                    IsReadOnly="True"/>

                <!-- Notes Preview - LAST column, takes all remaining space -->
                <DataGridTemplateColumn Header="הערות" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RecentNotesSummary}" 
                                       VerticalAlignment="Top"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.7"
                                       Padding="2"
                                       ToolTip="{Binding RecentNotesSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="MaxHeight" Value="20"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowFullNotes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="MaxHeight" Value="200"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- Compact Row Details: History + Add Note -->
            <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Open Action Button (visible only for email-action tasks) -->
                                <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,6"
                                        Visibility="{Binding DataContext.SelectedTaskHasAction, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding DataContext.SelectedTaskActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="#C8E6C9" BorderBrush="#66BB6A"
                                                FontWeight="Bold" Padding="12,6" Margin="0,0,8,0"
                                                Cursor="Hand"/>
                                        <TextBlock Text="לחץ לפתיחת הפעולה המקושרת"
                                                   Foreground="#388E3C" FontSize="11"
                                                   VerticalAlignment="Center" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <!-- Row 1: Event History -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding DataContext.SelectedTaskEvents, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserResizeColumns="True"
                                          CanUserReorderColumns="True"
                                          HeadersVisibility="Column"
                                          MaxHeight="220"
                                          MinHeight="80"
                                          GridLinesVisibility="Horizontal"
                                          BorderBrush="#DDD"
                                          BorderThickness="1"
                                          Background="White"
                                          MinRowHeight="24">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="תאריך" 
                                                            Binding="{Binding LocalCreatedDate, StringFormat=dd/MM HH:mm}" 
                                                            Width="95"
                                                            MinWidth="70"/>
                                        <DataGridTextColumn Header="סוג" 
                                                            Binding="{Binding EventType}" 
                                                            Width="95"
                                                            MinWidth="60"/>
                                        <DataGridTextColumn Header="סטטוס קודם" 
                                                            Binding="{Binding OldStatus.Name}" 
                                                            Width="90"
                                                            MinWidth="60"/>
                                        <DataGridTextColumn Header="סטטוס חדש" 
                                                            Binding="{Binding NewStatus.Name}" 
                                                            Width="90"
                                                            MinWidth="60"/>
                                        <DataGridTextColumn Header="ע״י" 
                                                            Binding="{Binding CreatedByUser.Name}" 
                                                            Width="80"
                                                            MinWidth="50"/>
                                        <DataGridTextColumn Header="הערה" 
                                                            Binding="{Binding Note}" 
                                                            Width="*"
                                                            MinWidth="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Undo Last Event Button -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding DataContext.CanUndoLastEvent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="↩ בטל פעולה אחרונה"
                                            Command="{Binding DataContext.UndoLastEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource SmallButton}"
                                            Foreground="#C62828"
                                            ToolTip="מחיקת האירוע האחרון בלבד (LIFO) - לא ניתן למחוק את אירוע היצירה"/>
                                </StackPanel>

                                <!-- Pending Emails to Tag (visible only when pending emails exist) -->
                                <ItemsControl Grid.Row="3"
                                              ItemsSource="{Binding DataContext.PendingEmails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Margin="0,8,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8,5" Margin="0,2"
                                                    BorderBrush="#FFB74D" BorderThickness="1"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding Subject}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.NavigateToEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding EmailId}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📧" FontSize="14"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Foreground="#E65100"/>
                                                        <TextBlock Foreground="#888" FontSize="11">
                                                            <Run Text="{Binding FromAddress, Mode=OneWay}"/>
                                                            <Run Text=" · " Foreground="#CCC"/>
                                                            <Run Text="{Binding DateDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#FFF8E1" CornerRadius="3"
                                                            Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                                   Foreground="#F57F17" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="← לחץ לתיוק" FontSize="11"
                                                               Foreground="#FF9800" VerticalAlignment="Center"
                                                               FontStyle="Italic"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Task Links (visible only when links exist) -->
                                <ItemsControl Grid.Row="4"
                                              ItemsSource="{Binding DataContext.SelectedTaskLinks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="3" Padding="6,3" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="🔗" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}"
                                                               FontWeight="SemiBold" Foreground="#2E7D32"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Summary}">
                                                        <Run Text="{Binding EntityTypeDisplay, Mode=OneWay}"/>
                                                        <Run Text=": " Foreground="#666"/>
                                                        <Run Text="{Binding LinkedEntityName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Grid.Column="3" Background="#FFF3E0" CornerRadius="8" Padding="6,1" Margin="6,0,2,0"
                                                            Visibility="{Binding IsWorkTarget, Converter={StaticResource BoolToVisibility}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WorkStatusDisplay}" FontSize="10" Foreground="#E65100"/>
                                                    </Border>
                                                    <Button Grid.Column="4" Content="✓" FontSize="10"
                                                            Command="{Binding DataContext.MarkWorkTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="#2E7D32" Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsWorkTarget, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="סמן יעד עבודה כהושלם"/>
                                                    <Button Grid.Column="5" Content="✕" FontSize="10"
                                                            Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding LinkId}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="#999" Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            ToolTip="הסר קישור"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add Note - Multi-line -->
                                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="הערה חדשה:" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DataContext.NewNote, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="80"
                                                 MaxHeight="160"
                                                 Padding="4"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Content="הוסף" 
                                            Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Bottom"
                                            Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="80" Height="8" 
                             Margin="15,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
