<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.WorkflowDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
             xmlns:models="clr-namespace:SiNetSQL.Models;assembly=SiNetSQL"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}"
             FlowDirection="RightToLeft"
             Focusable="True"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:WorkflowEnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:ItemIndexConverter x:Key="ItemIndex"/>

        <!-- Enum value sources for ComboBoxes -->
        <ObjectDataProvider x:Key="TriggerTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowTransitionTriggerType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ConditionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowTransitionConditionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EvaluationModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowEvaluationMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ActionTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowTransitionActionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="SubWfWaitModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowSubWorkflowWaitMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StartTriggerSourceValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WorkflowStartTriggerSource"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EmailFileTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:EmailFileType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- ═══ NODE TEMPLATES ═══ -->

        <!-- Stage: rounded rectangle -->
        <DataTemplate x:Key="StageNodeTemplate">
            <Grid>
                <!-- Glow effect when selected -->
                <Border CornerRadius="10"
                        MinWidth="{Binding DefaultWidth}" MinHeight="{Binding DefaultHeight}"
                        Margin="-3" Opacity="{Binding GlowOpacity}">
                    <Border.Effect>
                        <BlurEffect Radius="8"/>
                    </Border.Effect>
                    <Border.Background>
                        <SolidColorBrush Color="#FF5722"/>
                    </Border.Background>
                </Border>
                <!-- Main node -->
                <Border CornerRadius="8"
                        MinWidth="{Binding DefaultWidth}" MinHeight="{Binding DefaultHeight}"
                        Background="{Binding NodeBrush}" Opacity="0.92"
                        BorderBrush="{Binding SelectionBrush}" BorderThickness="3"
                        Cursor="Hand" Padding="8,6"
                        MouseLeftButtonDown="Node_MouseLeftButtonDown"
                        MouseMove="Node_MouseMove"
                        MouseLeftButtonUp="Node_MouseLeftButtonUp">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120"/>
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#E0E0E0"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="120" MaxHeight="30"/>
                    </StackPanel>
                </Border>
                <!-- Index badge -->
                <Border Background="#37474F" CornerRadius="8" MinWidth="24" Height="16"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4,-4,0,0" Padding="4,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Decision: diamond via RotateTransform -->
        <DataTemplate x:Key="DecisionNodeTemplate">
            <Grid Width="{Binding DefaultWidth}" Height="{Binding DefaultHeight}"
                  Cursor="Hand"
                  MouseLeftButtonDown="Node_MouseLeftButtonDown"
                  MouseMove="Node_MouseMove"
                  MouseLeftButtonUp="Node_MouseLeftButtonUp">
                <Grid.Background>
                    <SolidColorBrush Color="Transparent"/>
                </Grid.Background>
                <Border Background="{Binding NodeBrush}" CornerRadius="4"
                        Width="56" Height="56"
                        RenderTransformOrigin="0.5,0.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{Binding SelectionBrush}" BorderThickness="2">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" TextAlignment="Center"/>
                <!-- Index badge -->
                <Border Background="#37474F" CornerRadius="8" MinWidth="24" Height="16"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4,-4,0,0" Padding="4,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Start/End: circle -->
        <DataTemplate x:Key="CircleNodeTemplate">
            <Grid>
                <Border CornerRadius="30"
                        Width="{Binding DefaultWidth}" Height="{Binding DefaultHeight}"
                        Background="{Binding NodeBrush}"
                        BorderBrush="{Binding SelectionBrush}" BorderThickness="3"
                        Cursor="Hand"
                        MouseLeftButtonDown="Node_MouseLeftButtonDown"
                        MouseMove="Node_MouseMove"
                        MouseLeftButtonUp="Node_MouseLeftButtonUp">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11"/>
                </Border>
                <!-- Index badge -->
                <Border Background="#37474F" CornerRadius="8" MinWidth="24" Height="16"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4,-4,0,0" Padding="4,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Fork/Join: thick horizontal bar -->
        <DataTemplate x:Key="BarNodeTemplate">
            <Grid>
                <Border Width="{Binding DefaultWidth}" Height="{Binding DefaultHeight}"
                        Background="{Binding NodeBrush}" CornerRadius="4"
                        BorderBrush="{Binding SelectionBrush}" BorderThickness="2"
                        Cursor="Hand"
                        MouseLeftButtonDown="Node_MouseLeftButtonDown"
                        MouseMove="Node_MouseMove"
                        MouseLeftButtonUp="Node_MouseLeftButtonUp">
                    <TextBlock Text="{Binding IconText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                </Border>
                <!-- Index badge -->
                <Border Background="#37474F" CornerRadius="8" MinWidth="24" Height="16"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4,-4,0,0" Padding="4,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- SubWorkflow: double-border rectangle -->
        <DataTemplate x:Key="SubWorkflowNodeTemplate">
            <Grid>
                <Border CornerRadius="6"
                        MinWidth="{Binding DefaultWidth}" MinHeight="{Binding DefaultHeight}"
                        Background="{Binding NodeBrush}" Opacity="0.92"
                        BorderBrush="{Binding SelectionBrush}" BorderThickness="3"
                        Cursor="Hand" Padding="4"
                        MouseLeftButtonDown="Node_MouseLeftButtonDown"
                        MouseMove="Node_MouseMove"
                        MouseLeftButtonUp="Node_MouseLeftButtonUp">
                    <Border CornerRadius="4" BorderBrush="White" BorderThickness="2" Padding="6,4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="140" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Border>
                <!-- Index badge -->
                <Border Background="#37474F" CornerRadius="8" MinWidth="24" Height="16"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4,-4,0,0" Padding="4,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template selector -->
        <local:NodeTemplateSelector x:Key="NodeSelector"
            StageTemplate="{StaticResource StageNodeTemplate}"
            DecisionTemplate="{StaticResource DecisionNodeTemplate}"
            CircleTemplate="{StaticResource CircleNodeTemplate}"
            BarTemplate="{StaticResource BarNodeTemplate}"
            SubWorkflowTemplate="{StaticResource SubWorkflowNodeTemplate}"/>

        <!-- ═══ CONNECTOR TEMPLATE ═══ -->
        <DataTemplate x:Key="ConnectorTemplate">
            <Canvas>
                <!-- Invisible wide hit area for easier clicking -->
                <Line X1="{Binding X1}" Y1="{Binding Y1}"
                      X2="{Binding X2}" Y2="{Binding Y2}"
                      Stroke="Transparent" StrokeThickness="14"
                      Cursor="Hand"
                      MouseLeftButtonDown="Connector_MouseLeftButtonDown"/>
                <!-- Visible line (dashed when selected) -->
                <Line X1="{Binding X1}" Y1="{Binding Y1}"
                      X2="{Binding X2}" Y2="{Binding Y2}"
                      Stroke="{Binding StrokeColor}"
                      StrokeThickness="{Binding StrokeWidth}"
                      StrokeDashArray="{Binding StrokeDash}"
                      MouseLeftButtonDown="Connector_MouseLeftButtonDown"/>
                <!-- Arrowhead at target end -->
                <Polygon Points="{Binding ArrowPoints}"
                         Fill="{Binding StrokeColor}"
                         Canvas.Left="{Binding ArrowX}" Canvas.Top="{Binding ArrowY}"
                         RenderTransformOrigin="0,0">
                    <Polygon.RenderTransform>
                        <RotateTransform Angle="{Binding ArrowAngle}"/>
                    </Polygon.RenderTransform>
                </Polygon>
                <!-- Label at midpoint (shifted down to avoid badge overlap) -->
                <Border Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"
                        Background="#F0FFFFFF" CornerRadius="3" Padding="4,1"
                        BorderBrush="#CCC" BorderThickness="1">
                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#424242"/>
                </Border>
                <!-- Index badge at midpoint of the line (offset slightly above the label) -->
                <Border Background="#546E7A" CornerRadius="8" MinWidth="22" Height="16"
                        Padding="3,0"
                        Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}"
                        Margin="0,-20,0,0">
                    <TextBlock Text="{Binding DisplayLabel}" Foreground="White"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: TOOLBAR ═══ -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <!-- Definition selector -->
                <TextBlock Text="תהליך:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Definitions}"
                          SelectedItem="{Binding SelectedDefinition}"
                          DisplayMemberPath="Name"
                          Width="200" Margin="0,0,16,0"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Margin="0,2,12,2"/>

                <!-- Add nodes -->
                <TextBlock Text="הוסף:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <Button Content="⏺ התחלה" Command="{Binding AddStartCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#C8E6C9" BorderBrush="#66BB6A"
                        ToolTip="הוסף צומת התחלה (אחד בלבד)"/>
                <Button Content="⏹ סיום" Command="{Binding AddEndCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#FFCDD2" BorderBrush="#EF5350"
                        ToolTip="הוסף צומת סיום"/>
                <Button Content="➕ שלב" Command="{Binding AddStageCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#E3F2FD" BorderBrush="#90CAF9"/>
                <Button Content="◆ תנאי" Command="{Binding AddDecisionCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#FFF3E0" BorderBrush="#FFB74D"/>
                <Button Content="⑂ פיצול" Command="{Binding AddForkCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#F3E5F5" BorderBrush="#CE93D8"/>
                <Button Content="⊕ מיזוג" Command="{Binding AddJoinCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#E0F2F1" BorderBrush="#80CBC4"/>
                <Button Content="🔄 תת-תהליך" Command="{Binding AddSubWorkflowCommand}" Padding="8,4" Margin="0,0,16,0"
                        Background="#EFEBE9" BorderBrush="#A1887F"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Margin="0,2,12,2"/>

                <!-- Connect / Delete -->
                <Button Content="🔗 חבר" Command="{Binding BeginConnectCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#E8EAF6" BorderBrush="#9FA8DA"
                        ToolTip="לחץ, ואז בחר צומת מקור ← צומת יעד"/>
                <Button Content="🗑 מחק" Command="{Binding DeleteNodeCommand}" Padding="8,4" Margin="0,0,16,0"
                        Background="#FFEBEE" BorderBrush="#EF9A9A"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Margin="0,2,12,2"/>

                <!-- Persistence -->
                <Button Content="💾 שמור" Command="{Binding SaveCommand}" Padding="8,4" Margin="0,0,4,0"
                        Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"/>
                <Button Content="✅ בדוק" Command="{Binding ValidateCommand}" Padding="8,4" Margin="0,0,4,0"/>
                <Button Content="🔄 סדר אוטומטי" Command="{Binding AutoLayoutCommand}" Padding="8,4" Margin="0,0,4,0"/>
                <Button Content="❓ עזרה" Click="HelpButton_Click" Padding="8,4"
                        Background="#E3F2FD" BorderBrush="#90CAF9"
                        ToolTip="מדריך מלא לעורך התהליכים"/>

                <!-- Connect mode indicator -->
                <TextBlock Text="🔗 מצב חיבור — לחץ על צומת יעד (ESC לביטול)"
                           Foreground="#FF5722" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- ═══ ROW 1: START TRIGGERS HEADER STRIP ═══ -->
        <Border Grid.Row="1" Background="#E8F5E9" Padding="8,4" BorderBrush="#C8E6C9" BorderThickness="0,0,0,1"
                Visibility="{Binding HasStartTriggers, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🟢 מופעל ע״י:" FontWeight="SemiBold" Foreground="#2E7D32"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StartTriggersSummary}" Foreground="#388E3C"
                           VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 2: CANVAS + PROPERTIES ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas Area -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              x:Name="CanvasScroller"
                              PreviewMouseWheel="Canvas_PreviewMouseWheel">
                    <Grid x:Name="CanvasRoot"
                          Background="White"
                          Width="2000" Height="1500"
                          MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Grid dots background -->
                        <Rectangle IsHitTestVisible="False" Opacity="0.3">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#D0D0D0">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="10,10" RadiusX="0.7" RadiusY="0.7"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Layer 1: Connectors (behind nodes) -->
                        <ItemsControl ItemsSource="{Binding Connectors}"
                                      ItemTemplate="{StaticResource ConnectorTemplate}"
                                      Panel.ZIndex="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Layer 2: Nodes -->
                        <ItemsControl ItemsSource="{Binding Nodes}"
                                      ItemTemplateSelector="{StaticResource NodeSelector}"
                                      Panel.ZIndex="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- Properties Panel -->
            <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#E0E0E0"
                    BorderThickness="1,0,0,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ── Node Properties ── -->
                        <StackPanel Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="מאפייני צומת" FontWeight="Bold" FontSize="14"
                                       Foreground="#1565C0" Margin="0,0,0,10"/>

                            <TextBlock Text="שם:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedNode.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="קוד:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedNode.Code, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="תיאור:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedNode.Description, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <CheckBox Content="שלב התחלתי (Initial)" IsChecked="{Binding SelectedNode.IsInitial}"
                                      Margin="0,0,0,4"/>
                            <CheckBox Content="שלב סופי (Final)" IsChecked="{Binding SelectedNode.IsFinal}"
                                      Margin="0,0,0,8"/>

                            <!-- Decision condition -->
                            <StackPanel Visibility="{Binding SelectedNode.IsDecision, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ביטוי תנאי:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SelectedNode.ConditionExpression, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- SubWorkflow properties -->
                            <StackPanel Visibility="{Binding SelectedNode.IsSubWorkflow, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="תת-תהליך מקושר:" Margin="0,8,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Definitions}"
                                          SelectedValue="{Binding SelectedNode.SubWorkflowDefinitionId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,8"/>

                                <TextBlock Text="מצב המתנה:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource SubWfWaitModeValues}}"
                                          SelectedItem="{Binding SelectedNode.SubWorkflowWaitMode}"
                                          Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Group Assignment for Stage -->
                            <StackPanel Visibility="{Binding SelectedNode.IsStage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="קבוצה אחראית:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableGroups}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedNode.AssignedGroupId}"
                                          Margin="0,0,0,4">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEditable" Value="False"/>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </StackPanel>

                            <!-- Tasks for Stage -->
                            <StackPanel Visibility="{Binding SelectedNode.IsStage, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock Text="משימות בשלב:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Button Content="＋" Command="{Binding AddStageTaskCommand}"
                                                Padding="4,1" Margin="0,0,4,0" FontWeight="Bold" ToolTip="הוסף משימה"/>
                                        <Button Content="✕" Command="{Binding RemoveStageTaskCommand}"
                                                CommandParameter="{Binding SelectedNode.Tasks/}"
                                                Padding="4,1" FontWeight="Bold" ToolTip="הסר משימה"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding SelectedNode.Tasks}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          MaxHeight="200" IsReadOnly="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          BorderThickness="1" BorderBrush="#E0E0E0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="סוג" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TaskType.Name}" VerticalAlignment="Center" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableTaskTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding TaskTypeId, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="אחראי" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DefaultAssignee.Name}" VerticalAlignment="Center" Margin="4,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.AvailableEmployees, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                                              SelectedValue="{Binding DefaultAssigneeId, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn Header="חובה" Binding="{Binding IsRequired}" Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- Position info -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Opacity="0.6">
                                <TextBlock Text="X: "/>
                                <TextBlock Text="{Binding SelectedNode.X, StringFormat=F0}"/>
                                <TextBlock Text="  Y: " Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding SelectedNode.Y, StringFormat=F0}"/>
                            </StackPanel>

                            <!-- ── Start Triggers (Workflow-Level) ── -->
                            <StackPanel Visibility="{Binding SelectedNode.IsStart, Converter={StaticResource BoolToVis}}"
                                        Margin="0,12,0,0">
                                <Border Background="#E8F5E9" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="🟢 טריגרים שמפעילים את התהליך" FontWeight="SemiBold" Foreground="#2E7D32"
                                                       VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                            <Button Content="➕ הוסף טריגר"
                                                    Command="{Binding DataContext.AddStartTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Padding="6,2" HorizontalAlignment="Left"
                                                    Background="#C8E6C9" BorderBrush="#66BB6A" FontSize="11"/>
                                        </DockPanel>

                                        <ListBox ItemsSource="{Binding DataContext.StartTriggers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 SelectedItem="{Binding DataContext.SelectedStartTrigger, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 HorizontalContentAlignment="Stretch"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder" Background="White" CornerRadius="4" Padding="6"
                                                                        BorderBrush="#C8E6C9" BorderThickness="1">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#1565C0"/>
                                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5"/>
                                                                    </Trigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsSelected" Value="True"/>
                                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#BBDEFB"/>
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Row 0: Number badge + Trigger Source + Active + Delete -->
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Button Content="🗑" DockPanel.Dock="Left" Padding="4,1" FontSize="10"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    ToolTip="הסר טריגר"
                                                                    Command="{Binding DataContext.RemoveStartTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <CheckBox Content="פעיל" DockPanel.Dock="Left" IsChecked="{Binding IsActive}"
                                                                      VerticalAlignment="Center" Margin="4,0,0,0" FontSize="10"/>
                                                            <!-- Number badge -->
                                                            <Border DockPanel.Dock="Right" Background="#1565C0" CornerRadius="10"
                                                                    MinWidth="20" Height="20" Margin="0,0,4,0"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource ItemIndex}}"
                                                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ComboBox ItemsSource="{Binding Source={StaticResource StartTriggerSourceValues}}"
                                                                      SelectedItem="{Binding TriggerSource}"
                                                                      FontSize="11">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>

                                                        <!-- Description (always visible) -->
                                                        <TextBlock Text="תיאור:" FontSize="10" Opacity="0.7" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="11" Margin="0,0,0,4"/>

                                                        <!-- ═══ Dynamic Properties per Trigger Type ═══ -->

                                                        <!-- 📧 EmailFiled Properties -->
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerSource}" Value="EmailFiled">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Background="#E3F2FD" CornerRadius="3" Padding="5" Margin="0,0,0,2">
                                                                <StackPanel>
                                                                    <TextBlock Text="סוג תיוק:" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                                    <ComboBox ItemsSource="{Binding Source={StaticResource EmailFileTypeValues}}"
                                                                              SelectedItem="{Binding Properties.EmailFileType}"
                                                                              FontSize="11" Margin="0,0,0,4">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <CheckBox Content="חייב פרויקט קיים" IsChecked="{Binding Properties.RequiresProject}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                    <CheckBox Content="צור פרויקט אם חסר" IsChecked="{Binding Properties.CreateProjectIfMissing}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="סוג פרויקט חדש:" FontSize="10" Opacity="0.7" Margin="0,2,0,2"/>
                                                                    <TextBox Text="{Binding Properties.NewProjectTypeCode, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="10" Margin="0,0,0,2"
                                                                             ToolTip="Proposal, Planning, Execution..."/>
                                                                    <CheckBox Content="חובה קבצים מצורפים" IsChecked="{Binding Properties.RequiredAttachments}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 🖱️ ManualStart Properties -->
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerSource}" Value="ManualStart">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Background="#F3E5F5" CornerRadius="3" Padding="5" Margin="0,0,0,2">
                                                                <StackPanel>
                                                                    <CheckBox Content="חובה לבחור פרויקט" IsChecked="{Binding Properties.RequiresProject}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 📁 ProjectCreated Properties -->
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerSource}" Value="ProjectCreated">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Background="#E8F5E9" CornerRadius="3" Padding="5" Margin="0,0,0,2">
                                                                <StackPanel>
                                                                    <TextBlock Text="סוגי פרויקט (מופרד בפסיק):" FontSize="10" Opacity="0.7" Margin="0,0,0,2"/>
                                                                    <TextBox FontSize="10" Margin="0,0,0,2"
                                                                             ToolTip="Planning, Execution, Proposal... (ריק = כולם)"
                                                                             Tag="{Binding Properties}"/>
                                                                    <CheckBox Content="התחל מיד" IsChecked="{Binding Properties.AutoStart}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 📋 ProjectTypeAssigned Properties -->
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerSource}" Value="ProjectTypeAssigned">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Background="#FFF3E0" CornerRadius="3" Padding="5" Margin="0,0,0,2">
                                                                <StackPanel>
                                                                    <TextBlock Text="מסוג (ריק = כל שינוי):" FontSize="10" Opacity="0.7" Margin="0,0,0,2"/>
                                                                    <TextBox Text="{Binding Properties.FromTypeCode, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="10" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="לסוג:" FontSize="10" Opacity="0.7" Margin="0,0,0,2"/>
                                                                    <TextBox Text="{Binding Properties.ToTypeCode, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="10" Margin="0,0,0,2"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 🔄 ParentWorkflow Properties -->
                                                        <StackPanel Margin="0,2,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TriggerSource}" Value="ParentWorkflow">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Background="#E0F7FA" CornerRadius="3" Padding="5" Margin="0,0,0,2">
                                                                <StackPanel>
                                                                    <CheckBox Content="ירש ProjectId מהאב" IsChecked="{Binding Properties.InheritProjectId}"
                                                                              FontSize="10" Margin="0,0,0,2"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Empty state -->
                                        <TextBlock Text="אין טריגרים — לחץ ➕ להוספה" FontSize="10" FontStyle="Italic"
                                                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.StartTriggers.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── Connector Properties ── -->
                        <StackPanel Visibility="{Binding HasSelectedConnector, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="מאפייני חיבור" FontWeight="Bold" FontSize="14"
                                       Foreground="#FF5722" Margin="0,0,0,10"/>

                            <TextBlock Text="תווית:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedConnector.Label, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="תנאי (תצוגה):" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedConnector.Condition, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="עדיפות:" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedConnector.Priority, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12" Width="60" HorizontalAlignment="Right"/>

                            <!-- Trigger / Condition / Evaluation -->
                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="טריגר / תנאי / הערכה" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,8"/>

                                    <TextBlock Text="טריגר (מה מפעיל):" Margin="0,0,0,3" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource TriggerTypeValues}}"
                                              SelectedItem="{Binding SelectedConnector.TriggerType}"
                                              Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="תנאי (מה צריך להתקיים):" Margin="0,0,0,3" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource ConditionTypeValues}}"
                                              SelectedItem="{Binding SelectedConnector.ConditionType}"
                                              Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="מצב הערכה:" Margin="0,0,0,3" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource EvaluationModeValues}}"
                                              SelectedItem="{Binding SelectedConnector.EvaluationMode}"
                                              Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="JSON תנאי:" Margin="0,0,0,3" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedConnector.ConditionJson, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="10"
                                             AcceptsReturn="True" Height="40" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Actions (פעולות) ── -->
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="פעולות (Actions)" FontWeight="SemiBold" Foreground="#E65100"
                                                   VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                        <Button Content="➕ הוסף פעולה" Command="{Binding DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,2" HorizontalAlignment="Left"
                                                Background="#FFE0B2" BorderBrush="#FFB74D" FontSize="11"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding SelectedConnector.Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="4" Padding="6" Margin="0,0,0,4"
                                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Action Type + Delete -->
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                            <Button Content="🗑" DockPanel.Dock="Left" Padding="4,1" FontSize="10"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    ToolTip="הסר פעולה"
                                                                    Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypeValues}}"
                                                                      SelectedItem="{Binding ActionType}"
                                                                      FontSize="11">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>

                                                        <!-- Row 1: Config hint per action type -->
                                                        <TextBlock Grid.Row="1" FontSize="10" Opacity="0.7" Margin="0,0,0,2">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="הגדרות (JSON):"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="SetProjectStatus">
                                                                            <Setter Property="Text" Value='הגדרות: {"code":"Active"}  — קודי ProjectStatus'/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="RecordTaskResult">
                                                                            <Setter Property="Text" Value='הגדרות: {"code":"QuoteApprovedByClient"}  — קודי TaskResult'/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="SetBillingPending">
                                                                            <Setter Property="Text" Value="ללא הגדרות נדרשות (משאיר ריק)"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="CloseProject">
                                                                            <Setter Property="Text" Value='הגדרות (אופציונלי): {"reason":"..."}'/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="SendNotification">
                                                                            <Setter Property="Text" Value='הגדרות: {"template":"...","to":"..."}'/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="StartSubWorkflow">
                                                                            <Setter Property="Text" Value='הגדרות: {"workflowCode":"..."}'/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Grid.Row="2"
                                                                 Text="{Binding ConfigJson, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="Consolas" FontSize="10"
                                                                 AcceptsReturn="True" Height="30" TextWrapping="Wrap"
                                                                 ToolTip="JSON קונפיגורציה לפי סוג הפעולה"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <TextBlock Text="אין פעולות — לחץ ➕ להוספה" FontSize="10" FontStyle="Italic"
                                               Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedConnector.Actions.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Opacity="0.7" FontSize="11">
                                        <Run Text="מ: "/><Run Text="{Binding SelectedConnector.Source.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Opacity="0.7" FontSize="11">
                                        <Run Text="ל: "/><Run Text="{Binding SelectedConnector.Target.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Button Content="🗑 מחק חיבור" Command="{Binding DeleteConnectorCommand}"
                                    Padding="8,4" Margin="0,4,0,0"
                                    Background="#FFEBEE" BorderBrush="#EF9A9A"/>
                        </StackPanel>

                        <!-- ── No Selection ── -->
                        <TextBlock Text="בחר צומת או חיבור לעריכה"
                                   Foreground="Gray" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSelectedNode}" Value="False"/>
                                                <Condition Binding="{Binding HasSelectedConnector}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- ── Validation Messages ── -->
                        <ItemsControl ItemsSource="{Binding ValidationMessages}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               FontSize="11" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ ROW 3: STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="8,4" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Nodes.Count, StringFormat='צמתים: {0}'}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Connectors.Count, StringFormat='חיבורים: {0}'}" Margin="0,0,12,0"/>
                <TextBlock Text="● שינויים לא שמורים" Foreground="#FF5722" FontWeight="Bold"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
