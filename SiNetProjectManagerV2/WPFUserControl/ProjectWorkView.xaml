<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.ProjectWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:selectors="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Alternating row styles for file items -->
        <Style x:Key="FileItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="ItemsControl.AlternationCount" Value="2"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E1E1E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Filters -->
            <RowDefinition Height="Auto"/>  <!-- 1: Project details -->
            <RowDefinition Height="*"/>     <!-- 2: Main content -->
            <RowDefinition Height="Auto"/>  <!-- 3: Status bar -->
        </Grid.RowDefinitions>

        <!-- 0: Filters -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5">
            <controls:SearchableProjectSelector
                ItemsSource="{Binding ProjectsView}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ExternalFilter="{Binding ProjectFilterPredicate}"
                FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                SortPropertyPath="Number"
                SortAscending="False"
                Width="300" Margin="0,0,5,0"
                ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding JobTypes}"
                      SelectedItem="{Binding SelectedJobTypeFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סוג פרויקט" />

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding ProjectStatuses}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סטטוס" />

            <ComboBox Width="120"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUserFilter}"
                      DisplayMemberPath="Name"
                      ToolTip="משתמש (Siuser.Name)" />
        </StackPanel>

        <!-- 1: Project details -->
        <Border Grid.Row="1"
                Padding="5" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="4" Background="#F9F9F9" Margin="0,0,0,10">
            <TextBlock Text="{Binding ProjectDetails}" TextWrapping="Wrap" />
        </Border>

        <!-- 2: Main content — unified TreeView + WebView2 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Unified TreeView (Folders → Files → Alternatives → Versions) -->
            <TreeView Grid.Column="0" Name="UnifiedTree"
                      ItemsSource="{Binding RootFolders}"
                      VirtualizingStackPanel.IsVirtualizing="True">

                <i:Interaction.Behaviors>
                    <local:FileDropBehavior
                        FileDroppedCommand="{Binding HandleFileDropCommand}"
                        AllowMultipleFiles="False" />
                </i:Interaction.Behaviors>

                <TreeView.Resources>
                    <!-- ══════ Folder Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ProjectFolderNode}">
                        <!-- 
                            CompositeCollection merges sub-folders + files into one ItemsSource.
                            Children = sub-folders, FolderFiles = inline files.
                        -->
                        <HierarchicalDataTemplate.ItemsSource>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <selectors:CompositeChildrenConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="Children"/>
                                <Binding Path="FolderFiles"/>
                                <Binding Path="Children.Count"/>
                                <Binding Path="FolderFiles.Count"/>
                            </MultiBinding>
                        </HierarchicalDataTemplate.ItemsSource>

                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <Image Width="16" Height="16" Margin="0,0,5,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Assets/folder_project.png"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUserCreated}" Value="True">
                                                <Setter Property="Source" Value="/Assets/folder_user.png"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Colored folder glyph: green = subtree has files, gray = empty subtree.
                                 Sits on top of the asset image so existing iconography is preserved
                                 while the colour communicates the recursive "has-files" status. -->
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Foreground="{Binding FolderColor}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ File Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ProjectFileNode}" ItemsSource="{Binding Alternatives}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <Image Source="{Binding FileTypeIconByExtension}" Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StorageLocationLabel}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding StorageLocationColor}"
                                       VerticalAlignment="Center" Margin="0,0,3,0"
                                       ToolTip="{Binding StorageLocationToolTip}"/>
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding Extension}" />
                            <TextBlock Text=")  " />
                            <TextBlock>
                                <Run Text="Alt: " />
                                <Run Text="{Binding AlternativeCount, Mode=OneWay}" />
                                <Run Text=", Ver: " />
                                <Run Text="{Binding VersionCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ Alternative Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:AlternativeNode}" ItemsSource="{Binding Versions}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <!-- ACC viewer tab toggle: visible only when this alternative has ACC versions.
                                 Checked = open / activate the ACC tab; Unchecked = close it. -->
                            <CheckBox IsChecked="{Binding IsAccTabOpen, Mode=TwoWay}"
                                      Visibility="{Binding HasAccVersions, Converter={StaticResource BoolToVis}}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      ToolTip="פתח/סגור טאב ACC עבור חלופה זו"/>
                            <Image Source="{Binding DisplayIcon}" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlternativeName}" FontWeight="SemiBold" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding VersionCount, Mode=OneWay}" />
                            <TextBlock Text=" גרסאות)" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ Version Node ══════ -->
                    <DataTemplate DataType="{x:Type local:VersionNode}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <!-- File type icon from shell -->
                            <Image Source="{Binding FileTypeIcon}" Width="16" Height="16" Margin="0,0,3,0" />
                            <!-- Storage location badge -->
                            <TextBlock Text="{Binding StorageLocationLabel}" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       ToolTip="{Binding StorageLocationToolTip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StorageDestination}" Value="0">
                                                <Setter Property="Foreground" Value="#555555"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StorageDestination}" Value="1">
                                                <Setter Property="Foreground" Value="#1565C0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StorageDestination}" Value="2">
                                                <Setter Property="Foreground" Value="#0F9D58"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" Margin="5,0" />
                            <TextBlock Text=" Ver: " FontWeight="Bold" />
                            <TextBlock Text="{Binding VersionNumber}" Margin="5,0" />
                            <TextBlock Text=" Size: " FontWeight="Bold" />
                            <TextBlock Text="{Binding Size}" Margin="5,0" />
                            <TextBlock Text=" Date: " FontWeight="Bold" />
                            <TextBlock Text="{Binding Date}" Margin="5,0" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>

                <!-- Expand only first two folder levels via bound IsExpanded -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="TreeViewItem_MouseMove"/>
                        <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right: Multi-tab ACC viewer.
                 The tab strip is bound to AccViewerTabs; each tab renders its own
                 persistent WebView2 so navigation/state survives tab switches.
                 Tabs only close via the alternative checkbox or the tab's X button.
                 The whole panel can be popped out to a floating window via the dock toggle. -->
            <Border Grid.Column="2" x:Name="AccViewerDockHost">
                <Grid x:Name="AccViewerInner">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E3F2FD" Padding="8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="AccDockToggleButton" DockPanel.Dock="Right"
                                Click="AccDockToggleButton_Click"
                                Content="⧉" FontSize="14" Padding="6,2"
                                ToolTip="נתק לחלון צף / החזר לתוך החלון"
                                Cursor="Hand"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 ACC - קבצי פרויקט" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text=" (Autodesk Construction Cloud)" Opacity="0.6" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tab strip -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding AccViewerTabs}"
                              Visibility="{Binding HasAccTabs, Converter={StaticResource BoolToVis}}"
                              Background="#F5F5F5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,2,0,0" Padding="6,3" CornerRadius="3,3,0,0"
                                    BorderBrush="#90CAF9" BorderThickness="1,1,1,0"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ActivateCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                                               ToolTip="{Binding Title}"/>
                                    <Button Command="{Binding CloseCommand}"
                                            Content="✕" FontSize="10" Margin="6,0,0,0"
                                            Padding="4,0" MinWidth="16" Height="16"
                                            ToolTip="סגור טאב"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tab content host: one WebView2 per tab; only the active one is visible. -->
                <Grid Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding AccViewerTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <wv2:WebView2 selectors:WebView2Helper.IsAccViewer="True"
                                              selectors:WebView2Helper.NavigateUrl="{Binding Url}"
                                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Placeholder when no ACC tabs are open -->
                    <Border Background="#FAFAFA"
                            Visibility="{Binding HasAccTabs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, FallbackValue=Visible}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="אין טאבים פתוחים" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="סמן ✓ ליד חלופה עם קבצי ACC כדי לפתוח טאב" Opacity="0.6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3: Status bar — scan + upload progress -->
        <Border Grid.Row="3" Background="#ECEFF1" BorderBrush="#B0BEC5" BorderThickness="0,1,0,0"
                Padding="8,4" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scan progress -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 סריקה:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ScanStatus}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ProgressBar Height="6" Margin="0,3,0,0"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Upload progress -->
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆ העלאה:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding UploadStatus}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ProgressBar Height="6" Margin="0,3,0,0"
                                 IsIndeterminate="{Binding IsUploading}"
                                 Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Extension-conflict badge (visible only when there are conflicts).
                     Hover = full list of conflicts; double-click = popup with the same list. -->
                <Border Grid.Column="2" Background="#FDECEA" BorderBrush="#D32F2F" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        Cursor="Hand"
                        Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ConflictDetailsText}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowConflictsCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#D32F2F" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Foreground="#B71C1C" FontWeight="SemiBold">
                            <Run Text="{Binding ConflictCount, Mode=OneWay}"/>
                            <Run Text=" התנגשויות סיומות"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ACC metadata-health badge (visible only when there are failures).
                     Hover = up to 25 most-recent failures; double-click = popup with full list + clear option.
                     Mirrors the conflicts badge but uses an amber palette so the two are visually distinct. -->
                <Border Grid.Column="2" Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Visibility="{Binding HasAccMetadataIssues, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding AccMetadataIssuesText}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowAccMetadataIssuesCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ⓘ" Foreground="#F9A825" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Foreground="#8D6E00" FontWeight="SemiBold">
                            <Run Text="{Binding AccMetadataIssueCount, Mode=OneWay}"/>
                            <Run Text=" כשלי מטא-דאטה ACC"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
