<UserControl x:Class="SiNetProjectManagerV2.WPFUserControl.ProjectWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:selectors="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
             xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Alternating row styles for file items -->
        <Style x:Key="FileItemStyle" TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="ItemsControl.AlternationCount" Value="2"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E1E1E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Filters -->
            <RowDefinition Height="Auto"/>  <!-- 1: Project details -->
            <RowDefinition Height="*"/>     <!-- 2: Main content -->
        </Grid.RowDefinitions>

        <!-- 0: Filters -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5">
            <controls:SearchableProjectSelector
                ItemsSource="{Binding ProjectsView}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ExternalFilter="{Binding ProjectFilterPredicate}"
                FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                SortPropertyPath="Number"
                SortAscending="False"
                Width="300" Margin="0,0,5,0"
                ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding JobTypes}"
                      SelectedItem="{Binding SelectedJobTypeFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סוג פרויקט" />

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding ProjectStatuses}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סטטוס" />

            <ComboBox Width="120"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUserFilter}"
                      DisplayMemberPath="Name"
                      ToolTip="משתמש (Siuser.Name)" />
        </StackPanel>

        <!-- 1: Project details -->
        <Border Grid.Row="1"
                Padding="5" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="4" Background="#F9F9F9" Margin="0,0,0,10">
            <TextBlock Text="{Binding ProjectDetails}" TextWrapping="Wrap" />
        </Border>

        <!-- 2: Main content — unified TreeView + WebView2 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Unified TreeView (Folders → Files → Alternatives → Versions) -->
            <TreeView Grid.Column="0" Name="UnifiedTree"
                      ItemsSource="{Binding RootFolders}"
                      VirtualizingStackPanel.IsVirtualizing="True">

                <i:Interaction.Behaviors>
                    <local:FileDropBehavior
                        FileDroppedCommand="{Binding HandleFileDropCommand}"
                        AllowMultipleFiles="False" />
                </i:Interaction.Behaviors>

                <TreeView.Resources>
                    <!-- ══════ Folder Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ProjectFolderNode}">
                        <!-- 
                            CompositeCollection merges sub-folders + files into one ItemsSource.
                            Children = sub-folders, FolderFiles = inline files.
                        -->
                        <HierarchicalDataTemplate.ItemsSource>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <selectors:CompositeChildrenConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="Children"/>
                                <Binding Path="FolderFiles"/>
                                <Binding Path="Children.Count"/>
                                <Binding Path="FolderFiles.Count"/>
                            </MultiBinding>
                        </HierarchicalDataTemplate.ItemsSource>

                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <Image Width="16" Height="16" Margin="0,0,5,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="/Assets/folder_project.png"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUserCreated}" Value="True">
                                                <Setter Property="Source" Value="/Assets/folder_user.png"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ File Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ProjectFileNode}" ItemsSource="{Binding Alternatives}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <TextBlock Text="📄 " />
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding Extension}" />
                            <TextBlock Text=")  " />
                            <TextBlock>
                                <Run Text="Alt: " />
                                <Run Text="{Binding AlternativeCount, Mode=OneWay}" />
                                <Run Text=", Ver: " />
                                <Run Text="{Binding VersionCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ Alternative Node ══════ -->
                    <HierarchicalDataTemplate DataType="{x:Type local:AlternativeNode}" ItemsSource="{Binding Versions}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <Image Source="{Binding DisplayIcon}" Width="20" Height="20" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlternativeName}" FontWeight="SemiBold" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding VersionCount, Mode=OneWay}" />
                            <TextBlock Text=" גרסאות)" />
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ══════ Version Node ══════ -->
                    <DataTemplate DataType="{x:Type local:VersionNode}">
                        <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                            <!-- ACC cloud badge -->
                            <TextBlock Text="☁" Foreground="#1565C0" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       ToolTip="קובץ שמור ב-ACC — לחץ פעמיים לצפייה"
                                       Visibility="{Binding IsAccFile, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Description}" Margin="5,0" />
                            <TextBlock Text=" Ver: " FontWeight="Bold" />
                            <TextBlock Text="{Binding VersionNumber}" Margin="5,0" />
                            <TextBlock Text=" Size: " FontWeight="Bold" />
                            <TextBlock Text="{Binding Size}" Margin="5,0" />
                            <TextBlock Text=" Date: " FontWeight="Bold" />
                            <TextBlock Text="{Binding Date}" Margin="5,0" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>

                <!-- Expand only first two folder levels via bound IsExpanded -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="TreeViewItem_MouseMove"/>
                        <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right: ACC WebView2 file viewer -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E3F2FD" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 ACC - קבצי פרויקט" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" (Autodesk Construction Cloud)" Opacity="0.6" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- WebView2 for ACC documents viewer -->
                <wv2:WebView2 Grid.Row="1" x:Name="AccWebView"
                              selectors:WebView2Helper.IsAccViewer="True"
                              selectors:WebView2Helper.NavigateUrl="{Binding AccViewerUrl}"/>

                <!-- Placeholder when no ACC URL is available -->
                <Border Grid.Row="1" Background="#FAFAFA"
                        Visibility="{Binding AccViewerUrl, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, FallbackValue=Visible}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="חיבור ACC לא מוגדר לפרויקט זה" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="לאחר מיפוי מזהה ACC, קבצי הפרויקט יוצגו כאן" Opacity="0.6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
