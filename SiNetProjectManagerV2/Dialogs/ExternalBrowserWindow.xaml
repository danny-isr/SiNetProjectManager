<Window x:Class="SiNetProjectManagerV2.Dialogs.ExternalBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="דפדפן חיצוני"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- URL Bar -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="🌐 " VerticalAlignment="Center" FontSize="14"
                           DockPanel.Dock="Left" Margin="0,0,6,0"/>
                <TextBlock x:Name="UrlText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#555"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- WebView2 (clean — no Gmail/Calendar scripts) -->
        <wv2:WebView2 x:Name="BrowserWebView" Grid.Row="1"/>

        <!-- Download / upload progress -->
        <Border x:Name="ProgressPanel"
                Grid.Row="2"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="0,1,0,0"
                Padding="12,10"
                Visibility="Collapsed"
                FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProgressStageText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#0D47A1"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ProgressDetailText"
                           Grid.Row="1"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#1565C0"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="2"
                             Height="8"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
