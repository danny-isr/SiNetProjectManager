<Window x:Class="SiNetProjectManagerV2.Dialogs.ResetOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אפשרויות איפוס נתונים"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFF3E0" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚠️ אפשרויות איפוס נתונים"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#E65100"/>
                <TextBlock x:Name="DbInfoText"
                           FontSize="12" Foreground="#555" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="בחר אילו חלקים לאפס. ברירת המחדל שומרת על הגדרות משתמשים וקבוצות כדי ש־Workflow יוכל ליצור משימות לאחר האיפוס."
                   FontSize="12" Foreground="#444" Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Options -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <CheckBox x:Name="OptInitiateResetCheck"
                      IsChecked="True"
                      Margin="0,4">
                <CheckBox.Content>
                    <StackPanel>
                        <TextBlock Text="הפעל איפוס נתוני פיתוח"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="מוחק את כל הנתונים מהטבלאות החדשות שנוצרו במיגריישנים (מיילים, ACC, סטטוסים, החלטות, ביקורות, תהליכי עבודה, משימות וכו')."
                                   FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox.Content>
            </CheckBox>

            <CheckBox x:Name="OptConfirmIrreversibleCheck"
                      IsChecked="True"
                      Margin="0,4">
                <CheckBox.Content>
                    <StackPanel>
                        <TextBlock Text="אני מאשר/ת שזו פעולה בלתי הפיכה"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="אישור סופי לפני ביצוע המחיקה. ללא סימון לא תתבצע מחיקה."
                                   FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox.Content>
            </CheckBox>

            <CheckBox x:Name="OptWipeSystemSettingsCheck"
                      IsChecked="False"
                      Margin="0,4">
                <CheckBox.Content>
                    <StackPanel>
                        <TextBlock Text="מחק גם את טבלת ה־Bootstrap / SystemSettings"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="כברירת מחדל הגדרות המערכת (ACC admin, נתיבי חותמות, default project IDs, logging) נשמרות."
                                   FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox.Content>
            </CheckBox>

            <CheckBox x:Name="OptResetUserSettingsCheck"
                      IsChecked="False"
                      Margin="0,4">
                <CheckBox.Content>
                    <StackPanel>
                        <TextBlock Text="אפס גם הגדרות משתמשים וקבוצות"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="כברירת מחדל UserGroups, UserGroupMemberships והקצאות ברירת מחדל נשמרים, כדי ש־Workflow יוכל ליצור משימות פתיחה."
                                   FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox.Content>
            </CheckBox>
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,8,0,8"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="הפעל איפוס"
                    Click="RunReset_Click"
                    Padding="14,8" MinWidth="130" Margin="0,0,8,0"
                    FontWeight="SemiBold" FontSize="13"
                    Background="#FFCDD2" BorderBrush="#E57373"/>
            <Button Content="ביטול"
                    Click="Cancel_Click"
                    IsCancel="True" IsDefault="True"
                    Padding="14,8" MinWidth="80"
                    FontSize="13" Foreground="#777"/>
        </StackPanel>
    </Grid>
</Window>
