<Window x:Class="SiNetProjectManagerV2.Dialogs.EmailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מידע על המייל"
        Width="500" Height="170"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">
    <Border Margin="10" Padding="12" CornerRadius="6"
            Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="SubjectText" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock x:Name="FromText" Foreground="#555" Margin="0,0,0,3"/>
            <TextBlock x:Name="DateText" Foreground="#555"/>
        </StackPanel>
    </Border>
</Window>
