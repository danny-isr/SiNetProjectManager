<Window x:Class="SiNetProjectManagerV2.Dialogs.EmailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מידע על המייל"
        Width="520" Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="400" MinHeight="200"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">
    <DockPanel Margin="10">
        <!-- Email header -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="6"
                Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="SubjectText" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="FromText" Foreground="#555" Margin="0,0,0,3"/>
                <TextBlock x:Name="DateText" Foreground="#555"/>
            </StackPanel>
        </Border>

        <!-- Attachments header -->
        <TextBlock DockPanel.Dock="Top" x:Name="AttachmentsHeader"
                   Text="📎 קבצים מצורפים:" FontWeight="SemiBold" Margin="0,0,0,5"/>

        <!-- Attachments list -->
        <ListBox x:Name="AttachmentsList" BorderBrush="#CCC" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,5" Background="Transparent"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="פתח ▶" Padding="8,2"
                                    Click="OpenAttachment_Click" Tag="{Binding}"
                                    Cursor="Hand" Background="#E3F2FD" Foreground="#1565C0"
                                    BorderBrush="#90CAF9" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
