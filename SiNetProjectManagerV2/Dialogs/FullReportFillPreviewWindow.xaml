<Window x:Class="SiNetProjectManagerV2.Dialogs.FullReportFillPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Report Fill Preview — Preview Only"
        Height="820" Width="1200"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Banner -->
            <RowDefinition Height="Auto"/>  <!-- 1: Template compat banner -->
            <RowDefinition Height="Auto"/>  <!-- 2: Section 1 header -->
            <RowDefinition Height="Auto"/>  <!-- 3: Section 1 — Identity fields -->
            <RowDefinition Height="Auto"/>  <!-- 4: Section 2 header -->
            <RowDefinition Height="160"/>   <!-- 5: Section 2 — Report-fill fields from extraction -->
            <RowDefinition Height="Auto"/>  <!-- 6: Section 3 header + count -->
            <RowDefinition Height="*"/>     <!-- 7: Section 3 — All extracted sections -->
            <RowDefinition Height="Auto"/>  <!-- 8: Technical details (collapsed) -->
            <RowDefinition Height="Auto"/>  <!-- 9: Close button row -->
        </Grid.RowDefinitions>

        <!-- Row 0: Preview-only banner -->
        <Border Grid.Row="0"
                Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1"
                CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="Preview only"/>
                    <Run Foreground="#7B6000" Text=" — shows interpreted report values. No DB write, no extraction, no AI."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Row 1: Template compatibility banner (hidden when no template validation) -->
        <Border Grid.Row="1" x:Name="TemplateCompatBanner" Visibility="Collapsed" Margin="0,0,0,8">
            <Border x:Name="TemplateCompatBannerBorder"
                    Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                    CornerRadius="4" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TemplateCompatBannerText"
                               FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Row 2: Section 1 header -->
        <TextBlock Grid.Row="2"
                   Text="שדות זהות (מספר פרויקט / דוח / גרסה)"
                   FontWeight="SemiBold" FontSize="12"
                   Foreground="#1565C0" Margin="0,0,0,4"/>

        <!-- Row 3: Section 1 — Report-fill fields table -->
        <Border Grid.Row="3"
                BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3"
                Margin="0,0,0,8">
            <DataGrid x:Name="ReportFieldsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9"
                      MaxHeight="210"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="שם השדה (תצוגה)" Binding="{Binding DisplayName}"  Width="200"/>
                    <DataGridTextColumn Header="מפתח פנימי"       Binding="{Binding FieldKey}"     Width="160"/>
                    <DataGridTextColumn Header="ערך"              Binding="{Binding Value}"        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="MaxHeight"    Value="48"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="מקור / הערה"      Binding="{Binding SourceNote}"   Width="200"/>
                </DataGrid.Columns>
                <!-- Row style: gray out "not detected" rows -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Row 4: Section 2 header -->
        <TextBlock Grid.Row="4"
                   Text="שדות דוח מתוצאת החילוץ (מה ימולא בייבוא)"
                   FontWeight="SemiBold" FontSize="12"
                   Foreground="#1565C0" Margin="0,0,0,4"/>

        <!-- Row 5: Section 2 — GeneralFields from extraction result -->
        <Border Grid.Row="5"
                BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3"
                Margin="0,0,0,8">
            <DataGrid x:Name="GeneralFieldsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="שם שדה" Binding="{Binding Key}"   Width="260"/>
                    <DataGridTextColumn Header="ערך"    Binding="{Binding Value}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="MaxHeight"    Value="48"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 6: Section 3 header + count -->
        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="כל הסעיפים המחולצים (הדוח המלא)"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="#1565C0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="SectionCountLabel"
                       FontSize="11" Foreground="#555"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 7: Section 3 — All extracted sections -->
        <DataGrid Grid.Row="7"
                  x:Name="SectionsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserResizeColumns="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5"
                  BorderBrush="#D0D0D0" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="קוד סעיף"    Binding="{Binding SectionCode}"       Width="65"/>
                <DataGridTextColumn Header="אינדקס"       Binding="{Binding NoteSubIndex}"      Width="52"/>
                <DataGridTextColumn Header="פרק"          Binding="{Binding ChapterTitle}"      Width="70"/>
                <DataGridTextColumn Header="שם סעיף"      Binding="{Binding SectionTitle}"      Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight"    Value="56"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="סטטוס"        Binding="{Binding StatusKey}"         Width="110"/>
                <DataGridTextColumn Header="צבע"          Binding="{Binding StatusColorHex}"    Width="62"/>
                <DataGridTextColumn Header="טקסט הערה"    Binding="{Binding NoteText}"          Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight"    Value="96"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="תגובת מתכנן"  Binding="{Binding DesignerResponse}"  Width="115">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight"    Value="72"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="נסגר"     Binding="{Binding IsResolved}"        Width="44"/>
                <DataGridTextColumn Header="תאריך סגירה"  Binding="{Binding ClosedDate, StringFormat=dd/MM/yyyy}" Width="82"/>
                <DataGridTextColumn Header="שורת מקור"    Binding="{Binding ReportRow}"         Width="55"/>
                <DataGridTextColumn Header="תא מקור"      Binding="{Binding OriginalCellRef}"   Width="58"/>
                <DataGridCheckBoxColumn Header="פוצל"     Binding="{Binding WasSplit}"          Width="44"/>
                <DataGridTextColumn Header="מס׳ פיצול"    Binding="{Binding SplitIndex}"        Width="50"/>
                <DataGridTextColumn Header="אימות כותרת"  Binding="{Binding HeaderValidation}"  Width="88"/>
                <DataGridTextColumn Header="שיטת זיהוי"   Binding="{Binding DetectionMethod}"   Width="74"/>
                <DataGridTextColumn Header="התאמת תבנית" Binding="{Binding TemplateMatchStatus}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#555"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="כותרת תבנית"  Binding="{Binding TemplateSectionTitle}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight" Value="48"/>
                            <Setter Property="Foreground" Value="#777"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 8: Technical details — collapsed by default -->
        <Expander Grid.Row="8"
                  Header="🔧 פרטים טכניים (Template ID, Report ID, Cache)"
                  Margin="0,8,0,0" IsExpanded="False">
            <Border BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
                <ItemsControl x:Name="TechDetailsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"
                                           MinWidth="180" FontSize="11"
                                           Foreground="#666" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Value}" FontSize="11"
                                           Foreground="#444" TextWrapping="Wrap"
                                           MaxWidth="700"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Expander>

        <!-- Row 9: Close button -->
        <StackPanel Grid.Row="9" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="סגור" Width="90" Height="28"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
