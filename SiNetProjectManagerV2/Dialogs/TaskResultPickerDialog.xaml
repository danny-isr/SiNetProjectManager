<Window x:Class="SiNetProjectManagerV2.Dialogs.TaskResultPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תוצאת המשימה"
        Width="440" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="IntroBanner" Background="#E8F5E9" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="✅ סגירת משימה — תוצאה מקצועית"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#2E7D32"/>
                <TextBlock Text="בחר את התוצאה העסקית של המשימה (אופציונלי). זה מאפשר לתהליך להסתעף לפי התוצאה."
                           FontSize="11" Foreground="#666" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" x:Name="CategoryLabel" Text="קטגוריה:"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="#333" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="2" x:Name="CategoryComboBox"
                  Margin="0,0,0,8"
                  SelectionChanged="CategoryComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="3" Text="תוצאה:"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="#333" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="4" x:Name="ResultComboBox"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5"
                   x:Name="HelpText"
                   Text="ניתן לדלג ולסגור את המשימה ללא תוצאה."
                   FontSize="11" Foreground="#888"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="אישור" Width="90" Height="32" Margin="0,0,8,0"
                    Click="Ok_Click" IsDefault="True"/>
            <Button x:Name="NoResultButton" Content="ללא תוצאה" Width="100" Height="32" Margin="0,0,8,0"
                    Click="NoResult_Click"/>
            <Button Content="ביטול" Width="80" Height="32"
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
