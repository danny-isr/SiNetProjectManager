<Window x:Class="SiNetProjectManagerV2.Dialogs.TaskImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ייבוא משימות מ-TSV"
        Width="950" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="500"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <!-- DataContext set in code-behind via DI -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Title -->
            <RowDefinition Height="140"/>    <!-- 1: TSV Input -->
            <RowDefinition Height="Auto"/>   <!-- 2: Buttons -->
            <RowDefinition Height="*"/>      <!-- 3: Preview Grid -->
            <RowDefinition Height="Auto"/>   <!-- 4: Status Mapping -->
            <RowDefinition Height="Auto"/>   <!-- 5: Apply Mapping Button -->
            <RowDefinition Height="Auto"/>   <!-- 6: Ready to Import Summary (NEW! - Shows after mapping applied) -->
            <RowDefinition Height="Auto"/>   <!-- 7: Summary Text -->
            <RowDefinition Height="Auto"/>   <!-- 8: Status Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Title / Instructions -->
        <TextBlock Grid.Row="0"
                   Text="ייבוא משימות — הדבק נתוני TSV מ-Excel או Google Sheets"
                   FontWeight="SemiBold"
                   Foreground="#1565C0"
                   Margin="0,0,0,8"/>

        <!-- Row 1: Large TextBox for pasting -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
            <TextBox Text="{Binding RawTsvText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Padding="6"
                     FlowDirection="LeftToRight"
                     ToolTip="הדבק כאן נתוני TSV (Ctrl+V)"/>
        </Border>

        <!-- Row 2: Action buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="👁 תצוגה מקדימה"
                    Command="{Binding PreviewCommand}"
                    Padding="14,6"
                    FontWeight="SemiBold"
                    Background="#E3F2FD"
                    BorderBrush="#90CAF9"
                    Cursor="Hand"
                    ToolTip="פרסר את הנתונים והצג תצוגה מקדימה"/>

            <Button Grid.Column="1"
                    Content="✓ ייבא למערכת"
                    Command="{Binding CommitCommand}"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    FontWeight="SemiBold"
                    Background="#E8F5E9"
                    BorderBrush="#A5D6A7"
                    Foreground="#2E7D32"
                    Cursor="Hand"
                    ToolTip="שמור את הנתונים שעברו בדיקה למסד הנתונים"/>

            <ProgressBar Grid.Column="3"
                         IsIndeterminate="True"
                         Width="80" Height="6"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Row 3: Preview DataGrid -->
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="PreviewDataGrid"
                      ItemsSource="{Binding PreviewRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      FlowDirection="RightToLeft"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                
                <!-- ✨ FIXED: Row Style with Color-Coding (NO static backgrounds!) -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <!-- Default white background (before mapping) -->
                        <Setter Property="Background" Value="White"/>
                        
                        <Style.Triggers>
                            <!-- ⚠️ ORDER MATTERS: Most specific triggers LAST (highest priority) -->
                            
                            <!-- Task Destination: Light Blue Background -->
                            <DataTrigger Binding="{Binding IsTask}" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#BBDEFB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </DataTrigger>
                            
                            <!-- Decision Destination: Light Green Background -->
                            <DataTrigger Binding="{Binding IsDecision}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                
                <DataGrid.Columns>
                    <!-- 🔍 DEBUG: Temporary column to verify binding (REMOVE after testing) -->
                    <DataGridTextColumn Header="DEBUG" Width="60">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="IsTask"/>
                                <Binding Path="IsDecision"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="Red"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"/>
                    <DataGridTextColumn Header="מס' פרויקט" Binding="{Binding ProjectNumber}" Width="80"/>
                    <DataGridTextColumn Header="שם פרויקט" Binding="{Binding ProjectName}" Width="120"/>
                    <DataGridTextColumn Header="מטפל" Binding="{Binding Handler}" Width="80"/>
                    <DataGridTextColumn Header="סטטוס" Binding="{Binding Status}" Width="85"/>
                    <DataGridTextColumn Header="סוג" Binding="{Binding Type}" Width="80"/>
                    <DataGridTextColumn Header="עדיפות" Binding="{Binding Priority}" Width="55"/>
                    <DataGridTextColumn Header="תאריך" Binding="{Binding OpenDate}" Width="80"/>
                    <DataGridTextColumn Header="תיאור" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 4: Status Mapping Section -->
        <Border Grid.Row="4" Margin="0,8,0,0"
                Background="#FFF8E1" Padding="10" CornerRadius="4"
                BorderBrush="#FFE082" BorderThickness="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusMappings}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="⚙️ מיפוי סטטוסים — בחר יעד לכל סטטוס:"
                               FontWeight="Bold"
                               Foreground="#F57C00"
                               VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1" 
                               Text="(קבע אם פריטים עם כל סטטוס יובאו כמשימות או כהחלטות)"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    
                    <!-- Status Count Badge -->
                    <Border Grid.Column="2" 
                            Background="#F57C00" 
                            CornerRadius="12" 
                            Padding="8,3">
                        <TextBlock Text="{Binding StatusMappings.Count, StringFormat=\{0\} סטטוסים}" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Info Message -->
                <Border Grid.Row="1" 
                        Background="#FFFBF0" 
                        Padding="8,5" 
                        CornerRadius="3"
                        BorderBrush="#FFE082" 
                        BorderThickness="1"
                        Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="💡 "/>
                        <Run Text="כברירת מחדל, כל הסטטוסים מוגדרים כ-" FontWeight="SemiBold"/>
                        <Run Text="'משימה (Task)'" Foreground="#2E7D32" FontWeight="Bold"/>
                        <Run Text=". בחר "/>
                        <Run Text="'החלטה (Decision)'" Foreground="#1565C0" FontWeight="Bold"/>
                        <Run Text=" עבור סטטוסים שמייצגים החלטות ועדה או החלטות ניהוליות."/>
                    </TextBlock>
                </Border>

                <!-- Status Mappings List -->
                <ScrollViewer Grid.Row="2" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StatusMappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" 
                                        Padding="8,6" 
                                        Margin="0,0,0,4"
                                        CornerRadius="3"
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Name -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding StatusName}" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <!-- Occurrence Count -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding OccurrenceCount, StringFormat='({0} פריטים)'}"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Radio: Task -->
                                        <RadioButton Grid.Column="2"
                                                     Content="משימה (Task)"
                                                     IsChecked="{Binding ImportAsTask}"
                                                     GroupName="{Binding StatusName}"
                                                     Margin="15,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#2E7D32"
                                                     FontWeight="SemiBold"/>

                                        <!-- Radio: Decision -->
                                        <RadioButton Grid.Column="3"
                                                     Content="החלטה (Decision)"
                                                     IsChecked="{Binding ImportAsDecision}"
                                                     GroupName="{Binding StatusName}"
                                                     Margin="15,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#1565C0"
                                                     FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 5: Apply Mapping Button (Confirmation Step) -->
        <Border Grid.Row="5" 
                Margin="0,10,0,0"
                Padding="10" 
                CornerRadius="4"
                Background="#FFF3E0"
                BorderBrush="#FFB74D"
                BorderThickness="2"
                Visibility="{Binding HasStatusMappings, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon & Instructions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👁" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="צעד 3: אישור ויזואלי" 
                                   FontWeight="Bold" 
                                   Foreground="#E65100"/>
                        <TextBlock Text="לחץ על הכפתור להחלת צבעים לאישור ויזואלי" 
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Apply Mapping Button -->
                <Button Grid.Column="2"
                        Content="✓ החל מיפוי וצבע שורות"
                        Command="{Binding ApplyMappingCommand}"
                        Padding="16,8"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#FF9800"
                        Foreground="White"
                        BorderBrush="#F57C00"
                        BorderThickness="2"
                        Cursor="Hand"
                        ToolTip="החל את המיפוי שבחרת וצבע את השורות לאישור ויזואלי">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF9800" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#CCC"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="BorderBrush" Value="#AAA"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMappingApplied}" Value="True">
                                    <Setter Property="Content" Value="✓ מיפוי הוחל - הצבעים פעילים"/>
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="BorderBrush" Value="#388E3C"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Row 6: Ready to Import Summary (NEW! - Shows after mapping applied) -->
        <Border Grid.Row="6" 
                Margin="0,10,0,0"
                Background="#E8F5E9" 
                BorderBrush="#4CAF50"
                BorderThickness="2"
                Padding="12"
                CornerRadius="4"
                Visibility="{Binding IsMappingApplied, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="✓ מוכן לייבוא" 
                           FontWeight="Bold" 
                           FontSize="16"
                           Foreground="#2E7D32"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                
                <!-- Summary Counts -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Task Count (Blue) -->
                    <TextBlock FontSize="14" Margin="0,0,4,0"
                               Text="{Binding TaskCount}"
                               FontWeight="Bold"
                               Foreground="#1976D2"/>
                    <TextBlock FontSize="14" Margin="0,0,8,0"
                               Text=" משימות (כחול)"
                               Foreground="#424242"/>
                    
                    <TextBlock Text=" | " FontSize="14" Foreground="#9E9E9E"/>
                    
                    <!-- Decision Count (Green) -->
                    <TextBlock FontSize="14" Margin="4,0,4,0"
                               Text="{Binding DecisionCount}"
                               FontWeight="Bold"
                               Foreground="#388E3C"/>
                    <TextBlock FontSize="14" Margin="0,0,8,0"
                               Text=" החלטות (ירוק)"
                               Foreground="#424242"/>
                    
                    <!-- Ignored Count (if any) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasIgnoredRows, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text=" | " FontSize="14" Foreground="#9E9E9E" Margin="0,0,4,0"/>
                        <TextBlock Text="התעלמו מ-" FontSize="14" Foreground="#757575"/>
                        <TextBlock Text="{Binding IgnoredCount}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F57C00"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text=" שורות ריקות" FontSize="14" Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Visual Guide -->
                <TextBlock Text="בדוק את הצבעים בטבלה למעלה ולחץ על 'ייבא למערכת' להשלמת הייבוא"
                           FontSize="12"
                           Foreground="#616161"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Row 7: Summary / Warnings text (visible only when SummaryText is non-null) -->
        <Border Grid.Row="7" Margin="0,6,0,0"
                Background="#FFFDE7" Padding="8,6" CornerRadius="4"
                BorderBrush="#FFF9C4" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SummaryText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="#555"
                       TextWrapping="Wrap"
                       MaxHeight="120"/>
        </Border>

        <!-- Row 8: Status bar -->
        <Border Grid.Row="8" Margin="0,6,0,0"
                Background="#FAFAFA" Padding="8,5"
                CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#666"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
