<Window x:Class="SiNetProjectManagerV2.Dialogs.WorkflowCreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SiNetProjectManagerV2.Controls"
        Title="יצירת פרויקט חדש"
        Width="850" Height="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="700" MinHeight="600"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Email viewer panel (scalable) -->
            <RowDefinition Height="1.2*" MinHeight="250"/>
            <RowDefinition Height="Auto"/>
            <!-- Project creation form -->
            <RowDefinition Height="1*" MinHeight="250"/>
        </Grid.RowDefinitions>

        <!-- ═══ Top: Email Viewer Control ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFD54F" BorderThickness="0,0,0,1">
            <controls:EmailViewerControl x:Name="EmailViewer" ForceHtmlOnly="True" FlowDirection="LeftToRight"/>
        </Border>

        <!-- Separator with collapse toggle -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="#FFD54F" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

        <!-- ═══ Bottom: Project Creation Form ═══ -->
        <Grid Grid.Row="2">
            <ContentPresenter x:Name="ProjectFormHost"/>
        </Grid>
    </Grid>
</Window>