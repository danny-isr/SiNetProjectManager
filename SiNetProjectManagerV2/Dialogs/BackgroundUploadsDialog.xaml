<Window x:Class="SiNetProjectManagerV2.Dialogs.BackgroundUploadsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תהליכים ברקע"
        Width="480" Height="280"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF3E0" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           Text="תהליכי רקע פעילים (ACC)"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#E65100"/>
                <TextBlock x:Name="CountText"
                           FontSize="13" Foreground="#555" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="6"
                     Margin="0,0,0,10" Foreground="#FB8C00"
                     x:Name="ProgressIndicator"/>

        <TextBlock Grid.Row="2" x:Name="InfoText"
                   FontSize="12" Foreground="#555" TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left"
                    Margin="0,12,0,0">
            <Button x:Name="CloseWhenDoneButton"
                    Click="CloseWhenDone_Click"
                    IsDefault="True"
                    Padding="14,8" MinWidth="150" Margin="0,0,8,0"
                    FontWeight="SemiBold" FontSize="12"
                    Background="#C8E6C9" BorderBrush="#81C784"/>
            <Button x:Name="ForceCloseButton"
                    Click="ForceClose_Click"
                    Padding="14,8" MinWidth="150" Margin="0,0,8,0"
                    FontWeight="SemiBold" FontSize="12"
                    Background="#FFCDD2" BorderBrush="#EF9A9A"/>
            <Button x:Name="CancelButton"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="14,8" MinWidth="100"
                    FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
