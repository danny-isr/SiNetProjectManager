<Window x:Class="SiNetProjectManagerV2.Dialogs.SyncFailureDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Failure — Full Details"
        Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Metadata -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Failed At:" FontWeight="Bold" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FailedAtText"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Error Stage:" FontWeight="Bold" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ErrorStageText"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Error Type:" FontWeight="Bold" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ErrorTypeText"/>
        </Grid>

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Text="Error Message:" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2"
                 x:Name="ErrorMessageBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="11"
                 Background="#FAFAFA"
                 BorderBrush="#CCCCCC"
                 Margin="0,0,0,10"/>

        <!-- Close Button -->
        <Button Grid.Row="3"
                Content="Close"
                Padding="12,6"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="Close_Click"/>
    </Grid>
</Window>
