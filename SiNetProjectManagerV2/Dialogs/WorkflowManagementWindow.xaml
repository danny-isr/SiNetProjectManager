<Window x:Class="SiNetProjectManagerV2.Dialogs.WorkflowManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:SiNetProjectManagerV2.WPFUserControl"
        Title="ניהול תהליכי עבודה"
        Width="1120" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="860" MinHeight="540"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MAIN TAB CONTROL                                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="0" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 1: BUILDER (בונה תהליכים)                           -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="🏗️ בונה תהליכים ומשימות" x:Name="BuilderTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" Foreground="#1565C0" FontSize="12"
                                   Text="עץ תהליכים: בחר תהליך ← שלב ← משימה. ניתן להוסיף משימות לשלבים ולשייך עובד ברירת מחדל."/>
                    </Border>

                    <!-- Tree + Detail -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Tree -->
                        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="עץ תהליכים" FontWeight="Bold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="➕ תהליך חדש"
                                                Click="BuilderAddWorkflow_Click" Padding="6,2" FontSize="11"
                                                Margin="0,0,4,0" Background="#BBDEFB" FontWeight="Bold"/>
                                        <Button Grid.Column="2" Content="🔄 רענן"
                                                Click="BuilderRefresh_Click" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <TreeView Grid.Row="1" x:Name="WorkflowTree"
                                          BorderThickness="0" Padding="4"
                                          SelectedItemChanged="WorkflowTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="True"/>
                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right: Detail panel -->
                        <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <TextBlock x:Name="BuilderDetailHeader" Text="בחר פריט מהעץ..."
                                               FontWeight="Bold" FontSize="13"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                    <StackPanel x:Name="BuilderDetailPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 2: VISUAL DESIGNER (עורך ויזואלי)                    -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="🎨 עורך ויזואלי" x:Name="DesignerTab">
                <uc:WorkflowDesignerView x:Name="DesignerView"/>
            </TabItem>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 3: POLICY (שיוך לסוגי פרויקט)                       -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="⚙️ שיוך תהליכים לסוגי פרויקט" x:Name="PolicyTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock Text="בחר סוג פרויקט משמאל, וסמן את תהליכי העבודה המותרים עבורו מימין. סימון ⭐ = ברירת מחדל."
                                   TextWrapping="Wrap" Foreground="#1565C0" FontSize="12"/>
                    </Border>

                    <!-- Two panels -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: ProjectType list -->
                        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <TextBlock Text="סוגי פרויקט" FontWeight="Bold" FontSize="13"/>
                                </Border>

                                <TextBox Grid.Row="1" x:Name="PolicySearchBox"
                                         TextChanged="PolicySearchBox_TextChanged"
                                         Padding="6,4" Margin="6,6,6,2"
                                         Tag="🔍 חיפוש סוג..."/>

                                <ListBox Grid.Row="2"
                                         x:Name="PolicyProjectTypeListBox"
                                         SelectionChanged="PolicyProjectType_SelectionChanged"
                                         BorderThickness="0" Padding="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MappingCount, StringFormat=' ({0})'}"
                                                           Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right: Workflow checklist -->
                        <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <TextBlock x:Name="PolicySelectedTypeHeader"
                                               Text="בחר סוג פרויקט..."
                                               FontWeight="Bold" FontSize="13"/>
                                </Border>

                                <ListBox Grid.Row="1"
                                         x:Name="PolicyWorkflowListBox"
                                         BorderThickness="0" Padding="4"
                                         SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Checked="PolicyCheckBox_Changed"
                                                          Unchecked="PolicyCheckBox_Changed"
                                                          VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DefinitionName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DefinitionDescription}"
                                                               Foreground="Gray" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <ToggleButton Grid.Column="2"
                                                              IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                              Content="⭐" ToolTip="ברירת מחדל"
                                                              FontSize="14" Width="32" Height="28"
                                                              Margin="4,0,0,0"
                                                              IsEnabled="{Binding IsEnabled}"
                                                              Checked="PolicyDefaultToggle_Changed"
                                                              Unchecked="PolicyDefaultToggle_Changed"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Save button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="💾 שמור שיוכים" Padding="14,6"
                                Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"
                                Click="PolicySave_Click"
                                ToolTip="שמור את כל השינויים"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 3: DASHBOARD (לוח תהליכים)                          -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="📊 לוח תהליכים" x:Name="DashboardTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="פרויקט:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DashboardProjectCombo"
                                  DisplayMemberPath="Title"
                                  Width="300" Margin="0,0,16,0"
                                  SelectionChanged="DashboardProject_SelectionChanged"/>

                        <CheckBox x:Name="DashboardActiveOnlyCheck"
                                  Content="הצג פעילים בלבד" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Checked="DashboardActiveOnly_Changed"
                                  Unchecked="DashboardActiveOnly_Changed"/>

                        <Button Content="🔄 רענן" Click="DashboardRefresh_Click"
                                Padding="8,4" Margin="0,0,8,0"/>

                        <Border BorderThickness="1,0,0,0" BorderBrush="#E0E0E0" Margin="8,0,8,0"/>

                        <TextBlock Text="תבנית:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DashboardDefinitionCombo"
                                  DisplayMemberPath="Name"
                                  Width="180" Margin="0,0,8,0"/>

                        <Button Content="▶ הפעל תהליך" Click="DashboardStartWorkflow_Click"
                                Padding="8,4" Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Instances DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="DashboardInstancesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0"
                              RowHeaderWidth="0"
                              MouseDoubleClick="DashboardGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="תבנית" Binding="{Binding WorkflowDefinition.Name}" Width="150"/>
                            <DataGridTextColumn Header="שלב נוכחי" Binding="{Binding CurrentStage.Name}" Width="150"/>
                            <DataGridTextColumn Header="סטטוס" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="נוצר" Binding="{Binding CreatedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="הערות" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 4: BEHAVIORS (התנהגויות משימה)                       -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="🧠 התנהגויות משימה" x:Name="BehaviorTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" Foreground="#E65100" FontSize="12"
                                   Text="הגדרת התנהגויות אוטומטיות: מה מפעיל יצירת משימה (Trigger) ומה מסיים אותה (Completion). בחר התנהגות מהרשימה לעריכה, או הוסף חדשה."/>
                    </Border>

                    <!-- Left list + Right detail -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="220"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Behavior list -->
                        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="התנהגויות מוגדרות" FontWeight="Bold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🔄 רענן"
                                                Click="BehaviorRefresh_Click" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1" x:Name="BehaviorListBox"
                                         SelectionChanged="BehaviorList_SelectionChanged"
                                         BorderThickness="0" Padding="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActiveIcon}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Foreground="Gray"
                                                           FontSize="10" Margin="18,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Row="2" Content="➕ הוסף התנהגות חדשה"
                                        Click="BehaviorAdd_Click"
                                        Margin="6" Padding="8,4"
                                        Background="#BBDEFB" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right: Detail panel -->
                        <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                                    <TextBlock x:Name="BehaviorDetailHeader" Text="בחר התנהגות מהרשימה..."
                                               FontWeight="Bold" FontSize="13"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                    <StackPanel x:Name="BehaviorDetailPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <!-- TAB 5: HELP (עזרה)                                       -->
            <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
            <TabItem Header="❓ עזרה" x:Name="HelpTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel x:Name="HelpContentPanel" Margin="4"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FOOTER                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>

            <Button Grid.Column="1" Content="סגור" Padding="14,6"
                    Click="Close_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
