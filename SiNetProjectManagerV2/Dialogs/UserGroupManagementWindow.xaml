<Window x:Class="SiNetProjectManagerV2.Dialogs.UserGroupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול קבוצות משתמשים"
        Width="750" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="650" MinHeight="450"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Left: Group List ═══ -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="קבוצות" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddGroupButton" Content="➕ חדש" Click="AddGroupButton_Click"
                        Padding="8,4" Margin="0,0,5,0" Cursor="Hand"/>
                <Button x:Name="DeleteGroupButton" Content="🗑️ מחק" Click="DeleteGroupButton_Click"
                        Padding="8,4" Cursor="Hand" Foreground="#D32F2F"/>
            </StackPanel>

            <ListBox x:Name="GroupListBox" SelectionChanged="GroupListBox_SelectionChanged"
                     DisplayMemberPath="Name" BorderBrush="#CCC" BorderThickness="1"/>
        </DockPanel>

        <!-- ═══ Right: Group Details ═══ -->
        <DockPanel Grid.Column="1">
            <!-- Group header fields -->
            <StackPanel DockPanel.Dock="Top">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="קוד:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="GroupCodeTextBox" Grid.Row="0" Grid.Column="1"
                             Padding="5,3" Margin="0,0,0,6" FlowDirection="LeftToRight" MaxLength="50"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="שם:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="GroupNameTextBox" Grid.Row="1" Grid.Column="1"
                             Padding="5,3" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="תיאור:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox x:Name="GroupDescriptionTextBox" Grid.Row="2" Grid.Column="1"
                             Padding="5,3" Margin="0,0,0,6"/>
                </Grid>

                <!-- Default Assignee -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="ברירת מחדל:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="DefaultAssigneeCombo" Width="200" DisplayMemberPath="Name"
                              SelectedValuePath="Id" VerticalContentAlignment="Center"
                              SelectionChanged="DefaultAssigneeCombo_SelectionChanged"/>
                    <Button x:Name="ClearDefaultButton" Content="✖" Click="ClearDefaultButton_Click"
                            Padding="5,2" Margin="5,0,0,0" Cursor="Hand" ToolTip="נקה ברירת מחדל"
                            Background="Transparent" BorderBrush="#CCC"/>
                </StackPanel>

                <Separator Margin="0,0,0,10"/>

                <!-- Members header -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="חברי קבוצה" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"/>
                    <Button x:Name="AddMemberButton" Content="➕ הוסף חבר" Click="AddMemberButton_Click"
                            DockPanel.Dock="Left" HorizontalAlignment="Left"
                            Padding="8,3" Cursor="Hand"/>
                </DockPanel>
            </StackPanel>

            <!-- Members list -->
            <DockPanel>
                <Button x:Name="RemoveMemberButton" DockPanel.Dock="Bottom" Content="הסר חבר מהקבוצה"
                        Click="RemoveMemberButton_Click" Padding="8,4" Margin="0,8,0,0"
                        HorizontalAlignment="Right" Cursor="Hand" Foreground="#D32F2F"/>

                <DataGrid x:Name="MembersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" HeadersVisibility="Column"
                          BorderBrush="#CCC" BorderThickness="1"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="שם" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="דוא&quot;ל" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="תפקיד" Binding="{Binding Role}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
