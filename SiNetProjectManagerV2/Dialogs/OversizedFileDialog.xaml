<Window x:Class="SiNetProjectManagerV2.Dialogs.OversizedFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קובץ גדול"
        Width="500" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0" Background="#FFF3E0" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚠️ קובץ גדול מהמותר" 
                           FontSize="15" FontWeight="Bold" 
                           Foreground="#E65100"/>
                <TextBlock x:Name="FileNameText"
                           FontSize="12" Foreground="#555" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="36"/>
            </StackPanel>
        </Border>

        <!-- Size Info -->
        <Border Grid.Row="1" Background="#FBE9E7" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="SizeInfoText"
                           FontSize="12" Foreground="#BF360C"
                           TextWrapping="Wrap"/>
                <TextBlock Text="ניתן לשנות את המגבלה בקובץ appsettings.json → WebView2 → MaxUploadFileSizeMb"
                           FontSize="11" Foreground="#999" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Question -->
        <TextBlock Grid.Row="2"
                   Text="האם בכל זאת להעלות את הקובץ ל-ACC?"
                   FontSize="13" Foreground="#333" Margin="0,4,0,0"
                   VerticalAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="✅ העלה בכל זאת" 
                    Click="UploadAnyway_Click"
                    Padding="14,8" MinWidth="130" Margin="0,0,8,0"
                    FontWeight="SemiBold" FontSize="13"
                    Background="#FFF9C4" BorderBrush="#FFD54F"/>
            <Button Content="ביטול" 
                    Click="Cancel_Click"
                    IsCancel="True" IsDefault="True"
                    Padding="14,8" MinWidth="70"
                    FontSize="13" Foreground="#999"/>
        </StackPanel>
    </Grid>
</Window>
