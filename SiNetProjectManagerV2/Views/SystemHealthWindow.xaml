<Window x:Class="SiNetProjectManagerV2.Views.SystemHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SiNetProjectManagerV2.Converters"
        Title="מצב מערכת"
        FlowDirection="RightToLeft"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:ServiceHealthStateToBrushConverter x:Key="StateToBrush"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="מצב מערכת" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Left"
                    Content="🔄 בדוק עכשיו"
                    Padding="10,4"
                    Click="RefreshButton_Click"/>
        </DockPanel>

        <TextBlock x:Name="LastUpdatedText"
                   DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   Foreground="Gray"
                   FontSize="11"/>

        <DataGrid x:Name="StatusGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="מצב" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="4,0,4,0"
                                         Fill="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                <TextBlock Text="{Binding StateGlyph}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="שירות" Binding="{Binding DisplayName}" Width="200"/>
                <DataGridTextColumn Header="קטגוריה" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="הודעה" Binding="{Binding Message}" Width="*"/>
                <DataGridTextColumn Header="עודכן" Binding="{Binding LastCheckedLocal}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

