<UserControl x:Class="SiNetProjectManager.Controls.SearchableProjectSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SiNetProjectManager.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Converter for compact display format: [Number] Title | Company -->
        <local:ProjectDisplayConverter x:Key="ProjectDisplayConverter"/>

        <!-- Custom ItemContainerStyle for better performance -->
        <Style x:Key="VirtualizedComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </UserControl.Resources>

    <!-- 
    IMPORTANT: Do NOT bind SelectedItem or Text here!
    All synchronization is handled in code-behind to avoid circular binding issues.
    The SelectionChanged event updates the UserControl's SelectedItem DP,
    which then propagates to the ViewModel via the external binding.
    -->
    <ComboBox x:Name="PART_ComboBox"
              IsEditable="True"
              IsTextSearchEnabled="False"
              StaysOpenOnEdit="True"
              IsSynchronizedWithCurrentItem="False"
              TextSearch.TextPath="NameAndNumber"
              SelectionChanged="PART_ComboBox_SelectionChanged"
              ItemContainerStyle="{StaticResource VirtualizedComboBoxItem}"
              MaxDropDownHeight="350">

        <!-- Enable virtualization for large lists -->
        <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel 
                    IsVirtualizing="True"
                    VirtualizationMode="Recycling"/>
            </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>

        <!-- Custom ItemTemplate with text highlighting and compact display -->
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock local:HighlightBehavior.HighlightText="{Binding FilterText, ElementName=Root}"
                           local:HighlightBehavior.SourceText="{Binding Converter={StaticResource ProjectDisplayConverter}}"
                           local:HighlightBehavior.HighlightBrush="Yellow"/>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
