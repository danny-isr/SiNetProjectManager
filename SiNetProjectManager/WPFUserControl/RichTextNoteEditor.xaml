<UserControl x:Class="SiNetProjectManager.WPFUserControl.RichTextNoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <!-- Display mode: colored text preview (visible when NOT editing) -->
        <Border x:Name="DisplayBorder"
                Background="White"
                BorderBrush="#DDD" BorderThickness="1"
                Padding="2,0"
                MinHeight="20"
                MouseLeftButtonDown="DisplayBorder_MouseDown"
                Visibility="Visible">
            <Border.ContextMenu>
                <ContextMenu Opened="AiContextMenu_Opened"/>
            </Border.ContextMenu>
            <TextBlock x:Name="DisplayBlock"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource AppFontSizeSecondary}"
                       VerticalAlignment="Top"/>
        </Border>

        <!-- Edit mode: raw markup TextBox (visible when editing) -->
        <TextBox x:Name="EditBox"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="White"
                 BorderBrush="#90CAF9" BorderThickness="1.5"
                 Padding="2,0" FontSize="{DynamicResource AppFontSizeSecondary}"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="Collapsed"
                 TextChanged="EditBox_TextChanged"
                 LostFocus="EditBox_LostFocus">
            <TextBox.ContextMenu>
                <ContextMenu Closed="ContextMenu_Closed">
                    <MenuItem Header="🔴 אדום (בולט)" Tag="1!" Click="ColorText_Click"/>
                    <MenuItem Header="🔵 כחול (בולט)" Tag="2!" Click="ColorText_Click"/>
                    <MenuItem Header="🟢 ירוק (בולט)" Tag="4!" Click="ColorText_Click"/>
                    <MenuItem Header="⬜ אפור (בולט)" Tag="3!" Click="ColorText_Click"/>
                    <Separator/>
                    <MenuItem Header="🔴 אדום" Tag="1" Click="ColorText_Click"/>
                    <MenuItem Header="🔵 כחול" Tag="2" Click="ColorText_Click"/>
                    <MenuItem Header="🟢 ירוק" Tag="4" Click="ColorText_Click"/>
                    <MenuItem Header="⬜ אפור" Tag="3" Click="ColorText_Click"/>
                    <Separator/>
                    <MenuItem Header="𝐁 בולט" Tag="!" Click="ColorText_Click"/>
                    <MenuItem Header="⬛ ברירת מחדל" Tag="0" Click="ColorText_Click"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
    </Grid>
</UserControl>
