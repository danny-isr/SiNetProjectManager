<UserControl x:Class="SiNetProjectManager.WPFUserControl.ProjectFolderTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:selectors="clr-namespace:SiNetProjectManager.WPFUserControl"
             xmlns:controls="clr-namespace:SiNetProjectManager.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <!--<UserControl.DataContext>
        <local:ProjectFolderTreeViewModel />
    </UserControl.DataContext>-->

    <!-- Styles לבין StyleSelector להצללה לסירוגין של ProjectFileNode -->
    <UserControl.Resources>
        <!-- Style עבור ProjectFileNode (שכבת ה-File הראשונית) -->
        <Style x:Key="FileItemStyle"
           TargetType="TreeViewItem"
           BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <!-- מגדיר סירוגין בכל שני פריטים בתת-עץ פנימי -->
            <Setter Property="ItemsControl.AlternationCount" Value="2"/>
            <!-- רקע ברירת המחדל -->
            <Setter Property="Background" Value="#F7F7F7"/>
            <Style.Triggers>
                <!-- רקע כהה יותר לפריטים עם אינדקס אי-זוגי -->
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E1E1E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style עבור AlternativeNode ו-VersionNode (ולכל TreeViewItem לא-ראשי) -->
        <Style x:Key="DefaultItemStyle"
           TargetType="TreeViewItem"
           BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="ItemsControl.AlternationCount" Value="2"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#E1E1E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- StyleSelector שמפנה בין הסטיילים -->
        <selectors:FileItemContainerStyleSelector
        x:Key="FileStyleSelector"
        FileStyle="{StaticResource FileItemStyle}"
        DefaultStyle="{StaticResource DefaultItemStyle}" />
    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0: סינונים -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
            <controls:SearchableProjectSelector
                ItemsSource="{Binding ProjectsView}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ExternalFilter="{Binding ProjectFilterPredicate}"
                FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                SortPropertyPath="Number"
                SortAscending="False"
                Width="300" Margin="0,0,5,0"
                ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

            <!-- Place and Company filters removed - SearchableProjectSelector handles these via text search -->

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding JobTypes}"
                      SelectedItem="{Binding SelectedJobTypeFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סוג פרויקט" />

            <ComboBox Width="120" Margin="0,0,5,0"
                      ItemsSource="{Binding ProjectStatuses}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      DisplayMemberPath="Title"
                      ToolTip="סטטוס" />

            <ComboBox Width="120"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUserFilter}"
                      DisplayMemberPath="Name"
                      ToolTip="משתמש (Siuser.Name)" />
        </StackPanel>



        <!-- 1: בחירת פרויקט -->
        
        <!-- 2: פרטי הפרויקט -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Padding="5" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="4" Background="#F9F9F9" Margin="0,0,0,10">
            <TextBlock Text="{Binding ProjectDetails}" TextWrapping="Wrap" />
        </Border>

        <!-- 3: עץ תיקיות (TreeView כולל ScrollViewer פנימי משלו) -->
        <TreeView Grid.Row="3" Grid.Column="0"
                  ItemsSource="{Binding RootFolders}"
                  SelectedItemChanged="TreeView_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                        <Image Width="16" Height="16" Margin="0,0,5,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="/Assets/folder_project.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUserCreated}" Value="True">
                                            <Setter Property="Source" Value="/Assets/folder_user.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 3: עץ קבצים עם סירוגין גוונים (TreeView כולל ScrollViewer פנימי משלו) -->
        <TreeView Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"
    Name="FilesTreeView"
    ItemsSource="{Binding ProjectFiles}"
    AlternationCount="2"
    ItemContainerStyleSelector="{StaticResource FileStyleSelector}">

            <i:Interaction.Behaviors>
                <local:FileDropBehavior
            FileDroppedCommand="{Binding HandleFileDropCommand}"
            AllowMultipleFiles="False" />
            </i:Interaction.Behaviors>

            <TreeView.Resources>
                <!-- ProjectFileNode -->
                <HierarchicalDataTemplate DataType="{x:Type local:ProjectFileNode}" ItemsSource="{Binding Alternatives}">
                    <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                        <TextBlock Text=" (" />
                        <TextBlock Text="{Binding Extension}" />
                        <TextBlock Text=")  " />
                        <TextBlock>
                    <Run Text="Alt: " />
                    <Run Text="{Binding AlternativeCount, Mode=OneWay}" />
                    <Run Text=", Ver: " />
                    <Run Text="{Binding VersionCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- AlternativeNode עם Drag&Drop -->
                <HierarchicalDataTemplate DataType="{x:Type local:AlternativeNode}" ItemsSource="{Binding Versions}">
                    <HierarchicalDataTemplate.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="ItemsControl.AlternationCount" Value="2"/>
                            <Setter Property="Background" Value="#F7F7F7"/>

                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="MouseMove" Handler="TreeViewItem_MouseMove"/>
                            <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>

                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#E1E1E1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </HierarchicalDataTemplate.ItemContainerStyle>

                    <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                        <Image Source="{Binding DisplayIcon}" Width="20" Height="20" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AlternativeName}" FontWeight="SemiBold" />
                        <TextBlock Text=" (" />
                        <TextBlock Text="{Binding VersionCount, Mode=OneWay}" />
                        <TextBlock Text=" גרסאות)" />
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- VersionNode -->
                <DataTemplate DataType="{x:Type local:VersionNode}">
                    <StackPanel Orientation="Horizontal" ContextMenu="{Binding ContextMenu}">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Description}" Margin="5,0" />
                        <TextBlock Text=" Ver: " FontWeight="Bold" />
                        <TextBlock Text="{Binding VersionNumber}" Margin="5,0" />
                        <TextBlock Text=" Size: " FontWeight="Bold" />
                        <TextBlock Text="{Binding Size}" Margin="5,0" />
                        <TextBlock Text=" Date: " FontWeight="Bold" />
                        <TextBlock Text="{Binding Date}" Margin="5,0" />
                        <TextBlock Text=" Exclude: " FontWeight="Bold" />
                        <TextBlock Text="{Binding ExcludeReason }" Margin="5,0" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
