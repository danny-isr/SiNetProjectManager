<local:FloatingWindowBase x:Class="SiNetProjectManager.WPFUserControl.FloatingProjectTasksView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:SiNetProjectManager.Converters"
        xmlns:local="clr-namespace:SiNetProjectManager.WPFUserControl"
        mc:Ignorable="d"
        Title="משימות פרויקט"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        ShowInTaskbar="False"
        Width="420" Height="560"
        MinWidth="340" MinHeight="360"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StatusIdToColorConverter x:Key="StatusIdToColor"/>

        <!-- Card border style for task items -->
        <Style TargetType="Border" x:Key="TaskCardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <!-- Waiting: alive but ball is outside (IsOpen=true, IsActionable=false) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AssignmentStatus.IsOpen}" Value="True"/>
                        <Condition Binding="{Binding AssignmentStatus.IsActionable}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="BorderBrush" Value="#FFE082"/>
                </MultiDataTrigger>
                <!-- Closed: done (IsOpen=false) -->
                <DataTrigger Binding="{Binding AssignmentStatus.IsOpen}" Value="False">
                    <Setter Property="Background" Value="#F9F9F9"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox item container: transparent, no chrome, card look -->
        <Style TargetType="ListBoxItem" x:Key="CardListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action button -->
        <Style TargetType="Button" x:Key="CardActionButton">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Status badge style - background driven by StatusColorService cache -->
        <Style TargetType="Border" x:Key="StatusBadge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{Binding StatusId, Converter={StaticResource StatusIdToColor}}"/>
        </Style>

        <!-- Status text style - clean, color is conveyed by badge background -->
        <Style TargetType="TextBlock" x:Key="StatusText">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="#F5F5F5" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Project Name + Pin Toggle + Close (draggable) -->
        <Border Grid.Row="0" Background="#1565C0" Padding="10,8"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveProjectDisplay}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsPinned, Mode=TwoWay}"
                              Width="28" Height="28"
                              Margin="6,0,0,0"
                              Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="ToolTip" Value="הצמד למעלה"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PinBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="4">
                                            <TextBlock x:Name="PinIcon"
                                                       Text="📌"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PinIcon" Property="Opacity" Value="1.0"/>
                                                <Setter TargetName="PinBorder" Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PinBorder" Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="False">
                                    <Setter Property="ToolTip" Value="הצמד למעלה (כבוי)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- Dock/Undock toggle: docked = stays with app, undocked = floats above all -->
                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsDocked, Mode=TwoWay}"
                              Width="28" Height="28"
                              Margin="4,0,0,0"
                              Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="ToolTip" Value="עגן לאפליקציה"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DockBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="4">
                                            <TextBlock x:Name="DockIcon"
                                                       Text="🏠"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="DockIcon" Property="Opacity" Value="1.0"/>
                                                <Setter TargetName="DockBorder" Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DockBorder" Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDocked}" Value="True">
                                    <Setter Property="ToolTip" Value="עגון לאפליקציה (פעיל — מוסתר מאחורי אפליקציות אחרות)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button Grid.Column="3"
                        Content="🔄"
                        Command="{Binding RefreshCommand}"
                        ToolTip="רענן"
                        Width="28" Height="28"
                        Margin="4,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"/>

                <Button Grid.Column="4"
                        Content="⊡"
                        Click="ResetSizeButton_Click"
                        ToolTip="אפס גודל חלון"
                        Width="28" Height="28"
                        Margin="4,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="14"/>

                <!-- Collapse / Expand toggle -->
                <Button Grid.Column="5"
                        Command="{Binding ToggleCollapseCommand}"
                        Width="28" Height="28"
                        Margin="4,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="🔽"/>
                            <Setter Property="ToolTip" Value="כווץ"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter Property="Content" Value="🔼"/>
                                    <Setter Property="ToolTip" Value="הרחב"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close button -->
                <Button Grid.Column="6"
                        Content="✕"
                        Click="CloseButton_Click"
                        ToolTip="סגור"
                        Width="28" Height="28"
                        Margin="4,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Filter bar -->
        <Border x:Name="FilterBar" Grid.Row="1" Background="#E3F2FD" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="הצג גם משימות סגורות"
                          IsChecked="{Binding IncludeClosedTasks}"
                          VerticalAlignment="Center"/>

                <CheckBox Content="📝 הערות מלאות"
                          IsChecked="{Binding ShowFullNotes}"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          ToolTip="הצג/הסתר הערות אחרונות במלואן"/>
            </StackPanel>
        </Border>

        <!-- Quick-create strip -->
        <Border x:Name="QuickCreateBar" Grid.Row="2" Background="#FFF8E1" Padding="8,5"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                IsEnabled="{Binding HasActiveProject}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Task Type + Status -->
                <ComboBox Grid.Row="0" Grid.Column="0"
                          ItemsSource="{Binding AllowedTaskTypes}"
                          SelectedItem="{Binding NewTaskType}"
                          DisplayMemberPath="Name"
                          Margin="0,0,4,4"
                          VerticalContentAlignment="Center"
                          ToolTip="סוג משימה"/>

                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding AllowedStatuses}"
                          SelectedItem="{Binding NewTaskStatus}"
                          DisplayMemberPath="Name"
                          Margin="4,0,0,4"
                          VerticalContentAlignment="Center"
                          ToolTip="סטטוס התחלתי (ברירת מחדל: פתוח)"/>

                <!-- Row 1: DatePicker + Create Button + Import Button -->
                <DatePicker Grid.Row="1" Grid.Column="0"
                            SelectedDate="{Binding NewTaskDueDate}"
                            Margin="0,0,4,0"
                            VerticalContentAlignment="Center"
                            ToolTip="תאריך יעד (ברירת מחדל: היום)"/>

                <Button Grid.Row="1" Grid.Column="1"
                        Content="+ חדש"
                        Command="{Binding CreateNewTaskCommand}"
                        Style="{StaticResource CardActionButton}"
                        FontWeight="SemiBold"
                        Padding="10,3"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Stretch"
                        ToolTip="צור משימה חדשה לפרויקט הנוכחי"/>

                <Button Grid.Row="1" Grid.Column="2"
                        Content="📥"
                        Click="ImportTsvButton_Click"
                        Style="{StaticResource CardActionButton}"
                        Padding="6,2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="ייבוא משימות מנתוני TSV"/>
            </Grid>
        </Border>

        <!-- Task Cards: ListBox with compact cards (supports selection) -->
        <ListBox x:Name="TaskListBox" Grid.Row="3"
                 ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}"
                 ItemContainerStyle="{StaticResource CardListBoxItem}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,6">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Tag="{Binding}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TaskCardBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: TaskType + Priority + Status Badge -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Priority number (editable) -->
                                <Border Grid.Column="0"
                                        Background="#E8EAF6"
                                        CornerRadius="3"
                                        Padding="2,1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBox Text="{Binding WorkPriority, Mode=OneWay}"
                                             FontWeight="Bold"
                                             Foreground="#3F51B5"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Width="28"
                                             MaxLength="3"
                                             Tag="{Binding}"
                                             FlowDirection="LeftToRight"
                                             PreviewTextInput="PriorityTextBox_PreviewTextInput"
                                             KeyDown="PriorityTextBox_KeyDown"
                                             LostFocus="PriorityTextBox_LostFocus"
                                             ToolTip="שנה סדר עדיפות (גרור מספר)"/>
                                </Border>

                                <!-- Task Type -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TaskType.Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <!-- Status badge -->
                                <Border Grid.Column="3" Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding AssignmentStatus.Name}"
                                               Style="{StaticResource StatusText}"/>
                                </Border>
                            </Grid>

                            <!-- Row 2: Assigned Employee + Due Date -->
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding AssignedTo.Name}"
                                           Opacity="0.7"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1"
                                           Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding DueDate, StringFormat=dd/MM/yyyy}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Row 2: Body/Description (shown when selected, scrollable for long text) -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding Body}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       MaxHeight="60"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Body}"
                                       Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Row 3: Notes Preview -->
                            <TextBlock Grid.Row="3"
                                       Text="{Binding RecentNotesSummary}"
                                       Opacity="0.7"
                                       Padding="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RecentNotesSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="MaxHeight" Value="18"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowFullNotes, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="MaxHeight" Value="120"/>
                                            </DataTrigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Row 4: Status change ComboBox (visible only when card is selected) -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox ItemsSource="{Binding DataContext.AllowedStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding StatusId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Width="130"
                                          Tag="{Binding}"
                                          SelectionChanged="StatusComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Selected Task Detail: Events + Undo + Note (shown when task selected) -->
        <Border x:Name="DetailPanel" Grid.Row="4"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="8,6"
                MaxHeight="280"
                Visibility="{Binding HasSelectedTask, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MaxHeight="130"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected task indicator -->
                <TextBlock Grid.Row="0"
                           FontWeight="SemiBold"
                           Foreground="#1565C0"
                           Margin="0,0,0,4">
                    <Run Text="🔹"/>
                    <Run Text="{Binding SelectedTask.TaskType.Name, Mode=OneWay}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding SelectedTask.AssignmentStatus.Name, Mode=OneWay}"/>
                </TextBlock>

                <!-- Compact events list -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding SelectedTaskEvents}"
                              MaxHeight="120"
                              Margin="0,0,0,4">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="2,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LocalCreatedDate, StringFormat=dd/MM HH:mm}"
                                               Foreground="#999"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EventType}"
                                               Foreground="#666"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Note}"
                                               Foreground="#444"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Note}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Undo button -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,4"
                            Visibility="{Binding CanUndoLastEvent, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="↩ בטל אחרון"
                            Command="{Binding UndoLastEventCommand}"
                            Style="{StaticResource CardActionButton}"
                            Foreground="#C62828"
                            ToolTip="מחיקת האירוע האחרון בלבד (LIFO)"/>
                </StackPanel>

                <!-- Pending Emails to Tag (visible only when pending emails exist) -->
                <ItemsControl Grid.Row="3"
                              ItemsSource="{Binding PendingEmails}"
                              Margin="0,2,0,4">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF3E0" CornerRadius="3" Padding="6,3" Margin="0,1"
                                    BorderBrush="#FFB74D" BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="{Binding Subject}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.NavigateToEmailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding EmailId}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📧" FontSize="11"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#E65100"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#FFF8E1" CornerRadius="3"
                                            Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                   Foreground="#F57F17" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Task Links (compact, visible only when links exist) -->
                <ItemsControl Grid.Row="4"
                              ItemsSource="{Binding SelectedTaskLinks}"
                              Margin="0,2,0,4">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E8F5E9" CornerRadius="3" Padding="4,2" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔗" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}"
                                               FontWeight="SemiBold" Foreground="#2E7D32" FontSize="11"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Summary}">
                                        <Run Text="{Binding EntityTypeDisplay, Mode=OneWay}"/>
                                        <Run Text=": " Foreground="#666"/>
                                        <Run Text="{Binding LinkedEntityName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Grid.Column="3" Content="✕" FontSize="9"
                                            Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding LinkId}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#999" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            ToolTip="הסר קישור"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Note area -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="50"
                             MaxHeight="100"
                             Padding="4"
                             BorderBrush="#DDD"
                             BorderThickness="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="הוסף"
                            Command="{Binding AddNoteCommand}"
                            Style="{StaticResource CardActionButton}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0"
                            Padding="8,4"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border x:Name="StatusBarPanel" Grid.Row="5" Background="#FAFAFA" Padding="8,4"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             Width="60" Height="4"
                             Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</local:FloatingWindowBase>







































