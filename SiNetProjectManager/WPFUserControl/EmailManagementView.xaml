<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SiNetProjectManager.WPFUserControl.EmailManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SiNetProjectManager.WPFUserControl"
             xmlns:conv="clr-namespace:SiNetProjectManager.Converters"
             xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:controls="clr-namespace:SiNetProjectManager.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <UserControl.DataContext>
        <vm:EmailManagementViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:StartsWithAssignedConverter x:Key="StartsWithAssigned" />
    <local:InverseBooleanConverter x:Key="InverseBoolConverter" />
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    <conv:ColorConverter x:Key="StringToBrushConverter" />
        
        <Style x:Key="EmailListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="📁 שייך לפרויקט"
                                  Command="{Binding PlacementTarget.Tag.FileEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding IsAssigned, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <MenuItem Header="↩️ בטל שיוך"
                                  Command="{Binding PlacementTarget.Tag.UnfileEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVis}}"/>
                        <Separator/>
                        <MenuItem Header="⏳ סמן כממתין לטיפול"
                                  Command="{Binding PlacementTarget.Tag.MarkAsPendingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="👤 סמן כאישי"
                                  Command="{Binding PlacementTarget.Tag.MarkAsPersonalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="🚫 סמן כלא רלוונטי"
                                  Command="{Binding PlacementTarget.Tag.MarkAsIrrelevantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selection highlight - uses distinct blue to show active selection -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2,0,0,1"/>
                </Trigger>
                <!-- Mouse over - use Opacity instead of Background to preserve context colors -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <Border Padding="8,4" CornerRadius="4" Margin="0,4,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name, Converter={StaticResource StartsWithAssigned}}" Value="True">
                                                    <Setter Property="Background" Value="#C8E6C9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📥"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name, Converter={StaticResource StartsWithAssigned}}" Value="True">
                                                            <Setter Property="Text" Value="📂"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name, Converter={StaticResource StartsWithAssigned}}" Value="True">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" (" Foreground="Gray"/>
                                        <TextBlock Text="{Binding ItemCount}" Foreground="Gray"/>
                                        <TextBlock Text=")" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter Margin="15,0,0,0"/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Filter Toggle Buttons in the Legend -->
        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AttachmentTemplate">
            <Border CornerRadius="3" 
                    Padding="4,2" 
                    Margin="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="AttachmentBorder_MouseLeftButtonUp"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExternalDownload}" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInAcc}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="BorderBrush" Value="#81C784"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 פתח קובץ מקומי" 
                                  Command="{Binding PlacementTarget.Tag.OpenLocalFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding HasLocalFile, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="🔍 הצג ב-ACC" 
                                  InputGestureText="Ctrl+Shift+A"
                                  Command="{Binding PlacementTarget.Tag.ShowAttachmentInAccCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IconName}" 
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <!-- ACC badge -->
                    <TextBlock Text="☁✓" 
                               Foreground="#2E7D32"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"
                               ToolTip="הקובץ הועלה ל-ACC — לחץ לפתיחה"
                               Visibility="{Binding IsInAcc, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding FileName}" 
                               FontSize="11"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip="{Binding FileName}"/>
                    <TextBlock Text="{Binding DisplaySize}" 
                               FontSize="9"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <!-- Tag badge -->
                    <TextBlock Text="{Binding TagBadge}"
                               Foreground="#1565C0"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"
                               ToolTip="{Binding TaggedProjectFileTitle}"/>
                    <!-- Inline tag selector (compact) -->
                    <ComboBox Margin="3,0,0,0"
                              MinWidth="100"
                              MaxWidth="160"
                              Height="20"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowTagSelector, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding DataContext.TagTargets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValue="{Binding TaggedProjectFileId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="TagDisplayLabel"
                              ToolTip="בחר סוג קובץ / יעד תיוג"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="TagDisplayLabel">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTagged}" Value="True">
                                        <Setter Property="BorderBrush" Value="#66BB6A"/>
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <!-- Inline alternative selector (compact) -->
                    <ComboBox Margin="3,0,0,0"
                              MinWidth="80"
                              MaxWidth="140"
                              Height="20"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowAlternativeSelector, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding AvailableAlternatives}"
                              SelectedValue="{Binding SelectedAlternativeId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              ToolTip="בחר אלטרנטיבה"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="BorderBrush" Value="#CE93D8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAlternativeId}" Value="{x:Null}">
                                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Global rounded-corner button style for a polished look -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Rounded ToggleButton style (for Calendar, etc.) -->
        <Style TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: Status Bar + Project Filters (Combined) -->
        <Border Grid.Row="0" 
                Background="#F5F5F5" 
                Padding="10,5" 
                Margin="0,0,0,8"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Text with Error Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Not Connected"/>
                                <Setter Property="Foreground" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                        <Setter Property="Text" Value="✓"/>
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Connected Email Display -->
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"
                               Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding ConnectedEmail, Mode=OneWay}" FontWeight="Bold" Foreground="#333"/>
                    </TextBlock>
                    <TextBlock Text=" | " Foreground="Gray" VerticalAlignment="Center"
                               Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               VerticalAlignment="Center"
                               Foreground="#555"/>
                    <!-- Error Count (Red) -->
                    <TextBlock VerticalAlignment="Center"
                               Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                        <Run Text=" | " Foreground="Gray"/>
                        <Run Text="Errors: " Foreground="Red" FontWeight="Bold"/>
                        <Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="Red" FontWeight="Bold"/>
                    </TextBlock>
                    <!-- Context enrichment indicator -->
                    <TextBlock Text=" | 🔄 Enriching..." 
                               Foreground="#1976D2"
                               Visibility="{Binding IsEnrichingContext, Converter={StaticResource BoolToVis}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Pagination Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <Button Content="⏮ First" 
                            Command="{Binding LoadFirstPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            Margin="0,0,5,0"
                            Padding="8,3"/>
                    <Button Content="◀ Prev" 
                            Command="{Binding LoadPreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            Margin="0,0,5,0"
                            Padding="8,3"/>
                    <TextBlock Text="{Binding PageInfo}" 
                               VerticalAlignment="Center" 
                               Margin="5,0"
                               FontWeight="SemiBold"/>
                    <Button Content="Next ▶" 
                            Command="{Binding LoadNextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            Margin="5,0,0,0"
                            Padding="8,3"/>
                </StackPanel>
                
                <!-- Refresh Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Content="🔄 Refresh"
                            Padding="10,3"/>

                    <!-- Calendar Toggle -->
                    <ToggleButton IsChecked="{Binding IsCalendarVisible}"
                                  Margin="8,0,0,0"
                                  Padding="10,3"
                                  Cursor="Hand"
                                  ToolTip="הצג/הסתר לוח שנה">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Setter Property="Content" Value="📅 לוח שנה"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="📅 לוח שנה"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Grid>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <controls:SearchableProjectSelector
                    ItemsSource="{Binding ProjectsView}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ExternalFilter="{Binding ProjectFilterPredicate}"
                    FilterProperties="NameAndNumber,Title,Place.Title,Company.Title"
                    SortPropertyPath="Number"
                    SortAscending="False"
                    Width="350" 
                    Margin="0,0,10,0" 
                    ToolTip="בחר פרויקט - הקלד לחיפוש לפי שם, עיר או לקוח"/>

                <ComboBox Width="120" 
                          Margin="0,0,10,0"
                          ItemsSource="{Binding JobTypes}"
                          SelectedItem="{Binding SelectedJobTypeFilter}"
                          DisplayMemberPath="Title"
                          ToolTip="Job Type"/>

                <ComboBox Width="120" 
                          Margin="0,0,10,0"
                          ItemsSource="{Binding ProjectStatuses}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="Title"
                          ToolTip="Status"/>

                <ComboBox Width="120"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUserFilter}"
                          DisplayMemberPath="Name"
                          ToolTip="User"/>
            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ROW 1: Selected Project Info -->
        <Border Grid.Row="1"
                Padding="10" 
                BorderBrush="#2196F3" 
                BorderThickness="1" 
                CornerRadius="4" 
                Background="#E3F2FD" 
                Margin="0,0,0,10"
                Visibility="{Binding SelectedProject, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Selected Project: " FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedProject.NameAndNumber}" FontWeight="Bold" Foreground="#1976D2"/>
                <TextBlock Text=" | " Foreground="Gray" Margin="10,0"/>
                <TextBlock Text="{Binding SelectedProject.Place.Title}" Foreground="Gray"/>
                <TextBlock Text=" | " Foreground="Gray" Margin="10,0"/>
                <TextBlock Text="{Binding SelectedProject.Company.Title}" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- ROW 2: Main Content Area (RTL: Column 0 = visual Right, last column = visual Left) -->
        <Grid Grid.Row="2" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CALENDAR SIDEBAR (visually Far-Left in RTL — last column) -->
            <wv2:WebView2 x:Name="CalendarWebView"
                           Grid.Column="4"
                           Width="385"
                           MinWidth="220"
                           MaxWidth="480"
                           FlowDirection="LeftToRight"
                           Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- SPLITTER: Email List | Email Viewer -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- EMAIL LIST (visually Right in RTL — first column) -->
            <Border Grid.Column="0"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" 
                            Background="#F5F5F5" 
                            Padding="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Emails to File" 
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <!-- All / Unread Toggle -->
                                        <ToggleButton IsChecked="{Binding ShowUnreadOnly}"
                                                      Margin="10,0,0,0"
                                                      Padding="8,2"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource FilterToggleStyle}"
                                                      Background="#E3F2FD"
                                                      BorderBrush="#64B5F6"
                                                      ToolTip="הצג רק מיילים שלא נקראו">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📩 לא נקראו " Foreground="#1565C0" FontSize="11"/>
                                                <TextBlock Text="{Binding UnreadCount, Mode=OneWay}" 
                                                           Foreground="#1565C0" 
                                                           FontWeight="Bold" 
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Opacity="0.7">
                                        <Run Text="{Binding EmailCount, Mode=OneWay}"/>
                                        <Run Text=" emails"/>
                                    </TextBlock>
                                    <!-- Loading/Enriching indicator next to count -->
                                    <TextBlock Text=" • Loading..." 
                                               Foreground="#2196F3" 
                                               FontStyle="Italic"
                                               Visibility="{Binding IsLoadingOrEnriching, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding LoginCommand}"
                                            Content="Login"
                                            Padding="10,5"
                                            Margin="0,0,5,0"
                                            Visibility="{Binding IsNotAuthenticated, Converter={StaticResource BoolToVis}}"/>
                                
                                    <Button Command="{Binding RefreshCommand}"
                                            Content="Refresh"
                                            ToolTip="Refresh"
                                            Padding="8,5"
                                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"/>
                                    
                                    <Button Command="{Binding LogoutCommand}"
                                            Margin="5,0,0,0"
                                            Padding="8,5"
                                            Background="#D32F2F"
                                            Foreground="White"
                                            BorderBrush="#D32F2F"
                                            ToolTip="Logout &amp; Switch User"
                                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="🚪 Logout" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            
                            
                            
                            <!-- Color Legend with Filter Toggles (Hebrew RTL) -->
                            <!-- Priority order: Yellow > Green > Gray > Pending (Toggle) > Ignored (Toggle) > White -->
                            <StackPanel Orientation="Horizontal" 
                                        FlowDirection="RightToLeft" 
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right">
                                <!-- Static Legends (not filterable) -->
                                <Border Background="#FFD54F" 
                                        CornerRadius="3" 
                                        Padding="6,2" 
                                        Margin="0,0,8,0"
                                        BorderBrush="#FFC107"
                                        BorderThickness="1">
                                    <TextBlock Text="⚠️ אי-התאמה" Foreground="#E65100"/>
                                </Border>
                                <Border Background="#C8E6C9" 
                                        CornerRadius="3" 
                                        Padding="6,2" 
                                        Margin="0,0,8,0"
                                        BorderBrush="#81C784"
                                        BorderThickness="1">
                                    <TextBlock Text="שייך לפרויקט הנבחר" Foreground="#2E7D32"/>
                                </Border>
                                <Border Background="#E0E0E0" 
                                        CornerRadius="3" 
                                        Padding="6,2" 
                                        Margin="0,0,8,0"
                                        BorderBrush="#9E9E9E"
                                        BorderThickness="1">
                                    <TextBlock Text="שייך לפרויקט אחר" Foreground="#424242"/>
                                </Border>
                                
                                <!-- TOGGLE: Pending (Default ON) - Purple Theme -->
                                <ToggleButton IsChecked="{Binding ShowPending}" 
                                              Style="{StaticResource FilterToggleStyle}"
                                              Background="#F3E5F5" 
                                              BorderBrush="#AB47BC" 
                                              Margin="0,0,8,0"
                                              ToolTip="לחץ להצגה/הסתרה של מיילים ממתינים לטיפול">
                                    <TextBlock Text="⏳ טיפול בהמשך" Foreground="#7B1FA2"/>
                                </ToggleButton>
                                
                                <!-- TOGGLE: Personal/Irrelevant (Default OFF) -->
                                <ToggleButton IsChecked="{Binding ShowIgnored}" 
                                              Style="{StaticResource FilterToggleStyle}"
                                              Background="#E3F2FD" 
                                              BorderBrush="#64B5F6"
                                              Margin="0,0,8,0"
                                              ToolTip="לחץ להצגה/הסתרה של מיילים אישיים ולא רלוונטיים">
                                    <TextBlock Text="🚫 אישי / לא רלוונטי" Foreground="#1565C0"/>
                                </ToggleButton>
                                
                                <Border Background="#FFFFFF" 
                                        CornerRadius="3" 
                                        Padding="6,2" 
                                        Margin="0,0,0,0"
                                        BorderBrush="#BDBDBD"
                                        BorderThickness="1">
                                    <TextBlock Text="חדש" Foreground="#616161"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Loading Overlay - shown during initial load -->
                    <Border Grid.Row="1" 
                            Background="#80FFFFFF"
                            Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="100">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" 
                                         Width="200" 
                                         Height="4"
                                         Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding StatusMessage}" 
                                       HorizontalAlignment="Center"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </Border>

                    <!-- Email List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding EmailsView}"
                             SelectedItem="{Binding SelectedEmail, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource EmailListItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}"/>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status indicator -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Grid.RowSpan="2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding TimeDisplay}"
                                               Opacity="0.7"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding SenderName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="📎"
                                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="{Binding RealAttachmentCount, StringFormat='{}{0} attachment(s)'}"
                                                   Margin="4,0,0,0"/>
                                        <TextBlock Text="{Binding RealAttachmentCount}"
                                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                               Text="{Binding Subject}"
                                               Foreground="#666"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"/>

                                    <!-- Thread Link Row (Row 2) - Shows for unassigned emails with thread context -->
                                    <!-- CRITICAL: Email stays in Date group until user clicks the button -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding ShowThreadProjectLink, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ThreadProjectLinkText}"
                                                   FontStyle="Italic"
                                                   Foreground="#616161"/>
                                        <Button Content="[שייך לפרויקט זה]"
                                                Foreground="#FF5722"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="8,0,0,0"
                                                Padding="4,2"
                                                ToolTip="לחץ לשייך מייל זה לפרויקט השרשור"
                                                Command="{Binding DataContext.FileToThreadProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock Text="{TemplateBinding Content}"
                                                                           Foreground="#FF5722"
                                                                           TextDecorations="Underline"
                                                                           Cursor="Hand"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#E64A19"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading Overlay -->
                    <Border Grid.Row="1" 
                            Background="#80FFFFFF" 
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Loading..." HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Not Authenticated Message -->
                    <Border Grid.Row="1" 
                            Background="#FAFAFA" 
                            Visibility="{Binding IsNotAuthenticated, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="Email" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Connect to Google" 
                                       FontWeight="Bold"
                                       Margin="0,10,0,5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="to see emails for filing" 
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"/>
                            <Button Command="{Binding LoginCommand}"
                                    Content="Login Now"
                                    Padding="15,8"
                                    Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SPLITTER: Email Viewer | Calendar -->
            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE"
                          Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- CENTER COLUMN: Email Viewer -->
            <Border Grid.Column="2" 
                    FlowDirection="LeftToRight"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <!-- No Email Selected -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <TextBlock Text="Mail" FontSize="64" HorizontalAlignment="Center" Foreground="#CCC"/>
                        <TextBlock Text="Select an email from the list" 
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Email Content -->
                    <Grid Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Email Header (compact) -->
                        <Border Grid.Row="0" 
                                Background="#F5F5F5" 
                                Padding="10,6">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedEmail.Subject}" 
                                           FontWeight="Bold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedEmail.Subject}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="From: " Opacity="0.7" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedEmail.From}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="  |  Date: " Opacity="0.7" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedEmail.ShortDateDisplay}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Attachments Bar (compact, scrollable) -->
                        <Border Grid.Row="1" 
                                Background="#FFF8E1" 
                                BorderBrush="#FFE082"
                                BorderThickness="0,1"
                                Padding="6,3"
                                MaxHeight="110"
                                Visibility="{Binding SelectedEmail.HasAttachments, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="📎" FontSize="11"/>
                                    <TextBlock Text=" Attachments" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text=" (" Opacity="0.7" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedEmail.RealAttachmentCount}" Opacity="0.7" FontSize="11"/>
                                    <TextBlock Text=")" Opacity="0.7" FontSize="11"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" 
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedEmail.AllDisplayableAttachments}"
                                                  ItemTemplate="{StaticResource AttachmentTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Row 2: Email Body -->
                        <wv2:WebView2 x:Name="EmailWebView"
                                       Grid.Row="2"
                                       local:WebView2Helper.NavigateUrl="{Binding SelectedEmail.GmailPopoutUrl}"
                                       local:WebView2Helper.FallbackHtml="{Binding SelectedEmail.HtmlBodyForDisplay}"
                                       local:WebView2Helper.SelectedEmailInfo="{Binding SelectedEmail}"
                                       Visibility="{Binding HasSelectedEmail, Converter={StaticResource BoolToVis}}"/>

                        <!-- Row 3: Action Bar -->
                        <Border Grid.Row="3"
                                Padding="8,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEmail.IsAssigned}" Value="True">
                                            <Setter Property="Background" Value="#C8E6C9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Show for unassigned emails -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSelectedEmailUnassigned, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="File to project:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedProject.NameAndNumber}" 
                                               Foreground="#2E7D32"
                                               FontWeight="Bold"
                                               Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Select a project above" 
                                               Foreground="Gray"
                                               FontStyle="Italic"
                                               Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                </StackPanel>

                                <!-- Show for assigned emails -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedEmail.IsAssigned, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ " Foreground="#2E7D32" FontWeight="Bold"/>
                                        <TextBlock Text="Already assigned to: " FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedEmail.AssignedProjectName}" 
                                               Foreground="#2E7D32"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <!-- File Email button (for unassigned) -->
                                <Button Grid.Column="1"
                                        Command="{Binding FileEmailCommand}"
                                        Padding="12,5"
                                        FontWeight="Bold"
                                        Content="File Email"
                                        Visibility="{Binding IsSelectedEmailUnassigned, Converter={StaticResource BoolToVis}}"/>

                                <!-- Assigned email buttons: Move to Project + Unfile -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Visibility="{Binding IsSelectedEmailAssigned, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding MoveToProjectCommand}"
                                            Padding="12,5"
                                            FontWeight="Bold"
                                            Content="📂 Move to Project"
                                            Background="#C8E6C9"
                                            BorderBrush="#66BB6A"
                                            ToolTip="העבר קבצים מתויגים לתיקיית הפרויקט ב-ACC"
                                            Margin="0,0,8,0"/>
                                    <Button Command="{Binding UnfileEmailCommand}"
                                            Padding="12,5"
                                            FontWeight="Bold"
                                            Content="Unfile Email"
                                            Background="#FFCDD2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 4: Email Context Panel (Workflow + Suggested Actions) -->
                        <local:EmailContextPanel x:Name="EmailContextPanel"
                                                  Grid.Row="4"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
