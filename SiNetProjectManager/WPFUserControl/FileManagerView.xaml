<UserControl x:Class="SiNetProjectManager.WPFUserControl.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiNetProjectManager.WPFUserControl"
             xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"

             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="{DynamicResource AppFontSize}"
             Background="{DynamicResource AppBackground}"
             Foreground="{DynamicResource AppForeground}">

    <UserControl.DataContext>
        <vm:FileManagerViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <CollectionViewSource x:Key="FileExtensionsSource" Source="{Binding FileExtensions}" />

        <!-- TreeView Style from ProjectFolderTreeView -->
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
             <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
             <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
             <Setter Property="Padding" Value="3,1"/>
        </Style>

        <!-- Folder Template -->
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderWrapper}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2" 
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add Sub-Folder" 
                                  Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>

                        <MenuItem Header="Assign Selected File Here" 
                                  Command="{Binding PlacementTarget.Tag.AssignFileToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>

                <TextBlock Text="??" Margin="0,0,5,0" Foreground="#FFDAA520"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar (Job Type) -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Top Bar (Job Type Filter) -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="5" BorderBrush="Gray" BorderThickness="0,0,0,1" Background="#F9F9F9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by Job Type:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding JobTypes}" 
                          SelectedItem="{Binding SelectedJobType}" 
                          DisplayMemberPath="Title"
                          Width="200" Margin="0,0,5,0"/>

                <Button Content="Add Job Type" Command="{Binding AddJobTypeCommand}" 
                        Padding="10,2" Margin="0,0,5,0" FontWeight="Bold"/>

                <Button Content="Edit" Command="{Binding RenameJobTypeCommand}" 
                        ToolTip="Rename Selected Job Type" Padding="8,2" Margin="0,0,10,0"/>

                <Button Content="Save Changes" Command="{Binding SaveChangesCommand}" 
                        Padding="10,2" Background="#4CAF50" Foreground="White" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content Grid (RTL: Col 0 is Right, Col 2 is Left) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/> <!-- Col 0 (Right in RTL): Tree -->
                <ColumnDefinition Width="5"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Col 2 (Left in RTL): DataGrid -->
            </Grid.ColumnDefinitions>
            
            <!-- Folder Tree (Right in RTL) -->
             <Grid Grid.Column="0">
                 <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>
                 <TextBlock Text="Project Folders" FontWeight="Bold" Margin="0,0,0,5"/>
                 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                     <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderTree}" BorderBrush="#DDD" BorderThickness="1"/>
                 </ScrollViewer>
             </Grid>

             <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

             <!-- DataGrid (Left in RTL) -->
             <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Files" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="Add New File" Command="{Binding AddFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=FolderTree}" Margin="10,0,0,0" Padding="8,2"/>
                    <Button Content="Delete Selected" Command="{Binding DeleteFileCommand}" Margin="5,0,0,0" Padding="8,2" Background="#FFEBEE" Foreground="#D32F2F"/>
                </StackPanel>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding FilesView}" 
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          ColumnWidth="*"
                          HorizontalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto"
                          BorderBrush="#DDD" BorderThickness="1" Background="White">
                    <DataGrid.Columns>
                        <!-- Title (2*) -->
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" MinWidth="150">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="MaxLength" Value="24"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Number (0.5*) -->
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="0.5*" MinWidth="50"/>

                        <!-- Extension (0.8*) -->
                        <DataGridComboBoxColumn Header="Ext" 
                                                SelectedItemBinding="{Binding Typefile}" 
                                                ItemsSource="{Binding Source={StaticResource FileExtensionsSource}}" 
                                                Width="0.8*" MinWidth="80"/>

                        <!-- Flags (0.5* each) -->
                        <DataGridCheckBoxColumn Header="Look" Binding="{Binding LookAtDes}" Width="0.5*" MinWidth="50"/>
                        <DataGridCheckBoxColumn Header="Out" Binding="{Binding OutSidData}" Width="0.5*" MinWidth="50"/>

                        <!-- Storage Destination -->
                        <DataGridComboBoxColumn Header="Storage"
                                                SelectedItemBinding="{Binding StorageDestination}"
                                                ItemsSource="{x:Static vm:ProjectFileViewModel.StorageDestinationOptions}"
                                                Width="0.8*" MinWidth="90"/>

                        <!-- Template Location (2*) -->
                        <DataGridTemplateColumn Header="Template Location" Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TemplateLocation, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Button Content="..." Grid.Column="1" Width="25"
                                                Command="{Binding DataContext.BrowseTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Description (3*) -->
                        <DataGridTextColumn Header="Description" Binding="{Binding Des}" Width="3*" MinWidth="250"/>
                    </DataGrid.Columns>
                </DataGrid>
             </Grid>

        </Grid>
        
        <!-- Dialog Overlay -->
        <Grid Background="#7F000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}" Grid.RowSpan="2">
            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" CornerRadius="5" Width="350">
                <StackPanel>
                    <TextBlock Text="{Binding DialogHeader}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="Name:" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding DialogInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Confirm" Command="{Binding ConfirmDialogCommand}" Width="80" Margin="0,0,10,0" Padding="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button Content="Cancel" Command="{Binding CancelDialogCommand}" Width="80" Padding="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
