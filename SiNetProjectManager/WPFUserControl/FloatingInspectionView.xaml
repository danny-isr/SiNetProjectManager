<local:FloatingWindowBase x:Class="SiNetProjectManager.WPFUserControl.FloatingInspectionView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mvvm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
        xmlns:local="clr-namespace:SiNetProjectManager.WPFUserControl"
        mc:Ignorable="d"
        Title="דוחות ביקורת"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        ShowInTaskbar="False"
        Width="420" Height="850"
        MinWidth="360" MinHeight="380"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Validation Error Template: red border with tooltip -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <Border BorderBrush="#E53935" BorderThickness="1.5" CornerRadius="2"
                    ToolTip="{Binding [0].ErrorContent}">
                <AdornedElementPlaceholder/>
            </Border>
        </ControlTemplate>

        <!-- Card border style for report items -->
        <Style TargetType="Border" x:Key="ReportCardBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ListBox item container: transparent, no chrome -->
        <Style TargetType="ListBoxItem" x:Key="CardListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action button -->
        <Style TargetType="Button" x:Key="CardActionButton">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ContentBorder" Background="{DynamicResource AppBackground}" CornerRadius="8" Margin="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════ Header: Project Name + Pin + Collapse + Close ═══════ -->
            <Border Grid.Row="0" Background="#2E7D32" Padding="10,8"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveProjectDisplay}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Width="28" Height="28"
                                  Margin="6,0,0,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="ToolTip" Value="הצמד למעלה"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="PinBorder"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="4">
                                                <TextBlock x:Name="PinIcon"
                                                           Text="📌"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="PinIcon" Property="Opacity" Value="1.0"/>
                                                    <Setter TargetName="PinBorder" Property="Background" Value="#388E3C"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PinBorder" Property="Background" Value="#388E3C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Dock/Undock toggle: docked = stays with app, undocked = floats above all -->
                    <ToggleButton Grid.Column="2"
                                  IsChecked="{Binding IsDocked, Mode=TwoWay}"
                                  Width="28" Height="28"
                                  Margin="4,0,0,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="ToolTip" Value="עגן לאפליקציה"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="DockBorder"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="4">
                                                <TextBlock x:Name="DockIcon"
                                                           Text="🏠"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="DockIcon" Property="Opacity" Value="1.0"/>
                                                    <Setter TargetName="DockBorder" Property="Background" Value="#388E3C"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DockBorder" Property="Background" Value="#388E3C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDocked}" Value="True">
                                        <Setter Property="ToolTip" Value="עגון לאפליקציה (פעיל — מוסתר מאחורי אפליקציות אחרות)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Button Grid.Column="3"
                            Content="🔄"
                            Command="{Binding RefreshCommand}"
                            ToolTip="רענן"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"/>

                    <Button Grid.Column="4"
                            Content="⊡"
                            Click="ResetSizeButton_Click"
                            ToolTip="אפס גודל חלון"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="14"/>

                    <Button Grid.Column="5"
                            Command="{Binding ToggleCollapseCommand}"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="🔽"/>
                                <Setter Property="ToolTip" Value="כווץ"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Content" Value="🔼"/>
                                        <Setter Property="ToolTip" Value="הרחב"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="6"
                            Content="✕"
                            Click="CloseButton_Click"
                            ToolTip="סגור"
                            Width="28" Height="28"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- ═══════ Create New Report Strip ═══════ -->
            <Border x:Name="CreateBar" Grid.Row="1" Background="{DynamicResource AppBackground}" Padding="8,6"
                    BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                    IsEnabled="{Binding HasActiveProject}"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Template Picker (Google Sheets from admin folder) -->
                    <ComboBox Grid.Row="0" Grid.Column="0"
                              ItemsSource="{Binding AvailableTemplates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name"
                              Padding="4,3"
                              Margin="0,0,4,4"
                              ToolTip="בחר תבנית ביקורת מתוך תיקיית Google Drive"/>
                    <Button Grid.Row="0" Grid.Column="1"
                            Content="🔄"
                            Command="{Binding LoadTemplatesCommand}"
                            ToolTip="רענן רשימת תבניות"
                            Width="28" Height="28"
                            Style="{StaticResource CardActionButton}"/>

                    <!-- Row 1: Series Picker -->
                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding ExistingSeries}"
                              SelectedItem="{Binding SelectedSeries}"
                              DisplayMemberPath="DisplayName"
                              Padding="4,3"
                              Margin="0,0,0,4"
                              ToolTip="בחר סדרת ביקורת קיימת או צור חדשה"/>

                    <!-- Row 2: Fallback manual URL (visible when no template selected) -->
                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Text="{Binding NewTemplateUrl, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3"
                             Margin="0,0,0,4"
                             ToolTip="או הדבק קישור ישיר ל-Google Sheet">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedTemplate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Right" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="או הדבק קישור ישיר..."
                                                                   Foreground="#999" FontStyle="Italic" Margin="6,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Right" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="או הדבק קישור ישיר..."
                                                                   Foreground="#999" FontStyle="Italic" Margin="6,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Row 3: Inspector Name + Create Button -->

                    <!-- Admin view: searchable inspector dropdown -->
                    <ComboBox Grid.Row="3" Grid.Column="0"
                              ItemsSource="{Binding InspectorFilterItems}"
                              SelectedItem="{Binding SelectedInspectorFilter}"
                              DisplayMemberPath="DisplayName"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="DisplayName"
                              Padding="4,3"
                              ToolTip="סנן לפי בודק (מנהל)">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- Regular user view: static inspector name -->
                    <TextBox Grid.Row="3" Grid.Column="0"
                             Text="{Binding InspectorName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3"
                             ToolTip="שם הבודק">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Row="3" Grid.Column="1"
                            Content="+ דוח חדש"
                            Command="{Binding CreateReportCommand}"
                            Style="{StaticResource CardActionButton}"
                            FontWeight="SemiBold"
                            Padding="10,3"
                            Margin="4,0,0,0"
                            ToolTip="סנכרן תבנית, צור דוח ביקורת חדש עם תצלום סעיפים פעילים"/>
                </Grid>
            </Border>

            <!-- ═══════ Inspection Questionnaire TreeView (TOP — main working area) ═══════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AppBackground}"
                    Padding="2"
                    Visibility="{Binding HasSelectedReport, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Foreground="#2E7D32" Margin="4,0,0,2">
                        <Run Text="📋 שאלון ביקורת — דוח #"/>
                        <Run Text="{Binding SelectedReport.ReportNumber, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Grid.Row="0" Content="❓"
                            Click="HelpButton_Click"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="4,0,0,2"
                            Padding="3,0"
                            FontSize="{DynamicResource AppFontSizeSecondary}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="עזרה — מבנה תגיות בתבנית"/>

                    <!-- Global Fields: Report metadata (non-hierarchical) -->
                    <Border Grid.Row="1" Background="{DynamicResource AppBackground}" CornerRadius="4"
                            BorderBrush="#D0D0D0" BorderThickness="1"
                            Padding="6,3" Margin="2,0,2,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Text="בודק:"
                                       FontSize="{DynamicResource AppFontSizeSecondary}" Foreground="#555"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedReport.InspectorName, Mode=OneWay}"
                                       FontSize="{DynamicResource AppFontSizeSecondary}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="תאריך:"
                                       FontSize="{DynamicResource AppFontSizeSecondary}" Foreground="#555"
                                       VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SelectedReport.InspectionDate, StringFormat=dd/MM/yyyy, Mode=OneWay}"
                                       FontSize="{DynamicResource AppFontSizeSecondary}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding InspectionTree}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="19"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <!-- Expand/Collapse toggle (standard WPF arrow) -->
                                                <ToggleButton x:Name="Expander"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              Focusable="False"
                                                              OverridesDefaultStyle="True">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Width="16" Height="16" Padding="4">
                                                                <Path x:Name="ExpandArrow"
                                                                      Data="M0,0 L0,6 L6,0z"
                                                                      Fill="Transparent"
                                                                      Stroke="#FF989898">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="135" CenterX="3" CenterY="3"/>
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpandArrow" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter TargetName="ExpandArrow" Property="Fill" Value="#FF595959"/>
                                                                    <Setter TargetName="ExpandArrow" Property="Stroke" Value="#FF262626"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ExpandArrow" Property="Stroke" Value="#FF1BBBFA"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>

                                                <!-- Header content — Width="*" forces constrained width so TextWrapping works -->
                                                <Border x:Name="Bd" Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Border>

                                                <!-- Child items (indented under header column) -->
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1" Grid.Column="1"
                                                                Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <!-- Level 1: Chapter — number only, tooltip for title -->
                            <HierarchicalDataTemplate DataType="{x:Type mvvm:ChapterTreeItem}"
                                                      ItemsSource="{Binding Sections}">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           FontSize="{DynamicResource AppFontSizeSecondary}"
                                           Margin="0"
                                           ToolTip="{Binding DisplayTitle}"/>
                            </HierarchicalDataTemplate>

                            <!-- Level 2: Section — code only + sync state + "+" button -->
                            <HierarchicalDataTemplate DataType="{x:Type mvvm:SectionTreeItem}"
                                                      ItemsSource="{Binding Notes}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sync state indicator -->
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource AppFontSizeSmall}" Margin="0,0,3,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SyncState}" Value="MissingFromTemplate">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="⛔"/>
                                                        <Setter Property="ToolTip" Value="סעיף חסר מהתבנית"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SyncState}" Value="TitleMismatch">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="⚠"/>
                                                        <Setter Property="ToolTip" Value="כותרת שונה מהתבנית"/>
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SyncState}" Value="NewFromTemplate">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="🆕"/>
                                                        <Setter Property="ToolTip" Value="סעיף חדש מהתבנית"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                                   Text="{Binding SectionHeaderText}"
                                                   Foreground="#333" FontSize="{DynamicResource AppFontSizeSecondary}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding SectionDisplayText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SyncState}" Value="MissingFromTemplate">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SyncState}" Value="TitleMismatch">
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Content="+"
                                            Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CardActionButton}"
                                            Padding="2,0" FontSize="{DynamicResource AppFontSizeSecondary}" FontWeight="Bold"
                                            Width="18" Height="18"
                                            ToolTip="הוסף הערה חדשה"/>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <!-- Level 3: Note row — [↑↓] [Index] [Status] [Text] (RTL: buttons on far right) -->
                            <DataTemplate DataType="{x:Type mvvm:NoteTreeItem}">
                                <Border Padding="1,0" Margin="0"
                                        Background="{DynamicResource AppBackground}" CornerRadius="2"
                                        BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical"
                                                    VerticalAlignment="Center" Margin="0,0,1,0">
                                            <Button Content="▲" FontSize="{DynamicResource AppFontSizeSmall}"
                                                    Width="14" Height="10" Padding="0"
                                                    Command="{Binding DataContext.MoveNoteUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CardActionButton}"
                                                    ToolTip="הזז למעלה"/>
                                            <Button Content="▼" FontSize="{DynamicResource AppFontSizeSmall}"
                                                    Width="14" Height="10" Padding="0"
                                                    Command="{Binding DataContext.MoveNoteDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CardActionButton}"
                                                    ToolTip="הזז למטה"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayLabel}"
                                                   Foreground="#333" FontSize="{DynamicResource AppFontSizeSecondary}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,2,0"/>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="DbKey"
                                                  SelectedValue="{Binding NoteStatus, Mode=TwoWay, ValidatesOnDataErrors=True}"
                                                  Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                                  FontSize="{DynamicResource AppFontSizeSmall}"
                                                  Padding="1,0"
                                                  Margin="0,0,2,0"
                                                  VerticalAlignment="Center"
                                                  Height="20"
                                                  SelectionChanged="TreeNoteStatusComboBox_SelectionChanged"/>

                                        <local:RichTextNoteEditor Grid.Column="3"
                                                 EncodedText="{Binding NoteText, ValidatesOnDataErrors=True}"
                                                 NoteStatus="{Binding NoteStatus}"
                                                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 EditCompleted="NoteEditor_EditCompleted"
                                                 AiReviewRequested="NoteEditor_AiReviewRequested"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- General Data Chapter (Chapter 0) — top-level branch for non-numbered fields -->
                            <HierarchicalDataTemplate DataType="{x:Type mvvm:GeneralDataChapterItem}"
                                                      ItemsSource="{Binding Fields}">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           FontWeight="Bold"
                                           Foreground="#1565C0"
                                           FontSize="{DynamicResource AppFontSizeSecondary}"
                                           Margin="0"
                                           ToolTip="שדות כלליים מהתבנית"/>
                            </HierarchicalDataTemplate>

                            <!-- General Field — label + editable text box + auto/manual toggle -->
                            <DataTemplate DataType="{x:Type mvvm:GeneralFieldTreeItem}">
                                <Border Padding="1,1" Margin="0"
                                        Background="{DynamicResource AppBackground}" CornerRadius="2"
                                        BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   FontSize="{DynamicResource AppFontSizeSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource AppFontSizeSecondary}"
                                                 Padding="3,2"
                                                 VerticalAlignment="Center"
                                                 LostFocus="GeneralField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                                            <Setter Property="IsReadOnly" Value="True"/>
                                                            <Setter Property="Background" Value="#F0F0F0"/>
                                                            <Setter Property="Foreground" Value="#888"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Auto/Manual toggle — only visible for automatic fields -->
                                        <ToggleButton Grid.Column="2"
                                                      IsChecked="{Binding IsManualOverride}"
                                                      Visibility="{Binding IsAutomatic, Converter={StaticResource BoolToVisibility}}"
                                                      FontSize="10"
                                                      Padding="4,1"
                                                      Margin="4,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ToolTip="לחץ כדי לעבור בין מילוי אוטומטי לידני"
                                                      Click="AutoManualToggle_Click">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="אוטומטי"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="ידני"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ═══════ Drawing Files Section ═══════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="#C0C0C0"
                    BorderThickness="0,1,0,0"
                    Padding="6,4"
                    MaxHeight="180"
                    Visibility="{Binding HasSelectedReport, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Add button -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="#555"
                                   FontSize="{DynamicResource AppFontSizeSecondary}">
                            📐 שרטוטים
                        </TextBlock>

                        <ComboBox x:Name="DrawingFileComboBox" Grid.Column="1"
                                  ItemsSource="{Binding AvailableDrawingFiles}"
                                  DisplayMemberPath="FileName"
                                  Width="160"
                                  FontSize="{DynamicResource AppFontSizeSecondary}"
                                  Margin="0,0,4,0"
                                  ToolTip="בחר קובץ שרטוט להוספה"/>

                        <Button Grid.Column="2"
                                Content="➕"
                                Command="{Binding AddDrawingCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=DrawingFileComboBox}"
                                Style="{StaticResource CardActionButton}"
                                Padding="4,1"
                                FontSize="{DynamicResource AppFontSizeSecondary}"
                                ToolTip="הוסף שרטוט לדוח"/>
                    </Grid>

                    <!-- Attached drawings list -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding ReportDrawings}"
                                  Visibility="{Binding HasDrawings, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="3,2" Margin="0,0,0,2"
                                        CornerRadius="3" BorderThickness="1" BorderBrush="#D0D0D0"
                                        Background="{DynamicResource AppBackground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FileTypeDisplay}"
                                                   FontWeight="SemiBold" Foreground="#1565C0"
                                                   FontSize="{DynamicResource AppFontSizeSmall}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                   FontSize="{DynamicResource AppFontSizeSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding StampStatusDisplay}"
                                                   FontSize="{DynamicResource AppFontSizeSmall}"
                                                   VerticalAlignment="Center" Margin="4,0"/>

                                        <Button Grid.Column="3" Content="✖"
                                                Command="{Binding DataContext.RemoveDrawingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CardActionButton}"
                                                Padding="2,0"
                                                FontSize="{DynamicResource AppFontSizeSmall}"
                                                ToolTip="הסר שרטוט"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Stamp all button -->
                    <Button Grid.Row="2"
                            Content="📐 חתום על שרטוטים"
                            Command="{Binding StampDrawingsCommand}"
                            Style="{StaticResource CardActionButton}"
                            HorizontalAlignment="Right"
                            Padding="8,3" Margin="0,4,0,0"
                            FontSize="{DynamicResource AppFontSizeSecondary}"
                            Visibility="{Binding HasDrawings, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="הוסף חותמת לכל השרטוטים שטרם נחתמו"/>
                </Grid>
            </Border>

            <!-- ═══════ Compact Report Cards List (BOTTOM) ═══════ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="#C0C0C0"
                    BorderThickness="0,1,0,0"
                    Padding="6,4"
                    MaxHeight="160"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Foreground="#555" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,2">
                        📋 דוחות ביקורת
                    </TextBlock>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="2,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,3" Margin="0,0,0,2"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="#D0D0D0"
                                        Background="{DynamicResource AppBackground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="2"
                                                Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Foreground="#2E7D32" FontSize="{DynamicResource AppFontSizeSecondary}">
                                                <Run Text="#"/><Run Text="{Binding ReportNumber, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding InspectorName}"
                                                   FontSize="{DynamicResource AppFontSizeSecondary}" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding InspectionDate, StringFormat=dd/MM}"
                                                   FontSize="{DynamicResource AppFontSizeSmall}" Foreground="#888"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="🔗"
                                                    Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource CardActionButton}"
                                                    Padding="2,0" FontSize="{DynamicResource AppFontSizeSecondary}"
                                                    ToolTip="פתח תבנית"/>
                                            <Button Content="📤"
                                                    Command="{Binding DataContext.ExportReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource CardActionButton}"
                                                    Padding="2,0" FontSize="{DynamicResource AppFontSizeSecondary}"
                                                    Margin="2,0,0,0"
                                                    ToolTip="ייצוא דוח"/>
                                            <Button Content="🗑️"
                                                    Command="{Binding DataContext.DeleteReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource CardActionButton}"
                                                    Padding="2,0" FontSize="{DynamicResource AppFontSizeSecondary}"
                                                    Margin="2,0,0,0"
                                                    ToolTip="מחק דוח"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════ Status Bar ═══════ -->
            <Border Grid.Row="5" Background="{DynamicResource AppBackground}" Padding="8,4"
                    CornerRadius="0,0,8,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#555"
                           FontSize="{DynamicResource AppFontSizeSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</local:FloatingWindowBase>
