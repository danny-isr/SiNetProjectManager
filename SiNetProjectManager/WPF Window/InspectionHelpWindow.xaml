<Window x:Class="SiNetProjectManager.InspectionHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📘 מרכז עזרה — תבניות ביקורת"
        Width="560" Height="720"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Body text style -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <!-- Code block style -->
        <Style x:Key="CodeBlock" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <!-- Code text -->
        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <!-- Good example border -->
        <Style x:Key="GoodExample" TargetType="Border">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <!-- Bad example border -->
        <Style x:Key="BadExample" TargetType="Border">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <!-- Table header style -->
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Table cell style -->
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Expander style -->
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ Header ═══════ -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📘" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="מרכז עזרה — תבניות ביקורת"
                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="מדריך מקיף לבניית תבניות Google Sheets"
                                   FontSize="{DynamicResource AppFontSizeSecondary}" Foreground="#C8E6C9"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click"
                        Width="28" Height="28" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" FontWeight="Bold" FontSize="14"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ═══════ Scrollable Content ═══════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,8">
            <StackPanel>

                <!-- ════════ 1. מבוא ════════ -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="1. מבוא — איך המערכת עובדת" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}">
                            מערכת הביקורת מבוססת על תגיות (&lt;&lt;...&gt;&gt;) שמוטמעות בתוך תבנית Google Sheets.
                            בעת יצירת דוח חדש, המערכת סורקת את כל התאים, מאמתת את המבנה,
                            ומסנכרנת את הפרקים והסעיפים למסד הנתונים.
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,6,0,4">
                            תהליך העבודה:
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0">
                            1️⃣ בניית תבנית ב-Google Sheets עם תגיות&#x0a;
                            2️⃣ בחירת התבנית במערכת ויצירת דוח חדש&#x0a;
                            3️⃣ המערכת סורקת, מאמתת ומסנכרנת&#x0a;
                            4️⃣ מילוי הערות וסטטוסים בממשק&#x0a;
                            5️⃣ ייצוא — המערכת מעתיקה את התבנית ומזריקה נתונים
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 2. תגיות שדות כלליים ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="2. תגיות שדות כלליים (General Tags)" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}">
                            שדות כלליים הם תגיות ללא מספר סעיף — הם מוחלפים בנתוני פרויקט, דוח או משתמש.
                        </TextBlock>

                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,8,0,4">
                            שדות אוטומטיים (ממולאים מה-DB):
                        </TextBlock>

                        <!-- Auto-fields table -->
                        <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#2E7D32" Padding="1"><TextBlock Style="{StaticResource TableHeader}" Text="תגית"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#2E7D32" Padding="1"><TextBlock Style="{StaticResource TableHeader}" Text="מקור נתונים"/></Border>

                                <!-- Data rows -->
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;שם פרויקט&gt;&gt;"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="שם הפרויקט"/></Border>

                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;מספר פרויקט&gt;&gt;"/></Border>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מספר הפרויקט"/></Border>

                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;ישוב&gt;&gt; / &lt;&lt;רשות מקומית&gt;&gt;"/></Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="שם הישוב / רשות"/></Border>

                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;תאריך&gt;&gt; / &lt;&lt;Today&gt;&gt;"/></Border>
                                <Border Grid.Row="4" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="תאריך הביקורת"/></Border>

                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;ממלא דוח&gt;&gt; / &lt;&lt;User&gt;&gt;"/></Border>
                                <Border Grid.Row="5" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="שם הבודק"/></Border>

                                <Border Grid.Row="6" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;כתובת מייל&gt;&gt; / &lt;&lt;Email&gt;&gt;"/></Border>
                                <Border Grid.Row="6" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מייל הבודק"/></Border>

                                <Border Grid.Row="7" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="&lt;&lt;מספר דוח&gt;&gt;"/></Border>
                                <Border Grid.Row="7" Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מספר סידורי"/></Border>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,4">
                            שדות ידניים (נשמרים מהמשתמש):
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0">
                            • &lt;&lt;כתובת&gt;&gt; — כתובת האתר&#x0a;
                            • &lt;&lt;יזם התכנית&gt;&gt;&#x0a;
                            • &lt;&lt;מתכנן התכנית&gt;&gt;&#x0a;
                            • &lt;&lt;מספר מגרש&gt;&gt;&#x0a;
                            • &lt;&lt;תאריך קבלת התוכנית&gt;&gt;&#x0a;
                            • &lt;&lt;מספר תכנית&gt;&gt;&#x0a;
                            • &lt;&lt;גוש (חלקה)&gt;&gt;&#x0a;
                            • &lt;&lt;סוג נספח התנועה&gt;&gt;
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 3. תגיות סעיפים ממוספרים ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="3. תגיות סעיפים ממוספרים (Section Tags)" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                            תגית הגדרה (Status Tag):
                        </TextBlock>
                        <Border Style="{StaticResource CodeBlock}">
                            <TextBlock Style="{StaticResource CodeText}" Text="&lt;&lt;X.Y כותרת פרק [תוכן הסעיף]&gt;&gt;"/>
                        </Border>
                        <TextBlock Style="{StaticResource BodyText}">
                            • X.Y — קוד הסעיף (פרק.סעיף)&#x0a;
                            • כותרת פרק — שם הפרק (חייב להיות זהה לכל הסעיפים באותו פרק)&#x0a;
                            • [תוכן הסעיף] — שם הסעיף בתוך סוגריים מרובעים&#x0a;
                            &#x0a;
                            בייצוא: תא זה יוחלף בסטטוס מצטבר (מקובל / הערה / הערה חוזרת / לא רלוונטי)
                        </TextBlock>

                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,8,0,4">
                            תגית קלט הערות (Note Input Tag):
                        </TextBlock>
                        <Border Style="{StaticResource CodeBlock}">
                            <TextBlock Style="{StaticResource CodeText}" Text="&lt;&lt;X.Y $&gt;&gt;   או   &lt;&lt;$ X.Y&gt;&gt;"/>
                        </Border>
                        <TextBlock Style="{StaticResource BodyText}">
                            סימן ה-$ מציין את התא שבו יוזרקו הערות הבודק.&#x0a;
                            תומך בשני הסדרים (RTL ו-LTR).
                        </TextBlock>

                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="#D32F2F" Margin="0,10,0,4">
                            ⚠ כלל הצמדים — חובה!
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            כל סעיף חייב להכיל בדיוק שתי תגיות:&#x0a;
                            1. תג הגדרה: &lt;&lt;X.Y כותרת [תוכן]&gt;&gt;&#x0a;
                            2. תג קלט: &lt;&lt;X.Y $&gt;&gt;&#x0a;
                            &#x0a;
                            אם חסרה אחת מהן — המערכת תציג שגיאת תיקוף ותחסום יצירת דוח.
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 4. שדות אוטומטיים ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="4. שדות אוטומטיים — הטוגל 'אוטומטי / ידני'" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}">
                            שדות אוטומטיים ממולאים אוטומטית מנתוני הפרויקט והדוח.&#x0a;
                            לצדם מופיע כפתור "אוטומטי / ידני":
                        </TextBlock>

                        <TextBlock Style="{StaticResource BodyText}" Margin="12,6,0,0">
                            🟢 מצב אוטומטי (ברירת מחדל):&#x0a;
                               השדה מוצג לקריאה בלבד, הערך נשלף מה-DB.&#x0a;&#x0a;
                            🔵 מצב ידני:&#x0a;
                               לחיצה על "ידני" פותחת את השדה לעריכה.&#x0a;
                               הערך שתקלידו יישמר וישמש בייצוא.&#x0a;&#x0a;
                            🔄 חזרה לאוטומטי:&#x0a;
                               לחיצה חוזרת על "אוטומטי" מחזירה את הערך מה-DB.
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 5. כללי תיקוף ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="5. כללי תיקוף (בודק תקינות)" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}">
                            המערכת מפעילה בודק תקינות אוטומטי לפני כל סנכרון או ייצוא:
                        </TextBlock>

                        <!-- Rule 1 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 1: עקביות כותרת פרק
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: CHAPTER_TITLE_MISMATCH&#x0a;
                            כל הסעיפים באותו פרק חייבים לשתף את אותה כותרת.
                        </TextBlock>

                        <!-- Rule 2 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 2: תג הגדרה יחיד
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: DUPLICATE_DEFINITION&#x0a;
                            לכל קוד סעיף מותר תג הגדרה אחד בלבד (עם סוגריים מרובעים).
                        </TextBlock>

                        <!-- Rule 3 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 3: חובת צמד
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: MISSING_NOTE_INPUT / MISSING_HEADER&#x0a;
                            כל סעיף חייב לכלול גם תג הגדרה וגם תג קלט $.
                        </TextBlock>

                        <!-- Rule 4 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 4: מגבלת כפילויות
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: EXCESS_DUPLICATE&#x0a;
                            כל קוד סעיף יכול להופיע מקסימום 2 פעמים (הגדרה + קלט).
                        </TextBlock>

                        <!-- Rule 5 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 5: סעיף אב חסר
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: ORPHAN_SECTION&#x0a;
                            סעיף X.Y.Z (תת-סעיף) חייב שיהיה לו סעיף אב X.Y בתבנית.
                        </TextBlock>

                        <!-- Rule 6 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 6: תגית ריקה
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: EMPTY_TAG&#x0a;
                            תגית ללא תוכן (&lt;&lt;  &gt;&gt;) היא שגיאה.
                        </TextBlock>

                        <!-- Rule 7 -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,8,0,2">
                            כלל 7: תגית כללית כפולה
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="#555" Margin="12,0,0,0">
                            קוד: DUPLICATE_GENERAL_TAG&#x0a;
                            כל תגית כללית (&lt;&lt;שם פרויקט&gt;&gt;) חייבת להיות ייחודית בתבנית.
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 6. דוגמאות תקין מול שגוי ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="6. דוגמאות: תקין ✅ מול שגוי ❌" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">

                        <!-- Example A: Correct pair -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,0,0,4">
                            דוגמה א': צמד סעיף תקין
                        </TextBlock>
                        <Border Style="{StaticResource GoodExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#2E7D32" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">✅ תקין</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="תא A5:  &lt;&lt;1.1 כללי [תרשים סביבה, חץ צפון]&gt;&gt;&#x0a;תא B5:  &lt;&lt;1.1 $&gt;&gt;"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#2E7D32" Margin="0,4,0,0">
                                    → המערכת תזהה סעיף 1.1, תציג סטטוס בתא A5 והערות בתא B5.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Example B: Missing input -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,4,0,4">
                            דוגמה ב': חסר תג קלט
                        </TextBlock>
                        <Border Style="{StaticResource BadExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#D32F2F" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">❌ שגוי</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="תא A5:  &lt;&lt;1.1 כללי [תרשים סביבה]&gt;&gt;&#x0a;(ללא &lt;&lt;1.1 $&gt;&gt;)"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" Margin="0,4,0,0">
                                    → שגיאה: "מזהה '1.1' חסר תג קלט (&lt;&lt;1.1 $&gt;&gt;) — נדרש זוג הגדרה + קלט."
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Example C: Duplicate definition -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,4,0,4">
                            דוגמה ג': כפילות הגדרה
                        </TextBlock>
                        <Border Style="{StaticResource BadExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#D32F2F" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">❌ שגוי</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="תא A5:  &lt;&lt;1.1 כללי [תרשים סביבה]&gt;&gt;&#x0a;תא A8:  &lt;&lt;1.1 כללי [חץ צפון]&gt;&gt;&#x0a;תא B5:  &lt;&lt;1.1 $&gt;&gt;"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" Margin="0,4,0,0">
                                    → שגיאה: "מזהה '1.1' מכיל 2 תגי הגדרה — מותר אחד בלבד."
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Example D: Chapter title mismatch -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,4,0,4">
                            דוגמה ד': כותרות פרק לא עקביות
                        </TextBlock>
                        <Border Style="{StaticResource BadExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#D32F2F" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">❌ שגוי</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="&lt;&lt;1.1 תנועה [שילוט]&gt;&gt;&#x0a;&lt;&lt;1.2 כללי [מידות]&gt;&gt;"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" Margin="0,4,0,0">
                                    → שגיאה: "תגים בפרק 1 מכילים כותרות שונות: 'תנועה', 'כללי'."
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Example E: Correct general tag -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,4,0,4">
                            דוגמה ה': שדות כלליים תקינים
                        </TextBlock>
                        <Border Style="{StaticResource GoodExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#2E7D32" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">✅ תקין</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="תא C2:  &lt;&lt;שם פרויקט&gt;&gt;&#x0a;תא C3:  &lt;&lt;מספר פרויקט&gt;&gt;&#x0a;תא C4:  &lt;&lt;Today&gt;&gt;"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#2E7D32" Margin="0,4,0,0">
                                    → יוחלפו אוטומטית בנתוני הפרויקט.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Example F: Duplicate general tag -->
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Margin="0,4,0,4">
                            דוגמה ו': תגית כללית כפולה
                        </TextBlock>
                        <Border Style="{StaticResource BadExample}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Foreground="#D32F2F" FontSize="{DynamicResource AppFontSizeSecondary}" Margin="0,0,0,4">❌ שגוי</TextBlock>
                                <TextBlock Style="{StaticResource CodeText}" Text="תא A5:  &lt;&lt;שם פרויקט&gt;&gt;&#x0a;תא C8:  &lt;&lt;שם פרויקט&gt;&gt;"/>
                                <TextBlock Style="{StaticResource BodyText}" Foreground="#D32F2F" Margin="0,4,0,0">
                                    → שגיאה: "נמצאה תגית כפולה '&lt;&lt;שם פרויקט&gt;&gt;' בתא C8. ההופעה הראשונה בתא A5."
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- ════════ 7. סטטוסים ואגרגציה ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="7. סטטוסים ואגרגציה" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,8">
                        <TextBlock Style="{StaticResource BodyText}">
                            בעת ייצוא, המערכת מחשבת סטטוס מצטבר לכל סעיף מתוך כל ההערות שלו.
                            הסטטוס ה"חזק" ביותר מנצח:
                        </TextBlock>

                        <!-- Status table -->
                        <Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Margin="0,8,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    <ColumnDefinition Width="Auto" MinWidth="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#2E7D32" Padding="1"><TextBlock Style="{StaticResource TableHeader}" Text="סטטוס"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#2E7D32" Padding="1"><TextBlock Style="{StaticResource TableHeader}" Text="צבע"/></Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#2E7D32" Padding="1"><TextBlock Style="{StaticResource TableHeader}" Text="עדיפות"/></Border>

                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="הערה (Failed)" FontWeight="Bold"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#FFCDD2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="🔴 אדום" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="1 (חזק)" HorizontalAlignment="Center"/></Border>

                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="הערה חוזרת (RecurringFailed)"/></Border>
                                <Border Grid.Row="2" Grid.Column="1" Background="#BBDEFB" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="🔵 כחול" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Row="2" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="2" HorizontalAlignment="Center"/></Border>

                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="מקובל (Passed)"/></Border>
                                <Border Grid.Row="3" Grid.Column="1" Background="#C8E6C9" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="🟢 ירוק" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Row="3" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="3" HorizontalAlignment="Center"/></Border>

                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="לא רלוונטי (NotApplicable)"/></Border>
                                <Border Grid.Row="4" Grid.Column="1" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="⚪ אפור" HorizontalAlignment="Center"/></Border>
                                <Border Grid.Row="4" Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource TableCell}" Text="4 (חלש)" HorizontalAlignment="Center"/></Border>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,4">
                            דוגמה לאגרגציה:
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0">
                            סעיף 1.1 מכיל 3 הערות:&#x0a;
                            • הערה 1.1.1: מקובל ✅&#x0a;
                            • הערה 1.1.2: מקובל ✅&#x0a;
                            • הערה 1.1.3: הערה ❌&#x0a;
                            &#x0a;
                            → הסטטוס המצטבר: הערה (אדום) — כי "הערה" חזקה יותר מ"מקובל".
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <!-- ════════ 8. טיפים ════════ -->
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="8. טיפים ושיטות עבודה מומלצות" Style="{StaticResource SectionHeader}"/>
                    </Expander.Header>
                    <StackPanel Margin="8,4,0,12">
                        <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0">
                            💡 תמיד צרו צמד — תג הגדרה [...] + תג קלט $ לכל סעיף.&#x0a;&#x0a;
                            💡 שמרו על עקביות כותרות — כל הסעיפים בפרק חייבים לשתף את אותה כותרת.&#x0a;&#x0a;
                            💡 השתמשו בשדות אוטומטיים — חוסכים הקלדה ומונעים טעויות.&#x0a;&#x0a;
                            💡 בדקו לפני יצירת דוח — המערכת מפעילה בודק תקינות אוטומטי.&#x0a;&#x0a;
                            💡 רעננו אחרי שינויים בתבנית — שינוי בגוגל שיטס דורש רענון בממשק.&#x0a;&#x0a;
                            💡 אל תמחקו תגיות באמצע העבודה — זה ישנה את המיפוי ויחסום ייצוא.
                        </TextBlock>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
