<Window x:Class="SiNetProjectManager.WPF_Window.TemplateValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SiNetProjectManager.WPF_Window"
        Title="🔍 בדיקת תבניות ביקורת"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E8EAF6" Padding="12" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="🔍 בדיקת תקינות תבניות ביקורת"
                           FontSize="16" FontWeight="Bold" Foreground="#283593"/>
                <TextBlock Text="הכלי סורק את כל התבניות בתיקיית Google Drive ומדווח על שגיאות מבנה."
                           Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="8" CornerRadius="4" Margin="0,0,0,8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="מוכן" Foreground="#555" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ScanProgress" 
                                 Width="200" Height="6" 
                                 Margin="12,0,0,0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Help Button -->
                    <ToggleButton x:Name="HelpToggle"
                                  Margin="0,0,8,0"
                                  Padding="10,3"
                                  Cursor="Hand"
                                  ToolTip="מדריך בניית תבנית"
                                  Content="❓ עזרה"
                                  Background="#E8EAF6"
                                  BorderBrush="#7986CB"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=HelpToggle}"
                           PlacementTarget="{Binding ElementName=HelpToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="White"
                                BorderBrush="#7986CB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                MaxWidth="540"
                                MaxHeight="620">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel FlowDirection="RightToLeft">

                                    <!-- Title -->
                                    <TextBlock Text="📘 מדריך בניית תבנית ביקורת"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#283593"
                                               Margin="0,0,0,10"/>

                                    <!-- Intro -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                        <Run Text="התבנית נבנית ב-Google Sheets ומבוססת על " Foreground="#444"/>
                                        <Run Text="תגיות" FontWeight="Bold"/>
                                        <Run Text=" בפורמט " Foreground="#444"/>
                                        <Run Text="&lt;&lt;...&gt;&gt;" FontWeight="Bold" FontFamily="Consolas"/>
                                        <Run Text=". המערכת סורקת את התגיות, מאמתת אותן, מסנכרנת למסד הנתונים, ובייצוא — מחליפה אותן בנתונים אמיתיים." Foreground="#444"/>
                                    </TextBlock>

                                    <Separator Margin="0,2,0,8"/>

                                    <!-- Section: 3 Tag Types -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="סוגי תגיות" FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                    </TextBlock>

                                    <!-- Tag 1: Status -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="1. תגית הגדרה (סטטוס)" FontWeight="Bold" Foreground="#1565C0"/>
                                        <LineBreak/>
                                        <Run Text="תבנית: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;X.Y כותרת [תוכן]&gt;&gt;" FontFamily="Consolas" FontWeight="Bold"/>
                                        <LineBreak/>
                                        <Run Text="דוגמה: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;1.1 כללי [תרשים סביבה]&gt;&gt;" FontFamily="Consolas" Foreground="#2E7D32"/>
                                        <LineBreak/>
                                        <Run Text="מגדירה סעיף ביקורת. בייצוא — מוחלפת בסטטוס (מקובל/הערה/הערה חוזרת/לא רלוונטי)." Foreground="#666"/>
                                    </TextBlock>

                                    <!-- Tag 2: Note Input -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="2. תגית קלט הערות" FontWeight="Bold" Foreground="#1565C0"/>
                                        <LineBreak/>
                                        <Run Text="תבנית: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;X.Y $&gt;&gt;" FontFamily="Consolas" FontWeight="Bold"/>
                                        <Run Text=" או " Foreground="#444"/>
                                        <Run Text="&lt;&lt;$ X.Y&gt;&gt;" FontFamily="Consolas" FontWeight="Bold"/>
                                        <LineBreak/>
                                        <Run Text="דוגמה: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;1.1 $&gt;&gt;" FontFamily="Consolas" Foreground="#2E7D32"/>
                                        <LineBreak/>
                                        <Run Text="סימן ה-$ מציין את התא שבו יוזרקו הערות הבודק." Foreground="#666"/>
                                    </TextBlock>

                                    <!-- Tag 3: General -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="3. תגית שדה כללי" FontWeight="Bold" Foreground="#1565C0"/>
                                        <LineBreak/>
                                        <Run Text="תבנית: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;שם&gt;&gt;" FontFamily="Consolas" FontWeight="Bold"/>
                                        <Run Text=" (ללא מספר סעיף)" Foreground="#444"/>
                                        <LineBreak/>
                                        <Run Text="דוגמה: " Foreground="#444"/>
                                        <Run Text="&lt;&lt;שם פרויקט&gt;&gt;  &lt;&lt;Today&gt;&gt;  &lt;&lt;מספר דוח&gt;&gt;" FontFamily="Consolas" Foreground="#2E7D32"/>
                                        <LineBreak/>
                                        <Run Text="שדות מטא-דאטה — מוחלפים בנתוני הפרויקט/הדוח/המשתמש." Foreground="#666"/>
                                    </TextBlock>

                                    <Separator Margin="0,4,0,8"/>

                                    <!-- Pairing Rule -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="⚠ כלל הצמדים" FontWeight="Bold" FontSize="13" Foreground="#E65100"/>
                                        <LineBreak/>
                                        <Run Text="כל סעיף חייב להכיל " Foreground="#444"/>
                                        <Run Text="בדיוק שתי תגיות:" FontWeight="Bold" Foreground="#D32F2F"/>
                                        <LineBreak/>
                                        <Run Text="  ① " Foreground="#1565C0"/>
                                        <Run Text="&lt;&lt;X.Y כותרת [תוכן]&gt;&gt;" FontFamily="Consolas"/>
                                        <Run Text=" — הגדרה + סטטוס" Foreground="#666"/>
                                        <LineBreak/>
                                        <Run Text="  ② " Foreground="#1565C0"/>
                                        <Run Text="&lt;&lt;X.Y $&gt;&gt;" FontFamily="Consolas"/>
                                        <Run Text=" — קלט הערות" Foreground="#666"/>
                                        <LineBreak/>
                                        <Run Text="אם חסרה אחת מהן — המערכת תציג שגיאת תיקוף." Foreground="#D32F2F" FontStyle="Italic"/>
                                    </TextBlock>

                                    <!-- Chapter Title Rule -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="📌 עקביות כותרת פרק" FontWeight="Bold" Foreground="#1565C0"/>
                                        <LineBreak/>
                                        <Run Text="כל הסעיפים באותו פרק (X.1, X.2, X.3...) חייבים לשתף את " Foreground="#444"/>
                                        <Run Text="אותה כותרת." FontWeight="Bold" Foreground="#444"/>
                                        <LineBreak/>
                                        <Run Text="✅ " Foreground="#2E7D32"/>
                                        <Run Text="&lt;&lt;1.1 כללי [תרשים]&gt;&gt;  &lt;&lt;1.2 כללי [מידות]&gt;&gt;" FontFamily="Consolas" Foreground="#2E7D32"/>
                                        <LineBreak/>
                                        <Run Text="❌ " Foreground="#D32F2F"/>
                                        <Run Text="&lt;&lt;1.1 כללי [תרשים]&gt;&gt;  &lt;&lt;1.2 חנייה [מידות]&gt;&gt;" FontFamily="Consolas" Foreground="#D32F2F"/>
                                    </TextBlock>

                                    <Separator Margin="0,4,0,8"/>

                                    <!-- General Tags Table -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="📋 שדות כלליים נתמכים" FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="אוטומטיים (מ-DB):" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <LineBreak/>
                                        <Run Text="שם פרויקט · מספר פרויקט · ישוב · רשות מקומית · תאריך · ממלא דוח · כתובת מייל · מספר דוח · Today · User · Email" FontFamily="Consolas" Foreground="#444" FontSize="11"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="ידניים (מילוי ע&quot;י הבודק):" FontWeight="Bold" Foreground="#E65100"/>
                                        <LineBreak/>
                                        <Run Text="כתובת · יזם התכנית · מתכנן התכנית · מספר מגרש · תאריך קבלת התוכנית · מספר תכנית · גוש (חלקה) · סוג נספח התנועה" FontFamily="Consolas" Foreground="#444" FontSize="11"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="💡 " Foreground="#FF8F00"/>
                                        <Run Text="שדות אוטומטיים מציגים כפתור אוטומטי/ידני — לחיצה על 'ידני' מאפשרת לדרוס את הערך." Foreground="#666" FontStyle="Italic"/>
                                    </TextBlock>

                                    <Separator Margin="0,4,0,8"/>

                                    <!-- Validation Rules -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="🔍 כללי תיקוף" FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="CHAPTER_TITLE_MISMATCH" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — כותרות פרק לא עקביות (סעיפים באותו פרק עם כותרות שונות)." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="DUPLICATE_DEFINITION" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — תג הגדרה כפול (מותר רק אחד לכל קוד סעיף)." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="MISSING_NOTE_INPUT" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — חסר תג קלט הערות ($) לסעיף שיש לו הגדרה." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="MISSING_HEADER" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — חסר תג הגדרה לסעיף שיש לו רק קלט ($)." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="EXCESS_DUPLICATE" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — קוד סעיף מופיע יותר מ-2 פעמים." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="EMPTY_TAG" FontWeight="Bold" FontFamily="Consolas" Foreground="#D32F2F" FontSize="11"/>
                                        <Run Text=" — תגית ריקה (&lt;&lt;&gt;&gt; או &lt;&lt;  &gt;&gt;)." Foreground="#444"/>
                                    </TextBlock>

                                    <Separator Margin="0,6,0,8"/>

                                    <!-- Status Aggregation -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="📊 סטטוסים ואגרגציה" FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                        <LineBreak/>
                                        <Run Text="בייצוא, כל סעיף מקבל סטטוס מצטבר — הסטטוס החזק ביותר מנצח:" Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="  🔴 " Foreground="#D32F2F"/>
                                        <Run Text="הערה (Failed)" FontWeight="Bold" Foreground="#D32F2F"/>
                                        <Run Text=" — עדיפות 1 (חזק ביותר)" Foreground="#666"/>
                                        <LineBreak/>
                                        <Run Text="  🔵 " Foreground="#1565C0"/>
                                        <Run Text="הערה חוזרת (RecurringFailed)" FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" — עדיפות 2" Foreground="#666"/>
                                        <LineBreak/>
                                        <Run Text="  🟢 " Foreground="#2E7D32"/>
                                        <Run Text="מקובל (Passed)" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <Run Text=" — עדיפות 3" Foreground="#666"/>
                                        <LineBreak/>
                                        <Run Text="  ⚪ " Foreground="#9E9E9E"/>
                                        <Run Text="לא רלוונטי (NotApplicable)" FontWeight="Bold" Foreground="#9E9E9E"/>
                                        <Run Text=" — עדיפות 4 (חלש ביותר)" Foreground="#666"/>
                                    </TextBlock>

                                    <Separator Margin="0,4,0,8"/>

                                    <!-- Tips -->
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="💡 טיפים" FontWeight="Bold" FontSize="13" Foreground="#1565C0"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="1." FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" תמיד צרו צמד — תג הגדרה [תוכן] + תג קלט $ לכל סעיף." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="2." FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" שמרו על עקביות כותרות — כל הסעיפים בפרק חייבים לשתף אותה כותרת." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="3." FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" השתמשו בשדות אוטומטיים — חוסכים הקלדה ומונעים טעויות." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="4." FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" בדקו לפני יצירת דוח — הכלי הזה מפעיל בודק תקינות אוטומטי." Foreground="#444"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,0">
                                        <Run Text="5." FontWeight="Bold" Foreground="#1565C0"/>
                                        <Run Text=" רעננו אחרי שינויים בתבנית — שינוי בגוגל שיטס דורש רענון בממשק." Foreground="#444"/>
                                    </TextBlock>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <Button x:Name="ScanButton" Content="▶ הפעל סריקה" 
                            Click="ScanButton_Click"
                            Padding="16,6"
                            Background="#1976D2" Foreground="White" 
                            FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}"
                                        Cursor="Hand">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Area -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" 
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="לחץ 'הפעל סריקה' כדי לבדוק את התבניות"
                               Foreground="#999" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Results TreeView -->
                <TreeView x:Name="ResultsTree" 
                          Visibility="Collapsed"
                          BorderThickness="0"
                          Padding="4">
                    <TreeView.Resources>
                        <!-- Template level -->
                        <HierarchicalDataTemplate DataType="{x:Type local:TemplateReportItem}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TemplateName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text=" — " Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TagCountDisplay}" 
                                           Foreground="Gray" Margin="8,0,0,0" 
                                           VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Error/Warning detail level -->
                        <DataTemplate DataType="{x:Type local:TemplateReportDetail}">
                            <Border Padding="4,2" Margin="0,1" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RuleCode}" FontWeight="SemiBold" Foreground="#555"
                                               Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" 
                                               MaxWidth="600" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <!-- Summary Footer -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="8" CornerRadius="4" Margin="0,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock x:Name="SummaryText" Text="" Foreground="#555"/>
        </Border>
    </Grid>
</Window>
