<local:BaseWindow x:Class="SiNetProjectManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 

        xmlns:local="clr-namespace:SiNetProjectManager.WPF"
        xmlns:conv="clr-namespace:SiNetProjectManager.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="הגדרות"
        Height="750" Width="560"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        AutoScrollEnabled="False">

    <local:BaseWindow.Resources>
        <conv:ColorConverter x:Key="ColorConverter"/>
        <conv:HexToColorConverter x:Key="HexToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </local:BaseWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- === Appearance Section === -->
            <TextBlock Text="מראה" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="סוג פונט:" />
            <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding Settings.FontFamily, Mode=TwoWay}" />

            <TextBlock Text="גודל פונט:" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Minimum="10" Maximum="30"
                        Value="{Binding Settings.FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Width="200" />
                <TextBlock Text="{Binding Settings.FontSize}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="צבע טקסט:" Margin="0,10,0,0"/>
            <xctk:ColorPicker 
                SelectedColor="{Binding Settings.ForegroundColor, Mode=TwoWay}" 
                Margin="0,0,0,10" />

            <TextBlock Text="צבע רקע:" Margin="0,10,0,0"/>
            <xctk:ColorPicker 
                SelectedColor="{Binding Settings.BackgroundColor, Mode=TwoWay}" 
                Margin="0,0,0,10" />

            <!-- Multiple Instances toggle -->
            <CheckBox Content="אפשר לפתוח מספר מופעים (Multiple Instances)"
                      Margin="0,10,0,0"
                      IsChecked="{Binding Settings.AllowMultipleInstances, Mode=TwoWay}"/>

            <!-- === Floating Window Opacity === -->
            <Separator Margin="0,20,0,10"/>
            <TextBlock Text="שקיפות חלון צף" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="שליטה ברמת השקיפות של חלון המשימות הצף."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="שקיפות פעילה (בעת ריחוף עכבר):" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Minimum="0.1" Maximum="1.0"
                        Value="{Binding Settings.FloatingWindowActiveOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Width="200" />
                <TextBlock Text="{Binding Settings.FloatingWindowActiveOpacity, StringFormat={}{0:P0}}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="שקיפות רקע (בעת אי-שימוש):" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Minimum="0.1" Maximum="1.0"
                        Value="{Binding Settings.FloatingWindowIdleOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Width="200" />
                <TextBlock Text="{Binding Settings.FloatingWindowIdleOpacity, StringFormat={}{0:P0}}"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- === Logging Section === -->
            <Separator Margin="0,20,0,10"/>
            <TextBlock Text="רישום לוג (Logging)" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="כאשר מופעל, המערכת שומרת קובץ לוג יומי לאבחון תקלות." 
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <CheckBox Content="הפעל רישום לוג לקובץ"
                      IsChecked="{Binding Settings.LoggingEnabled, Mode=TwoWay}"
                      Margin="0,5,0,10"/>

            <!-- Log folder settings (only enabled when logging is ON) -->
            <StackPanel IsEnabled="{Binding Settings.LoggingEnabled}">
                <TextBlock Text="תיקיית לוג:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding LogDirectoryDisplay, Mode=OneWay}" 
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="5,3"/>
                    <Button Grid.Column="1" 
                            Content="בחר..." 
                            Click="BrowseLogFolder_Click"
                            Width="60" Margin="5,0,0,0"/>
                </Grid>

                <!-- Log folder action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="בדוק כתיבה" Click="TestLogWrite_Click" Width="80" Margin="0,0,5,0"/>
                    <Button Content="פתח תיקייה" Click="OpenLogFolder_Click" Width="80" Margin="0,0,5,0"/>
                    <Button Content="נקה לוגים ישנים" Click="ClearOldLogs_Click" Width="100"/>
                </StackPanel>
            </StackPanel>

            <!-- === My Status Colors === -->
            <Separator Margin="0,20,0,10"/>
            <TextBlock Text="צבעי סטטוס אישיים" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="התאם את הצבעים לטעמך. שינויים משפיעים רק עליך. לחץ 'איפוס' כדי לחזור לברירת המחדל הגלובלית."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <ItemsControl x:Name="UserStatusColorsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding StatusName}" 
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>

                                <xctk:ColorPicker x:Name="UserColorPicker" Grid.Column="1"
                                                  SelectedColor="{Binding ResolvedColorHex, Converter={StaticResource HexToColor}, Mode=TwoWay}"
                                                  ShowStandardColors="True"
                                                  ShowRecentColors="True"
                                                  UsingAlphaChannel="False"
                                                  Width="130"
                                                  Margin="0,0,8,0"
                                                  SelectedColorChanged="UserColorPicker_SelectedColorChanged"
                                                  ToolTip="בחר צבע לסטטוס"/>

                                <!-- Live badge preview (mirrors task grid appearance) -->
                                <Border Grid.Column="2" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                        MinWidth="50" VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedColor, ElementName=UserColorPicker}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding StatusName}" Foreground="#333"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="3" Content="איפוס" 
                                        Click="ResetStatusColor_Click"
                                        Padding="4,2" Margin="4,0,0,0"
                                        ToolTip="חזרה לצבע ברירת המחדל הגלובלית"/>

                                <TextBlock Grid.Column="4" VerticalAlignment="Center" 
                                           Margin="6,0,0,0" Opacity="0.7"
                                           Text="{Binding DefaultColorHex}" 
                                           ToolTip="ברירת מחדל גלובלית"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- === Save Button === -->
            <Button Content="שמור" Margin="0,25,0,0" Click="Save_Click" HorizontalAlignment="Right" Width="80"/>
        </StackPanel>
    </ScrollViewer>
</local:BaseWindow>
