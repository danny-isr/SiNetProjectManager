<Window x:Class="SiNetProjectManager.WPF_Window.AlternativeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:conv="clr-namespace:SiNetProjectManager.Converters"
        Title="Enter Alternative Name"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <DockPanel>
                <TextBlock Foreground="Red"
                   DockPanel.Dock="Bottom"
                   Text="{Binding [0].ErrorContent}" />
                <AdornedElementPlaceholder/>
            </DockPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Alternative Name:"/>
            <TextBox Width="200"
               Margin="0,5,0,0"
               Text="{Binding AlternativeName,
                              UpdateSourceTrigger=PropertyChanged,
                              ValidatesOnNotifyDataErrors=True}"
               Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK"
              IsDefault="True"
              Click="Ok_Click"
              IsEnabled="{Binding IsOkEnabled}" />
            <Button Content="Cancel"
              IsCancel="True"
              Click="Cancel_Click"
              Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
