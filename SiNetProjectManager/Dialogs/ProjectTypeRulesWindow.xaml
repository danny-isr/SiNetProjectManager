<Window x:Class="SiNetProjectManager.Dialogs.ProjectTypeRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
        Title="הגדרות חוקי סוג פרויקט"
        Width="800" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="450"
        Closing="Window_Closing"
        Background="{DynamicResource AppBackground}">

    <!-- DataContext set in code-behind via DI -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        
        <Style TargetType="Button" x:Key="AddButton">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#E3F2FD"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: ProjectType Selector -->
        <Border Grid.Row="0" Background="#E8F4FC" Padding="10" CornerRadius="4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="סוג פרויקט:" 
                           FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProjectTypes}"
                          SelectedItem="{Binding SelectedProjectType}"
                          DisplayMemberPath="Title"
                          VerticalContentAlignment="Center"/>

                <ProgressBar Grid.Column="2" 
                             IsIndeterminate="True" 
                             Width="60" Height="8"
                             Margin="10,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Main Content: Two Sections Side by Side -->
        <Grid Grid.Row="1" Visibility="{Binding HasSelectedProjectType, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Task Types (RTL — appears on right visually) -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8">
                        <Grid>
                            <TextBlock Text="סוגי משימה מותרים" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TaskTypeRules.Count, StringFormat='({0})'}" 
                                       HorizontalAlignment="Left" Margin="130,0,0,0"
                                       Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,5,5,0">
                        <Button Content="בחר הכל" 
                                Command="{Binding SelectAllTaskTypesCommand}"
                                Style="{StaticResource SmallButton}"/>
                        <Button Content="בטל הכל" 
                                Command="{Binding DeselectAllTaskTypesCommand}"
                                Style="{StaticResource SmallButton}"/>
                        <Button Content="+ הוסף סוג משימה" 
                                Command="{Binding ShowAddTaskTypeCommand}"
                                Style="{StaticResource AddButton}"
                                Margin="10,2,2,2"/>
                    </StackPanel>

                    <!-- TaskType List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5">
                        <ItemsControl ItemsSource="{Binding TaskTypeRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Name}" 
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>

                                            <TextBlock Grid.Column="2" 
                                                       Text="●" 
                                                       Foreground="Orange"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasChanged, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="שונה"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add TaskType Form -->
                    <Border Grid.Row="3" 
                            Background="#E3F2FD" 
                            Padding="8" 
                            Visibility="{Binding IsAddingTaskType, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="הוספת סוג משימה חדש" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="שם:" VerticalAlignment="Center" Margin="0,0,5,3"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                         Text="{Binding NewTaskTypeName, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,3"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="סדר:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                                         Text="{Binding NewTaskTypeSortOrder}" 
                                         Width="60" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button Content="הוסף" Command="{Binding AddTaskTypeCommand}" Padding="10,3"/>
                                <Button Content="ביטול" Command="{Binding CancelAddTaskTypeCommand}" Padding="10,3" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Separator -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Statuses -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10,8">
                        <Grid>
                            <TextBlock Text="סטטוסים מותרים" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusRules.Count, StringFormat='({0})'}" 
                                       HorizontalAlignment="Left" Margin="110,0,0,0"
                                       Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,5,5,0">
                        <Button Content="בחר הכל" 
                                Command="{Binding SelectAllStatusesCommand}"
                                Style="{StaticResource SmallButton}"/>
                        <Button Content="בטל הכל" 
                                Command="{Binding DeselectAllStatusesCommand}"
                                Style="{StaticResource SmallButton}"/>
                        <Button Content="+ הוסף סטטוס" 
                                Command="{Binding ShowAddStatusCommand}"
                                Style="{StaticResource AddButton}"
                                Margin="10,2,2,2"/>
                    </StackPanel>

                    <!-- Status List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5">
                        <ItemsControl ItemsSource="{Binding StatusRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>

                                            <!-- Name - Display Mode -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Name}" 
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Name - Edit Mode -->
                                            <TextBox Grid.Column="1" 
                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" 
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Margin="8,0,0,0"
                                                     Padding="3,2"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Open/Closed indicator - Display Mode -->
                                            <Border Grid.Column="2" 
                                                    Padding="4,2" 
                                                    CornerRadius="3"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EEEEEE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="סגור"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                    <Setter Property="Text" Value="פתוח"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Open/Closed - Edit Mode -->
                                            <CheckBox Grid.Column="2" 
                                                      Content="פתוח"
                                                      IsChecked="{Binding EditIsOpen}"
                                                      VerticalAlignment="Center"
                                                      Margin="5,0"
                                                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                                            <!-- Edit / Save / Cancel buttons -->
                                            <Button Grid.Column="3" 
                                                    Content="✏️" 
                                                    Padding="4,2"
                                                    Margin="3,0"
                                                    Cursor="Hand"
                                                    ToolTip="ערוך סטטוס"
                                                    Command="{Binding DataContext.BeginEditStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <StackPanel Grid.Column="3" 
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <Button Content="✓" 
                                                        Padding="4,2" Margin="2,0"
                                                        FontWeight="Bold" 
                                                        Foreground="#2E7D32"
                                                        ToolTip="אשר שינוי"
                                                        Command="{Binding DataContext.ConfirmEditStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✗" 
                                                        Padding="4,2" Margin="2,0"
                                                        Foreground="#C62828"
                                                        ToolTip="בטל עריכה"
                                                        Command="{Binding DataContext.CancelEditStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4" 
                                                       Text="●" 
                                                       Foreground="Orange"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasChanged, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="שונה"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Status Form -->
                    <Border Grid.Row="3" 
                            Background="#E3F2FD" 
                            Padding="8" 
                            Visibility="{Binding IsAddingStatus, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="הוספת סטטוס חדש" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="שם:" VerticalAlignment="Center" Margin="0,0,5,3"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                         Text="{Binding NewStatusName, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,3"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="סוג:" VerticalAlignment="Center" Margin="0,0,5,3"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" 
                                          Content="סטטוס פתוח (משימה פעילה)"
                                          IsChecked="{Binding NewStatusIsOpen}"
                                          Margin="0,0,0,3"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="סדר:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" 
                                         Text="{Binding NewStatusSortOrder}" 
                                         Width="60" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button Content="הוסף" Command="{Binding AddStatusCommand}" Padding="10,3"/>
                                <Button Content="ביטול" Command="{Binding CancelAddStatusCommand}" Padding="10,3" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="8,4" Margin="0,8,0,0" CornerRadius="3">
            <TextBlock Text="{Binding StatusMessage}" 
                       Opacity="0.8"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Save / Reset Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="💾  שמור שינויים" 
                    Command="{Binding SaveCommand}" 
                    Padding="14,6" 
                    MinWidth="120"
                    FontWeight="Bold"
                    Background="#4CAF50" Foreground="White"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="↩  בטל שינויים" 
                    Command="{Binding ResetCommand}" 
                    Padding="14,6" 
                    MinWidth="100"
                    Margin="0,0,8,0"/>
            <TextBlock Text="● שינויים שלא נשמרו" 
                       Foreground="Orange" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>
