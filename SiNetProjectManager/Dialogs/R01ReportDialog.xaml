<Window x:Class="SiNetProjectManager.Dialogs.R01ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetProjectManager.ViewModels"
        Title="דוח R01 - תיק פרויקטים"
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Window.DataContext>
        <vm:R01ReportViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="דוח תיק פרויקטים - R01" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="הדוח יווצר כקובץ Google Sheets בתיקיית הדוחות המשותפת" 
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Filters -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,15">
            <StackPanel IsEnabled="{Binding CanEditFilters}">

                <!-- Customer Multi-Select with Search -->
                <TextBlock Text="לקוח" Style="{StaticResource HeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Customer selector toggle button -->
                    <ToggleButton x:Name="CustomerSelectorToggle" 
                                  Grid.Column="0"
                                  HorizontalContentAlignment="Right"
                                  Padding="8,6"
                                  Style="{StaticResource FieldStyle}">
                        <TextBlock Text="{Binding SelectedCustomersSummary}" TextTrimming="CharacterEllipsis"/>
                    </ToggleButton>

                    <!-- Clear selection button -->
                    <Button Grid.Column="1" 
                            Content="נקה" 
                            Command="{Binding ClearCustomerSelectionCommand}"
                            Padding="8,4"
                            Margin="5,3,0,3"
                            ToolTip="נקה בחירה - חזור לכל הלקוחות"/>

                    <!-- Customer selection popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=CustomerSelectorToggle, Mode=TwoWay}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=CustomerSelectorToggle}"
                           Placement="Bottom"
                           Width="{Binding ActualWidth, ElementName=CustomerSelectorToggle}"
                           MaxHeight="300">
                        <Border Background="White" 
                                BorderBrush="#CCCCCC" 
                                BorderThickness="1"
                                Padding="5">
                            <StackPanel>
                                <!-- Search box -->
                                <TextBox Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5,3"
                                         Margin="0,0,0,5"/>

                                <!-- Customers list with checkboxes -->
                                <ListBox ItemsSource="{Binding FilteredCustomers}"
                                         MaxHeight="220"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="2">
                                                <TextBlock Text="{Binding Name}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Project Multi-Select with Search -->
                <TextBlock Text="פרויקטים" Style="{StaticResource HeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project selector toggle button -->
                    <ToggleButton x:Name="ProjectSelectorToggle" 
                                  Grid.Column="0"
                                  HorizontalContentAlignment="Right"
                                  Padding="8,6"
                                  Style="{StaticResource FieldStyle}">
                        <TextBlock Text="{Binding SelectedProjectsSummary}" TextTrimming="CharacterEllipsis"/>
                    </ToggleButton>

                    <!-- Clear selection button -->
                    <Button Grid.Column="1" 
                            Content="נקה" 
                            Command="{Binding ClearProjectSelectionCommand}"
                            Padding="8,4"
                            Margin="5,3,0,3"
                            ToolTip="נקה בחירה - חזור לכל הפרויקטים"/>

                    <!-- Project selection popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=ProjectSelectorToggle, Mode=TwoWay}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=ProjectSelectorToggle}"
                           Placement="Bottom"
                           Width="{Binding ActualWidth, ElementName=ProjectSelectorToggle}"
                           MaxHeight="300">
                        <Border Background="White" 
                                BorderBrush="#CCCCCC" 
                                BorderThickness="1"
                                Padding="5">
                            <StackPanel>
                                <!-- Search box -->
                                <TextBox Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5,3"
                                         Margin="0,0,0,5">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Tag" Value="חפש לפי מספר או שם פרויקט..."/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Projects list with checkboxes -->
                                <ListBox ItemsSource="{Binding FilteredProjects}"
                                         MaxHeight="220"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProjectNum}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" - "/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <TextBlock Text=" (" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding CustomerName, TargetNullValue=''}" Foreground="Gray"/>
                                                    <TextBlock Text=")" Foreground="Gray"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <CheckBox Content="פרויקטים פעילים בלבד" 
                          IsChecked="{Binding ActiveProjectsOnly}"
                          Margin="0,8,0,0"/>

                <!-- Hour Price -->
                <TextBlock Text="מחיר לשעה" Style="{StaticResource HeaderStyle}"/>
                <TextBox Text="{Binding HourPrice, StringFormat={}{0:N0}, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldStyle}"
                         Width="120"
                         HorizontalAlignment="Right"/>

                <!-- Progress -->
                <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <TextBlock Text="{Binding ProgressMessage}" FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="20" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Results -->
                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <Border Padding="10" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF0F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FFF0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" FontWeight="Bold" FontSize="13"/>

                            <!-- Success: Show URL button -->
                            <Button Content="פתח בדפדפן →" 
                                    Command="{Binding OpenUrlCommand}"
                                    Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0"
                                    Padding="15,8"
                                    Background="#4285F4"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>

                            <!-- Details -->
                            <TextBlock Text="{Binding ResultDetails}" 
                                       Margin="0,10,0,0" 
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="צור דוח" 
                    Command="{Binding GenerateCommand}"
                    Width="100" Height="35" 
                    FontWeight="Bold"
                    Background="#2E7D32"
                    Foreground="White"/>
            <Button Content="ביטול" 
                    Command="{Binding CancelCommand}"
                    Width="80" Height="35" 
                    Margin="10,0,0,0"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
            <Button Content="סגור" 
                    Click="CloseButton_Click"
                    Width="80" Height="35" 
                    Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
