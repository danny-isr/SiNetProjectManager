<Window x:Class="SiNetProjectManager.Dialogs.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetSQL.MVVM;assembly=SiNetSQL"
        Title="הוספת משתמש חדש"
        Width="520" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="480" MinHeight="700"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">
    <!-- DataContext is set from code-behind via DI (AddUserViewModel requires IDbContextFactory) -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E3F2FD" Padding="15,10" CornerRadius="4" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="הוספת משתמש חדש למערכת" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="#1565C0"/>
                <TextBlock Text="התפקיד נקבע לפי התפקיד שנבחר" 
                           FontSize="11" Foreground="#666" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- ═══ Active Directory Import ═══ -->
            <Border Background="#E8F5E9" Padding="12,10" CornerRadius="4" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📂 ייבוא מ-Active Directory"
                                   FontWeight="Bold" FontSize="13" Foreground="#2E7D32"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="🔄 טען משתמשי דומיין"
                                Command="{Binding LoadAdUsersCommand}"
                                Padding="10,4" FontSize="12"/>
                    </Grid>

                    <!-- Loading indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsLoadingAd, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="0,0,8,0"/>
                        <TextBlock Text="טוען משתמשי דומיין..." Foreground="#666" FontSize="11"/>
                    </StackPanel>

                    <!-- Search + List (visible after loading) -->
                    <StackPanel Visibility="{Binding HasAdUsers, Converter={StaticResource BoolToVis}}"
                                Margin="0,8,0,0">
                        <TextBox Text="{Binding AdSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" FontSize="12"
                                 Tag="🔍 חפש לפי שם, login או מייל..."/>

                        <ListBox ItemsSource="{Binding FilteredAdUsers}"
                                 SelectedItem="{Binding SelectedAdUser}"
                                 MaxHeight="130"
                                 Margin="0,4,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding LoginName}" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Margin="0,0,0,15" Background="#E0E0E0"/>

            <!-- Name -->
            <TextBlock Text="שם *" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     MaxLength="100"/>

            <!-- LoginName -->
            <TextBlock Text="שם התחברות (LoginName) *" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     MaxLength="100"
                     ToolTip="לדוגמה: DOMAIN\username או username"/>

            <!-- Email -->
            <TextBlock Text="דוא&quot;ל" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     MaxLength="200"/>

            <!-- Notes -->
            <TextBlock Text="הערות" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource InputStyle}"
                     MaxLength="500"
                     Height="50"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Role (Application Permission Level) -->
            <TextBlock Text="תפקיד *" Style="{StaticResource LabelStyle}"/>
            <Border Background="#FFF8E1" Padding="12,10" CornerRadius="4" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox Grid.Row="0"
                              ItemsSource="{Binding AppUserRoles}"
                              SelectedItem="{Binding SelectedRole}"
                              FontSize="13" Padding="6,4" Margin="0,0,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static vm:UserManagementConverters.RoleToHebrew}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" 
                               Text="{Binding RoleDescription}" 
                               FontSize="11" Foreground="#666" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Validation Message -->
        <Border Grid.Row="2" 
                Background="#FFEBEE" 
                Padding="10,8" 
                CornerRadius="4"
                Margin="0,15,0,0"
                Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ValidationMessage}" 
                       Foreground="#C62828" 
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Saving indicator -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                        Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="0,0,10,0"/>
                <TextBlock Text="שומר..." Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="ביטול" 
                    Command="{Binding CancelCommand}"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Grid.Column="2" 
                    Content="שמור"
                    Command="{Binding SaveCommand}"
                    Padding="25,10"
                    FontWeight="Bold"
                    IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#388E3C"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCC"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="BorderBrush" Value="#AAA"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
