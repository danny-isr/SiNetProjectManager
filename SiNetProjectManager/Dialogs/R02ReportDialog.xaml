<Window x:Class="SiNetProjectManager.Dialogs.R02ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetProjectManager.ViewModels"
        Title="דוח R02 - שעות עבודה"
        Height="650" Width="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Window.DataContext>
        <vm:R02ReportViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="דוח שעות עבודה - R02" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="הדוח יווצר כקובץ Google Sheets בתיקיית הדוחות המשותפת" 
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Filters -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,15">
            <StackPanel IsEnabled="{Binding CanEditFilters}">

                <!-- Date Range -->
                <TextBlock Text="טווח תאריכים" Style="{StaticResource HeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" 
                                SelectedDate="{Binding StartDate}"
                                Style="{StaticResource FieldStyle}"/>
                    <TextBlock Grid.Column="1" Text=" עד " VerticalAlignment="Center" Margin="10,0"/>
                    <DatePicker Grid.Column="2" 
                                SelectedDate="{Binding EndDate}"
                                Style="{StaticResource FieldStyle}"/>
                </Grid>

                <!-- Customer Multi-Select with Search -->
                <TextBlock Text="לקוח" Style="{StaticResource HeaderStyle}"/>
                <Grid Style="{StaticResource FieldStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" 
                                  x:Name="CustomerSelectorToggle"
                                  IsChecked="{Binding IsCustomerPopupOpen, Mode=TwoWay}"
                                  HorizontalContentAlignment="Right"
                                  Padding="8,6">
                        <ToggleButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedCustomersSummary}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text=" ▼" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Button Grid.Column="1" 
                            Content="נקה" 
                            Command="{Binding ClearCustomerSelectionCommand}"
                            Padding="8,6" 
                            Margin="5,0,0,0"
                            ToolTip="נקה בחירת לקוחות"/>

                    <Popup IsOpen="{Binding IsChecked, ElementName=CustomerSelectorToggle}"
                           PlacementTarget="{Binding ElementName=CustomerSelectorToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <Border Background="White" 
                                BorderBrush="#CCC" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Width="{Binding ActualWidth, ElementName=CustomerSelectorToggle}"
                                MinWidth="300"
                                MaxHeight="350">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" 
                                         Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5"
                                         Padding="5"
                                         FlowDirection="RightToLeft">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Right">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="🔍 חפש לקוח..." Foreground="Gray" Margin="5,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding FilteredCustomers}"
                                         MaxHeight="280"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="3"
                                                      FlowDirection="RightToLeft">
                                                <TextBlock Text="{Binding Name}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Project Multi-Select with Search -->
                <TextBlock Text="פרויקט" Style="{StaticResource HeaderStyle}"/>
                <Grid Style="{StaticResource FieldStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toggle Button to open popup -->
                    <ToggleButton Grid.Column="0" 
                                  x:Name="ProjectSelectorToggle"
                                  IsChecked="{Binding IsProjectPopupOpen, Mode=TwoWay}"
                                  HorizontalContentAlignment="Right"
                                  Padding="8,6">
                        <ToggleButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedProjectsSummary}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text=" ▼" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <!-- Clear button -->
                    <Button Grid.Column="1" 
                            Content="נקה" 
                            Command="{Binding ClearProjectSelectionCommand}"
                            Padding="8,6" 
                            Margin="5,0,0,0"
                            ToolTip="נקה בחירת פרויקטים"/>

                    <!-- Popup with search + checkboxes -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=ProjectSelectorToggle}"
                           PlacementTarget="{Binding ElementName=ProjectSelectorToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <Border Background="White" 
                                BorderBrush="#CCC" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Width="{Binding ActualWidth, ElementName=ProjectSelectorToggle}"
                                MinWidth="300"
                                MaxHeight="350">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Search box -->
                                <TextBox Grid.Row="0" 
                                         Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5"
                                         Padding="5"
                                         FlowDirection="RightToLeft">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Right">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="🔍 חפש פרויקט..." Foreground="Gray" Margin="5,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Project list with checkboxes -->
                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding FilteredProjects}"
                                         MaxHeight="280"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="3"
                                                      FlowDirection="RightToLeft">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProjectNum}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" - "/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <CheckBox Content="פרויקטים פעילים בלבד" 
                          IsChecked="{Binding ActiveProjectsOnly}"
                          Margin="0,5,0,0"/>

                <!-- Employee Multi-Select with Search -->
                <TextBlock Text="עובד" Style="{StaticResource HeaderStyle}"/>
                <Grid Style="{StaticResource FieldStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" 
                                  x:Name="EmployeeSelectorToggle"
                                  IsChecked="{Binding IsEmployeePopupOpen, Mode=TwoWay}"
                                  HorizontalContentAlignment="Right"
                                  Padding="8,6">
                        <ToggleButton.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedEmployeesSummary}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text=" ▼" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Button Grid.Column="1" 
                            Content="נקה" 
                            Command="{Binding ClearEmployeeSelectionCommand}"
                            Padding="8,6" 
                            Margin="5,0,0,0"
                            ToolTip="נקה בחירת עובדים"/>

                    <Popup IsOpen="{Binding IsChecked, ElementName=EmployeeSelectorToggle}"
                           PlacementTarget="{Binding ElementName=EmployeeSelectorToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <Border Background="White" 
                                BorderBrush="#CCC" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Width="{Binding ActualWidth, ElementName=EmployeeSelectorToggle}"
                                MinWidth="300"
                                MaxHeight="350">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" 
                                         Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5"
                                         Padding="5"
                                         FlowDirection="RightToLeft">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Right">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="🔍 חפש עובד..." Foreground="Gray" Margin="5,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding FilteredEmployees}"
                                         MaxHeight="280"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="3"
                                                      FlowDirection="RightToLeft">
                                                <TextBlock Text="{Binding FullName}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <CheckBox Content="עובדים פעילים בלבד" 
                          IsChecked="{Binding ActiveEmployeesOnly}"
                          Margin="0,5,0,0"/>

                <!-- Options -->
                <TextBlock Text="אפשרויות" Style="{StaticResource HeaderStyle}"/>
                <CheckBox Content="הסתר דיווחים עם 0 שעות" 
                          IsChecked="{Binding ExcludeZeroHours}"
                          Margin="0,3,0,0"/>
                <CheckBox Content="ייצוא ללקוח (שדות מוגבלים)" 
                          IsChecked="{Binding IsClientExport}"
                          Margin="0,5,0,0"/>

                <!-- Progress -->
                <StackPanel Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <TextBlock Text="{Binding ProgressMessage}" FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="20" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Results -->
                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <Border Padding="10" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFF0F0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FFF0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" FontWeight="Bold" FontSize="13"/>
                            
                            <Button Content="פתח בדפדפן →" 
                                    Command="{Binding OpenUrlCommand}"
                                    Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0"
                                    Padding="15,8"
                                    Background="#4285F4"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand"/>
                            
                            <TextBlock Text="{Binding ResultDetails}" 
                                       Margin="0,10,0,0" 
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="צור דוח" 
                    Command="{Binding GenerateCommand}"
                    Width="100" Height="35" 
                    FontWeight="Bold"
                    Background="#2E7D32"
                    Foreground="White"/>
            <Button Content="ביטול" 
                    Command="{Binding CancelCommand}"
                    Width="80" Height="35" 
                    Margin="10,0,0,0"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
            <Button Content="סגור" 
                    Click="CloseButton_Click"
                    Width="80" Height="35" 
                    Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
