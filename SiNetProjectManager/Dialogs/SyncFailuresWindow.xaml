<Window x:Class="SiNetProjectManager.Dialogs.SyncFailuresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠ Sync Failures Detected"
        Height="450" Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#C62828"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource HeaderText}"
                       Text="Daily Sync failures detected in the last 7 days:"/>
            <TextBlock x:Name="SubHeaderText" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Failures Grid -->
        <DataGrid Grid.Row="1"
                  x:Name="FailuresGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  AlternatingRowBackground="#F5F5F5"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Failed At"
                                    Binding="{Binding FailedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                    Width="155"/>
                <DataGridTextColumn Header="Stage"
                                    Binding="{Binding ErrorStage}"
                                    Width="140"/>
                <DataGridTextColumn Header="Error Type"
                                    Binding="{Binding ErrorType}"
                                    Width="200"/>
                <DataGridTextColumn Header="Error Message"
                                    Binding="{Binding ErrorMessageTruncated}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DetailsButton"
                    Content="Open Full Details"
                    Padding="12,6" Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="OpenDetails_Click"/>
            <Button Content="Close"
                    Padding="12,6"
                    IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
