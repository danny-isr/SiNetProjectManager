<Window x:Class="SiNetProjectManager.Dialogs.DownloadAssociationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="קובץ התקבל"
        Width="480" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E3F2FD" Padding="12,8" CornerRadius="4" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="📥 קובץ הורד בהצלחה" 
                           FontSize="15" FontWeight="Bold" 
                           Foreground="#1565C0"/>
                <TextBlock x:Name="FileNameText"
                           FontSize="12" Foreground="#555" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="36"/>
            </StackPanel>
        </Border>

        <!-- Project Info -->
        <Border Grid.Row="1" Background="#F1F8E9" Padding="10,8" CornerRadius="4" Margin="0,0,0,8"
                x:Name="ProjectInfoBorder">
            <StackPanel>
                <TextBlock Text="📂 פרויקט משויך:" 
                           FontSize="12" FontWeight="SemiBold" Foreground="#33691E"/>
                <TextBlock x:Name="ProjectNameText"
                           FontSize="13" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Question -->
        <TextBlock Grid.Row="2" x:Name="QuestionText"
                   Text="האם להעלות את הקובץ ל-ACC?"
                   FontSize="13" Foreground="#333" Margin="0,4,0,0"
                   VerticalAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="UploadAccButton"
                    Content="☁ העלה ל-ACC" 
                    Click="UploadToAcc_Click"
                    IsDefault="True"
                    Padding="14,8" MinWidth="120" Margin="0,0,8,0"
                    FontWeight="SemiBold" FontSize="13"
                    Background="#C8E6C9" BorderBrush="#81C784"
                    ToolTip="שמור מקומית והעלה ל-ACC Inbox"/>
            <Button x:Name="SaveButton"
                    Content="💾 שמור להורדות" 
                    Click="SaveToDownloads_Click"
                    Padding="14,8" MinWidth="120" Margin="0,0,8,0"
                    FontSize="13"
                    ToolTip="שמור מקומית בלבד (ללא העלאה ל-ACC)"/>
            <Button Content="ביטול" 
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="14,8" MinWidth="70"
                    FontSize="13" Foreground="#999"/>
        </StackPanel>
    </Grid>
</Window>
