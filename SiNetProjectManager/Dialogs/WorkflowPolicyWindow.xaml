<Window x:Class="SiNetProjectManager.Dialogs.WorkflowPolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול תהליכים לפי סוג פרויקט"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="420"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="בחר סוג פרויקט משמאל, וסמן את תהליכי העבודה המותרים עבורו מימין. סימון ⭐ = ברירת מחדל."
                       TextWrapping="Wrap" Foreground="#1565C0" FontSize="12"/>
        </Border>

        <!-- Main: Two-panel layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: ProjectType list -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="סוגי פרויקט" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="ProjectTypeSearchBox"
                             TextChanged="ProjectTypeSearchBox_TextChanged"
                             Padding="6,4" Margin="6,6,6,2"
                             Tag="🔍 חיפוש סוג..."/>

                    <ListBox Grid.Row="2"
                             x:Name="ProjectTypeListBox"
                             SelectionChanged="ProjectTypeListBox_SelectionChanged"
                             BorderThickness="0"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MappingCount, StringFormat=' ({0})'}"
                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Workflow definitions checklist -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="SelectedTypeHeader"
                                   Text="בחר סוג פרויקט..."
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="WorkflowListBox"
                             BorderThickness="0"
                             Padding="4"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Checked="WorkflowCheckBox_Changed"
                                              Unchecked="WorkflowCheckBox_Changed"
                                              VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DefinitionName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DefinitionDescription}"
                                                   Foreground="Gray" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="2"
                                                  IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                  Content="⭐"
                                                  ToolTip="ברירת מחדל"
                                                  FontSize="14"
                                                  Width="32" Height="28"
                                                  Margin="4,0,0,0"
                                                  IsEnabled="{Binding IsEnabled}"
                                                  Checked="DefaultToggle_Changed"
                                                  Unchecked="DefaultToggle_Changed"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: Save / Close -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="💾 שמור" Padding="14,6" Margin="0,0,8,0"
                        Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"
                        Click="Save_Click"
                        ToolTip="שמור את כל השינויים"/>

                <Button Content="סגור" Padding="14,6"
                        Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
