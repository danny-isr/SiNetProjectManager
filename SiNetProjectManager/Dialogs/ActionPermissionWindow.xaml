<Window x:Class="SiNetProjectManager.Dialogs.ActionPermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול הרשאות פעולות"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="550" MinHeight="400"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="בחר פעולה מהרשימה משמאל, וסמן את המשתמשים המורשים לבצע אותה מימין."
                       TextWrapping="Wrap" Foreground="#1565C0" FontSize="12"/>
        </Border>

        <!-- Main: Two-panel layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Action types list -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="פעולות" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="ActionListBox"
                             SelectionChanged="ActionListBox_SelectionChanged"
                             BorderThickness="0"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AuthorizedCount, StringFormat=' ({0})'}"
                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Users checklist for selected action -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="SelectedActionHeader"
                                   Text="בחר פעולה..."
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <!-- Search box -->
                    <TextBox Grid.Row="1" x:Name="UserSearchBox"
                             TextChanged="UserSearchBox_TextChanged"
                             Padding="6,4" Margin="6,6,6,2"
                             Tag="🔍 חיפוש עובד..."/>
                    
                    <!-- User checkboxes -->
                    <ListBox Grid.Row="2"
                             x:Name="UserListBox"
                             BorderThickness="0"
                             Padding="4"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAuthorized, Mode=TwoWay}"
                                          Checked="UserCheckBox_Changed"
                                          Unchecked="UserCheckBox_Changed"
                                          Margin="2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserName}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UserEmail, StringFormat=' ({0})'}"
                                                   Foreground="Gray" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: Save / Close -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="💾 שמור" Padding="14,6" Margin="0,0,8,0"
                        Background="#C8E6C9" BorderBrush="#66BB6A" FontWeight="Bold"
                        Click="Save_Click"
                        ToolTip="שמור את כל השינויים"/>

                <Button Content="סגור" Padding="14,6"
                        Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
