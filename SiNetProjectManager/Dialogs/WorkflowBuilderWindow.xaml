<Window x:Class="SiNetProjectManager.Dialogs.WorkflowBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בונה תהליכים ומשימות"
        Width="960" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="750" MinHeight="480"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource AppFontSize}"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TreeLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="#1565C0" FontSize="12"
                       Text="עץ תהליכים: בחר תהליך ← שלב ← משימה. ניתן להוסיף משימות לשלבים ולשייך עובד ברירת מחדל."/>
        </Border>

        <!-- ═══ Main: Tree + Detail ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: The Tree -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="עץ תהליכים" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="🔄 רענן"
                                    Click="Refresh_Click" Padding="6,2" FontSize="11"/>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1" x:Name="WorkflowTree"
                              BorderThickness="0" Padding="4"
                              SelectedItemChanged="WorkflowTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Detail panel — changes based on selection -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" CornerRadius="4,4,0,0">
                        <TextBlock x:Name="DetailHeader" Text="בחר פריט מהעץ..."
                                   FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <StackPanel x:Name="DetailPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Footer ═══ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>

            <Button Grid.Column="1" Content="סגור" Padding="14,6"
                    Click="Close_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
