<Window x:Class="SiNetProjectManager.Dialogs.ExternalBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="דפדפן חיצוני"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- URL Bar -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="🌐 " VerticalAlignment="Center" FontSize="14"
                           DockPanel.Dock="Left" Margin="0,0,6,0"/>
                <TextBlock x:Name="UrlText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#555"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- WebView2 (clean — no Gmail/Calendar scripts) -->
        <wv2:WebView2 x:Name="BrowserWebView" Grid.Row="1"/>
    </Grid>
</Window>
