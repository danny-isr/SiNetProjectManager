<Window x:Class="SiNetProjectManager.Dialogs.R03ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SiNetProjectManager.ViewModels"
        Title="דוח R03 - השוואת נוכחות"
        Height="700" Width="850"
        MinHeight="580" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}">

    <Window.DataContext>
        <vm:R03ReportViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="דוח השוואת נוכחות - R03" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="השוואה בין שעות נוכחות לשעות מדווחות לפי עובד ויום" 
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" IsEnabled="{Binding CanEditFilters}" Margin="0,15,0,10">

            <!-- Month/Year -->
            <TextBlock Text="חודש ושנה" Style="{StaticResource HeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableMonths}"
                          SelectedValue="{Binding SelectedMonth}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource FieldStyle}"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding AvailableYears}"
                          SelectedItem="{Binding SelectedYear}"
                          Width="80"
                          Style="{StaticResource FieldStyle}"/>
            </Grid>

            <!-- Employee Multi-Select -->
            <TextBlock Text="עובדים" Style="{StaticResource HeaderStyle}"/>
            <Grid Style="{StaticResource FieldStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              x:Name="EmployeeSelectorToggle"
                              IsChecked="{Binding IsEmployeePopupOpen, Mode=TwoWay}"
                              HorizontalContentAlignment="Right"
                              Padding="8,6">
                    <ToggleButton.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedEmployeesSummary}" 
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text=" ▼" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </ToggleButton.Content>
                </ToggleButton>

                <Button Grid.Column="1" 
                        Content="נקה" 
                        Command="{Binding ClearEmployeeSelectionCommand}"
                        Padding="8,6" Margin="5,0,0,0"
                        ToolTip="נקה בחירת עובדים"
                        Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>

                <Popup IsOpen="{Binding IsChecked, ElementName=EmployeeSelectorToggle}"
                       PlacementTarget="{Binding ElementName=EmployeeSelectorToggle}"
                       Placement="Bottom"
                       StaysOpen="False"
                       Width="{Binding ActualWidth, ElementName=EmployeeSelectorToggle}">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <TextBox Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,5"
                                     Padding="4"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredEmployees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding Name}"
                                                      Margin="2"
                                                      IsEnabled="{Binding DataContext.IsAdminMode, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

        </StackPanel>

        <!-- Data Grid (employee view) -->
        <Grid Grid.Row="2" Visibility="{Binding HasViewData, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding ViewDailyRows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9"
                      HeadersVisibility="Column"
                      FlowDirection="RightToLeft"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="0,0,0,5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="עובד" Binding="{Binding EmployeeName}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="יום" Binding="{Binding DayName}" Width="60"/>
                    <DataGridTextColumn Header="נוכחות" Binding="{Binding AttendanceHours, StringFormat=N2}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="מדווח" Binding="{Binding ReportedHours, StringFormat=N2}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="הפרש" Binding="{Binding Difference, StringFormat=N2}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNegativeDifference}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" Text="{Binding ViewSummary}" FontWeight="Bold" FontSize="13"
                       Margin="0,3,0,5" Foreground="#333"/>
        </Grid>

        <!-- Progress & Result -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ProgressMessage}" FontSize="11" Foreground="Gray" Margin="0,3,0,0"
                       Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>

            <!-- Result -->
            <Border Margin="0,5,0,0" Padding="10" CornerRadius="4"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFEEEE"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                                <Setter Property="Background" Value="#FFEEFFEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ResultMessage}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultDetails}" FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="פתח בדפדפן" Command="{Binding OpenUrlCommand}"
                            Margin="0,5,0,0" Padding="10,5" HorizontalAlignment="Right"
                            Visibility="{Binding ResultSuccess, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="הצג נתונים" Command="{Binding ViewCommand}"
                    Padding="15,8" Margin="0,0,10,0"
                    ToolTip="הצגת נתוני נוכחות באפליקציה"/>
            <Button Content="צור דוח בגוגל" Command="{Binding GenerateCommand}"
                    Padding="15,8" FontWeight="Bold" Margin="0,0,10,0"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
                    ToolTip="יצירת דוח בגוגל שיטס (הנהלה בלבד)"/>
            <Button Content="ביטול" Command="{Binding CancelCommand}"
                    Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="סגור" Click="CloseButton_Click" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
